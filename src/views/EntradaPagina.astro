---
import { getCollection, getEntry, render } from 'astro:content';
import PostLayout from '../layouts/PostLayout.astro';
import EntradaGaleria from '../components/EntradaGaleria.astro';
import EntradaImagen from '../components/EntradaImagen.astro';
import EntradaBanner from '../components/EntradaBanner.astro';
import EntradaLibro from '../components/EntradaLibro.astro';
import { normalizeTitleText } from '../lib/text';
import { datosPortada } from '../lib/portada';

const { entrada } = Astro.props;
const { Content } = await render(entrada);

const autor = await getEntry('autores', entrada.data.autor);
const categoria = await getEntry('categorias', entrada.data.categoria);
const traductor = entrada.data.traducidoPor
  ? await getEntry('autores', entrada.data.traducidoPor)
  : null;
const tituloEntrada = normalizeTitleText(entrada.data.titulo);

// Un espacio de galería o de imagen individual sin imagen (Keystatic lo guarda como `- {}`
// si el campo no era obligatorio) se ignora en vez de romper la entrada.
const galeriaConImagen = (entrada.data.galeria ?? []).filter(
  (item): item is typeof item & { imagen: string } => !!item.imagen
);
const individualesConImagen = (entrada.data.imagenesIndividuales ?? []).filter(
  (item): item is typeof item & { imagen: string } => !!item.imagen
);

const formattedDate = entrada.data.fecha.toLocaleDateString('es-ES', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});

// Con portada, el banner de estampilla reemplaza a la cabecera centrada: lleva la misma
// información (categoría, título, autor, fecha, traducción), así que mantener las dos la
// duplicaría. Sin portada —hoy 309 de 324 entradas— la cabecera queda intacta.
const portada = entrada.data.portada;
const { orientacion, maxAncho } = datosPortada(portada);
---

<PostLayout
  title={entrada.data.metaTitulo || tituloEntrada}
  description={entrada.data.metaDescripcion || entrada.data.extracto}
>
  {
    portada && (
      <EntradaBanner
        slot="banner"
        portada={portada}
        portadaAlt={entrada.data.portadaAlt}
        portadaLeyenda={entrada.data.portadaLeyenda}
        orientacion={orientacion}
        maxAncho={maxAncho}
        titulo={tituloEntrada}
        categoria={categoria ? { id: categoria.id, nombre: categoria.data.nombre } : undefined}
        autor={autor ? { id: autor.id, nombre: autor.data.nombre } : undefined}
        fechaFormateada={formattedDate}
        traductor={traductor ? { id: traductor.id, nombre: traductor.data.nombre } : undefined}
      />
    )
  }

  {/* Cabecera centrada de siempre, solo cuando NO hay portada: con banner estaría repetida,
      y además dejaría un segundo <h1> en el documento. */}
  {!portada && (
  <header class="not-prose mb-8 text-center">
    {
      categoria && (
        <a
          href={`/category/${categoria.id}`}
          class="mb-4 inline-block font-mono text-xs uppercase tracking-widest text-accent no-underline hover:underline"
        >
          {categoria.data.nombre}
        </a>
      )
    }
    <h1 class="font-headline text-5xl leading-[0.9] text-ink md:text-6xl">
      {tituloEntrada}
    </h1>
    <p class="mt-4 font-mono text-xs uppercase tracking-widest text-ink-muted">
      Por{' '}
      {autor && (
        <a
          href={`/autor/${autor.id}`}
          class="text-ink no-underline hover:text-accent"
        >
          {autor.data.nombre}
        </a>
      )}
      {' '}&middot; {formattedDate}
    </p>
    {
      traductor && (
        <p class="mt-1 font-mono text-xs uppercase tracking-widest text-ink-muted">
          Traducción de{' '}
          <a
            href={`/autor/${traductor.id}`}
            class="text-ink no-underline hover:text-accent"
          >
            {traductor.data.nombre}
          </a>
        </p>
      )
    }
  </header>
  )}

  {/* Ya no hace falta la <img hidden> que antes conservaba el texto alternativo de la portada:
      ahora la portada se ve de verdad, con su alt, dentro de EntradaBanner.astro. Mantenerla
      descargaría la imagen dos veces. */}

  <div class="not-prose mb-8 text-center">
    <button
      type="button"
      id="entrada-enter-reading"
      class="hidden items-center gap-2 rounded-full border border-ink/15 bg-surface px-5 py-2 font-mono text-xs uppercase tracking-widest text-ink transition-colors hover:border-accent hover:text-accent"
    >
      ✦ Leer en hojas
    </button>
  </div>

  <div
    id="entrada-content"
    class="drop-cap"
    data-categoria={categoria?.id ?? ''}
  >
    <Content />
  </div>

  {
    individualesConImagen.map((item) => (
      <EntradaImagen
        imagen={item.imagen}
        alt={item.alt}
        leyenda={item.leyenda}
        posicion={item.posicion}
        titulo={tituloEntrada}
      />
    ))
  }

  {
    galeriaConImagen.length > 0 && (
      <EntradaGaleria
        imagenes={galeriaConImagen}
        titulo={tituloEntrada}
        posicion={entrada.data.galeriaPosicion}
      />
    )
  }

  {
    entrada.data.notas && (
      <div class="not-prose mt-12 border-t border-ink/15 pt-8">
        <h2 class="mb-3 font-headline text-2xl text-ink">Notas</h2>
        <p class="whitespace-pre-line font-serif text-sm leading-relaxed text-ink-muted">
          {entrada.data.notas}
        </p>
      </div>
    )
  }

  {
    entrada.data.biografiaAutor && (
      <div class="not-prose mt-12 border-t border-ink/15 pt-8">
        <h2 class="mb-3 font-headline text-2xl text-ink">
          {autor ? autor.data.nombre : 'Sobre el autor'}
        </h2>
        <p class="font-serif text-sm italic leading-relaxed text-ink-muted">
          {entrada.data.biografiaAutor}
        </p>
      </div>
    )
  }

  {
    entrada.data.bibliografia && (
      <div class="not-prose mt-12 border-t border-ink/15 pt-8">
        <h2 class="mb-3 font-headline text-2xl text-ink">Bibliografía</h2>
        <p class="whitespace-pre-line font-serif text-sm leading-relaxed text-ink-muted">
          {entrada.data.bibliografia}
        </p>
      </div>
    )
  }

  {/* El libro de hojas: capa propia a pantalla completa, armada sobre una copia del cuerpo.
      Va al final del markup porque es `position: fixed` y no participa del flujo. */}
  <EntradaLibro />
</PostLayout>

<script>
  import { repartirEnPliegos, objetivoPorPliego } from '../lib/pliegos';

  /**
   * Flujo normal de la entrada: reubica los bloques especiales y arma los pliegos de dos
   * columnas. La lectura inmersiva ya no vive acá: es el libro de hojas
   * (EntradaLibro.astro), que trabaja sobre una COPIA del cuerpo y en su propia capa.
   *
   * Antes había acá un modo lectura que revelaba un párrafo a la vez con efecto de máquina
   * de escribir. Se retiró al introducir el libro: vaciaba este <article>, movía los nodos
   * reales y los reconstruía planos al salir, lo que lo volvía frágil y obligaba a
   * coordinarlo con los pliegos y con los bloques especiales. El libro no tiene ese
   * problema porque nunca toca este DOM.
   *
   * Sin JS: el contenido se lee completo y en flujo, con las dos columnas que pone el CSS,
   * y el botón del libro no aparece (lo muestra el propio script del libro).
   */
  const container = document.getElementById('entrada-content');
  // @astrojs/markdoc envuelve el documento renderizado en su propio <article>, así
  // que los párrafos/versos son nietos de #entrada-content, no hijos directos.
  const blocksRoot = container?.querySelector<HTMLElement>(':scope > article') ?? container;
  // Los bloques especiales (imágenes individuales de EntradaImagen.astro y el carrusel de
  // EntradaGaleria.astro) viven por defecto fuera de #entrada-content, al pie de la entrada.
  // Los que configuraron "después de qué párrafo" (data-posicion) se reubican ACÁ, moviendo
  // el nodo real y no un clon, para que el carrusel y su listener de scroll sigan andando.
  // Varios en la misma posición conservan su orden en el DOM (cada uno se inserta antes del
  // mismo nodo de referencia).
  const especiales = Array.from(document.querySelectorAll<HTMLElement>('[data-bloque-especial]'));
  // Devuelve boolean a propósito (no un predicado de tipo `el is HTMLElement`): con un
  // predicado, TypeScript deja `source` como `never` en la rama contraria.
  const esEspecial = (el: Element | undefined): boolean =>
    !!el && especiales.includes(el as HTMLElement);
  if (blocksRoot) {
    const textos = Array.from(blocksRoot.children);
    especiales.forEach((el) => {
      const posicion = Number(el.dataset.posicion);
      if (Number.isInteger(posicion) && posicion >= 1 && posicion <= textos.length) {
        blocksRoot.insertBefore(el, textos[posicion] ?? null);
      }
    });
  }
  /* ---------- Pliegos: dos columnas de una pantalla de alto ----------
   *
   * Dos columnas equilibradas no sirven para texto largo: en la entrada mediana (10.100
   * caracteres) cada columna mide 2,6 pantallas, así que habría que bajar 2,6 pantallas por la
   * izquierda y volver a subirlas para empezar la derecha. Acá el cuerpo se parte en pliegos de
   * dos columnas que entran en una pantalla, apilados: se lee izquierda, derecha, se baja.
   *
   * CUÁNDO SE LLAMA. Después de la reubicación de los bloques especiales, para que cada uno
   * caiga en el pliego que le toca. La llamada va al final del módulo.
   *
   * Antes esto era delicado: había que agrupar después de que el modo lectura capturara sus
   * bloques, o revelaba pliegos enteros en vez de párrafos y una imagen intercalada podía
   * terminar insertada en un nodo desconectado al salir. El libro de hojas no tiene ese
   * problema porque trabaja sobre una copia y nunca toca este DOM.
   */
  const anchoPliegos = window.matchMedia('(min-width: 1024px)');

  const desagruparPliegos = () => {
    if (!blocksRoot) return;
    const pliegos = Array.from(blocksRoot.querySelectorAll<HTMLElement>(':scope > [data-pliego]'));
    pliegos.forEach((pliego) => {
      while (pliego.firstChild) blocksRoot.insertBefore(pliego.firstChild, pliego);
      pliego.remove();
    });
    blocksRoot.classList.remove('con-pliegos');
  };

  const agruparEnPliegos = () => {
    if (!blocksRoot) return;
    desagruparPliegos();
    if (!anchoPliegos.matches) return;

    const bloques = Array.from(blocksRoot.children) as HTMLElement[];
    if (!bloques.length) return;

    // Se miden TODOS los altos primero y se reparte después: medir y mover en el mismo bucle
    // haría que cada lectura dependiera del movimiento anterior. Los altos se miden con el
    // <article> ya en dos columnas (la regla CSS de arriba), así que son altos de columna.
    const medidos = bloques.map((el) => ({ alto: el.offsetHeight, especial: esEspecial(el) }));
    const reparto = repartirEnPliegos(medidos, objetivoPorPliego(window.innerHeight));

    reparto.forEach((grupo) => {
      const pliego = document.createElement('div');
      pliego.dataset.pliego = '';
      pliego.className = grupo.ancho ? 'entrada-pliego entrada-pliego--ancho' : 'entrada-pliego';
      grupo.indices.forEach((i) => pliego.appendChild(bloques[i]));
      blocksRoot.appendChild(pliego);
    });
    blocksRoot.classList.add('con-pliegos');
    // La barra de progreso de PostLayout.astro mide #post-article: después de agrupar, el
    // documento cambia de alto y hay que recalcularla.
    window.dispatchEvent(new Event('scroll'));
  };

  // Después de la reubicación de los especiales (ver el comentario de agruparEnPliegos).
  agruparEnPliegos();

  // El alto de la pantalla manda el corte de cada pliego, así que hay que rearmarlos al
  // cambiar de tamaño. Con debounce: `resize` dispara decenas de veces al arrastrar el borde
  // de la ventana y cada pliegue vuelve a medir todos los bloques.
  let reagrupar: number | undefined;
  window.addEventListener('resize', () => {
    window.clearTimeout(reagrupar);
    reagrupar = window.setTimeout(agruparEnPliegos, 200);
  });
</script>

<style is:global>
  /* Global y con prefijo #entrada-content porque los elementos que se estilan acá vienen del
     HTML que genera @astrojs/markdoc (via <Content />), no de markup propio de este
     componente: el scoping por componente de Astro no llega ahí de forma confiable. */

  /* ---------- Dos columnas en desktop ----------
     La columna de lectura usaba el max-width de 65ch de Tailwind Typography, unos 650px de
     los 1504px disponibles: sobraba ancho. Ahora el cuerpo va en dos columnas a partir de
     1024px, donde cada una da 47 caracteres por línea (54-60 de 1440px en adelante). Por
     debajo de eso las columnas quedarían demasiado angostas y el cuerpo sigue en una sola,
     igual que antes.

     Esta regla es el SUELO: es lo que se ve sin JS y también en el primer pintado. Encima,
     el script agrupa los bloques en "pliegos" de una pantalla de alto (ver agruparEnPliegos),
     porque dos columnas equilibradas de una entrada mediana miden 2,6 pantallas cada una y
     obligarían a bajar y volver a subir para leer la segunda. Con pliegos se lee
     izquierda-derecha y se baja. */
  @media (min-width: 1024px) {
    #entrada-content > article {
      columns: 2;
      column-gap: 3.5rem;
    }

    /* Ya agrupado en pliegos, las columnas las pone cada pliego: si el <article> siguiera
       con las suyas, repartiría los PLIEGOS en dos columnas. */
    #entrada-content > article.con-pliegos {
      columns: 1;
    }

    .entrada-pliego {
      columns: 2;
      column-gap: 3.5rem;
    }

    /* Un bloque especial (galería o imagen individual) va solo, a ancho completo: dentro de
       una columna de 450px su max-height de 80vh desborda la caja, el scroll horizontal de la
       galería se fragmenta entre columnas y sus degradados de borde de 3,5rem se comen un
       cuarto de la imagen. */
    .entrada-pliego--ancho {
      columns: 1;
    }

    /* Que no se parta lo que se lee como una pieza, ni queden líneas huérfanas. */
    #entrada-content h2,
    #entrada-content h3,
    #entrada-content blockquote,
    #entrada-content figure,
    #entrada-content [data-bloque-especial] {
      break-inside: avoid;
    }

    #entrada-content p {
      orphans: 2;
      widows: 2;
    }
  }

</style>
