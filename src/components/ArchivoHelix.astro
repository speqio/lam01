---
import { cardBadge } from '../lib/cardStyles';
import { normalizeTitleText } from '../lib/text';

/**
 * Componente principal de /archivo — hélice 3D de portadas adaptada de una referencia
 * standalone en Three.js/WebGL (ver historial). El proyecto sacó Three.js
 * deliberadamente (ver CLAUDE.md: "GSAP is the sole animation/interaction library") así
 * que la geometría 3D se rehace con transforms CSS (`perspective`/`preserve-3d`) más
 * GSAP para la física de arrastre, en vez de un canvas WebGL — mismo recurso ya usado
 * en NumeroEntradasDial (dial circular, eliminado) y UltimasEntradasCarousel (arco):
 * cada card es un `<a>` normal posicionado con `transform: translate3d(...) rotateY(...)`
 * dentro de un grupo con `transform-style: preserve-3d`, no una malla 3D real.
 *
 * Interacción, adaptada del original con un cambio deliberado de seguridad para mobile:
 * el original controlaba la velocidad VERTICAL con el mismo arrastre que la rotación
 * horizontal (deltaY del drag) — en mobile eso significa capturar el gesto vertical
 * dentro de un componente a pantalla completa sin ninguna vía de escape, exactamente la
 * clase de trampa que este proyecto evita a propósito (ver nota sobre mobile/desktop en
 * CLAUDE.md). Acá el arrastre SOLO rota la hélice (eje horizontal); el desplazamiento
 * vertical es un flujo ambiente automático que el wheel puede acelerar (sin
 * preventDefault, así que scrollear sobre la hélice sigue scrolleando la página) — este
 * mismo criterio es el que ya usan NumeroSequence/CategoriasCarousel/UltimasEntradas
 * (`touch-action: pan-y`, capturar solo el eje horizontal).
 *
 * Cantidad de cards limitada (ver prop `items`, se pasa ya recortado desde
 * /archivo.astro) — con cientos de entradas en el archivo real, renderizar todas como
 * nodos 3D sería un problema de performance; esta vista es un "vistazo" curado, no un
 * listado completo (el listado completo por año sigue debajo, sin límite).
 */
export interface ArchivoHelixItem {
  slug: string;
  title: string;
  categoryName: string;
  coverImage?: string;
}

interface Props {
  items: ArchivoHelixItem[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <div class="archivo-helix-clip" id="archivo-helix-scene">
      <div class="archivo-helix-scene">
        <div class="archivo-helix-group" id="archivo-helix-group">
          {items.map((item, i) => (
            <a href={`/entrada/${item.slug}`} class="archivo-helix-card" data-index={i}>
              {item.coverImage && (
                <img
                  src={item.coverImage}
                  alt=""
                  class="pointer-events-none h-full w-full object-cover grayscale contrast-125"
                  loading="lazy"
                  draggable="false"
                />
              )}
              <span class={cardBadge}>{item.categoryName}</span>
              <span class="archivo-helix-title">{normalizeTitleText(item.title)}</span>
            </a>
          ))}
        </div>
      </div>

      <p class="archivo-helix-hint">Arrastrá para explorar &middot; scroll para acelerar</p>
    </div>
  )
}

<style>
  /* Dos wrappers separados a propósito: `overflow: hidden` y `perspective` en el mismo
     elemento hacen que Chrome deje de recortar correctamente a los hijos 3D que quedan
     muy cerca de la cámara (el translateZ grande "escapa" del clip) — bug conocido de
     la combinación overflow+perspective+preserve-3d. Separando el recorte (2D, en
     `.archivo-helix-clip`) del contexto 3D (`.archivo-helix-scene`, sin overflow
     propio) el recorte vuelve a ser confiable. */
  .archivo-helix-clip {
    position: relative;
    width: 100%;
    height: 70vh;
    max-height: 640px;
    overflow: hidden;
    touch-action: pan-y;
    cursor: grab;
    /* Mismo recurso que el carrusel de Últimas entradas en mobile (ahí en los lados,
       acá arriba/abajo): las cards se desvanecen hacia los bordes en vez de cortarse en
       seco al entrar/salir del recorrido vertical infinito. */
    mask-image: linear-gradient(to bottom, transparent 0, black 14%, black 86%, transparent 100%);
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 0,
      black 14%,
      black 86%,
      transparent 100%
    );
  }

  .archivo-helix-clip:active {
    cursor: grabbing;
  }

  .archivo-helix-scene {
    position: absolute;
    inset: 0;
    perspective: 1400px;
  }

  .archivo-helix-group {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0;
    height: 0;
    transform-style: preserve-3d;
    will-change: transform;
  }

  .archivo-helix-card {
    position: absolute;
    left: 0;
    top: 0;
    width: 10rem;
    height: 13rem;
    margin-left: -5rem;
    margin-top: -6.5rem;
    display: block;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: #292929;
    backface-visibility: hidden;
    will-change: transform;
    -webkit-user-drag: none;
  }

  .archivo-helix-title {
    position: absolute;
    inset: auto 0 0 0;
    padding: 0.6rem 0.6rem 0.5rem;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.85), transparent);
    font-family: 'Lekton', monospace;
    font-size: 0.8rem;
    line-height: 1.1;
    color: #fff;
  }

  .archivo-helix-hint {
    position: absolute;
    bottom: 0.75rem;
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    font-family: 'Lekton', monospace;
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.4);
    pointer-events: none;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { Observer } from 'gsap/Observer';

  gsap.registerPlugin(Observer);

  function initArchivoHelix() {
    const sceneCandidate = document.getElementById('archivo-helix-scene');
    const groupCandidate = document.getElementById('archivo-helix-group');
    if (!(sceneCandidate instanceof HTMLElement) || !(groupCandidate instanceof HTMLElement)) return;

    // TS no propaga el narrowing de arriba a las funciones anidadas más abajo (render/
    // tick se declaran y se llaman después, no puede probar que siguen sin ser null en
    // ese punto) — se capturan en bindings ya tipados como no-nulos para no repetir
    // chequeos redundantes en cada uso.
    const sceneEl: HTMLElement = sceneCandidate;
    const groupEl: HTMLElement = groupCandidate;

    const cards = Array.from(groupEl.querySelectorAll<HTMLElement>('.archivo-helix-card'));
    const total = cards.length;
    if (total === 0) return;

    const RADIUS = 340;
    const TURNS = total > 12 ? 3 : 2;
    const HEIGHT_SPAN = Math.max(600, total * 46);
    const BASE_VERTICAL_SPEED = 0.35;
    const DRAG_SENSITIVITY = 0.25;
    const WHEEL_SENSITIVITY = 0.6;

    const state = {
      rotation: 0,
      rotationVelocity: 0,
      targetRotationVelocity: 0,
      verticalVelocity: BASE_VERTICAL_SPEED,
      targetVerticalVelocity: BASE_VERTICAL_SPEED,
    };

    const cardData = cards.map((card, i) => {
      const angle = (i / total) * 360 * TURNS;
      const y = (i / total) * HEIGHT_SPAN - HEIGHT_SPAN / 2;
      return { card, angle, y };
    });

    function render() {
      groupEl.style.transform = `translate(-50%, -50%) rotateY(${state.rotation}deg)`;

      cardData.forEach((data) => {
        const rad = (data.angle * Math.PI) / 180;
        const x = RADIUS * Math.sin(rad);
        const z = RADIUS * Math.cos(rad);
        data.card.style.transform = `translate3d(${x}px, ${data.y}px, ${z}px) rotateY(${data.angle}deg)`;
      });
    }

    function tick() {
      state.rotationVelocity += (state.targetRotationVelocity - state.rotationVelocity) * 0.08;
      state.verticalVelocity += (state.targetVerticalVelocity - state.verticalVelocity) * 0.05;

      state.targetRotationVelocity *= 0.92;
      state.targetVerticalVelocity += (BASE_VERTICAL_SPEED - state.targetVerticalVelocity) * 0.02;

      state.rotation += state.rotationVelocity;

      cardData.forEach((data) => {
        data.y += state.verticalVelocity;
        if (data.y > HEIGHT_SPAN / 2) data.y -= HEIGHT_SPAN;
        else if (data.y < -HEIGHT_SPAN / 2) data.y += HEIGHT_SPAN;
      });

      render();
    }

    render();
    gsap.ticker.add(tick);

    Observer.create({
      target: sceneEl,
      type: 'touch,pointer',
      preventDefault: true,
      onPress: () => {
        state.targetRotationVelocity = 0;
      },
      onChange: (self) => {
        state.targetRotationVelocity = self.deltaX * DRAG_SENSITIVITY;
      },
    });

    sceneEl.addEventListener(
      'wheel',
      (event) => {
        state.targetVerticalVelocity += event.deltaY * WHEEL_SENSITIVITY * 0.01;
      },
      { passive: true }
    );
  }

  const scene = document.getElementById('archivo-helix-scene');
  if (scene && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          initArchivoHelix();
          observer.disconnect();
        }
      },
      { rootMargin: '200px' }
    );
    observer.observe(scene);
  } else {
    initArchivoHelix();
  }
</script>
