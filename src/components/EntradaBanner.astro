---
/**
 * Banner de la entrada: la portada presentada como estampilla, con los datos de la entrada al
 * lado. Reemplaza a la cabecera centrada de EntradaPagina.astro cuando la entrada tiene
 * portada; las entradas sin portada (hoy 309 de 324) siguen con esa cabecera.
 *
 * Por qué dos formas fijas y no la proporción real de cada foto: el encargo es estandarizar
 * cualquier imagen, así que la estampilla es 3:4 cuando la portada es vertical y 4:3 cuando es
 * horizontal, y la imagen rellena por `object-cover`. La orientación la mide `medirPortada()`
 * leyendo el archivo en el build (src/lib/portada.ts) — es la única excepción a la regla de
 * "imágenes sin recorte" del resto de la entrada (EntradaImagen.astro, EntradaGaleria.astro),
 * y es deliberada: ahí manda la obra, acá manda la uniformidad del banner.
 *
 * Los topes de ancho son para no agrandar nunca una portada: la más pequeña del sitio mide
 * 464x597 px y con 420px de tope se sigue mostrando por debajo de su tamaño natural.
 *
 * Sin GSAP y sin JS: es un banner estático. La estampilla que gira y se arrastra es la del hero
 * de la home (HoverRevealHero.astro) y aquí sería ruido encima del título.
 */
interface Referencia {
  id: string;
  nombre: string;
}

interface Props {
  portada: string;
  portadaAlt?: string;
  portadaLeyenda?: string;
  orientacion: 'vertical' | 'horizontal';
  titulo: string;
  categoria?: Referencia;
  autor?: Referencia;
  fechaFormateada: string;
  traductor?: Referencia;
}

const {
  portada,
  portadaAlt,
  portadaLeyenda,
  orientacion,
  titulo,
  categoria,
  autor,
  fechaFormateada,
  traductor,
} = Astro.props;

const esHorizontal = orientacion === 'horizontal';
---

<section
  {/* El margen inferior lo pone el `my-12` del artículo en PostLayout.astro; acá solo el
      superior, para separarlo del header fijo. */}
  class="not-prose mt-6 flex flex-col items-center gap-8 md:mt-8 md:grid md:grid-cols-[auto_1fr] md:items-center md:gap-10 lg:gap-14"
  data-entrada-banner
  data-orientacion={orientacion}
>
  {/* La estampilla ocupa su ancho natural (grid-cols-[auto_1fr]), así que una portada vertical
      deja columna de texto ancha y una horizontal se la come: el reparto se ajusta solo. */}
  <figure
    class:list={[
      'entrada-estampilla estampilla-perforada relative m-0 shrink-0 bg-surface p-3 md:p-4',
      esHorizontal ? 'entrada-estampilla--horizontal' : 'entrada-estampilla--vertical',
    ]}
  >
    <div class:list={['relative overflow-hidden', esHorizontal ? 'aspect-[4/3]' : 'aspect-[3/4]']}>
      <img
        src={portada}
        alt={portadaAlt || titulo}
        loading="eager"
        decoding="async"
        class="h-full w-full object-cover"
      />
      {/* Misma viñeta interior que EstampillaFace.astro, para que la foto no quede plana
          contra el papel. */}
      <span class="entrada-estampilla-vineta pointer-events-none absolute inset-0"></span>
    </div>
    {
      portadaLeyenda && (
        <figcaption class="entrada-estampilla-leyenda mt-3 font-mono text-[11px] leading-snug text-ink-muted">
          {portadaLeyenda}
        </figcaption>
      )
    }
  </figure>

  <div class="flex min-w-0 flex-col text-center md:text-left">
    {
      categoria && (
        <a
          href={`/category/${categoria.id}`}
          class="mb-4 inline-block self-center font-mono text-xs uppercase tracking-widest text-accent no-underline hover:underline md:self-start"
        >
          {categoria.nombre}
        </a>
      )
    }
    <h1 class="font-headline text-4xl leading-[0.95] text-ink sm:text-5xl md:text-5xl lg:text-6xl">
      {titulo}
    </h1>
    <p class="mt-4 font-mono text-xs uppercase tracking-widest text-ink-muted">
      Por{' '}
      {autor && (
        <a href={`/autor/${autor.id}`} class="text-ink no-underline hover:text-accent">
          {autor.nombre}
        </a>
      )}
      {' '}&middot; {fechaFormateada}
    </p>
    {
      traductor && (
        <p class="mt-1 font-mono text-xs uppercase tracking-widest text-ink-muted">
          Traducción de{' '}
          <a href={`/autor/${traductor.id}`} class="text-ink no-underline hover:text-accent">
            {traductor.nombre}
          </a>
        </p>
      )
    }
  </div>
</section>

<style>
  /* Topes de ancho: nunca agrandar la portada (la más pequeña del sitio mide 464px de ancho).
     La horizontal admite más ancho porque su alto es menor con la misma superficie. */
  .entrada-estampilla--vertical {
    width: min(72vw, 300px);
  }

  .entrada-estampilla--horizontal {
    width: min(88vw, 420px);
  }

  @media (min-width: 768px) {
    .entrada-estampilla--vertical {
      width: 340px;
    }

    .entrada-estampilla--horizontal {
      width: 460px;
    }
  }

  @media (min-width: 1024px) {
    .entrada-estampilla--vertical {
      width: 400px;
    }

    .entrada-estampilla--horizontal {
      width: 520px;
    }
  }

  .entrada-estampilla-vineta {
    box-shadow: inset 0 0 25px rgba(0, 0, 0, 0.5);
  }

  /* Una leyenda larga no debe ensanchar la figura más allá de la imagen — mismo recurso que
     EntradaImagen.astro. */
  .entrada-estampilla-leyenda {
    width: 0;
    min-width: 100%;
  }
</style>
