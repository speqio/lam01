---
import { cardImageWrap, cardBadge } from '../lib/cardStyles';

/**
 * Carrusel para las entradas de un número, solo mobile — reemplaza al mecanismo de
 * scroll virtual/carril de NumeroSequence.astro en ese breakpoint (ver comentario de
 * ese archivo: capturar wheel/touch ahí no es seguro, así que mobile usaba scroll real
 * pasivo dentro de un carril alto medido en JS). Ese carril dio problemas de nuevo en
 * mobile, posiblemente ligado a números con pocas entradas — en vez de seguir
 * depurando esa mecánica puntual, se prueba una estrategia estructuralmente distinta
 * acá, misma idea que UltimasEntradasCarousel.astro en el home (arrastrable, sin
 * scroll de la página involucrado) pero con otra geometría — ver siguiente párrafo.
 *
 * Geometría tipo "dial"/rolodex — a propósito distinta de UltimasEntradasCarousel.astro
 * (que es un arco: offset horizontal + curva vertical). Acá no hay curva vertical en
 * absoluto: las tarjetas se ubican en un círculo alrededor de un eje vertical
 * (coordenadas polares — X y Z desde ángulo/radio, rotateY = -ángulo), como fichas
 * paradas en el borde de un disco visto de frente. La activa queda de frente al
 * centro; las vecinas se inclinan y se corren hacia atrás/al costado según cuánto
 * rotaron alrededor del eje, en vez de desplazarse en línea recta — de ahí que "salgan
 * del costado" en vez de desparramarse en fila. El tamaño decreciente de las tarjetas
 * alejadas sale solo de la perspectiva (translateZ negativo) más una leve opacidad
 * decreciente, no de un `scale` forzado.
 *
 * Mismo criterio de implementación que UltimasEntradasCarousel.astro: sin React,
 * `Observer` de GSAP para el arrastre, `gsap.quickTo` para el snap al soltar, render
 * solo en el propio onUpdate del drag/tween (nada corre en reposo), `overflow:hidden`
 * en el viewport para que las tarjetas de los extremos no ensanchen el scroll de la
 * página, `touch-action:pan-y` para no bloquear el scroll vertical normal.
 */
export interface NumeroEntradaItem {
  slug: string;
  titulo: string;
  categoriaNombre: string;
  autorNombre: string;
  portada?: string;
}

interface Props {
  entradas: NumeroEntradaItem[];
}

const { entradas } = Astro.props;
---

{
  entradas.length > 0 && (
    <div class="numero-dial-scene" id="numero-dial-scene">
      <div class="numero-dial-carousel" id="numero-dial-carousel">
        {entradas.map((item, i) => (
          <a href={`/entrada/${item.slug}`} class="numero-dial-card" data-index={i}>
            <div class="flex h-full w-full overflow-hidden border border-ink/15 bg-surface">
              <div class={cardImageWrap}>
                {item.portada && (
                  <img
                    src={item.portada}
                    alt=""
                    class="pointer-events-none h-full w-full object-cover grayscale contrast-125"
                    loading="lazy"
                    draggable="false"
                  />
                )}
                <span class={cardBadge}>{item.categoriaNombre}</span>
              </div>
              <div class="flex w-3/5 flex-col justify-center gap-1 p-3">
                <h3 class="font-headline text-sm uppercase leading-[1.05] text-ink line-clamp-2">
                  {item.titulo}
                </h3>
                <p class="font-mono text-[9px] uppercase tracking-widest text-ink-muted">
                  Por {item.autorNombre}
                </p>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  )
}

<style>
  .numero-dial-scene {
    position: relative;
    width: 100%;
    height: 24rem;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    perspective: 1100px;
    touch-action: pan-y;
  }

  .numero-dial-carousel {
    position: relative;
    width: 20rem;
    height: 22rem;
    transform-style: preserve-3d;
  }

  .numero-dial-card {
    position: absolute;
    left: 0;
    top: 0;
    width: 20rem;
    height: 22rem;
    will-change: transform, opacity;
    backface-visibility: hidden;
    -webkit-user-drag: none;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { Observer } from 'gsap/Observer';

  gsap.registerPlugin(Observer);

  // Radio del círculo (px) y grados que rota cada paso — juntos definen qué tan
  // "cerrado" se ve el dial. Con este radio/ángulo, la vecina inmediata ya se nota
  // rotada e internada en Z, no solo corrida al costado.
  const RADIUS = 290;
  const ANGLE_STEP = 46;
  const DEG_TO_RAD = Math.PI / 180;
  const DRAG_SENSITIVITY = 0.006;

  // Distancia circular más corta entre un índice y la posición actual.
  function shortestDistance(index: number, position: number, total: number) {
    let dist = (((index - position) % total) + total) % total;
    if (dist > total / 2) dist -= total;
    return dist;
  }

  function initNumeroDial() {
    const scene = document.getElementById('numero-dial-scene');
    if (!(scene instanceof HTMLElement)) return;
    if (window.matchMedia('(min-width: 768px)').matches) return;

    const cards = Array.from(scene.querySelectorAll<HTMLElement>('.numero-dial-card'));
    const total = cards.length;
    if (total === 0) return;

    const pos = { value: 0 };

    function render() {
      cards.forEach((card, i) => {
        const dist = shortestDistance(i, pos.value, total);
        const absDist = Math.abs(dist);
        const theta = dist * ANGLE_STEP;
        const rad = theta * DEG_TO_RAD;

        gsap.set(card, {
          // Coordenadas polares: cada tarjeta es un punto sobre un círculo de radio
          // RADIUS, a `theta` grados del frente. rotateY = theta (mismo signo que el
          // ángulo posicional, no invertido) la hace girar CON el círculo, tangente a
          // su borde — por eso las vecinas se ven entrando de costado en vez de
          // corridas en línea recta. Con el signo invertido quedaba asimétrico: un
          // lado giraba "para adentro" (se veía bien) y el otro "para afuera" (se
          // escondía casi del todo, mucho menos visible).
          x: RADIUS * Math.sin(rad),
          z: RADIUS * Math.cos(rad) - RADIUS,
          rotateY: theta,
          opacity: Math.max(0.35, 1 - absDist * 0.35),
          zIndex: Math.round(100 - absDist * 10),
        });
      });
    }

    render();

    // Con una sola entrada no hay nada para arrastrar — se muestra fija, sin
    // Observer/snap de más.
    if (total <= 1) return;

    const snapTo = gsap.quickTo(pos, 'value', {
      duration: 0.65,
      ease: 'power3.out',
      onUpdate: render,
    });

    Observer.create({
      target: scene,
      type: 'touch,pointer',
      preventDefault: true,
      onPress: () => gsap.killTweensOf(pos),
      onChange: (self) => {
        pos.value -= self.deltaX * DRAG_SENSITIVITY;
        render();
      },
      onRelease: () => snapTo(Math.round(pos.value)),
    });
  }

  const scene = document.getElementById('numero-dial-scene');
  if (scene && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          initNumeroDial();
          observer.disconnect();
        }
      },
      { rootMargin: '200px' }
    );
    observer.observe(scene);
  } else {
    initNumeroDial();
  }
</script>
