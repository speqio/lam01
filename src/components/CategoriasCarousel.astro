---
import type { CollectionEntry } from 'astro:content';
import { normalizeTitleText } from '../lib/text';

/**
 * Categorías del home — ticker tipográfico simple y estable, igual a la versión
 * publicada en producción. Una sola línea de palabras enlazadas con separadores,
 * sin pills, sin controles, sin scroll lateral activado.
 */
interface Props {
  categorias: CollectionEntry<'categorias'>[];
}

const { categorias } = Astro.props;
---

{
  categorias.length > 0 && (
    <section class="relative mb-12 md:mb-20">
      <div class="mb-6 md:hidden">
        <h2 class="font-headline text-2xl text-white/90 lg:text-3xl">Categorías</h2>
      </div>

      <div class="mb-6 hidden text-center md:block">
        <span class="mb-2 block font-mono text-xs uppercase tracking-widest text-white/60">
          Revisá nuestro catálogo
        </span>
        <h2 class="font-headline text-4xl leading-none tracking-tight text-white/90 lg:text-6xl">
          Categorías
        </h2>
      </div>

      <div class="categorias-ticker-view" aria-label="Carrusel de categorías">
        <div class="categorias-ticker-track">
          {[0, 1].map((setIndex) => (
            <div class="categorias-ticker-set" aria-hidden={setIndex === 1}>
              {categorias.map((categoria) => (
                <>
                  <a href={`/categoria/${categoria.id}`} class="categorias-ticker-item">
                    {normalizeTitleText(categoria.data.nombre)}
                  </a>
                  <span class="categorias-ticker-separator" aria-hidden="true">•</span>
                </>
              ))}
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .categorias-ticker-view {
    position: relative;
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    -ms-overflow-style: none;
    cursor: grab;
    touch-action: pan-x;
    scroll-behavior: smooth;
    mask-image: linear-gradient(to right, transparent 0, black 8%, black 92%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0, black 8%, black 92%, transparent 100%);
  }

  .categorias-ticker-view::-webkit-scrollbar {
    display: none;
  }

  .categorias-ticker-view:active {
    cursor: grabbing;
  }

  .categorias-ticker-track {
    display: flex;
    align-items: center;
    width: max-content;
    white-space: nowrap;
    padding-right: clamp(1rem, 2vw, 2rem);
    gap: 0;
  }

  .categorias-ticker-set {
    display: flex;
    align-items: center;
    white-space: nowrap;
    padding-right: clamp(1rem, 2vw, 2rem);
  }

  .categorias-ticker-item {
    display: inline-block;
    color: rgba(255, 255, 255, 0.9);
    font-family: var(--font-sans, 'Lekton', 'Arial', sans-serif);
    font-size: clamp(1.2rem, 2vw, 2.4rem);
    line-height: 1;
    letter-spacing: -0.02em;
    white-space: nowrap;
    font-weight: 400;
    transition: color 180ms ease, opacity 180ms ease;
  }

  .categorias-ticker-item:hover,
  .categorias-ticker-item:focus-visible {
    color: #a6294a;
  }

  .categorias-ticker-separator {
    display: inline-block;
    margin: 0 0.8rem;
    color: rgba(255, 255, 255, 0.5);
    font-size: clamp(1.1rem, 1.6vw, 2rem);
    line-height: 1;
    font-family: var(--font-sans, 'Lekton', 'Arial', sans-serif);
  }
</style>

<script>
  const tickerViews = document.querySelectorAll('.categorias-ticker-view');

  tickerViews.forEach((view) => {
    let isDragging = false;
    let startX = 0;
    let startScrollLeft = 0;

    view.addEventListener('wheel', (event) => {
      if (Math.abs(event.deltaY) > 0) {
        event.preventDefault();
        view.scrollLeft += event.deltaY;
      }
    }, { passive: false });

    view.addEventListener('pointerdown', (event) => {
      isDragging = true;
      startX = event.clientX;
      startScrollLeft = view.scrollLeft;
      view.setPointerCapture(event.pointerId);
    });

    view.addEventListener('pointermove', (event) => {
      if (!isDragging) return;
      const delta = event.clientX - startX;
      view.scrollLeft = startScrollLeft - delta;
    });

    const stopDragging = () => {
      isDragging = false;
    };

    view.addEventListener('pointerup', stopDragging);
    view.addEventListener('pointerleave', stopDragging);
    view.addEventListener('pointercancel', stopDragging);
  });
</script>
