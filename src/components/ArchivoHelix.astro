---
import { cardBadge } from '../lib/cardStyles';
import { normalizeTitleText } from '../lib/text';

/**
 * Componente principal de /archivo — hélice 3D de portadas adaptada de una referencia
 * standalone en Three.js/WebGL (ver historial). El proyecto sacó Three.js
 * deliberadamente (ver CLAUDE.md: "GSAP is the sole animation/interaction library") así
 * que la geometría 3D se rehace con transforms CSS (`perspective`/`preserve-3d`) más
 * GSAP para la física de arrastre, en vez de un canvas WebGL — mismo recurso ya usado
 * en NumeroEntradasDial (dial circular, eliminado) y UltimasEntradasCarousel (arco):
 * cada card es un `<a>` normal posicionado con `transform: translate3d(...) rotateY(...)`
 * dentro de un grupo con `transform-style: preserve-3d`, no una malla 3D real.
 *
 * Interacción: arrastrar (touch/mouse) o scrollear (wheel) sobre la hélice la recorre
 * verticalmente — a pedido explícito, es un scroll real, no solo un empujón ambiente —
 * y arrastrar horizontalmente la rota. A diferencia del resto de los carruseles del
 * sitio (que dejan pasar el eje vertical con `touch-action: pan-y` para no atrapar el
 * scroll de la página en mobile, ver CLAUDE.md), acá se captura también el vertical
 * (`touch-action: none`) porque es justo el gesto que se pidió. Se compensa por tamaño:
 * el componente nunca es pantalla completa (se achica en mobile, ver `<style>` más
 * abajo), así que siempre queda margen arriba/abajo para scrollear la página tocando
 * fuera de la hélice.
 *
 * Geometría (radio, paso vertical) derivada en runtime del tamaño real de la card ya
 * renderizada — cambia sola entre el breakpoint mobile/desktop del CSS sin duplicar
 * constantes a mano, y se recalcula en resize.
 *
 * Cantidad de cards limitada (ver prop `items`, se pasa ya recortado desde
 * /archivo.astro) — con cientos de entradas en el archivo real, renderizar todas como
 * nodos 3D sería un problema de performance; esta vista es un "vistazo" curado, no un
 * listado completo.
 */
export interface ArchivoHelixItem {
  slug: string;
  title: string;
  categoryName: string;
  coverImage?: string;
}

interface Props {
  items: ArchivoHelixItem[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <div class="archivo-helix-clip" id="archivo-helix-scene">
      <div class="archivo-helix-scene">
        <div class="archivo-helix-group" id="archivo-helix-group">
          {items.map((item, i) => (
            <a href={`/entrada/${item.slug}`} class="archivo-helix-card" data-index={i}>
              {item.coverImage && (
                <img
                  src={item.coverImage}
                  alt=""
                  class="pointer-events-none h-full w-full object-cover grayscale contrast-125"
                  loading="lazy"
                  draggable="false"
                />
              )}
              <span class={cardBadge}>{item.categoryName}</span>
              <span class="archivo-helix-title">{normalizeTitleText(item.title)}</span>
            </a>
          ))}
        </div>
      </div>

      <p class="archivo-helix-hint">Arrastra para explorar &middot; scroll para acelerar</p>
    </div>
  )
}

<style>
  /* Dos wrappers separados a propósito: `overflow: hidden` y `perspective` en el mismo
     elemento hacen que Chrome deje de recortar correctamente a los hijos 3D que quedan
     muy cerca de la cámara (el translateZ grande "escapa" del clip) — bug conocido de
     la combinación overflow+perspective+preserve-3d. Separando el recorte (2D, en
     `.archivo-helix-clip`) del contexto 3D (`.archivo-helix-scene`, sin overflow
     propio) el recorte vuelve a ser confiable. */
  .archivo-helix-clip {
    position: relative;
    /* Angosta y centrada en mobile a propósito: con el mismo ancho que el texto de al
       lado (que en mobile ni se muestra) el espiral se veía como un abanico ancho y
       chato en vez de una torre — recortando el ancho se nota mucho más que es un
       espiral vertical. */
    width: 62vw;
    max-width: 210px;
    margin-inline: auto;
    height: 52vh;
    max-height: 420px;
    overflow: hidden;
    /* El gesto vertical (scroll/swipe) lo captura el propio componente para desplazarse
       por la hélice — ver el script más abajo — así que acá no queda ningún eje suelto
       para que el navegador maneje de forma nativa. */
    touch-action: none;
    cursor: grab;
    /* Mismo recurso que el carrusel de Últimas entradas en mobile (ahí en los lados,
       acá arriba/abajo): las cards se desvanecen hacia los bordes en vez de cortarse en
       seco al entrar/salir del recorrido vertical infinito. */
    mask-image: linear-gradient(to bottom, transparent 0, black 14%, black 86%, transparent 100%);
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 0,
      black 14%,
      black 86%,
      transparent 100%
    );
  }

  .archivo-helix-clip:active {
    cursor: grabbing;
  }

  @media (min-width: 768px) {
    .archivo-helix-clip {
      width: 100%;
      max-width: none;
      height: 70vh;
      max-height: 640px;
    }
  }

  .archivo-helix-scene {
    position: absolute;
    inset: 0;
    perspective: 1400px;
  }

  .archivo-helix-group {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0;
    height: 0;
    transform-style: preserve-3d;
    will-change: transform;
  }

  .archivo-helix-card {
    position: absolute;
    left: 0;
    top: 0;
    width: 5rem;
    height: 6.5rem;
    margin-left: -2.5rem;
    margin-top: -3.25rem;
    display: block;
    overflow: hidden;
    border: 1px solid rgb(var(--color-ink) / 0.15);
    background: rgb(var(--color-surface));
    backface-visibility: hidden;
    will-change: transform;
    -webkit-user-drag: none;
  }

  @media (min-width: 768px) {
    .archivo-helix-card {
      width: 10rem;
      height: 13rem;
      margin-left: -5rem;
      margin-top: -6.5rem;
    }
  }

  .archivo-helix-title {
    position: absolute;
    inset: auto 0 0 0;
    padding: 0.4rem 0.4rem 0.35rem;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.85), transparent);
    font-family: 'Lekton', monospace;
    font-size: 0.65rem;
    line-height: 1.1;
    color: #fff;
  }

  @media (min-width: 768px) {
    .archivo-helix-title {
      padding: 0.6rem 0.6rem 0.5rem;
      font-size: 0.8rem;
    }
  }

  .archivo-helix-hint {
    position: absolute;
    bottom: 0.75rem;
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    font-family: 'Lekton', monospace;
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.4);
    pointer-events: none;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { Observer } from 'gsap/Observer';

  gsap.registerPlugin(Observer);

  function initArchivoHelix() {
    const sceneCandidate = document.getElementById('archivo-helix-scene');
    const groupCandidate = document.getElementById('archivo-helix-group');
    if (!(sceneCandidate instanceof HTMLElement) || !(groupCandidate instanceof HTMLElement)) return;

    // TS no propaga el narrowing de arriba a las funciones anidadas más abajo (render/
    // tick se declaran y se llaman después, no puede probar que siguen sin ser null en
    // ese punto) — se capturan en bindings ya tipados como no-nulos para no repetir
    // chequeos redundantes en cada uso.
    const sceneEl: HTMLElement = sceneCandidate;
    const groupEl: HTMLElement = groupCandidate;

    const cards = Array.from(groupEl.querySelectorAll<HTMLElement>('.archivo-helix-card'));
    const total = cards.length;
    if (total === 0) return;

    const TURNS = total > 12 ? 3 : 2;
    const DRAG_SENSITIVITY_X = 0.25;
    const DRAG_SENSITIVITY_Y = 0.35;
    const WHEEL_SENSITIVITY = 0.35;
    const AMBIENT_SPIRAL_SPEED = 0.35;
    // Techo de velocidad: sin esto, una seguidilla de wheel/drag fuertes puede acumular
    // más velocidad de la que el lerp de abajo llega a asentar entre frame y frame, y el
    // giro se ve entrecortado/lento en vez de fluido — el techo evita que se dispare.
    const MAX_SPIRAL_VELOCITY = 5;
    const MAX_VIEW_VELOCITY = 6;

    function clamp(value: number, limit: number) {
      return Math.max(-limit, Math.min(limit, value));
    }

    // Geometría derivada de la card ya renderizada (su tamaño real, el que aplique el
    // media query de CSS) y del ancho del propio contenedor — así el radio y el paso
    // vertical se recalculan solos entre mobile y desktop en vez de hardcodear dos
    // juegos de números a mano.
    let RADIUS = 0;
    let HEIGHT_SPAN = 0;
    // Pasos verticales por cada grado de giro — el mismo paso "de fábrica" con el que
    // ya está armada la forma en espiral (TURNS vueltas a lo largo de HEIGHT_SPAN), así
    // que desplazarse por acá sigue exactamente la rosca en vez de una proporción
    // inventada aparte.
    let PITCH = 0;

    // Dos rotaciones que se suman: `view` es "mirar alrededor" (arrastre horizontal,
    // no mueve nada verticalmente, decae a 0 al soltar) y `spiral` es "recorrer la
    // rosca" (scroll/arrastre vertical, mueve rotación Y altura juntas — un giro real
    // de espiral). `spiral` nunca decae a 0: se asienta en una velocidad ambiente baja,
    // así que al soltar sigue girando en espiral, solo que más lento.
    const state = {
      viewRotation: 0,
      viewVelocity: 0,
      targetViewVelocity: 0,
      spiralProgress: 0,
      spiralVelocity: AMBIENT_SPIRAL_SPEED,
      targetSpiralVelocity: AMBIENT_SPIRAL_SPEED,
    };

    const cardData = cards.map((card, i) => ({ card, angle: (i / total) * 360 * TURNS, baseY: 0 }));

    function layout() {
      const cardRect = cards[0].getBoundingClientRect();
      const cardW = cardRect.width || 160;
      const cardH = cardRect.height || 208;

      RADIUS = Math.min(sceneEl.clientWidth * 0.4, cardW * 1.8);
      HEIGHT_SPAN = Math.max(cardH * 3, total * cardH * 0.24);
      PITCH = HEIGHT_SPAN / (TURNS * 360);

      cardData.forEach((data, i) => {
        data.baseY = (i / total) * HEIGHT_SPAN - HEIGHT_SPAN / 2;
      });
    }

    layout();

    function wrap(value: number, span: number) {
      return ((((value + span / 2) % span) + span) % span) - span / 2;
    }

    function render() {
      const rotation = state.viewRotation + state.spiralProgress;
      groupEl.style.transform = `translate(-50%, -50%) rotateY(${rotation}deg)`;

      cardData.forEach((data) => {
        const rad = (data.angle * Math.PI) / 180;
        const x = RADIUS * Math.sin(rad);
        const z = RADIUS * Math.cos(rad);
        const y = wrap(data.baseY + state.spiralProgress * PITCH, HEIGHT_SPAN);
        data.card.style.transform = `translate3d(${x}px, ${y}px, ${z}px) rotateY(${data.angle}deg)`;
      });
    }

    function tick() {
      state.viewVelocity += (state.targetViewVelocity - state.viewVelocity) * 0.08;
      state.spiralVelocity += (state.targetSpiralVelocity - state.spiralVelocity) * 0.08;

      state.targetViewVelocity *= 0.92;
      state.targetSpiralVelocity += (AMBIENT_SPIRAL_SPEED - state.targetSpiralVelocity) * 0.02;
      state.targetViewVelocity = clamp(state.targetViewVelocity, MAX_VIEW_VELOCITY);
      state.targetSpiralVelocity = clamp(state.targetSpiralVelocity, MAX_SPIRAL_VELOCITY);

      state.viewRotation += state.viewVelocity;
      state.spiralProgress += state.spiralVelocity;

      render();
    }

    render();
    gsap.ticker.add(tick);

    let resizeTimer: ReturnType<typeof setTimeout>;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(layout, 150);
    });

    // Arrastre: horizontal es "mirar alrededor" (view, no mueve nada vertical);
    // vertical es recorrer la rosca (spiral: gira Y sube/baja a la vez, como un
    // espiral de verdad). Capturamos ambos ejes (touch-action: none en CSS) en vez de
    // dejar pasar el vertical como en los otros carruseles del sitio — el componente no
    // es pantalla completa (se achica en mobile), así que siempre queda margen
    // arriba/abajo para scrollear la página tocando fuera de la hélice.
    Observer.create({
      target: sceneEl,
      type: 'touch,pointer',
      preventDefault: true,
      onPress: () => {
        state.targetViewVelocity = 0;
      },
      onChange: (self) => {
        state.targetViewVelocity = clamp(self.deltaX * DRAG_SENSITIVITY_X, MAX_VIEW_VELOCITY);
        state.targetSpiralVelocity = clamp(
          AMBIENT_SPIRAL_SPEED - self.deltaY * DRAG_SENSITIVITY_Y,
          MAX_SPIRAL_VELOCITY
        );
      },
    });

    // Wheel: mismo recorrido de espiral que el arrastre vertical, preventDefault para
    // que scrollear sobre la hélice la recorra a ella y no a la página — mismo criterio
    // que ya usa NumeroSequence en desktop para su propio scroll virtual.
    Observer.create({
      target: sceneEl,
      type: 'wheel',
      preventDefault: true,
      onChange: (self) => {
        state.targetSpiralVelocity = clamp(
          AMBIENT_SPIRAL_SPEED + self.deltaY * WHEEL_SENSITIVITY,
          MAX_SPIRAL_VELOCITY
        );
      },
    });
  }

  const scene = document.getElementById('archivo-helix-scene');
  if (scene && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          initArchivoHelix();
          observer.disconnect();
        }
      },
      { rootMargin: '200px' }
    );
    observer.observe(scene);
  } else {
    initArchivoHelix();
  }
</script>
