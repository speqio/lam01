---
import { dialWrap, dialCount, dialTrack, dialThumb } from '../lib/dialNav';

/**
 * Galería de una entrada: una "cinta" horizontal donde cada imagen se ve completa, con su
 * proporción y sus colores originales (sin recorte ni filtros).
 * - Cada imagen se muestra en su tamaño natural (nunca se agranda), limitada al ancho de
 *   la columna y a ~60vh de alto: una vertical queda angosta, una panorámica ancha. Nada
 *   de cajas de proporción fija con `object-cover`, que recortarían fotos de formatos
 *   mixtos, ni de estirar todas a una misma altura, que desenfocaría las chicas.
 * - Un solo diseño para escritorio y móvil, con scroll-snap NATIVO (mismo patrón que
 *   NumeroSequence.astro — nada de Draggable/Observer controlando el carril, ver el
 *   comentario ahí). En escritorio se suman flechas anterior/siguiente, porque con mouse
 *   no hay un gesto horizontal natural.
 * - Cada imagen lleva su leyenda debajo. El indicador "01 / N" (`src/lib/dialNav.ts`)
 *   sigue a la imagen más cercana al centro.
 * - 1 sola imagen: se muestra sola, en su tamaño natural, sin cinta ni indicador.
 */
interface GaleriaItem {
  imagen: string;
  alt?: string;
  leyenda?: string;
}

interface Props {
  imagenes: GaleriaItem[];
  titulo: string;
  /** Después de qué párrafo/verso va (desde 1); sin valor, al final de la entrada. */
  posicion?: number;
}

const { imagenes: items, titulo, posicion } = Astro.props;
const altDe = (item: GaleriaItem) => item.alt || item.leyenda || titulo;

const botonFlecha =
  'hidden h-9 w-9 shrink-0 items-center justify-center rounded-full border border-ink/15 bg-surface text-ink transition-colors hover:border-accent hover:text-accent disabled:cursor-default disabled:opacity-30 disabled:hover:border-ink/15 disabled:hover:text-ink md:flex';
---

{
  items.length > 0 && (
    <div
      id="entrada-galeria"
      class="not-prose my-10"
      data-bloque-especial
      data-etiqueta="Galería"
      data-posicion={posicion ?? ''}
    >
      {items.length === 1 ? (
        <figure class="mx-auto w-fit max-w-full">
          <img
            src={items[0].imagen}
            alt={altDe(items[0])}
            decoding="async"
            class="entrada-imagen block h-auto max-h-[80vh] w-auto max-w-full border border-ink/15"
          />
          {items[0].leyenda && (
            <figcaption class="entrada-galeria-leyenda mt-2 font-mono text-xs text-ink-muted">
              {items[0].leyenda}
            </figcaption>
          )}
        </figure>
      ) : (
        <>
          <div
            class="entrada-galeria-carousel relative flex snap-x snap-mandatory items-start gap-4 overflow-x-auto pb-2"
            data-galeria-scroll
            role="region"
            aria-label="Galería de imágenes"
            tabindex="0"
          >
            {items.map((item, i) => (
              <figure class="w-fit shrink-0 snap-center" data-galeria-slide>
                <img
                  src={item.imagen}
                  alt={altDe(item)}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                  class="block h-auto max-h-[min(60vh,520px)] w-auto max-w-[100cqw] border border-ink/15"
                />
                {item.leyenda && (
                  <figcaption class="entrada-galeria-leyenda mt-2 font-mono text-xs text-ink-muted">
                    {item.leyenda}
                  </figcaption>
                )}
              </figure>
            ))}
          </div>

          <div class="mt-3 flex items-center gap-2">
            <button type="button" class={botonFlecha} data-galeria-prev aria-label="Imagen anterior">
              <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="m15 6-6 6 6 6" />
              </svg>
            </button>

            <div class={`${dialWrap} flex-1`}>
              <span class={dialCount} data-dial-count>
                {`01 / ${String(items.length).padStart(2, '0')}`}
              </span>
              <div class={dialTrack}>
                <div class={dialThumb} data-dial-thumb />
              </div>
            </div>

            <button type="button" class={botonFlecha} data-galeria-next aria-label="Imagen siguiente">
              <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="m9 6 6 6-6 6" />
              </svg>
            </button>
          </div>
        </>
      )}
    </div>
  )
}

<style>
  /* Oculta la scrollbar nativa del carril horizontal — cosmético, el gesto de scroll
     sigue siendo el nativo del navegador (mismo criterio que NumeroSequence.astro). */
  .entrada-galeria-carousel {
    scrollbar-width: none;
    /* Las imágenes limitan su ancho con `cqw` (1% del ancho de este carril): una imagen
       ancha nunca queda más ancha que la columna, sin deformarse ni cortarse. */
    container-type: inline-size;
  }

  .entrada-galeria-carousel::-webkit-scrollbar {
    display: none;
  }

  /* Una leyenda larga no debe ensanchar la figura más allá de la imagen: con ancho 0 y
     min-width 100% el texto se ajusta al ancho que ya fijó la imagen. */
  .entrada-galeria-leyenda {
    width: 0;
    min-width: 100%;
  }
</style>

<script>
  import { gsap } from 'gsap';

  /**
   * Observa el scroll nativo de la cinta (igual que NumeroSequence.astro): mueve el thumb
   * del dial, actualiza el contador según la imagen más cercana al centro y activa/desactiva
   * las flechas. Nada de Draggable/Observer controlando el carril.
   *
   * Se inicializa siempre (no solo en escritorio): si el modo lectura de la entrada mueve
   * este mismo nodo al centro de la pantalla, la cinta debe seguir andando ahí sin
   * reinicializarse — estos listeners quedan armados sobre el elemento real desde el
   * principio, se mueva a donde se mueva.
   */
  const galeria = document.getElementById('entrada-galeria');
  const scrollEl = galeria?.querySelector<HTMLElement>('[data-galeria-scroll]');
  const thumb = galeria?.querySelector<HTMLElement>('[data-dial-thumb]');
  const countEl = galeria?.querySelector<HTMLElement>('[data-dial-count]');
  const prev = galeria?.querySelector<HTMLButtonElement>('[data-galeria-prev]');
  const next = galeria?.querySelector<HTMLButtonElement>('[data-galeria-next]');
  const slides = galeria ? Array.from(galeria.querySelectorAll<HTMLElement>('[data-galeria-slide]')) : [];

  if (scrollEl && thumb && slides.length > 1) {
    const total = slides.length;
    const track = thumb.parentElement as HTMLElement;
    const reducirMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    thumb.style.width = `${100 / total}%`;

    // Con imágenes de ancho distinto, la proporción del scroll no dice cuál se está mirando:
    // se toma la que tiene su centro más cerca del centro del carril (y los extremos
    // cuentan como primera/última, porque la última quizá nunca llegue a centrarse).
    const indiceActivo = () => {
      const max = scrollEl.scrollWidth - scrollEl.clientWidth;
      if (scrollEl.scrollLeft <= 2) return 0;
      if (scrollEl.scrollLeft >= max - 2) return total - 1;
      const centro = scrollEl.scrollLeft + scrollEl.clientWidth / 2;
      let mejor = 0;
      let distancia = Infinity;
      slides.forEach((slide, i) => {
        const d = Math.abs(slide.offsetLeft + slide.offsetWidth / 2 - centro);
        if (d < distancia) {
          distancia = d;
          mejor = i;
        }
      });
      return mejor;
    };

    const actualizar = () => {
      const max = scrollEl.scrollWidth - scrollEl.clientWidth;
      const ratio = max > 0 ? scrollEl.scrollLeft / max : 0;
      const trackWidth = track.clientWidth;
      const thumbWidth = trackWidth / total;
      gsap.to(thumb, { x: ratio * (trackWidth - thumbWidth), duration: 0.2, ease: 'power2.out', overwrite: true });

      const activo = indiceActivo();
      if (countEl) {
        countEl.textContent = `${String(activo + 1).padStart(2, '0')} / ${String(total).padStart(2, '0')}`;
      }
      if (prev) prev.disabled = activo === 0;
      if (next) next.disabled = activo === total - 1;
    };

    const ir = (indice: number) => {
      const slide = slides[Math.max(0, Math.min(total - 1, indice))];
      scrollEl.scrollTo({
        left: slide.offsetLeft - (scrollEl.clientWidth - slide.offsetWidth) / 2,
        behavior: reducirMovimiento ? 'auto' : 'smooth',
      });
    };

    prev?.addEventListener('click', () => ir(indiceActivo() - 1));
    next?.addEventListener('click', () => ir(indiceActivo() + 1));

    let ticking = false;
    scrollEl.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          actualizar();
          ticking = false;
        });
      },
      { passive: true }
    );
    // Las imágenes cargan de forma diferida: sus anchos recién se conocen al cargar, y el
    // indicador (y las flechas) tienen que recalcularse cuando eso pasa.
    slides.forEach((slide) => slide.querySelector('img')?.addEventListener('load', actualizar));
    window.addEventListener('resize', actualizar);

    actualizar();
  }
</script>
