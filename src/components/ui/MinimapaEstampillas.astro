---
/**
 * ESTAMPILLAS DE NÚMERO — la página de número. Dos variantes con estructuras distintas.
 *
 * - `escritorio` (por defecto): tres columnas. A la izquierda la información de la entrada
 *   al centro; al centro la estampilla grande (vertical); a la derecha una columna vertical
 *   de miniaturas sin marco: la que está al frente tiene opacidad 1. La rueda del
 *   mouse, desde cualquier punto de la pantalla, desplaza la columna; deja de capturarla en
 *   los extremos.
 * - `movil`: primero un carrusel horizontal de estampillas verticales con degradado a ambos
 *   lados; debajo, la información de la entrada. El arrastre horizontal con el dedo lo
 *   desplaza; un gesto vertical pasa a la página.
 *
 * En ambas, la estampilla al frente es la activa: su ficha (categoría, título, autor, botón)
 * cambia con cada desplazamiento. Clic en una que no está al frente: se centra. En móvil, el
 * clic en la activa abre la entrada.
 *
 * Adaptado de una demo de minimapa de imágenes (vanilla, rAF + lerp). Aquí se hace con GSAP
 * (ver "Animation: GSAP only" en CLAUDE.md): el movimiento es un tween con `overwrite`.
 *
 * REGLAS PROPIAS DE ESTE COMPONENTE:
 * - Las estampillas que no están al frente se atenúan (0,45), la misma regla que la tira.
 * - Degradado: vertical → arriba y abajo; horizontal → izquierda y derecha (CLAUDE.md).
 * - Las estampillas van pegadas, sin separación, como toda la colección.
 */
import { cardBadge } from '../../lib/cardStyles';
import { formatearTitulo } from '../../lib/text';
import type { EstampillaItem } from './ColeccionEstampillas.astro';

interface Props {
  items: EstampillaItem[];
  /** Línea chica sobre la ficha: el número y su fecha. */
  kicker: string;
  variante?: 'escritorio' | 'movil';
}

const { items, kicker, variante = 'escritorio' } = Astro.props;
const primero = items[0];
const eje = variante === 'movil' ? 'x' : 'y';
---

{
  primero && (
    <div class="minimapa" data-minimapa data-variante={variante} data-eje={eje}>
      {variante === 'escritorio' ? (
        <>
          {/* INFORMACIÓN: a la izquierda, alineada a la izquierda. */}
          <div class="minimapa-info">
            <p class="minimapa-kicker">{kicker}</p>
            <div class="minimapa-ficha" data-vista-ficha>
              {/* Lo llena el script con la ficha de la estampilla al frente. */}
            </div>
          </div>

          {/* CENTRO: la estampilla al frente, vertical. */}
          <div class="minimapa-vista">
            <a class="minimapa-foto estampilla-perforada" href={`/${primero.slug}`} data-vista-enlace>
              {primero.coverImage && (
                <img src={primero.coverImage} alt="" draggable="false" data-vista-img />
              )}
              <span class="minimapa-sin-portada" data-vista-sin-portada hidden={!!primero.coverImage}>
                <span set:html={formatearTitulo(primero.title).html}></span>
              </span>
            </a>
          </div>

          {/* DERECHA: columna vertical de miniaturas. */}
          <div class="minimapa-columna" data-ventana>
            <div class="minimapa-pista" data-pista>
              {items.map((item, i) => (
                <button
                  type="button"
                  class="minimapa-item"
                  data-item
                  data-indice={i}
                  data-slug={item.slug}
                  data-src={item.coverImage ?? ''}
                  data-titulo={item.title}
                  aria-label={`Ver ${item.title}`}
                >
                  <span class="minimapa-cara estampilla-perforada">
                    {item.coverImage ? (
                      <img src={item.coverImage} alt="" draggable="false" loading="lazy" />
                    ) : (
                      <span class="minimapa-sin-portada">{item.title}</span>
                    )}
                  </span>
                </button>
              ))}
            </div>
            <div class="minimapa-difuminado minimapa-difuminado--inicio" aria-hidden="true" />
            <div class="minimapa-difuminado minimapa-difuminado--fin" aria-hidden="true" />
          </div>
        </>
      ) : (
        <>
          {/* ARRIBA: la información de la entrada al frente. */}
          <div class="minimapa-info">
            <div class="minimapa-ficha" data-vista-ficha>
              {/* Lo llena el script con la ficha de la estampilla al frente. */}
            </div>
          </div>

          {/* CENTRO: la estampilla principal, la misma pieza de desktop. */}
          <div class="minimapa-vista">
            <p class="minimapa-lateral">{kicker}</p>
            <a class="minimapa-foto estampilla-perforada" href={`/${primero.slug}`} data-vista-enlace>
              {primero.coverImage && (
                <img src={primero.coverImage} alt="" draggable="false" data-vista-img />
              )}
              <span class="minimapa-sin-portada" data-vista-sin-portada hidden={!!primero.coverImage}>
                {primero.title}
              </span>
            </a>
          </div>

          {/* ABAJO: mini carrusel horizontal. El scroll vertical del dedo lo mueve. */}
          <div class="minimapa-columna" data-ventana>
            <div class="minimapa-pista" data-pista>
              {items.map((item, i) => (
                <button
                  type="button"
                  class="minimapa-item"
                  data-item
                  data-indice={i}
                  data-slug={item.slug}
                  data-src={item.coverImage ?? ''}
                  data-titulo={item.title}
                  aria-label={`Ver ${item.title}`}
                >
                  <span class="minimapa-cara estampilla-perforada">
                    {item.coverImage ? (
                      <img
                        src={item.coverImage}
                        alt=""
                        draggable="false"
                        loading={i < 3 ? 'eager' : 'lazy'}
                      />
                    ) : (
                      <span class="minimapa-sin-portada">{item.title}</span>
                    )}
                  </span>
                </button>
              ))}
            </div>
            <div class="minimapa-difuminado minimapa-difuminado--inicio" aria-hidden="true" />
            <div class="minimapa-difuminado minimapa-difuminado--fin" aria-hidden="true" />
          </div>
        </>
      )}

      {/* La ficha de cada estampilla, en un template para copiarla al cambiar de estampilla.
          El orden es el de las miniaturas. */}
      {items.map((item, i) => (
        <template data-ficha-fuente={i}>
          {item.categoryName && <span class="ficha-categoria">{item.categoryName}</span>}
          <h3 class="ficha-titulo" set:html={formatearTitulo(item.title).html}></h3>
          {item.authorName && <p class="ficha-autor">Por {item.authorName}</p>}
          {item.translatorName && <p class="ficha-autor">Traducción de {item.translatorName}</p>}
          <a class={`${cardBadge} ficha-entrar`} href={`/${item.slug}`}>
            Entrar al texto
          </a>
        </template>
      ))}
    </div>
  )
}

<style>
  /* ─── BASE (escritorio) ────────────────────────────────────────────────────────────── */
  .minimapa {
    --mini-w: 120px;
    --mini-h: 78px;
    /* Alto de la banda: todo el conjunto vive dentro de la ventana, sin scroll vertical de
       página. 14rem = header + padding del main + footer. */
    --banda: clamp(22rem, calc(100vh - 14rem), 42rem);
    display: grid;
    grid-template-columns: minmax(15rem, 1fr) auto minmax(15rem, 1fr);
    gap: 2.5rem;
    height: var(--banda);
    align-items: center;
  }

  /* INFORMACIÓN */
  .minimapa-info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    min-width: 0;
    max-width: 22rem;
  }
  .minimapa-kicker {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: lowercase;
    color: rgb(var(--rgb-ink-muted));
  }
  /* FICHA */
  .minimapa-ficha {
    display: flex;
    width: 100%;
    flex-direction: column;
    gap: 0.35rem;
  }
  .minimapa-ficha:empty {
    display: none;
  }
  .ficha-categoria {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: lowercase;
    color: rgb(var(--rgb-marmol) / 0.35);
    font-weight: 300;
  }
  .ficha-titulo {
    font-family: var(--font-headline);
    font-size: clamp(1.4rem, 2vw, 2rem);
    line-height: 1.1;
    color: rgb(var(--rgb-ink));
  }
  .ficha-autor {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    line-height: 1.35;
    color: rgb(var(--rgb-ink-muted));
  }
  /* El botón viene de cardBadge, que es absoluto (pensado para tapar la imagen de una
     tarjeta). Aquí va dentro del texto, así que vuelve al flujo normal. */
  .ficha-entrar {
    position: relative;
    left: auto;
    top: auto;
    align-self: flex-start;
    margin-top: 0.5rem;
    border-radius: 999px;
    padding: 0.6rem 1.3rem;
    font-size: 0.82rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  /* CENTRO (escritorio): la estampilla al frente, vertical, un poco más chica que la banda. */
  .minimapa-vista {
    min-width: 0;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .minimapa-foto {
    position: relative;
    display: block;
    height: calc(var(--banda) * 0.86);
    width: calc(var(--banda) * 0.86 * 300 / 460);
    max-width: 100%;
    aspect-ratio: 300 / 460;
    overflow: hidden;
    background-color: rgb(var(--rgb-surface));
  }
  .minimapa-foto img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    user-select: none;
  }
  .minimapa-foto .minimapa-sin-portada {
    position: absolute;
    inset: 0;
  }

  /* DERECHA (escritorio): columna vertical de miniaturas. */
  .minimapa-columna {
    position: relative;
    width: var(--mini-w);
    height: var(--banda);
    overflow: hidden;
    justify-self: end;
  }
  .minimapa-columna .minimapa-pista {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
  }
  .minimapa-columna .minimapa-item {
    width: 100%;
    height: var(--mini-h);
  }
  .minimapa-columna .minimapa-difuminado {
    left: 0;
    right: 0;
    height: 3.5rem;
  }
  .minimapa-columna .minimapa-difuminado--inicio {
    top: 0;
    background: linear-gradient(to bottom, rgb(var(--rgb-canvas)), transparent);
  }
  .minimapa-columna .minimapa-difuminado--fin {
    bottom: 0;
    background: linear-gradient(to top, rgb(var(--rgb-canvas)), transparent);
  }

  /* COMUNES: pista, estampillas y degradados. */
  .minimapa-pista {
    will-change: transform;
  }
  .minimapa-item {
    display: block;
    flex: 0 0 auto;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .minimapa-cara {
    display: block;
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background-color: rgb(var(--rgb-surface));
  }
  .minimapa-cara img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
    user-select: none;
  }
  /* `hidden` tiene que ganar al display de abajo; si no, el texto de respaldo se ve siempre. */
  .minimapa-sin-portada[hidden] {
    display: none;
  }
  .minimapa-sin-portada {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
    text-align: center;
    font-size: 0.6rem;
    line-height: 1.2;
    color: rgb(var(--rgb-ink-muted));
  }
  .minimapa-cara .minimapa-sin-portada {
    position: absolute;
    inset: 0;
  }
  .minimapa-difuminado {
    position: absolute;
    z-index: 2;
    pointer-events: none;
  }

  /* ─── VARIANTE MÓVIL ───────────────────────────────────────────────────────────────
     Una sola pantalla: información arriba, estampilla principal al centro y mini carrusel
     horizontal abajo. El scroll vertical del dedo mueve el carrusel (ver el script). */
  .minimapa[data-variante='movil'] {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    grid-template-columns: none;
    height: 100%;
    min-height: 0;
  }
  .minimapa[data-variante='movil'] .minimapa-info {
    max-width: none;
    /* Caja de alto fijo (cabe un título de 4 líneas): la ficha no mueve la estampilla. */
    flex: 0 0 auto;
    height: 9rem;
    justify-content: flex-start;
    width: 100%;
    align-items: center;
    gap: 0.25rem;
    /* Más aire entre el botón de la ficha y la estampilla principal. */
    padding-bottom: 0.6rem;
    text-align: center;
  }
  .minimapa[data-variante='movil'] .minimapa-ficha {
    align-items: center;
  }
  .minimapa[data-variante='movil'] .ficha-categoria {
    font-size: 0.6rem;
  }
  .minimapa[data-variante='movil'] .ficha-titulo {
    font-size: 1rem;
    line-height: 1.2;
  }
  .minimapa[data-variante='movil'] .ficha-autor {
    font-size: 0.75rem;
  }
  .minimapa[data-variante='movil'] .ficha-entrar {
    align-self: center;
    margin-top: 0.25rem;
    padding: 0.35rem 0.9rem;
    font-size: 0.72rem;
  }

  /* Número y fecha en vertical, fijos al lado de la estampilla: no ocupan alto de pantalla. */
  .minimapa-lateral {
    display: none;
  }
  .minimapa[data-variante='movil'] .minimapa-lateral {
    display: block;
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%) rotate(180deg);
    writing-mode: vertical-rl;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    color: rgb(var(--rgb-ink-muted));
  }

  /* CENTRO (móvil): la estampilla llena el alto que sobra, sin deformarse ni salirse del ancho. */
  .minimapa[data-variante='movil'] .minimapa-vista {
    flex: 1 1 0;
    min-height: 0;
    width: 100%;
    position: relative;
    container-type: size;
  }
  .minimapa[data-variante='movil'] .minimapa-foto {
    height: min(92cqh, calc(100cqw * 460 / 300));
    max-width: 100%;
  }

  /* ABAJO (móvil): mini carrusel horizontal, con las miniaturas acostadas de desktop. */
  .minimapa[data-variante='movil'] .minimapa-columna {
    flex: 0 0 auto;
    width: 100%;
    height: var(--mini-h);
    /* Más aire entre la estampilla principal y el carrusel mini. */
    margin-top: 1.25rem;
    justify-self: stretch;
    touch-action: pan-y;
  }
  .minimapa[data-variante='movil'] .minimapa-columna .minimapa-pista {
    top: 0;
    bottom: 0;
    left: 0;
    right: auto;
    width: max-content;
    height: 100%;
    display: flex;
    flex-direction: row;
  }
  .minimapa[data-variante='movil'] .minimapa-columna .minimapa-item {
    width: var(--mini-w);
    height: 100%;
    flex: 0 0 auto;
  }
  .minimapa[data-variante='movil'] .minimapa-difuminado {
    top: 0;
    bottom: 0;
    width: 3rem;
    height: auto;
  }
  .minimapa[data-variante='movil'] .minimapa-difuminado--inicio {
    left: 0;
    right: auto;
    background: linear-gradient(to right, rgb(var(--rgb-canvas)), transparent);
  }
  .minimapa[data-variante='movil'] .minimapa-difuminado--fin {
    right: 0;
    left: auto;
    background: linear-gradient(to left, rgb(var(--rgb-canvas)), transparent);
  }
</style>

<script>
  import { gsap } from 'gsap';

  const clamp = (v: number, min: number, max: number) => Math.min(max, Math.max(min, v));

  function iniciarCarrusel(raiz: HTMLElement) {
    const ventana = raiz.querySelector<HTMLElement>('[data-ventana]');
    const pista = raiz.querySelector<HTMLElement>('[data-pista]');
    const botones = Array.from(raiz.querySelectorAll<HTMLButtonElement>('[data-item]'));
    const plantillas = Array.from(raiz.querySelectorAll<HTMLTemplateElement>('[data-ficha-fuente]'));
    const img = raiz.querySelector<HTMLImageElement>('[data-vista-img]');
    const sinPortada = raiz.querySelector<HTMLElement>('[data-vista-sin-portada]');
    const enlace = raiz.querySelector<HTMLAnchorElement>('[data-vista-enlace]');
    const ficha = raiz.querySelector<HTMLElement>('[data-vista-ficha]');
    if (!ventana || !pista || botones.length === 0) return;

    // Eje: 'y' en escritorio (columna vertical), 'x' en móvil (carrusel horizontal).
    const horizontal = raiz.dataset.eje === 'x';
    const esEscritorio = raiz.dataset.variante === 'escritorio';
    const reducido = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const escritorio = () => window.matchMedia('(min-width: 768px)').matches;

    // paso: tamaño de una estampilla en el eje. ind: posición que la deja centrada en la
    // ventana. Con la pista en t, la estampilla i queda en t + i*paso; la centrada es la de
    // t = ind - i*paso. El rango va de la primera a la última.
    let paso = 0;
    let ind = 0;
    let tMin = 0;
    let tMax = 0;
    let objetivo = 0;
    let activa = -1;
    let iniciado = false;
    const uid = Math.random().toString(36).slice(2, 8);
    const estado = { t: 0 };

    const medir = () => {
      const r = botones[0].getBoundingClientRect();
      paso = horizontal ? r.width : r.height;
      if (paso <= 0) return false; // oculta (la otra variante está visible)
      ind = ((horizontal ? ventana.clientWidth : ventana.clientHeight) - paso) / 2;
      tMax = ind;
      tMin = ind - (botones.length - 1) * paso;
      return true;
    };

    const mostrar = (i: number) => {
      if (i === activa) return;
      activa = i;
      const b = botones[i];
      const src = b.dataset.src ?? '';
      if (img) {
        if (src) img.src = src;
        img.hidden = !src;
      }
      if (sinPortada) {
        sinPortada.textContent = b.dataset.titulo ?? '';
        sinPortada.hidden = !!src;
      }
      if (enlace && b.dataset.slug) enlace.href = `/${b.dataset.slug}`;

      const plantilla = plantillas[i];
      if (ficha && plantilla) {
        ficha.replaceChildren(plantilla.content.cloneNode(true));
        if (!reducido) {
          gsap.fromTo(
            ficha,
            { autoAlpha: 0, y: 6 },
            { autoAlpha: 1, y: 0, duration: 0.25, ease: 'power2.out', overwrite: true }
          );
        }
      }
    };

    const dibujar = () => {
      pista.style.transform = horizontal
        ? `translateX(${estado.t}px)`
        : `translateY(${estado.t}px)`;
      // La estampilla al frente es la más cercana a la posición central de la ventana.
      const pos = (ind - estado.t) / paso;
      const idx = clamp(Math.round(pos), 0, botones.length - 1);
      mostrar(idx);
      // Sin marco: la estampilla al frente está a opacidad 1 y las demás la pierden según su
      // distancia, así que el movimiento se lee al pasar de una a otra.
      botones.forEach((el, j) => {
        el.style.opacity = String(1 - 0.55 * Math.min(1, Math.abs(pos - j)));
      });
    };

    const mover = (destino: number, duracion: number) => {
      objetivo = clamp(destino, tMin, tMax);
      gsap.to(estado, {
        t: objetivo,
        duration: reducido ? 0 : duracion,
        ease: 'power3.out',
        overwrite: true,
        onUpdate: dibujar,
      });
    };

    // RUEDA (escritorio): desde cualquier punto de la pantalla mueve la columna. Solo deja de
    // capturarla cuando la columna ya no puede avanzar en esa dirección: en los extremos la
    // rueda vuelve a la página.
    window.addEventListener(
      'wheel',
      (ev) => {
        if (!esEscritorio || horizontal || !escritorio() || !medir()) return;
        const bajando = ev.deltaY > 0;
        const puede = bajando ? estado.t > tMin + 0.5 : estado.t < tMax - 0.5;
        if (!puede) return;
        ev.preventDefault();
        mover(objetivo - clamp(ev.deltaY * 0.5, -20, 20), 0.7);
      },
      { passive: false }
    );

    // TACTO (móvil): el dedo que sube o baja, en cualquier parte de la pantalla, mueve el
    // carrusel horizontal. Un gesto más horizontal que vertical no se toma. La página no se
    // desplaza con este gesto: en los extremos el carrusel simplemente se detiene.
    let tactilX = 0;
    let tactilY = 0;
    window.addEventListener(
      'touchstart',
      (ev) => {
        if (!horizontal) return;
        tactilX = ev.touches[0].clientX;
        tactilY = ev.touches[0].clientY;
      },
      { passive: true }
    );
    window.addEventListener(
      'touchmove',
      (ev) => {
        if (!horizontal || !medir()) return;
        const x = ev.touches[0].clientX;
        const y = ev.touches[0].clientY;
        const dx = x - tactilX;
        const dy = y - tactilY;
        tactilX = x;
        tactilY = y;
        if (Math.abs(dy) <= Math.abs(dx)) return;
        // El gesto vertical nunca mueve la página en esta variante: solo el carrusel.
        ev.preventDefault();
        const puede = dy < 0 ? estado.t > tMin + 0.5 : estado.t < tMax - 0.5;
        if (puede) mover(objetivo + dy, 0.35);
      },
      { passive: false }
    );

    // CLIC: centra la estampilla pulsada. La principal es un enlace y abre la entrada.
    botones.forEach((b, i) => {
      b.addEventListener('click', () => {
        if (!medir()) return;
        mover(ind - i * paso, 1.1);
      });
    });

    window.addEventListener('resize', () => {
      if (!medir()) return;
      if (!iniciado) {
        iniciado = true;
        estado.t = ind;
        objetivo = ind;
      } else {
        gsap.killTweensOf(estado);
        objetivo = clamp(objetivo, tMin, tMax);
        estado.t = objetivo;
      }
      dibujar();
    });

    if (medir()) {
      iniciado = true;
      estado.t = ind;
      objetivo = ind;
      dibujar();
    }
  }

  for (const raiz of Array.from(document.querySelectorAll<HTMLElement>('[data-minimapa]'))) {
    iniciarCarrusel(raiz);
  }
</script>
