---
import { dialWrap, dialCount, dialTrack, dialThumb } from '../lib/dialNav';
import { datosImagen } from '../lib/portada';
import FotoAntigua from './FotoAntigua.astro';

/**
 * Galería de una entrada: una "cinta" horizontal con scroll-snap NATIVO (mismo patrón que
 * NumeroSequence.astro — nada de Draggable/Observer controlando el carril, ver el comentario
 * ahí). Sin botones de navegación: en los extremos hay un degradado del color de fondo de la
 * página (`--color-canvas`, así también funciona en el tema claro) que funde las imágenes con
 * el fondo y avisa que hay más a ese lado; cada degradado solo aparece cuando hay contenido
 * por ver hacia ese lado.
 *
 * Cada imagen usa el mockup de "foto antigua" (FotoAntigua.astro) — mismo componente que
 * EntradaImagen.astro, para que las imágenes de la cinta calcen entre sí en vez de alternar
 * anchos y altos sueltos. La cinta en sí sigue siendo una tira de scroll simple: no es el
 * carrusel 3D del home (CategoriasCards.astro).
 *
 * Cada imagen lleva su leyenda debajo. El indicador "01 / N" (`src/lib/dialNav.ts`) sigue a
 * la imagen más cercana al centro.
 * - 1 sola imagen: se muestra sola, en su caja, sin cinta ni indicador.
 */
interface GaleriaItem {
  imagen: string;
  alt?: string;
  leyenda?: string;
}

interface Props {
  imagenes: GaleriaItem[];
  titulo: string;
  /** Después de qué párrafo/verso va (desde 1); sin valor, al final de la entrada. */
  posicion?: number;
}

const { imagenes: items, titulo, posicion } = Astro.props;
const altDe = (item: GaleriaItem) => item.alt || item.leyenda || titulo;
---

{
  items.length > 0 && (
    <div
      id="entrada-galeria"
      class="not-prose my-10"
      data-bloque-especial
      data-etiqueta="Galería"
      data-posicion={posicion ?? ''}
    >
      {items.length === 1 && (() => {
        const { orientacion, maxAncho } = datosImagen(items[0].imagen);
        return (
          <figure class="mx-auto w-fit max-w-full">
            <FotoAntigua
              imagen={items[0].imagen}
              alt={altDe(items[0])}
              orientacion={orientacion}
              maxAncho={maxAncho}
              class="mx-auto"
            />
            {items[0].leyenda && (
              <figcaption class="entrada-galeria-leyenda mt-2 font-mono text-xs text-ink-muted">
                {items[0].leyenda}
              </figcaption>
            )}
          </figure>
        );
      })()}
      {items.length > 1 && (
        <>
          <div class="relative">
            <div
              class="entrada-galeria-carousel relative flex snap-x snap-mandatory items-start gap-4 overflow-x-auto pb-2"
              data-galeria-scroll
              role="region"
              aria-label="Galería de imágenes"
              tabindex="0"
            >
              {items.map((item, i) => {
                const { orientacion, maxAncho } = datosImagen(item.imagen);
                return (
                  <figure class="shrink-0 snap-center" data-galeria-slide>
                    <FotoAntigua
                      imagen={item.imagen}
                      alt={altDe(item)}
                      orientacion={orientacion}
                      maxAncho={maxAncho}
                      loading={i === 0 ? 'eager' : 'lazy'}
                    />
                    {item.leyenda && (
                      <figcaption class="entrada-galeria-leyenda mt-2 font-mono text-xs text-ink-muted">
                        {item.leyenda}
                      </figcaption>
                    )}
                  </figure>
                );
              })}
            </div>

            <div class="entrada-galeria-fade entrada-galeria-fade--izq" aria-hidden="true" data-galeria-fade-izq />
            <div class="entrada-galeria-fade entrada-galeria-fade--der" aria-hidden="true" data-galeria-fade-der />
          </div>

          <div class="mt-3">
            <div class={dialWrap}>
              <span class={dialCount} data-dial-count>
                {`01 / ${String(items.length).padStart(2, '0')}`}
              </span>
              <div class={dialTrack}>
                <div class={dialThumb} data-dial-thumb />
              </div>
            </div>
          </div>
        </>
      )}
    </div>
  )
}

<style>
  /* Oculta la scrollbar nativa del carril horizontal — cosmético, el gesto de scroll
     sigue siendo el nativo del navegador (mismo criterio que NumeroSequence.astro). */
  .entrada-galeria-carousel {
    scrollbar-width: none;
    /* `cqw` abajo (1% del ancho de este carril) es el tope extra que evita que una caja se
       pase del ancho de la columna en pantallas angostas. */
    container-type: inline-size;
  }

  .entrada-galeria-carousel::-webkit-scrollbar {
    display: none;
  }

  /* Tope extra solo para las cajas dentro del carril (`cqw`, 1% de SU ancho): el ancho base
     de cada caja lo pone FotoAntigua.astro (`.foto-antigua--vertical/horizontal`); esto solo
     la recorta más si el carril es más angosto que ese ancho. `:global()` porque .foto-antigua
     es markup de un componente hijo, no de este archivo — sin eso el selector no matchearía
     (ver scoping de estilos de Astro). La figura suelta de 1 sola imagen no tiene un
     ancestro con `container-type`, así que esta regla no le aplica a ella — `cqw` sin
     contenedor resolvería a 0. */
  .entrada-galeria-carousel :global(.foto-antigua) {
    max-width: 90cqw;
  }

  /* Degradados de los extremos: van del color de fondo de la página a transparente, así
     las imágenes se funden con el fondo en cualquier tema. No capturan clics ni gestos
     (pointer-events: none) y solo se ven cuando hay más contenido hacia ese lado (el
     script cambia su opacidad). */
  .entrada-galeria-fade {
    position: absolute;
    top: 0;
    bottom: 0;
    z-index: 1;
    width: 3.5rem;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .entrada-galeria-fade--izq {
    left: 0;
    background: linear-gradient(to right, rgb(var(--color-canvas)), rgb(var(--color-canvas) / 0));
  }

  .entrada-galeria-fade--der {
    right: 0;
    background: linear-gradient(to left, rgb(var(--color-canvas)), rgb(var(--color-canvas) / 0));
  }

  /* Una leyenda larga no debe ensanchar la figura más allá de la imagen: con ancho 0 y
     min-width 100% el texto se ajusta al ancho que ya fijó la imagen. */
  .entrada-galeria-leyenda {
    width: 0;
    min-width: 100%;
  }
</style>

<script>
  import { gsap } from 'gsap';

  /**
   * Observa el scroll nativo de la cinta (igual que NumeroSequence.astro): mueve el thumb
   * del dial, actualiza el contador según la imagen más cercana al centro y muestra u
   * oculta los degradados de los extremos. Nada de Draggable/Observer controlando el carril.
   *
   * Se inicializa siempre (no solo en escritorio): si el modo lectura de la entrada mueve
   * este mismo nodo al centro de la pantalla, la cinta debe seguir andando ahí sin
   * reinicializarse — estos listeners quedan armados sobre el elemento real desde el
   * principio, se mueva a donde se mueva.
   */
  const galeria = document.getElementById('entrada-galeria');
  const scrollEl = galeria?.querySelector<HTMLElement>('[data-galeria-scroll]');
  const thumb = galeria?.querySelector<HTMLElement>('[data-dial-thumb]');
  const countEl = galeria?.querySelector<HTMLElement>('[data-dial-count]');
  const fadeIzq = galeria?.querySelector<HTMLElement>('[data-galeria-fade-izq]');
  const fadeDer = galeria?.querySelector<HTMLElement>('[data-galeria-fade-der]');
  const slides = galeria ? Array.from(galeria.querySelectorAll<HTMLElement>('[data-galeria-slide]')) : [];

  if (scrollEl && thumb && slides.length > 1) {
    const total = slides.length;
    const track = thumb.parentElement as HTMLElement;
    thumb.style.width = `${100 / total}%`;

    // Con imágenes de ancho distinto, la proporción del scroll no dice cuál se está mirando:
    // se toma la que tiene su centro más cerca del centro del carril (y los extremos
    // cuentan como primera/última, porque la última quizá nunca llegue a centrarse).
    const indiceActivo = () => {
      const max = scrollEl.scrollWidth - scrollEl.clientWidth;
      if (scrollEl.scrollLeft <= 2) return 0;
      if (scrollEl.scrollLeft >= max - 2) return total - 1;
      const centro = scrollEl.scrollLeft + scrollEl.clientWidth / 2;
      let mejor = 0;
      let distancia = Infinity;
      slides.forEach((slide, i) => {
        const d = Math.abs(slide.offsetLeft + slide.offsetWidth / 2 - centro);
        if (d < distancia) {
          distancia = d;
          mejor = i;
        }
      });
      return mejor;
    };

    const actualizar = () => {
      const max = scrollEl.scrollWidth - scrollEl.clientWidth;
      const ratio = max > 0 ? scrollEl.scrollLeft / max : 0;
      const trackWidth = track.clientWidth;
      const thumbWidth = trackWidth / total;
      gsap.to(thumb, { x: ratio * (trackWidth - thumbWidth), duration: 0.2, ease: 'power2.out', overwrite: true });

      if (countEl) {
        countEl.textContent = `${String(indiceActivo() + 1).padStart(2, '0')} / ${String(total).padStart(2, '0')}`;
      }
      // Cada degradado solo se ve si hay algo más por ver hacia ese lado.
      if (fadeIzq) fadeIzq.style.opacity = scrollEl.scrollLeft > 2 ? '1' : '0';
      if (fadeDer) fadeDer.style.opacity = scrollEl.scrollLeft < max - 2 ? '1' : '0';
    };

    let ticking = false;
    scrollEl.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          actualizar();
          ticking = false;
        });
      },
      { passive: true }
    );
    // Las imágenes cargan de forma diferida: sus anchos recién se conocen al cargar, y el
    // indicador (y los degradados) tienen que recalcularse cuando eso pasa.
    slides.forEach((slide) => slide.querySelector('img')?.addEventListener('load', actualizar));
    window.addEventListener('resize', actualizar);

    actualizar();
  }
</script>
