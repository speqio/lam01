---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import NumeroSequence from '../components/NumeroSequence.astro';
import CarpetaNumero from '../components/ui/CarpetaNumero.astro';
import { splitNumeroTitle } from '../lib/text';

const { numero } = Astro.props;

const todasLasEntradas = await getCollection('entradas');
const entradasDelNumero = todasLasEntradas.filter(
  (entrada) => entrada.data.numero === numero.id
);

const entradasConRelaciones = await Promise.all(
  entradasDelNumero.map(async (entrada) => {
    const autor = await getEntry('autores', entrada.data.autor);
    const categoria = await getEntry('categorias', entrada.data.categoria);
    const traductor = entrada.data.traducidoPor
      ? await getEntry('autores', entrada.data.traducidoPor)
      : null;
    return { entrada, autor, categoria, traductor };
  })
);

entradasConRelaciones.sort(
  (a, b) => b.entrada.data.fecha.valueOf() - a.entrada.data.fecha.valueOf()
);

const formattedDate = numero.data.fecha.toLocaleDateString('es-ES', {
  year: 'numeric',
  month: 'long',
  timeZone: 'UTC',
});

/* La fecha corta de la tapa ("oct·26"), el mismo formato que en /numeros: la carpeta se
   tiene que leer igual acá que allá. */
const fechaCarpeta = `${numero.data.fecha
  .toLocaleDateString('es-ES', { month: 'short', timeZone: 'UTC' })
  .replace('.', '')}·${numero.data.fecha.toLocaleDateString('es-ES', {
  year: '2-digit',
  timeZone: 'UTC',
})}`;

/* El indice sale del slug (`numero-31`), igual que en /numeros: el titulo puede traer
   subtitulo y el numero no siempre es el que se lee ahí. */
const indiceNumero = Number(numero.id.match(/(\d+)/)?.[0] ?? 0);

const { titulo: tituloPagina, subtitulo: subtituloPagina } = splitNumeroTitle(numero.data.titulo);
const tituloCompleto = subtituloPagina ? `${tituloPagina} ${subtituloPagina}` : tituloPagina;
---

<BaseLayout
  title={numero.data.metaTitulo || `${tituloCompleto} — La Antorcha Magacín`}
  description={numero.data.metaDescripcion || numero.data.descripcion}
>
  <NumeroSequence
    vista="estampillas"
    titulo={numero.data.titulo}
    descripcion={numero.data.descripcion}
    fechaFormateada={formattedDate}
    entradas={entradasConRelaciones.map(({ entrada, autor, categoria, traductor }) => ({
      slug: entrada.id,
      titulo: entrada.data.titulo,
      categoriaNombre: categoria?.data.nombre ?? '',
      autorNombre: autor?.data.nombre ?? '',
      translatorName: traductor?.data.nombre,
      portada: entrada.data.portada,
    }))}
  >
    {/* En desktop la tapa va al pie de la columna del titulo, enfrente del carrusel. */}
    <div slot="tapa" class="w-40 lg:w-48">
      <CarpetaNumero
        numero={indiceNumero}
        titulo={tituloPagina}
        subtitulo={subtituloPagina}
        portada={numero.data.portada}
        href={`/${numero.id}`}
        fecha={fechaCarpeta}
        items={[]}
        soloTapa
      />
    </div>
  </NumeroSequence>

  {
    entradasConRelaciones.length === 0 && (
      <p class="text-center font-sans text-ink-muted">
        Todavía no hay entradas publicadas en este número.
      </p>
    )
  }

  {/* La misma tapa, para pantallas chicas: ahí no hay dos lados, así que cierra la
      página en vez de acompañar al título. En desktop la de arriba ocupa su lugar y esta
      se esconde. Va en modo `soloTapa`: sin estampillas asomadas ni abanico del hover,
      porque las entradas ya están listadas y abrir acá una segunda colección sería
      mostrar dos veces lo mismo. */}
  <div class="mt-20 flex justify-center md:hidden">
    <div class="w-44 sm:w-52">
      <CarpetaNumero
        numero={indiceNumero}
        titulo={tituloPagina}
        subtitulo={subtituloPagina}
        portada={numero.data.portada}
        href={`/${numero.id}`}
        fecha={fechaCarpeta}
        items={[]}
        soloTapa
      />
    </div>
  </div>
</BaseLayout>
