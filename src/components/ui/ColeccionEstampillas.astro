---
/**
 * COLECCIÓN DE ESTAMPILLAS — conjunto agrupado e interactivo, pensado para reutilizarse
 * en cualquier listado de entradas (home, archivo, categoría, autor, número). Recibe
 * items y nada más: no sabe de dónde salen ni qué página lo muestra. Los items usan la
 * misma forma que EntradaTicket.astro (`EntradaTicketItem`), que es la que ya arman
 * index.astro, archivo.astro y category/[slug].astro.
 *
 * Adaptado de philately-gallery.framer.website. Lo que se toma de ahí es el CONJUNTO:
 * las estampillas van pegadas unas a otras, como una plancha de sellos sin cortar, y de
 * ese conjunto **se retira una** al elegirla. Reemplaza al anillo 3D que esta sección tuvo antes (queda en el historial de
 * git, en UltimasEntradasEstampillas.astro): un cilindro giratorio no es un conjunto, y
 * en mobile obligaba a capturar un gesto.
 *
 * DOS DISPOSICIONES DEL MISMO CONJUNTO, LAS DOS EN CSS PURO:
 * - Pantallas chicas: tira horizontal con scroll-snap NATIVO. Cero captura de gestos:
 *   estructuralmente no puede atrapar el scroll de la página — la regla de "Mobile vs.
 *   desktop" de CLAUDE.md, y el mismo criterio de la tira de NumeroSequence.astro y
 *   EntradaGaleria.astro.
 * - Desktop: bloque en grilla de N columnas.
 *
 * LAS ESTAMPILLAS NO SE SUPERPONEN NI SE INCLINAN NI SE SEPARAN: van pegadas borde con
 * borde, como una hoja única pre-picada de la que cada una se puede arrancar. El dentado
 * de dos vecinas que se tocan forma una sola línea de agujeros entre ambas, que es
 * justamente la costura por la que se separarían. Antes se probó montarlas unas sobre
 * otras con un giro leve (se leía como un montón desordenado) y después con un canal de
 * aire entre ellas (volvían a parecer cards sueltas).
 * Sin JS el conjunto se ve igual y cada estampilla es un link a su entrada; el JS solo
 * agrega el retiro al foco. Es el mismo criterio que .entry-card-reveal: el suelo es lo
 * que se sirve.
 *
 * RETIRARSE DEL CONJUNTO (`crearFoco`): al elegirla, la estampilla se MUDA a un
 * escenario fijo centrado en la ventana, crece a las medidas de la ficha y se da vuelta,
 * mientras el resto queda detrás de un telón borroso. Mudarla de verdad en el DOM no es
 * capricho: dentro de un ancestro con transform, `fixed` se resuelve contra ese ancestro
 * y no contra la ventana. El salto se disimula con un FLIP (se mide dónde estaba, se la
 * sienta en el escenario con esa diferencia y se anima hasta cero).
 *
 * EL DENTADO VA EN LOS CUATRO LADOS Y NO HAY AGUJEROS ADENTRO: la máscara es
 * `.estampilla-perforada` (global.css, la misma del banner de la entrada), cuatro capas
 * de círculos repetidos —una por borde— combinadas con `mask-composite: intersect`. No
 * es la de EstampillaFace.astro (el mockup del hero), que tesela agujeros por toda la
 * superficie. Y va en la CARA, no en una lámina interior: puesta adentro, el papel de la
 * cara quedaba sin recortar y asomaba alrededor de la foto como un marco mal cortado.
 *
 * PROPORCIÓN ACOSTADA (300/460, el mockup del hero al revés), y la ficha abierta con la
 * misma relación para que abrirse solo agrande y nunca deforme. El reverso crece
 * animando width/height y no `scale`: con `scale` el texto se rasteriza agrandado y
 * llega blando.
 *
 * VARIAS COLECCIONES EN UNA MISMA PÁGINA funcionan: el script recorre todas las raíces y
 * cada una tiene su propio telón, su escenario y su foco.
 */
import { dialWrap, dialCount, dialTrack, dialThumb } from '../../lib/dialNav';

export interface EstampillaItem {
  title: string;
  authorName?: string;
  /** Nombre de quien tradujo la entrada, si corresponde. */
  translatorName?: string;
  categoryName?: string;
  /** Slug de la entrada; el link es `/{slug}`. */
  slug: string;
  coverImage?: string;
  coverAlt?: string;
  /* Claves de filtrado, opcionales: solo las usa `filtrable` (ver abajo). Van en el
     hueco y no en la estampilla porque el hueco es el que se esconde — la estampilla
     puede estar mudada al escenario del foco en ese momento. */
  anio?: number;
  categoriaSlug?: string;
  numeroSlug?: string;
}

interface Props {
  items: EstampillaItem[];
  /** Columnas de la pila en desktop. 4 llena el ancho con 16 estampillas (4×4). */
  columnas?: number;
  /**
   * `hoja`: bloque en grilla en desktop, tira en pantallas chicas (el home).
   * `tira`: una sola fila horizontal en todos los anchos, con el dial debajo.
   * `columna`: una sola fila VERTICAL, con el dial al costado. Es lo que usa la carpeta
   * abierta de /numeros: una columna se adapta a cualquier ancho sin saber cuánto lugar
   * hay, y deja el gesto en el eje en el que la gente ya está leyendo.
   *
   * `grilla`: estampillas VERTICALES (el mockup del hero, de pie) en una grilla que
   * ocupa todo el ancho disponible en cualquier tamaño de pantalla — 2 columnas en
   * mobile y hasta 5 en pantallas grandes. Sin carril ni gesto: nunca hay scroll
   * horizontal que capturar. Es lo que usa el buscador del archivo en el home.
   *
   * `bucle`: columna VERTICAL EN BUCLE con las estampillas de pie, movida con la
   * rueda y con el dial al costado. Es lo que usa la página de un número en desktop:
   * la lista no tiene principio ni fin, se sigue girando y vuelve a empezar. Es la
   * única disposición con gesto capturado, y por eso es solo de desktop —en mobile esa
   * misma página usa `tira`, con el scroll nativo (ver "Mobile vs. desktop" en
   * CLAUDE.md: un gesto capturado sin escape no puede ir a un teléfono).
   */
  disposicion?: 'hoja' | 'tira' | 'columna' | 'grilla' | 'bucle';
  /**
   * Cuelga de cada hueco los `data-*` que espera el script de filtrado de
   * ArchivoCatalogo.astro (`data-catalogo-item`, año/categoría/número/autor), para que
   * esa misma colección se pueda filtrar sin que este componente sepa nada de filtros.
   */
  filtrable?: boolean;
}

const { items, columnas = 4, disposicion = 'hoja', filtrable = false } = Astro.props;

/* El dial vertical lo comparten la columna y el bucle: las clases de dialNav.ts están
   escritas para una franja horizontal. */
/* El dial acompania al eje del carril: vertical en la columna y en el bucle --los dos
   corren de arriba abajo--, horizontal en la tira. */
const dialVertical = disposicion === 'columna' || disposicion === 'bucle';
const conDial = disposicion === 'tira' || dialVertical;

/* Una entrada sin `portada` muestra la estampilla vacía, con su título como única
   marca. Es a propósito: rellenar con la tapa de un número sería mostrar una imagen que
   no es de esa entrada. Se va arreglando sola a medida que se cargan las portadas. */
---

<div
  class:list={[
    'coleccion',
    (disposicion === 'tira' || disposicion === 'columna') && 'coleccion--lineal',
    disposicion === 'columna' && 'coleccion--columna',
    disposicion === 'grilla' && 'coleccion--grilla',
    disposicion === 'bucle' && 'coleccion--bucle',
  ]}
  data-coleccion
  data-disposicion={disposicion}
  style={`--columnas: ${columnas};`}
>
  {/* Sonda de medida: lleva las dimensiones de la ficha abierta en CSS para que el
      script las lea ya resueltas en píxeles. getComputedStyle devuelve una custom
      property tal como se escribió ("calc(var(--card-w) * 300 / 460)"), sin resolver, y
      GSAP no puede animar hacia eso; además así siguen valiendo las unidades relativas
      (vw) y el breakpoint vigente, sin repetir ninguna medida en el JS. */}
  <span class="coleccion-medida" data-medida aria-hidden="true"></span>

  <div class="coleccion-pliego" data-pliego>
    {
      items.map((item, i) => (
        <div
          class="estampilla-hueco"
          data-catalogo-item={filtrable ? '' : undefined}
          data-anio={filtrable ? item.anio : undefined}
          data-categoria={filtrable ? item.categoriaSlug : undefined}
          data-numero={filtrable ? item.numeroSlug : undefined}
          data-autor-nombre={
            filtrable ? (item.authorName ?? '').toLocaleLowerCase('es') : undefined
          }
        >
          <div class="estampilla" data-estampilla data-indice={i}>
            <div class="estampilla-cara estampilla-perforada">
              {item.coverImage ? (
                <img
                  src={item.coverImage}
                  alt={item.coverAlt ?? ''}
                  draggable="false"
                  loading="lazy"
                />
              ) : (
                <span class="estampilla-sin-portada">{item.title}</span>
              )}
              {/* El link real: es lo que hace útil el conjunto sin JS, y con JS el
                  script le hace preventDefault para retirarla en vez de navegar. */}
              <a class="estampilla-enlace" href={`/${item.slug}`} data-abrir>
                <span class="sr-only">{item.title}</span>
              </a>
            </div>
          </div>

          {/* La ficha de esta entrada, servida en el HTML y escondida hasta que se la
              elige: al abrirla se copia al costado de la estampilla flotante. Está acá y
              no armada en JS para que exista también sin JS, donde es texto bajo su
              estampilla. */}
          <div class="estampilla-datos" data-datos>
            {item.categoryName && <span class="ficha-categoria">{item.categoryName}</span>}
            <h3 class="ficha-titulo">{item.title}</h3>
            {item.authorName && <p class="ficha-autor">Por {item.authorName}</p>}
            {item.translatorName && (
              <p class="ficha-autor">Traducción de {item.translatorName}</p>
            )}
            <a class="card-badge ficha-entrar" href={`/${item.slug}`}>Entrar al texto</a>
          </div>
        </div>
      ))
    }
  </div>

  {
    conDial && items.length > 1 && (
      /* Dial de paginación: la misma pieza de NumeroSequence y de la galería de la
         entrada (clases en lib/dialNav.ts). El gesto sigue siendo el scroll nativo del
         carril; el dial solo lo refleja y dice en qué entrada va. En columna las clases
         compartidas no sirven tal cual —están escritas para una franja horizontal— así
         que la vertical usa las suyas, acá al lado. */
      <div
        class:list={[dialVertical ? 'dial-vertical' : dialWrap]}
        data-dial
      >
        <span class:list={[dialVertical ? 'dial-vertical-cuenta' : dialCount]} data-dial-count>
          {`01 / ${String(items.length).padStart(2, '0')}`}
        </span>
        <div class:list={[dialVertical ? 'dial-vertical-pista' : dialTrack]}>
          <div
            class:list={[dialVertical ? 'dial-vertical-thumb' : dialThumb]}
            data-dial-thumb
          />
        </div>
      </div>
    )
  }

  {
    disposicion !== 'grilla' && items.length > 1 && (
      /* Difuminado en los dos extremos del carril, mismo criterio (y mismo degradado al
         canvas) que las máscaras de la rueda de categorías: sin esto, la estampilla que
         entra o sale del carril se corta contra un borde recto y duro. En la columna va
         arriba y abajo; en la hoja y la tira, a izquierda y derecha, y en la hoja además
         solo mientras el carril existe (en desktop pasa a ser grilla y no hay nada que
         difuminar). */
      <>
        <div class="coleccion-difuminado coleccion-difuminado--inicio" aria-hidden="true" />
        <div class="coleccion-difuminado coleccion-difuminado--fin" aria-hidden="true" />
      </>
    )
  }

  {/* Telón y escenario del foco: cuelgan de la raíz, que no tiene transform propio —
      dentro del pliego, un `fixed` se resolvería contra el ancestro transformado. */}
  <div class="coleccion-telon" data-telon aria-hidden="true"></div>
  <div class="coleccion-escenario" data-escenario>
    {/* Acá adentro se muda la estampilla elegida, y al lado —o abajo, en pantallas
        chicas— se copia su ficha. Sin recuadro ni fondo: solo la estampilla flotando y
        el texto sobre el telón borroso. */}
    <div class="coleccion-foco" data-foco-caja>
      <div class="coleccion-ficha" data-ficha></div>
      <button class="coleccion-cerrar" type="button" data-volver>
        <span class="sr-only">Volver a la colección</span>
        <span aria-hidden="true">✕</span>
      </button>
    </div>
  </div>
</div>

<style>
  .coleccion {
    /* ANCHO EXPLÍCITO, NO SHRINK-TO-FIT. Era el motivo de que la tira no se pudiera
       desplazar en pantallas chicas dentro de la carpeta de /numeros: la caja de esa
       ventana es un flex column con `align-items: center`, así que la colección medía
       su contenido (las dieciséis estampillas en fila, miles de píxeles) en vez del
       ancho disponible. Con el carril más ancho que su contenido no hay desborde, y sin
       desborde `overflow-x: auto` no desplaza nada: el gesto no hacía nada y la hoja
       quedaba recortada por el `overflow: hidden` de la ventana. */
    width: 100%;
    /* El difuminado de los extremos del carril se ancla acá. No rompe el `fixed` del
       telón ni del escenario: eso solo lo hace un transform/filter en un ancestro. */
    position: relative;
    --est-w: 240px;
    /* Las proporciones del mockup del hero, ACOSTADAS. */
    --est-h: calc(var(--est-w) * 300 / 460);
    --card-w: min(88vw, 380px);
    /* MISMA PROPORCIÓN QUE LA ESTAMPILLA: la apertura solo agranda, no deforma. */
    --card-h: calc(var(--card-w) * 300 / 460);
    /* Cero: las estampillas se tocan. Queda acá como variable porque es la medida que
       habría que mover si alguna vez se quiere separar la hoja. */
    --aire: 0px;
  }

  @media (min-width: 768px) {
    .coleccion {
      --est-w: 230px;
      --card-w: 460px;
    }
  }

  @media (min-width: 1280px) {
    .coleccion {
      --est-w: 290px;
      --card-w: 540px;
    }
  }

  .coleccion-medida {
    position: absolute;
    width: var(--card-w);
    height: var(--card-h);
    visibility: hidden;
    pointer-events: none;
  }

  /* TIRA (pantallas chicas): scroll-snap nativo, la misma hoja en una sola fila
     continua. */
  .coleccion-pliego {
    display: flex;
    gap: var(--aire);
    /* min-width: 0 por lo mismo que el width de la raíz: dentro de un flex/grid padre,
       la base de un contenedor con overflow es su contenido si no se la acota, y el
       carril volvía a medir toda la fila. */
    min-width: 0;
    overflow-x: auto;
    /* `proximity` y no `mandatory`: con mandatory el navegador se niega a quedar en una
       posición intermedia y, en pantallas donde entra más de una estampilla, pelea con
       el gesto en vez de acompañarlo. */
    scroll-snap-type: x proximity;
    -webkit-overflow-scrolling: touch;
    padding: 1.5rem 1rem 2rem;
    scrollbar-width: none;
  }
  .coleccion-pliego::-webkit-scrollbar {
    display: none;
  }

  /* COLUMNA: el mismo carril, de arriba abajo, con el dial al costado. */
  .coleccion--columna {
    position: relative;
    display: flex;
    align-items: stretch;
    gap: 1rem;
  }
  .coleccion--columna .coleccion-pliego {
    flex-direction: column;
    max-height: min(68vh, 620px);
    overflow-x: hidden;
    overflow-y: auto;
    scroll-snap-type: y proximity;
    padding: 0.5rem 0;
  }

  /* El difuminado de los extremos del carril, con el mismo degradado al canvas que usa
     la rueda de categorías en sus bordes. No intercepta el gesto.
     Por defecto (hoja y tira) el carril es horizontal, así que va a los costados. */
  .coleccion-difuminado {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2.5rem;
    z-index: 5;
    pointer-events: none;
  }
  .coleccion-difuminado--inicio {
    left: 0;
    background: linear-gradient(to right, rgb(var(--color-canvas)), transparent);
  }
  .coleccion-difuminado--fin {
    right: 0;
    background: linear-gradient(to left, rgb(var(--color-canvas)), transparent);
  }

  /* En la columna el carril corre de arriba abajo: el mismo degradado, girado. */
  .coleccion--columna .coleccion-difuminado,
  .coleccion--bucle .coleccion-difuminado {
    top: auto;
    bottom: auto;
    left: 0;
    right: 0;
    width: auto;
    height: 3.5rem;
  }
  .coleccion--columna .coleccion-difuminado--inicio,
  .coleccion--bucle .coleccion-difuminado--inicio {
    top: 0;
    background: linear-gradient(to bottom, rgb(var(--color-canvas)), transparent);
  }
  .coleccion--columna .coleccion-difuminado--fin,
  .coleccion--bucle .coleccion-difuminado--fin {
    bottom: 0;
    background: linear-gradient(to top, rgb(var(--color-canvas)), transparent);
  }

  /* La hoja solo tiene carril en pantallas chicas: en desktop es grilla a todo el ancho
     y un degradado sobre sus bordes taparía las estampillas de las puntas. */
  @media (min-width: 768px) {
    .coleccion:not(.coleccion--lineal):not(.coleccion--bucle) .coleccion-difuminado {
      display: none;
    }
  }
  .coleccion--columna .estampilla-hueco {
    margin: 0 auto;
  }

  /* BUCLE (solo desktop): la columna sin principio ni fin. Las estampillas conservan su
     medida y su proporcion normales (acostadas, como en la hoja); lo unico distinto es
     que el carril no scrollea --el script las mueve con transform-- y que al pasarse del
     final vuelve a empezar. El dial es el horizontal de siempre, debajo.

     El apilado en absoluto va gateado por `html.js` (la misma regla que
     .entry-card-reveal): sin JS no hay nada que las mueva, asi que quedan en flujo, una
     debajo de otra y cada una link a su entrada. Lo que NO se hace es nacer con
     opacity: 0 esperando al script: si el script falla, la seccion entera queda en
     blanco. Mejor un primer frame apilado que una pagina vacia. */
  .coleccion--bucle {
    position: relative;
    display: flex;
    align-items: stretch;
    gap: 1rem;
  }
  .coleccion--bucle .coleccion-pliego {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--aire);
    /* `flex: 1` o el carril no mide nada: la raiz es una fila (carril + dial al costado)
       y sus estampillas estan en posicion absoluta, asi que no hay contenido en flujo
       que le de ancho. Sin esto el carril queda en cero y las estampillas se apilan
       fuera de la vista. */
    flex: 1;
    min-width: 0;
    height: min(66vh, 560px);
    overflow-y: auto;
    scrollbar-width: none;
    padding: 0;
  }
  :global(html.js) .coleccion--bucle .coleccion-pliego {
    display: block;
    overflow: hidden;
  }
  /* El dial queda FUERA del difuminado: el degradado de los bordes del carril cubria
     tambien la paginacion y se leia atenuada, como si estuviera deshabilitada. */
  .coleccion--bucle [data-dial] {
    position: relative;
    z-index: 6;
  }
  :global(html.js) .coleccion--bucle .estampilla-hueco {
    position: absolute;
    left: 50%;
    top: 50%;
    margin: 0;
  }

  .dial-vertical {
    display: flex;
    flex: 0 0 auto;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0;
  }
  .dial-vertical-cuenta {
    flex-shrink: 0;
    font-family: theme('fontFamily.mono');
    font-size: 0.7rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.18em;
    color: rgb(var(--color-ink-muted));
    /* De abajo hacia arriba, al lado de la pista. */
    writing-mode: vertical-rl;
  }
  .dial-vertical-pista {
    position: relative;
    width: 3px;
    flex: 1 1 auto;
    overflow: hidden;
    border-radius: 999px;
    background-color: rgb(var(--color-ink) / 0.15);
  }
  .dial-vertical-thumb {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    border-radius: 999px;
    background-color: rgb(var(--color-accent));
  }

  .estampilla-hueco {
    /* El hueco queda SIEMPRE en el layout, también mientras su estampilla está en el
       foco: es el que reserva el lugar al que vuelve, y sin él la hoja se recompaginaría
       al sacar una y el regreso aterrizaría en cualquier parte. */
    position: relative;
    width: var(--est-w);
    height: var(--est-h);
    flex: 0 0 auto;
    scroll-snap-align: center;
  }

  /* Sin efecto de hover a propósito: las estampillas de la hoja no se mueven ni crecen
     al pasar por encima. Lo único que sale del conjunto es la que se elige, y sale del
     todo (ver el foco más abajo); un hover que además las levantaba competía con eso y
     deshacía la lectura de hoja continua. */

  .estampilla {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    /* Contenedor de consulta: el reverso mide sus textos contra el ancho de la
       estampilla, así la misma ficha se lee chica cuando está en la hoja y grande
       cuando se abre al centro, sin dos juegos de tamaños ni un `scale` que la
       emborrone. */
    container-type: size;
  }

  /* HOJA (desktop): la misma colección en grilla, borde con borde igual que en la
     tira. */
  @media (min-width: 768px) {
    /* En tira y en columna esta grilla no corre: el carril se mantiene en todos los
       anchos. */
    .coleccion:not(.coleccion--lineal):not(.coleccion--grilla):not(.coleccion--bucle) .coleccion-pliego {
      display: grid;
      /* 1fr y no var(--est-w): la hoja ocupa EXACTAMENTE el ancho de la sección, así sus
         bordes caen a plomo con el título ("Últimas entradas") y con el botón de la
         derecha. Con un ancho fijo centrado la hoja quedaba más angosta que el
         encabezado y las dos cosas no se alineaban con nada. Las estampillas crecen
         hasta llenarla. */
      grid-template-columns: repeat(var(--columnas), minmax(0, 1fr));
      gap: var(--aire);
      overflow: visible;
      /* Sin aire a los costados: el borde de la hoja ES el borde de la sección. */
      padding: 1.5rem 0 2rem;
    }
    /* La estampilla ya no mide --est-w: la mide la columna, y la proporción acostada la
       sostiene aspect-ratio. */
    .coleccion:not(.coleccion--lineal):not(.coleccion--grilla):not(.coleccion--bucle) .estampilla-hueco {
      width: auto;
      height: auto;
      aspect-ratio: 460 / 300;
    }
  }

  /* GRILLA: estampillas DE PIE (la proporción del mockup, sin acostar) repartidas en
     todo el ancho. Dos columnas en mobile y hasta cinco en pantallas grandes, siempre
     pegadas borde con borde como la hoja. No hay carril ni gesto que capturar en ningún
     ancho: es la disposición segura para una lista larga en mobile. */
  .coleccion--grilla .coleccion-pliego {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--aire);
    overflow: visible;
    padding: 0;
  }
  .coleccion--grilla .estampilla-hueco {
    width: auto;
    height: auto;
    aspect-ratio: 300 / 460;
  }
  @media (min-width: 640px) {
    .coleccion--grilla .coleccion-pliego {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .coleccion--grilla .coleccion-pliego {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  @media (min-width: 1280px) {
    .coleccion--grilla .coleccion-pliego {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
  /* La ficha abierta también se pone de pie, y se mide desde el ALTO para que nunca pase
     de la ventana (la estampilla vertical es más alta que ancha: partir del ancho, como
     hace la hoja, daba una ficha de más de 700px de alto). */
  .coleccion--grilla {
    --card-h: min(68vh, 620px);
    --card-w: calc(var(--card-h) * 300 / 460);
  }

  /* Sin giro ni hover: la estampilla solo muestra su cara, y lo único que pasa al
     elegirla es que se retira de la hoja. El reverso como tal ya no existe — la ficha
     de la entrada se lee al costado de la estampilla flotante, no detrás de ella. */
  .estampilla-cara {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background-color: rgb(var(--color-surface));
  }
  .estampilla-cara img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
    user-select: none;
  }

  /* Estampilla sin portada: el título, chico y centrado, para que no quede un
     rectángulo mudo mientras se cargan las imágenes. */
  .estampilla-sin-portada {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    text-align: center;
    font-size: 0.78rem;
    line-height: 1.3;
    color: rgb(var(--color-ink-muted));
  }

  .estampilla-enlace {
    position: absolute;
    inset: 0;
  }

  /* LA FICHA. En el HTML vive debajo de su estampilla (es lo que se lee sin JS); con JS
     se esconde y, al elegir la estampilla, se copia al lado de la que quedó flotando. */
  .estampilla-datos {
    display: flex;
    max-width: 34ch;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.75rem 0.25rem 0;
  }
  :global(html.js) .estampilla-hueco > .estampilla-datos {
    display: none;
  }

  .ficha-categoria {
    font-family: theme('fontFamily.mono');
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgb(var(--color-accent));
  }
  .ficha-titulo {
    font-family: theme('fontFamily.headline');
    font-size: 1.1rem;
    line-height: 1.15;
    color: rgb(var(--color-ink));
  }
  .ficha-autor {
    font-family: theme('fontFamily.sans');
    font-size: 0.9rem;
    line-height: 1.35;
    color: rgb(var(--color-ink-muted));
  }
  .ficha-entrar {
    align-self: flex-start;
    margin-top: 0.5rem;
    border-radius: 999px;
    padding: 0.6rem 1.3rem;
    font-size: 0.82rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  /* FOCO: la estampilla retirada del conjunto, flotando al centro con su ficha al lado,
     y el resto de la página detrás de un telón borroso. */
  .coleccion-telon,
  .coleccion-escenario {
    position: fixed;
    inset: 0;
    visibility: hidden;
    opacity: 0;
  }
  .coleccion-telon {
    z-index: 60;
    background-color: rgb(var(--color-canvas) / 0.72);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }
  .coleccion-escenario {
    z-index: 61;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    /* El escenario no intercepta clicks: el telón de abajo es el que cierra. */
    pointer-events: none;
  }

  /* Estampilla arriba y ficha abajo en pantallas chicas; una al lado de la otra en
     desktop. Sin recuadro, sin fondo: solo las dos piezas sobre el telón. */
  .coleccion-foco {
    position: relative;
    display: flex;
    max-width: 100%;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    pointer-events: auto;
  }
  @media (min-width: 768px) {
    .coleccion-foco {
      flex-direction: row;
      align-items: center;
      gap: 2.5rem;
      text-align: left;
    }
  }
  .coleccion-ficha {
    display: flex;
    max-width: 34ch;
    flex-direction: column;
  }
  .coleccion-ficha:empty {
    display: none;
  }
  .coleccion-ficha .estampilla-datos {
    padding: 0;
  }
  /* En la ESQUINA de la ventana, no pegada a la ficha: el escenario ocupa la pantalla
     entera, asi que una posicion absoluta contra el es una posicion contra la ventana.
     Pegada arriba de la ficha quedaba flotando en medio de la pantalla y no se leia
     como "cerrar". */
  .coleccion-cerrar {
    position: fixed;
    top: 1.25rem;
    right: 1.25rem;
    z-index: 62;
    padding: 0.4rem 0.6rem;
    font-size: 1rem;
    line-height: 1;
    color: rgb(var(--color-ink-muted));
    transition: color 0.2s;
  }
  .coleccion-cerrar:hover {
    color: rgb(var(--color-ink));
  }

  .coleccion-escenario .estampilla {
    pointer-events: auto;
  }
</style>

<script>
  import { gsap } from 'gsap';
  // Observer solo lo usa el bucle (disposicion `bucle`, desktop de la pagina de un
  // numero); el resto de las disposiciones no captura ningun gesto.
  import { Observer } from 'gsap/Observer';

  gsap.registerPlugin(Observer);

  /* RETIRO AL FOCO. La estampilla se MUDA al escenario (contenedor fijo, centrado en la
     ventana) y vuelve a su hueco al cerrar. Mudarla es necesario, no un capricho: dentro
     del pliego su ancestro puede tener transform, y ahí `position: fixed` se resuelve
     contra ese ancestro en vez de contra la ventana. El salto se disimula con un FLIP:
     se mide dónde estaba, se la sienta en el escenario con esa diferencia aplicada y se
     anima hasta cero. */
  function crearFoco(raiz: HTMLElement) {
    const telon = raiz.querySelector<HTMLElement>('[data-telon]');
    const escenario = raiz.querySelector<HTMLElement>('[data-escenario]');
    const cajaFoco = raiz.querySelector<HTMLElement>('[data-foco-caja]');
    const ficha = raiz.querySelector<HTMLElement>('[data-ficha]');
    const medida = raiz.querySelector<HTMLElement>('[data-medida]');
    const reducido = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const dur = reducido ? 0 : 0.6;

    let abierta: HTMLElement | null = null;
    let origen: {
      padre: HTMLElement;
      siguiente: Node | null;
      w: number;
      h: number;
    } | null = null;

    function abrir(est: HTMLElement) {
      if (abierta || !telon || !escenario) return;
      abierta = est;

      const antes = est.getBoundingClientRect();
      // offsetWidth/Height y no el rect: son las medidas de layout, las únicas que
      // sirven para volver al tamaño de reposo si algo la estuviera transformando.
      const w = est.offsetWidth;
      const h = est.offsetHeight;
      const padre = est.parentElement as HTMLElement;
      const siguiente = est.nextSibling;

      est.dataset.abierta = 'true';
      /* La ficha de esta entrada se copia al lado de la estampilla. Se clona en vez de
         mudarse para no dejarle un agujero a su hueco: el original se queda donde
         estaba, escondido, y el clon se descarta al cerrar. */
      const datos = (est.parentElement as HTMLElement).querySelector('[data-datos]');
      if (ficha && datos) ficha.replaceChildren(datos.cloneNode(true));
      // Delante de la ficha: la estampilla va primera en la fila (o arriba, en mobile).
      cajaFoco?.insertBefore(est, cajaFoco.firstChild);
      origen = { padre, siguiente, w, h };

      /* El orden importa: primero se le fija el TAMAÑO DE REPOSO y recién después se
         mide dónde cayó. Dentro del hueco la estampilla mide 100%×100% de su padre, y
         el padre nuevo es el escenario, que ocupa la ventana entera: midiéndola antes de
         fijarle el tamaño, el rect era el de toda la pantalla y el FLIP la hacía salir
         de una esquina en vez de su sitio en la hoja. */
      gsap.set(est, { clearProps: 'transform' });
      gsap.set(est, { width: w, height: h, x: 0, y: 0 });

      // FLIP de ida: arranca dibujada donde estaba en la hoja y se anima hasta el centro.
      const despues = est.getBoundingClientRect();
      gsap.set(est, { x: antes.left - despues.left, y: antes.top - despues.top });
      gsap.to(est, {
        x: 0,
        y: 0,
        width: medida?.offsetWidth ?? w,
        height: medida?.offsetHeight ?? h,
        duration: dur,
        ease: 'power2.inOut',
      });
      gsap.to([telon, escenario], { autoAlpha: 1, duration: dur * 0.6, ease: 'power2.out' });
      // El texto llega un poco después, cuando la estampilla ya está en su sitio.
      gsap.fromTo(
        ficha,
        { autoAlpha: 0, y: reducido ? 0 : 12 },
        { autoAlpha: 1, y: 0, duration: dur * 0.6, delay: dur * 0.5, ease: 'power2.out' }
      );
    }

    function cerrar() {
      const est = abierta;
      if (!est || !origen || !telon || !escenario) return;
      abierta = null;

      const volver = origen;
      origen = null;

      /* A dónde vuelve se MIDE AHORA, no se reusa la diferencia que se guardó al abrir:
         entre una cosa y la otra la página pudo scrollear, cambiar de ancho o
         recompaginar, y con el dato viejo la estampilla aterrizaba al lado de su hueco.
         Se mide el desplazamiento que falta —de donde está ahora al hueco que la
         espera— y se lo suma al que ya tiene puesto. */
      const ahora = est.getBoundingClientRect();
      const hueco = volver.padre.getBoundingClientRect();
      const dx = (gsap.getProperty(est, 'x') as number) + (hueco.left - ahora.left);
      const dy = (gsap.getProperty(est, 'y') as number) + (hueco.top - ahora.top);

      gsap.to(est, {
        x: dx,
        y: dy,
        width: volver.w,
        height: volver.h,
        duration: dur,
        ease: 'power2.inOut',
        onComplete: () => {
          volver.padre.insertBefore(est, volver.siguiente);
          // Sin esto la estampilla queda con medidas y transform en píxeles y deja de
          // seguir a --est-w y al giro del conjunto.
          gsap.set(est, { clearProps: 'transform,width,height,x,y' });
          delete est.dataset.abierta;
          ficha?.replaceChildren();
        },
      });
      gsap.to(ficha, { autoAlpha: 0, duration: dur * 0.4, ease: 'power2.in' });
      gsap.to([telon, escenario], {
        autoAlpha: 0,
        duration: dur * 0.6,
        delay: dur * 0.4,
        ease: 'power2.in',
      });
    }

    // Salidas: el telón y el ✕ del foco. Escape lo maneja un solo listener para toda la
    // página, más abajo.
    telon?.addEventListener('click', () => {
      cerrar();
      focoActivo = null;
    });

    /* Si ESTA estampilla es la que esta en el foco. Lo usa el click para que la misma
       estampilla sirva de interruptor: abre y vuelve. */
    const estaAbierta = (est: HTMLElement) => abierta === est;

    return { abrir, cerrar, abierta: estaAbierta };
  }

  /* Qué colección tiene algo abierto, a nivel página: hace falta porque Escape se
     escucha UNA sola vez y no una por colección. En /numeros hay una colección por
     número, o sea treinta: treinta listeners sobre document, y cada uno reaccionando a
     cada tecla, no se justifica para una sola salida. */
  let focoActivo: ReturnType<typeof crearFoco> | null = null;

  document.addEventListener('keydown', (ev) => {
    if (ev.key !== 'Escape' || !focoActivo) return;
    focoActivo.cerrar();
    focoActivo = null;
  });

  /* El dial: refleja el scroll nativo de la tira, no lo controla. Misma mecánica que
     NumeroSequence.astro y la galería de la entrada — el ancho del segmento es 1/total y
     su posición sale de la proporción de scroll recorrida. */
  function initDial(raiz: HTMLElement) {
    const pliego = raiz.querySelector<HTMLElement>('[data-pliego]');
    const thumb = raiz.querySelector<HTMLElement>('[data-dial-thumb]');
    const contador = raiz.querySelector<HTMLElement>('[data-dial-count]');
    const total = raiz.querySelectorAll('[data-estampilla]').length;
    if (!pliego || !thumb || total < 2) return;

    const pista = thumb.parentElement as HTMLElement;
    // El mismo dial en los dos ejes: cambia qué medida del carril se mira y en qué
    // dirección se mueve el segmento.
    const vertical = raiz.dataset.disposicion === 'columna';
    if (vertical) thumb.style.height = `${100 / total}%`;
    else thumb.style.width = `${100 / total}%`;

    let pedido = 0;
    const actualizar = () => {
      pedido = 0;
      const maximo = vertical
        ? pliego.scrollHeight - pliego.clientHeight
        : pliego.scrollWidth - pliego.clientWidth;
      const recorrido = vertical ? pliego.scrollTop : pliego.scrollLeft;
      const razon = maximo > 0 ? recorrido / maximo : 0;
      const largoPista = vertical ? pista.clientHeight : pista.clientWidth;
      const largoThumb = largoPista / total;
      const avance = razon * (largoPista - largoThumb);

      gsap.to(thumb, {
        [vertical ? 'y' : 'x']: avance,
        duration: 0.2,
        ease: 'power2.out',
        overwrite: true,
      });

      if (contador) {
        const activa = Math.round(razon * (total - 1)) + 1;
        contador.textContent = `${String(activa).padStart(2, '0')} / ${String(total).padStart(2, '0')}`;
      }
    };

    // El scroll dispara muchísimo más seguido que los frames: un rAF por frame alcanza.
    const alScrollear = () => {
      if (pedido) return;
      pedido = requestAnimationFrame(actualizar);
    };

    pliego.addEventListener('scroll', alScrollear, { passive: true });
    window.addEventListener('resize', alScrollear);
    actualizar();
  }

  /* EL BUCLE: columna vertical infinita movida con la rueda. Es la misma mecánica que
     tenía la secuencia de boletos de NumeroSequence.astro —un solo `desplazamiento`, la
     posición de cada estampilla sale de su índice módulo el total, y el dial lee esa
     cuenta— con las estampillas en su lugar. El gesto se captura (preventDefault en la
     rueda), por eso esta disposición es solo de desktop: ahí alcanza con mover el mouse
     fuera del carril para recuperar el scroll de la página. */
  function initBucle(raiz: HTMLElement) {
    const pliego = raiz.querySelector<HTMLElement>('[data-pliego]');
    const huecos = Array.from(raiz.querySelectorAll<HTMLElement>('.estampilla-hueco'));
    if (!pliego || huecos.length === 0) return;

    const thumb = raiz.querySelector<HTMLElement>('[data-dial-thumb]');
    const contador = raiz.querySelector<HTMLElement>('[data-dial-count]');
    const total = huecos.length;
    const pista = thumb?.parentElement ?? null;
    if (thumb) thumb.style.height = `${100 / total}%`;

    /* El paso se mide del alto real del hueco y no de un numero fijo, porque la
       estampilla cambia de tamanio por breakpoint. Si todavia no esta medido (primer
       frame, o la seccion aun oculta) cae en un valor razonable en vez de en cero, que
       dejaria todas las estampillas en el mismo punto. */
    const paso = () => {
      const alto = huecos[0].getBoundingClientRect().height;
      return (alto > 0 ? alto : 150) * 1.12;
    };

    let desplazamiento = 0;
    let indiceDial = -1;

    /* CON TOPE EN LAS DOS PUNTAS. El recorrido va de la primera estampilla a la ultima y
       ahi se planta: no vuelve a empezar. Dar la vuelta parecia mas vivo pero deja al
       lector sin saber donde esta --en una lista de catorce piezas, pasar de la ultima a
       la primera sin aviso se lee como que algo fallo--, y el dial, que cuenta "03 / 14",
       estaria diciendo una posicion de una lista que no tiene principio. El tope se
       aplica al acumular, no al dibujar: asi la rueda no sigue sumando contra el limite y
       soltarla no deja un saldo guardado que despues se descuente solo. */
    const tope = () => Math.max(0, (total - 1) * paso());

    Observer.create({
      target: pliego,
      type: 'wheel',
      preventDefault: true,
      onChange: (self) => {
        desplazamiento = Math.min(tope(), Math.max(0, desplazamiento + self.deltaY * 0.5));
      },
    });

    const dibujar = () => {
      const SALTO = paso();
      /* Un cambio de tamanio (girar el telefono, cambiar de breakpoint) mueve el paso, y
         con el el tope: si el desplazamiento quedo mas alla, se recorta aca. */
      const limite = Math.max(0, (total - 1) * SALTO);
      if (desplazamiento > limite) desplazamiento = limite;

      huecos.forEach((hueco, i) => {
        const avance = i * SALTO - desplazamiento;
        const lejania = Math.abs(avance) / (SALTO * 2.1);
        gsap.set(hueco, {
          xPercent: -50,
          yPercent: -50,
          y: avance,
          scale: Math.max(0.74, 1 - lejania * 0.26),
          opacity: Math.max(0, 1 - lejania * 0.95),
          /* Entre 1 y 50, nunca fuera: negativo manda el hueco DETRAS del fondo de su
             contexto de apilado (desaparece aunque su opacidad sea 1), y por encima de
             60 le pasaria por delante al telon y al escenario del foco, tapando la
             ficha que se acaba de abrir. La informacion pedida gana siempre. */
          zIndex: Math.max(1, Math.round(50 - Math.abs(avance) / 20)),
        });
      });

      const activa = Math.min(total - 1, Math.max(0, Math.round(desplazamiento / SALTO)));
      if (activa === indiceDial) return;
      indiceDial = activa;

      if (contador) {
        contador.textContent = `${String(activa + 1).padStart(2, '0')} / ${String(total).padStart(2, '0')}`;
      }
      if (thumb && pista) {
        const largoPista = pista.clientHeight;
        gsap.to(thumb, {
          y: (activa / total) * largoPista,
          duration: 0.3,
          ease: 'power2.out',
          overwrite: true,
        });
      }
    };

    gsap.ticker.add(dibujar);

  }

  function initColeccion(raiz: HTMLElement) {
    const foco = crearFoco(raiz);
    if (raiz.dataset.disposicion === 'tira') initDial(raiz);
    if (raiz.dataset.disposicion === 'bucle') initBucle(raiz);

    /* Un solo listener por colección, delegado, en vez de uno por estampilla: con todas
       las entradas del sitio repartidas en treinta carpetas serían cientos de handlers
       idénticos. */
    raiz.addEventListener('click', (ev) => {
      const objetivo = ev.target as HTMLElement | null;
      if (!objetivo) return;

      if (objetivo.closest('[data-volver]')) {
        ev.preventDefault();
        foco.cerrar();
        focoActivo = null;
        return;
      }

      const abrir = objetivo.closest('[data-abrir]');
      if (!abrir) return;
      ev.preventDefault();
      const est = abrir.closest<HTMLElement>('[data-estampilla]');
      if (!est) return;
      /* La misma estampilla es el interruptor: pulsarla de nuevo, ya abierta, vuelve a
         la coleccion. Las otras dos salidas siguen ahi: la X de la esquina y Escape. */
      if (foco.abierta(est)) {
        foco.cerrar();
        focoActivo = null;
        return;
      }
      foco.abrir(est);
      focoActivo = foco;
    });
  }

  if (document.documentElement.classList.contains('js')) {
    /* Sin IntersectionObserver a propósito, al revés que el resto de los componentes
       pesados del sitio: acá el arranque solo engancha un listener, no hay nada que
       diferir. Y sobre todo, una colección puede nacer dentro de una carpeta cerrada
       (ver CarpetaNumero.astro), que nunca interseca: con IO no se habría inicializado
       jamás y las estampillas habrían quedado como links pelados. */
    for (const raiz of Array.from(document.querySelectorAll<HTMLElement>('[data-coleccion]'))) {
      initColeccion(raiz);
    }
  }
</script>
