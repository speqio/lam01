---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import {
  cardShell,
  cardImageWrap,
  cardImage,
  cardBadge,
  cardBody,
  cardTitle,
  cardCta,
} from '../lib/cardStyles';

const numeros = await getCollection('numeros');
const numerosOrdenados = numeros.sort(
  (a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf()
);
---

<BaseLayout
  title="Números — Blog Literario"
  description="Todas las ediciones publicadas de la revista, ordenadas de la más reciente a la más antigua."
>
  <PageHeader eyebrow="Ediciones" title="Números" />

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
    {
      numerosOrdenados.map((numero) => (
        <a href={`/numero/${numero.id}`} class={cardShell}>
          <div class={cardImageWrap}>
            {numero.data.portada && (
              <img src={numero.data.portada} alt={numero.data.titulo} class={cardImage} />
            )}
            <span class={cardBadge}>
              {numero.data.fecha.toLocaleDateString('es-ES', {
                month: 'long',
                year: 'numeric',
                timeZone: 'UTC',
              })}
            </span>
          </div>

          <div class={cardBody}>
            <h2 class={cardTitle}>{numero.data.titulo}</h2>
            {numero.data.descripcion && (
              <p class="line-clamp-3 font-serif text-sm italic leading-relaxed text-ink-muted">
                {numero.data.descripcion}
              </p>
            )}
            <span class={cardCta}>Ver número</span>
          </div>
        </a>
      ))
    }
  </div>

  {
    numerosOrdenados.length === 0 && (
      <p class="text-center font-sans text-ink-muted">Todavía no hay números publicados.</p>
    )
  }
</BaseLayout>
