---
import { cardImageWrap, cardBadge } from '../lib/cardStyles';
import { normalizeTitleText } from '../lib/text';

/**
 * Carrusel de arco para las entradas de un número, solo mobile — reemplaza al
 * mecanismo de scroll virtual/carril de NumeroSequence.astro en ese breakpoint (ver
 * comentario de ese archivo: capturar wheel/touch ahí no es seguro, así que mobile
 * usaba scroll real pasivo dentro de un carril alto medido en JS). Ese carril dio
 * problemas de nuevo en mobile, posiblemente ligado a números con pocas entradas —
 * en vez de seguir depurando esa mecánica puntual, se prueba una estrategia
 * estructuralmente distinta acá, misma que UltimasEntradasCarousel.astro en el home:
 * arco 3D arrastrable, sin scroll de la página involucrado en absoluto.
 *
 * Adaptado de una segunda referencia HTML/JS standalone ("wide arch": arco más
 * separado horizontalmente, que cae hacia abajo en vez de subir) a Astro + GSAP + este
 * design system — mismo criterio que UltimasEntradasCarousel.astro: sin React,
 * `Observer` para el arrastre, `gsap.quickTo` para el snap al soltar (releva al lerp
 * manual del original), render solo en el propio onUpdate del drag/tween (nada corre
 * en reposo), `overflow:hidden` en el viewport para que las cards de los extremos no
 * ensanchen el scroll de la página, `touch-action:pan-y` para no bloquear el scroll
 * vertical normal.
 */
export interface NumeroEntradaItem {
  slug: string;
  titulo: string;
  categoriaNombre: string;
  autorNombre: string;
  portada?: string;
}

interface Props {
  entradas: NumeroEntradaItem[];
}

const { entradas } = Astro.props;
---

{
  entradas.length > 0 && (
    <div class="numero-arco-scene" id="numero-arco-scene">
      <div class="numero-arco-carousel" id="numero-arco-carousel">
        {entradas.map((item, i) => (
          <a href={`/entrada/${item.slug}`} class="numero-arco-card" data-index={i}>
            <div class="flex h-full w-full overflow-hidden border border-ink/15 bg-surface">
              <div class={cardImageWrap}>
                {item.portada && (
                  <img
                    src={item.portada}
                    alt=""
                    class="pointer-events-none h-full w-full object-cover grayscale contrast-125"
                    loading="lazy"
                    draggable="false"
                  />
                )}
                <span class={cardBadge}>{item.categoriaNombre}</span>
              </div>
              <div class="flex w-3/5 flex-col justify-center gap-1 p-3">
                <h3 class="font-headline text-sm leading-[1.05] text-ink line-clamp-2">
                  {normalizeTitleText(item.titulo)}
                </h3>
                <p class="font-mono text-[9px] uppercase tracking-widest text-ink-muted">
                  Por {item.autorNombre}
                </p>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  )
}

<style>
  .numero-arco-scene {
    position: relative;
    width: 100%;
    height: 21rem;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    overflow: hidden;
    perspective: 1400px;
    touch-action: pan-y;
  }

  .numero-arco-carousel {
    position: relative;
    width: 18rem;
    height: 12rem;
    margin-top: 2rem;
    transform-style: preserve-3d;
  }

  .numero-arco-card {
    position: absolute;
    left: 0;
    top: 0;
    width: 18rem;
    height: 12rem;
    will-change: transform, opacity;
    backface-visibility: hidden;
    -webkit-user-drag: none;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { Observer } from 'gsap/Observer';

  gsap.registerPlugin(Observer);

  const SPACING_X = 170;
  const ARCH_DROP = 55;
  const ROLL = 20;
  const YAW = -8;
  const DRAG_SENSITIVITY = 0.007;

  // Distancia circular más corta entre un índice y la posición actual.
  function shortestDistance(index: number, position: number, total: number) {
    let dist = (((index - position) % total) + total) % total;
    if (dist > total / 2) dist -= total;
    return dist;
  }

  function initNumeroArco() {
    const scene = document.getElementById('numero-arco-scene');
    if (!(scene instanceof HTMLElement)) return;
    if (window.matchMedia('(min-width: 768px)').matches) return;

    const cards = Array.from(scene.querySelectorAll<HTMLElement>('.numero-arco-card'));
    const total = cards.length;
    if (total === 0) return;

    const pos = { value: 0 };

    function render() {
      cards.forEach((card, i) => {
        const dist = shortestDistance(i, pos.value, total);
        const absDist = Math.abs(dist);

        gsap.set(card, {
          x: dist * SPACING_X,
          y: dist * dist * ARCH_DROP,
          rotateY: dist * YAW,
          rotateZ: dist * ROLL,
          scale: Math.max(0.6, 1 - absDist * 0.15),
          opacity: Math.max(0.15, 1 - absDist * 0.32),
          zIndex: Math.round(100 - absDist * 10),
        });
      });
    }

    render();

    // Con una sola entrada no hay nada para arrastrar — se muestra fija, sin
    // Observer/snap de más.
    if (total <= 1) return;

    const snapTo = gsap.quickTo(pos, 'value', {
      duration: 0.65,
      ease: 'power3.out',
      onUpdate: render,
    });

    Observer.create({
      target: scene,
      type: 'touch,pointer',
      preventDefault: true,
      onPress: () => gsap.killTweensOf(pos),
      onChange: (self) => {
        pos.value -= self.deltaX * DRAG_SENSITIVITY;
        render();
      },
      onRelease: () => snapTo(Math.round(pos.value)),
    });
  }

  const scene = document.getElementById('numero-arco-scene');
  if (scene && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          initNumeroArco();
          observer.disconnect();
        }
      },
      { rootMargin: '200px' }
    );
    observer.observe(scene);
  } else {
    initNumeroArco();
  }
</script>
