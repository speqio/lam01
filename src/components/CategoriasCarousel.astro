---
import type { CollectionEntry } from 'astro:content';

/**
 * Carrusel automático de categorías: pista CSS que se desplaza en loop infinito
 * (adaptado de una referencia de marquee de tarjetas con fondo, reemplaza al carrusel
 * 3D en Three.js que había antes). Cada tarjeta es un link real a `/categoria/[id]`.
 *
 * El loop es JS (rAF + `translateX` en px, offset con módulo sobre el ancho de un set):
 * la pista renderiza la lista de categorías dos veces seguidas, así que cuando el
 * primer set termina de salir por la izquierda el segundo ya está en la posición
 * inicial del primero. Es JS y no CSS puro porque además del autoplay hay que poder
 * navegar con la rueda del mouse/trackpad estando encima (mismo criterio que el resto
 * de las secciones scroll-driven de este sitio: la rueda se captura en el contenedor,
 * nunca en window). El segundo set se marca `aria-hidden`/`tabindex="-1"` para que
 * lectores de pantalla y navegación por teclado no encuentren cada categoría dos veces.
 *
 * Las categorías no tienen portada propia en el CMS (ver `imagenPorCategoria`, resuelto
 * en index.astro a partir de la entrada más reciente de cada categoría) — la tarjeta
 * cae a un panel tipográfico cuando no hay ninguna disponible todavía.
 *
 * Dos decisiones de rendimiento, ambas para que la animación en mobile no se ponga
 * pesada/lenta (era notorio justo al cruzar el borde izquierdo, donde vivía el mask):
 * - Las fotos van en `<img loading="lazy" decoding="async">` en vez de
 *   `background-image` inline: así el navegador puede decodificarlas fuera del hilo
 *   principal y no descargar las del segundo set (fuera de vista) de entrada.
 * - El desvanecido de los bordes es un par de overlays con gradiente (color sólido,
 *   compositados una sola vez), no un `mask-image` sobre todo el contenedor — un mask
 *   sobre una pista con fotos moviéndose obliga a recomponer la máscara contra el
 *   contenido en cada frame, que es justo lo que se sentía pesado en mobile.
 */
interface Props {
  categorias: CollectionEntry<'categorias'>[];
  imagenPorCategoria: Record<string, string>;
}

const { categorias, imagenPorCategoria } = Astro.props;
---

{
  categorias.length > 0 && (
    <section class="relative mb-12">
      <div class="mb-6 md:hidden">
        <h2 class="font-headline text-2xl lg:text-3xl">Categorías</h2>
      </div>

      <div class="mb-6 hidden text-center md:block">
        <span class="mb-2 block font-mono text-xs uppercase tracking-widest text-ink/50">
          Revisá nuestro catálogo
        </span>
        <h2 class="font-headline text-4xl uppercase leading-none tracking-tight text-ink lg:text-6xl">
          Categorías
        </h2>
      </div>

      <div id="categorias-marquee" class="categorias-marquee-view">
        <ul class="categorias-marquee-track">
          {categorias.map((categoria) => (
            <li class="categorias-marquee-card">
              <a
                href={`/categoria/${categoria.id}`}
                class="group relative block h-full w-full overflow-hidden border border-ink/15 bg-surface transition-colors duration-300 hover:border-accent"
              >
                {imagenPorCategoria[categoria.id] && (
                  <img
                    src={imagenPorCategoria[categoria.id]}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    class="pointer-events-none absolute inset-0 h-full w-full object-cover"
                  />
                )}
                {imagenPorCategoria[categoria.id] && (
                  <span class="absolute inset-0 bg-gradient-to-t from-canvas/90 via-canvas/10 to-transparent" />
                )}
                <span class="relative flex h-full flex-col justify-end p-4">
                  <span class="font-headline text-lg uppercase leading-tight text-ink lg:text-xl">
                    {categoria.data.nombre}
                  </span>
                  <span class="mt-1 font-mono text-xs uppercase tracking-widest text-accent opacity-0 transition-opacity duration-300 group-hover:opacity-100">
                    Explorar
                  </span>
                </span>
              </a>
            </li>
          ))}
          {categorias.map((categoria) => (
            <li class="categorias-marquee-card" aria-hidden="true">
              <a
                href={`/categoria/${categoria.id}`}
                tabindex="-1"
                class="group relative block h-full w-full overflow-hidden border border-ink/15 bg-surface transition-colors duration-300 hover:border-accent"
              >
                {imagenPorCategoria[categoria.id] && (
                  <img
                    src={imagenPorCategoria[categoria.id]}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    class="pointer-events-none absolute inset-0 h-full w-full object-cover"
                  />
                )}
                {imagenPorCategoria[categoria.id] && (
                  <span class="absolute inset-0 bg-gradient-to-t from-canvas/90 via-canvas/10 to-transparent" />
                )}
                <span class="relative flex h-full flex-col justify-end p-4">
                  <span class="font-headline text-lg uppercase leading-tight text-ink lg:text-xl">
                    {categoria.data.nombre}
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ul>

        <div
          class="pointer-events-none absolute inset-y-0 left-0 z-10 w-10 bg-gradient-to-r from-canvas to-transparent md:w-16"
          aria-hidden="true"
        />
        <div
          class="pointer-events-none absolute inset-y-0 right-0 z-10 w-10 bg-gradient-to-l from-canvas to-transparent md:w-16"
          aria-hidden="true"
        />
      </div>
    </section>
  )
}

<style>
  .categorias-marquee-view {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .categorias-marquee-track {
    display: flex;
    width: max-content;
    /* La posición la escribe el script (rAF + wheel) vía transform inline. */
    will-change: transform;
  }

  .categorias-marquee-card {
    width: 12rem;
    height: 17rem;
    margin-right: 1rem;
    flex-shrink: 0;
  }

  @media (min-width: 768px) {
    .categorias-marquee-card {
      width: 15rem;
      height: 21rem;
    }
  }

  @media (min-width: 1024px) {
    .categorias-marquee-card {
      width: 17rem;
      height: 23rem;
    }
  }
</style>

<script>
  const AUTOPLAY_DURATION_S = 48;

  function initMarquee() {
    const view = document.getElementById('categorias-marquee');
    const track = view?.querySelector<HTMLElement>('.categorias-marquee-track');
    if (!view || !track) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isCoarsePointer = window.matchMedia('(pointer: coarse)').matches;

    // La pista renderiza el set de categorías dos veces. Tomamos el ancho exacto del
    // conjunto para que la animación siga siendo precisa aunque cambie el breakpoint.
    let setWidth = 0;
    let offset = 0;
    let isInteracting = false;
    let lastTime: number | null = null;

    function measure() {
      const width = track.scrollWidth;
      setWidth = width > 0 ? width / 2 : 0;
      if (setWidth <= 0) return;
      offset = ((offset % setWidth) + setWidth) % setWidth;
      render();
    }

    function render() {
      if (!setWidth) return;
      track.style.transform = `translate3d(${-offset}px, 0, 0)`;
    }

    // En móvil no se captura la rueda ni el scroll del contenedor para evitar que el
    // carrusel “se coma” el desplazamiento de la página y termine ralentizándose.
    view.addEventListener(
      'wheel',
      (event) => {
        if (isCoarsePointer) return;
        event.preventDefault();
        const delta = Math.abs(event.deltaX) > Math.abs(event.deltaY) ? event.deltaX : event.deltaY;
        if (!delta || !setWidth) return;
        offset = ((offset + delta) % setWidth + setWidth) % setWidth;
        render();
      },
      { passive: false }
    );

    // El autoplay se pausa sólo cuando el usuario interactúa con el carrusel y en
    // pantallas no táctiles, para mantener el rendimiento estable en mobile.
    view.addEventListener('mouseenter', () => {
      if (!isCoarsePointer) isInteracting = true;
    });
    view.addEventListener('mouseleave', () => {
      isInteracting = false;
    });
    view.addEventListener('focusin', () => {
      isInteracting = true;
    });
    view.addEventListener('focusout', () => {
      isInteracting = false;
    });

    if (reduceMotion) {
      measure();
      render();
      return;
    }

    function tick(now: number) {
      if (lastTime === null) lastTime = now;
      const dt = Math.min((now - lastTime) / 1000, 0.05);
      lastTime = now;

      if (!isInteracting && setWidth > 0) {
        const velocity = setWidth / AUTOPLAY_DURATION_S;
        offset = ((offset + velocity * dt) % setWidth + setWidth) % setWidth;
        render();
      }

      requestAnimationFrame(tick);
    }

    measure();
    render();
    window.addEventListener('resize', measure, { passive: true });

    if ('ResizeObserver' in window) {
      const resizeObserver = new ResizeObserver(() => measure());
      resizeObserver.observe(view);
    }

    requestAnimationFrame(tick);
  }

  initMarquee();
</script>
