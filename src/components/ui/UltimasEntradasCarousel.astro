---
import EntradaTicket, { type EntradaTicketItem } from './EntradaTicket.astro';
import { dialWrap, dialCount, dialTrack, dialThumb } from '../../lib/dialNav';

/**
 * "Últimas entradas" en mobile: carrusel horizontal con scroll-snap NATIVO del
 * navegador, mismo criterio que ya se probó y quedó en NumeroSequence.astro (ver ese
 * archivo) tras descartar tres carruseles drag/arco custom por bugs de física de
 * arrastre. Reemplaza al carrusel de arco 3D que tenía antes este mismo archivo
 * (Observer + quickTo, ver historial) — cada tarjeta ahora es un elemento normal en
 * flujo horizontal, sin ninguna transformación 3D ni posición absoluta calculada por
 * JS, así que no hay física que se pueda romper.
 *
 * El dial "01 / N" debajo (dialNav.ts) es un observador PASIVO del scroll nativo
 * (scroll listener + gsap.to para suavizar el thumb) — no reimplementa el gesto.
 */
interface Props {
  items: EntradaTicketItem[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <div class="entradas-carrusel mt-8 flex flex-col gap-4 md:hidden" id="entradas-carrusel">
      <div class="entradas-carrusel-scroll flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 pb-2" data-entradas-scroll>
        {items.map((item) => (
          <div class="w-[85vw] max-w-sm shrink-0 snap-center" data-entrada-slide>
            <EntradaTicket {...item} class="h-64" />
          </div>
        ))}
      </div>

      {
        items.length > 1 && (
          <div class={dialWrap}>
            <span class={dialCount} data-dial-count>
              {`01 / ${String(items.length).padStart(2, '0')}`}
            </span>
            <div class={dialTrack}>
              <div class={dialThumb} data-dial-thumb />
            </div>
          </div>
        )
      }
    </div>
  )
}

<style>
  /* Oculta la scrollbar nativa del carril — el gesto sigue siendo el scroll nativo del
     navegador, esto es puramente cosmético (mismo criterio que numero-entradas-scroll
     en NumeroSequence.astro). */
  .entradas-carrusel-scroll {
    scrollbar-width: none;
  }

  .entradas-carrusel-scroll::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  import { gsap } from 'gsap';

  function initEntradasCarrusel() {
    const root = document.getElementById('entradas-carrusel');
    if (!(root instanceof HTMLElement)) return;
    if (window.matchMedia('(min-width: 768px)').matches) return;

    const scrollEl = root.querySelector<HTMLElement>('[data-entradas-scroll]');
    const thumb = root.querySelector<HTMLElement>('[data-dial-thumb]');
    const countEl = root.querySelector<HTMLElement>('[data-dial-count]');
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-entrada-slide]'));
    if (!scrollEl || !thumb || slides.length < 2) return;

    const total = slides.length;
    const track = thumb.parentElement as HTMLElement;
    thumb.style.width = `${100 / total}%`;

    const updateDial = () => {
      const maxScroll = scrollEl.scrollWidth - scrollEl.clientWidth;
      const ratio = maxScroll > 0 ? scrollEl.scrollLeft / maxScroll : 0;
      const trackWidth = track.clientWidth;
      const thumbWidth = trackWidth / total;
      const x = ratio * (trackWidth - thumbWidth);

      gsap.to(thumb, { x, duration: 0.2, ease: 'power2.out', overwrite: true });

      if (countEl) {
        const activeIndex = Math.round(ratio * (total - 1));
        countEl.textContent = `${String(activeIndex + 1).padStart(2, '0')} / ${String(total).padStart(2, '0')}`;
      }
    };

    let ticking = false;
    scrollEl.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          updateDial();
          ticking = false;
        });
      },
      { passive: true }
    );

    updateDial();
  }

  const root = document.getElementById('entradas-carrusel');
  if (root && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          initEntradasCarrusel();
          observer.disconnect();
        }
      },
      { rootMargin: '200px' }
    );
    observer.observe(root);
  } else {
    initEntradasCarrusel();
  }
</script>
