---
import SearchModal from './ui/SearchModal.tsx';
import ThemeToggle from './ThemeToggle.astro';
import { navItems } from '../data/navItems';

const currentPath = Astro.url.pathname;
---

<nav
  class="fixed inset-x-4 bottom-4 z-30 flex items-stretch justify-between border border-ink/15 bg-surface/95 px-1 py-1 backdrop-blur md:hidden"
  aria-label="Navegación móvil"
>
  {
    navItems.map((item) => {
      const isActive = currentPath === item.url;
      return (
        <a
          href={item.url}
          class:list={[
            'flex flex-1 flex-col items-center gap-0.5 px-2 py-1.5 font-mono text-[9px] uppercase tracking-wide transition-colors',
            isActive ? 'text-accent' : 'text-ink-muted',
          ]}
          aria-current={isActive ? 'page' : undefined}
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d={item.icon} />
          </svg>
          <span>{item.name}</span>
        </a>
      );
    })
  }

  <SearchModal client:load variant="compact" />
  <div class="flex items-center px-1">
    <ThemeToggle class="h-8 w-8 border-ink/15" />
  </div>
</nav>
