---
import { normalizeTitleText, splitNumeroTitle } from '../lib/text';
import { dialWrap, dialCount, dialTrack, dialThumb } from '../lib/dialNav';
import EntryCard from './EntryCard.tsx';

interface EntradaItem {
  slug: string;
  titulo: string;
  categoriaNombre: string;
  autorNombre: string;
  portada?: string;
}

interface Props {
  titulo: string;
  descripcion?: string;
  /** Sin valor (p. ej. en la página de un autor) no se muestra la línea de fecha. */
  fechaFormateada?: string;
  entradas: EntradaItem[];
  /** Usa el título tal cual (p. ej. un nombre propio), sin pasarlo a minúsculas de oración. */
  tituloLiteral?: boolean;
}

const { titulo, descripcion, fechaFormateada, entradas, tituloLiteral = false } = Astro.props;
const { titulo: tituloPrincipal, subtitulo } = tituloLiteral
  ? { titulo, subtitulo: '' }
  : splitNumeroTitle(titulo);
---

<section
  id="numero-sequence"
  class="relative w-full overflow-hidden md:grid md:h-[75vh] md:grid-cols-2 md:gap-10"
>
  <div class="numero-sequence-info flex flex-col items-center justify-center px-4 text-center md:sticky md:top-20 md:z-10 md:min-w-0 md:items-start md:self-start md:px-0 md:text-left">
    {fechaFormateada && <p class="font-mono text-xs uppercase tracking-widest text-ink-muted">{fechaFormateada}</p>}
    <h1 class="numero-sequence-title mt-2 font-headline leading-[0.9] text-ink">{tituloPrincipal}</h1>
    {
      subtitulo && (
        <p class="numero-sequence-subtitle mt-1 font-serif italic leading-tight text-ink/70">
          {subtitulo}
        </p>
      )
    }
    {
      descripcion && (
        <p class="numero-sequence-desc mx-auto mt-4 max-w-md overflow-hidden font-serif text-ink-muted md:mx-0">
          {descripcion}
        </p>
      )
    }
  </div>

  {
    /* Mobile: carrusel horizontal con scroll-snap NATIVO del navegador — nada de
       drag/rotación a mano. Se probaron tres mecánicas de carrusel custom para esta
       sección en mobile (scroll virtual con carril medido en JS, arco arrastrable,
       dial circular) y ninguna terminó de andar bien; el problema de fondo en las tres
       era la física de arrastre hecha a mano. `overflow-x-auto` + `scroll-snap` deja
       que el navegador maneje el gesto táctil, el momentum y el encastre — sin
       posibilidad de que una tarjeta quede "acoplada" con otra porque no hay ninguna
       transformación 3D ni posición absoluta calculada por JS, cada tarjeta es un
       elemento normal en flujo horizontal. Sigue resolviendo el problema real (mucho
       scroll vertical cuando un número tiene muchas entradas) sin repetir la clase de
       bug que tuvieron los intentos anteriores. Cada tarjeta usa EntryCard.tsx (mismo
       componente que /categoria y /autor) envuelta en un ancho fijo para que el
       scroll-snap tenga contra qué encastrar.

       Debajo va un indicador tipo "dial": una franja delgada donde un segmento (ancho
       proporcional a 1/total) se desplaza en función de `scrollLeft` del carril, más un
       contador "02 / 12". Es puramente de LECTURA del scroll nativo (scroll listener +
       gsap.to para suavizar), no reimplementa el gesto — evita la clase de bug de los
       carruseles anteriores porque no hay ningún Draggable/Observer controlando el
       carril, solo un observador pasivo de su posición. */
  }
  <div class="numero-entradas-mobile mt-8 flex min-h-[54vh] flex-col justify-center gap-5 md:hidden">
    <div
      class="numero-entradas-scroll flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 pb-2"
      data-entradas-scroll
    >
      {
        entradas.map((item) => (
          <div class="w-[85vw] max-w-sm shrink-0 snap-center" data-entrada-slide>
            <EntryCard
              client:visible
              title={item.titulo}
              authorName={item.autorNombre}
              categoryName={item.categoriaNombre}
              slug={item.slug}
              coverImage={item.portada}
            />
          </div>
        ))
      }
    </div>

    {
      entradas.length > 1 && (
        <div class={dialWrap}>
          <span class={dialCount} data-dial-count>
            {`01 / ${String(entradas.length).padStart(2, '0')}`}
          </span>
          <div class={dialTrack}>
            <div class={dialThumb} data-dial-thumb />
          </div>
        </div>
      )
    }
  </div>

  <div class="numero-sequence-runway relative hidden w-full md:block md:h-full">
    <div class="numero-sequence-track static h-full w-full overflow-visible">
      {
        entradas.map((item) => (
          <a
            href={`/entrada/${item.slug}`}
            class="numero-sequence-card group absolute left-1/2 top-1/2 w-full min-w-0 max-w-md md:max-w-xl lg:max-w-2xl"
          >
            <div class="flex h-56 w-full overflow-hidden border border-ink/15 bg-surface md:h-80 lg:h-96">
              <div class="relative h-full w-2/5 shrink-0 bg-surface">
                {item.portada && (
                  <img
                    src={item.portada}
                    alt=""
                    class="pointer-events-none h-full w-full object-cover grayscale contrast-125"
                    loading="lazy"
                  />
                )}
                <span class="absolute left-2 top-2 bg-accent px-2.5 py-1.5 font-mono text-[10px] font-bold uppercase tracking-widest text-canvas md:px-3.5 md:py-2 md:text-sm">
                  {item.categoriaNombre}
                </span>
              </div>
              <div class="flex w-3/5 flex-col gap-1 p-4 md:gap-2 md:p-6">
                <h3 class="font-headline text-lg leading-[1.05] text-ink md:text-2xl lg:text-3xl">
                  {normalizeTitleText(item.titulo)}
                </h3>
                <p class="font-mono text-[10px] uppercase tracking-widest text-ink-muted md:text-xs">
                  Por {item.autorNombre}
                </p>
                <span class="relative mt-auto inline-block">
                  <span class="font-mono text-xs font-medium uppercase tracking-widest text-accent md:text-sm">
                    Leer entrada
                  </span>
                  <span class="absolute -bottom-0.5 left-0 h-px w-0 bg-accent transition-all duration-300 group-hover:w-full" />
                </span>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Oculta la scrollbar nativa del carril horizontal en mobile — el gesto de scroll
     sigue siendo el nativo del navegador, esto es puramente cosmético. */
  .numero-entradas-scroll {
    scrollbar-width: none;
  }

  .numero-entradas-scroll::-webkit-scrollbar {
    display: none;
  }

  #numero-sequence {
    --seq-progress: 1;
  }

  @media (min-width: 768px) {
    #numero-sequence {
      --seq-progress: 0;
    }
  }

  .numero-sequence-title {
    font-size: clamp(1.75rem, calc(4rem - var(--seq-progress) * 2.1rem), 4.5rem);
  }

  /* Subtítulo (el "acompañamiento" que antes iba pegado al título después de ":")
     escala en proporción al título usando el mismo --seq-progress, pero a una fracción
     de su tamaño — jerarquía tipográfica explícita en vez de una sola línea con dos
     puntos en el medio. */
  .numero-sequence-subtitle {
    font-size: clamp(1.1rem, calc(1.9rem - var(--seq-progress) * 0.9rem), 2.1rem);
  }

  /* En mobile --seq-progress vale 1 fijo (no hay scroll virtual que lo anime, ver
     arriba) — la fórmula de abajo asume que progress va de 0 a 1 con el scroll de
     desktop, así que aplicada tal cual en mobile la descripción quedaba siempre en
     opacity 0 / max-height 0, invisible sin importar el contenido. Visible sin más en
     mobile; la fórmula que la esconde a medida que se scrollea solo corre en desktop. */
  .numero-sequence-desc {
    opacity: 1;
    max-height: none;
  }

  @media (min-width: 768px) {
    .numero-sequence-desc {
      opacity: calc(1 - var(--seq-progress) * 1.6);
      max-height: calc((1 - var(--seq-progress)) * 10rem);
      transition: opacity 0.1s linear;
    }
  }

  .numero-sequence-card {
    will-change: transform, opacity;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { Observer } from 'gsap/Observer';

  gsap.registerPlugin(Observer);

  const isDesktop = window.matchMedia('(min-width: 768px)').matches;
  const stage = document.getElementById('numero-sequence');

  if (stage && !isDesktop) {
    const scrollEl = stage.querySelector<HTMLElement>('[data-entradas-scroll]');
    const thumb = stage.querySelector<HTMLElement>('[data-dial-thumb]');
    const countEl = stage.querySelector<HTMLElement>('[data-dial-count]');
    const slides = Array.from(stage.querySelectorAll<HTMLElement>('[data-entrada-slide]'));

    if (scrollEl && thumb && slides.length > 1) {
      const total = slides.length;
      const track = thumb.parentElement as HTMLElement;
      thumb.style.width = `${100 / total}%`;

      const updateDial = () => {
        const maxScroll = scrollEl.scrollWidth - scrollEl.clientWidth;
        const ratio = maxScroll > 0 ? scrollEl.scrollLeft / maxScroll : 0;
        const trackWidth = track.clientWidth;
        const thumbWidth = trackWidth / total;
        const x = ratio * (trackWidth - thumbWidth);

        gsap.to(thumb, { x, duration: 0.2, ease: 'power2.out', overwrite: true });

        if (countEl) {
          const activeIndex = Math.round(ratio * (total - 1));
          countEl.textContent = `${String(activeIndex + 1).padStart(2, '0')} / ${String(total).padStart(2, '0')}`;
        }
      };

      let ticking = false;
      scrollEl.addEventListener(
        'scroll',
        () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            updateDial();
            ticking = false;
          });
        },
        { passive: true }
      );

      updateDial();
    }
  }

  if (stage && isDesktop) {
    const cards = Array.from(stage.querySelectorAll<HTMLElement>('.numero-sequence-card'));

    if (cards.length > 0) {
      const SPACING = 260;
      const SHRINK_DISTANCE = 320;

      let scrollOffset = 0;

      const infoProxy = { value: 0 };
      const animateInfoProgress = gsap.quickTo(infoProxy, 'value', {
        duration: 0.4,
        ease: 'power3',
        onUpdate: () => stage.style.setProperty('--seq-progress', infoProxy.value.toFixed(3)),
      });

      Observer.create({
        target: stage,
        type: 'wheel',
        preventDefault: true,
        onChange: (self) => {
          scrollOffset = Math.max(0, scrollOffset + self.deltaY * 0.5);
        },
      });

      Observer.create({
        target: stage,
        type: 'touch',
        onChange: (self) => {
          scrollOffset = Math.max(0, scrollOffset + self.deltaY * 0.8);
        },
      });

      const update = () => {
        const total = cards.length;

        const infoTarget = Math.min(scrollOffset / SHRINK_DISTANCE, 1);
        animateInfoProgress(infoTarget);

        cards.forEach((card, i) => {
          let progress = (i * SPACING - scrollOffset) % (total * SPACING);
          if (progress < -SPACING) progress += total * SPACING;
          if (progress > total * SPACING - SPACING) progress -= total * SPACING;

          const distanceNormalized = Math.abs(progress) / 400;
          const scale = Math.max(0.7, 1 - distanceNormalized * 0.3);
          const opacity = Math.max(0, 1 - distanceNormalized * 1.2);
          const zIndex = Math.round(100 - Math.abs(progress));

          gsap.set(card, { xPercent: -50, yPercent: -50, y: progress, scale, opacity, zIndex });
        });
      };

      gsap.ticker.add(update);
    }
  }
</script>
