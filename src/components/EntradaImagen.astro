---
/**
 * Imagen individual de una entrada, con su propia posición ("después de qué párrafo/verso",
 * contando desde 1; sin valor, al final). Comparte el mecanismo de bloques especiales de
 * EntradaGaleria.astro: `data-bloque-especial` + `data-posicion` los lee el script de
 * `entrada/[slug].astro` para reubicarla en el texto y tratarla como un bloque más del
 * modo lectura.
 *
 * La imagen se muestra con el mockup de "foto antigua" (FotoAntigua.astro): caja de
 * proporción fija, marco de papel y filtro envejecido. Mismo componente que usa
 * EntradaGaleria.astro, para que varias imágenes de distinta proporción seguidas en el
 * cuerpo calcen entre sí en vez de alternar anchos y altos sueltos.
 */
import FotoAntigua from './FotoAntigua.astro';
import { datosImagen } from '../lib/portada';

interface Props {
  imagen: string;
  alt?: string;
  leyenda?: string;
  posicion?: number;
  titulo: string;
}

const { imagen, alt, leyenda, posicion, titulo } = Astro.props;
const { orientacion, maxAncho } = datosImagen(imagen);
---

<figure
  class="not-prose mx-auto my-10 w-fit max-w-full"
  data-bloque-especial
  data-etiqueta="Imagen"
  data-posicion={posicion ?? ''}
>
  <FotoAntigua imagen={imagen} alt={alt || leyenda || titulo} orientacion={orientacion} maxAncho={maxAncho} class="mx-auto" />
  {
    leyenda && (
      <figcaption class="entrada-leyenda mt-2 font-mono text-xs text-ink-muted">{leyenda}</figcaption>
    )
  }
</figure>

<style>
  /* Una leyenda larga no debe ensanchar la figura más allá de la imagen: con ancho 0 y
     min-width 100% el texto se ajusta al ancho que ya fijó la imagen. */
  .entrada-leyenda {
    width: 0;
    min-width: 100%;
  }
</style>
