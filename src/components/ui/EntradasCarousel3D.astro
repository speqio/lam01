---
import { cardBadge } from '../../lib/cardStyles';
import { normalizeTitleText } from '../../lib/text';
import { dialCount } from '../../lib/dialNav';

/**
 * "Últimas entradas" en desktop: carrusel de dos columnas sincronizadas — a la
 * izquierda título + autor de la entrada activa, a la derecha su imagen con el badge
 * de categoría superpuesto (mismo tratamiento que el resto de las cards del sitio).
 * Ambas columnas comparten un único `pos.value` (mismo patrón de
 * shortestDistance/pos.value/render() que CategoriasCards.astro/ArchivoHelix.astro):
 * cada índice tiene un elemento de texto Y un elemento de imagen, y los dos se mueven
 * exactamente con la misma distancia al valor activo, así que avanzan "coordinados" en
 * vez de cada columna por su cuenta.
 *
 * Reemplaza al carrusel 3D (círculo/onda/grilla con Draggable+InertiaPlugin) que tenía
 * este mismo archivo antes — se descartó a pedido explícito, el movimiento de onda no
 * convencía. Ahora el control es rueda del mouse / arrastre vertical con Observer +
 * snap con inercia (gsap.quickTo), igual criterio que el resto de los carruseles.
 */
export interface EntradaCarouselItem {
  title: string;
  authorName: string;
  categoryName: string;
  coverImage?: string;
  href: string;
}

interface Props {
  items: EntradaCarouselItem[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <div class="entradas-split-outer">
      <div class="entradas-split-stage" id="entradas-split-stage">
        <div class="entradas-split-col" id="entradas-split-text">
          {items.map((item, index) => (
            <a href={item.href} class="entradas-split-text-item" data-index={index}>
              <span class="entradas-split-eyebrow">{`${String(index + 1).padStart(2, '0')} / ${String(items.length).padStart(2, '0')}`}</span>
              <h3 class="entradas-split-title">{normalizeTitleText(item.title)}</h3>
              <p class="entradas-split-author">Por {item.authorName}</p>
            </a>
          ))}
        </div>

        <div class="entradas-split-col" id="entradas-split-image">
          {items.map((item, index) => (
            <a href={item.href} class="entradas-split-image-item" data-index={index}>
              {item.coverImage ? (
                <img
                  src={item.coverImage}
                  alt=""
                  class="h-full w-full object-cover grayscale contrast-125"
                  loading="lazy"
                  draggable="false"
                />
              ) : (
                <div class="h-full w-full bg-surface" />
              )}
              <span class={cardBadge}>{item.categoryName}</span>
            </a>
          ))}
        </div>
      </div>

      {
        items.length > 1 && (
          <div class="entradas-split-dial-vertical">
            <span class={dialCount} data-dial-count>
              {`01 / ${String(items.length).padStart(2, '0')}`}
            </span>
            <div class="entradas-split-dial-track">
              <div class="entradas-split-dial-thumb" data-dial-thumb />
            </div>
          </div>
        )
      }
    </div>
  )
}

<style>
  .entradas-split-outer {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    gap: 1.5rem;
  }

  .entradas-split-stage {
    position: relative;
    flex: 1;
    min-width: 0;
    height: 26rem;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    touch-action: pan-x;
    cursor: grab;
  }

  .entradas-split-stage:active {
    cursor: grabbing;
  }

  .entradas-split-col {
    position: relative;
    height: 100%;
  }

  .entradas-split-text-item,
  .entradas-split-image-item {
    position: absolute;
    left: 0;
    top: 50%;
    display: block;
    width: 100%;
    user-select: none;
    -webkit-user-drag: none;
  }

  .entradas-split-text-item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .entradas-split-eyebrow {
    font-family: var(--font-mono, monospace);
    font-size: 0.7rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: rgb(var(--color-ink-muted));
  }

  .entradas-split-title {
    font-family: var(--font-headline, 'Lekton', 'Arial', sans-serif);
    font-size: 1.6rem;
    line-height: 1.1;
    color: rgb(var(--color-ink));
  }

  .entradas-split-author {
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgb(var(--color-ink-muted));
  }

  .entradas-split-image-item {
    height: 18rem;
    overflow: hidden;
    border: 1px solid rgb(var(--color-ink) / 0.15);
    background: rgb(var(--color-surface));
  }

  /* Dial vertical (en vez del horizontal de dialNav.ts): el carrusel se mueve
     arriba/abajo, así que una barra que también sube y baja hace mucho más obvio qué
     gesto lo controla que una barra horizontal moviéndose para un movimiento
     vertical. */
  .entradas-split-dial-vertical {
    display: flex;
    flex-shrink: 0;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    padding-block: 0.5rem;
  }

  .entradas-split-dial-track {
    position: relative;
    width: 3px;
    flex: 1;
    overflow: hidden;
    border-radius: 9999px;
    background: rgb(var(--color-ink) / 0.15);
  }

  .entradas-split-dial-thumb {
    position: absolute;
    inset-inline: 0;
    top: 0;
    border-radius: 9999px;
    background: rgb(var(--color-accent));
  }

  @media (min-width: 1024px) {
    .entradas-split-stage {
      height: 32rem;
      gap: 3.5rem;
    }

    .entradas-split-title {
      font-size: 2.4rem;
    }

    .entradas-split-author {
      font-size: 0.85rem;
    }

    .entradas-split-image-item {
      height: 24rem;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { Observer } from 'gsap/Observer';

  gsap.registerPlugin(Observer);

  const WHEEL_SENSITIVITY = 0.0035;
  const DRAG_SENSITIVITY = 0.005;

  // Sin wraparound a propósito: de la última entrada no se pasa a la primera ni al
  // revés — `pos.value` queda acotado a [0, total-1] en cada handler de abajo, así que
  // la distancia es simplemente lineal (no hace falta el módulo circular que sí usan
  // otros carruseles del sitio, como CategoriasCards.astro, que sí dan la vuelta).
  function distance(index: number, position: number) {
    return index - position;
  }

  function initEntradasSplit() {
    const stage = document.getElementById('entradas-split-stage');
    const textCol = document.getElementById('entradas-split-text');
    const imageCol = document.getElementById('entradas-split-image');
    if (!(stage instanceof HTMLElement) || !(textCol instanceof HTMLElement) || !(imageCol instanceof HTMLElement))
      return;
    if (!window.matchMedia('(min-width: 768px)').matches) return;

    const textItems = Array.from(textCol.querySelectorAll<HTMLElement>('.entradas-split-text-item'));
    const imageItems = Array.from(imageCol.querySelectorAll<HTMLElement>('.entradas-split-image-item'));
    const total = textItems.length;
    if (total === 0) return;

    const outer = stage.closest('.entradas-split-outer');
    const thumb = outer?.querySelector<HTMLElement>('[data-dial-thumb]') ?? null;
    const countEl = outer?.querySelector<HTMLElement>('[data-dial-count]') ?? null;
    const track = thumb?.parentElement ?? null;
    if (thumb && track) {
      thumb.style.height = `${100 / total}%`;
    }

    const pos = { value: 0 };
    const stageHeight = () => stage.getBoundingClientRect().height;

    function render() {
      const slot = stageHeight();

      const place = (el: HTMLElement, i: number) => {
        const dist = distance(i, pos.value);
        const absDist = Math.abs(dist);
        const visible = absDist < 1.5;
        gsap.set(el, {
          yPercent: -50,
          y: dist * slot * 0.62,
          scale: gsap.utils.clamp(0.82, 1, 1 - absDist * 0.14),
          opacity: Math.max(0, 1 - absDist * 0.75),
          zIndex: Math.round(100 - absDist * 10),
          pointerEvents: absDist < 0.5 ? 'auto' : 'none',
        });
        el.style.visibility = visible ? 'visible' : 'hidden';
      };

      textItems.forEach((el, i) => place(el, i));
      imageItems.forEach((el, i) => place(el, i));

      if (thumb && track && countEl) {
        const activeIndex = gsap.utils.clamp(0, total - 1, Math.round(pos.value));
        const ratio = activeIndex / total;
        const trackHeight = track.clientHeight;
        const thumbHeight = trackHeight / total;
        gsap.to(thumb, { y: ratio * (trackHeight - thumbHeight), duration: 0.2, ease: 'power2.out', overwrite: true });
        countEl.textContent = `${String(activeIndex + 1).padStart(2, '0')} / ${String(total).padStart(2, '0')}`;
      }
    }

    const snapTo = gsap.quickTo(pos, 'value', {
      duration: 0.55,
      ease: 'power3.out',
      onUpdate: render,
    });

    render();

    Observer.create({
      target: stage,
      type: 'wheel',
      preventDefault: true,
      onChangeY: (self) => {
        gsap.killTweensOf(pos);
        // Acotado a [0, total-1]: de la última entrada no se sigue de largo hacia la
        // primera ni al revés — el valor simplemente deja de moverse en el límite.
        pos.value = gsap.utils.clamp(0, total - 1, pos.value + self.deltaY * WHEEL_SENSITIVITY);
        render();
      },
      onStop: () => snapTo(gsap.utils.clamp(0, total - 1, Math.round(pos.value))),
    });

    Observer.create({
      target: stage,
      type: 'touch,pointer',
      preventDefault: true,
      onPress: () => gsap.killTweensOf(pos),
      onChange: (self) => {
        pos.value = gsap.utils.clamp(0, total - 1, pos.value + self.deltaY * DRAG_SENSITIVITY);
        render();
      },
      onRelease: () => snapTo(gsap.utils.clamp(0, total - 1, Math.round(pos.value))),
    });
  }

  const stage = document.getElementById('entradas-split-stage');
  if (stage && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          initEntradasSplit();
          observer.disconnect();
        }
      },
      { rootMargin: '200px' }
    );
    observer.observe(stage);
  } else {
    initEntradasSplit();
  }
</script>
