---
/**
 * Imagen individual de una entrada, con su propia posición ("después de qué párrafo/verso",
 * contando desde 1; sin valor, al final). Comparte el mecanismo de bloques especiales de
 * EntradaGaleria.astro: `data-bloque-especial` + `data-posicion` los lee el script de
 * `entrada/[slug].astro` para reubicarla en el texto y tratarla como un bloque más del
 * modo lectura.
 *
 * La imagen se muestra en una caja de proporción fija (3:4 vertical, 4:3 horizontal) con
 * `object-cover`, igual que la estampilla de portada (EntradaBanner.astro) y que las cards del
 * carrusel de categorías del home (CategoriasCards.astro) — mismo mecanismo de encuadre que
 * esas dos, sin su filtro de color ni su carrusel/animación: acá es solo la caja. El objetivo
 * es que varias imágenes de distinta proporción seguidas en el cuerpo calcen entre sí en vez
 * de alternar anchos y altos sueltos. La orientación la mide `integrations/portadas.mjs` en
 * el build (mismo mecanismo que la portada, ver src/lib/portada.ts).
 */
import { datosImagen } from '../lib/portada';

interface Props {
  imagen: string;
  alt?: string;
  leyenda?: string;
  posicion?: number;
  titulo: string;
}

const { imagen, alt, leyenda, posicion, titulo } = Astro.props;
const { orientacion, maxAncho } = datosImagen(imagen);
const esHorizontal = orientacion === 'horizontal';
---

<figure
  class:list={[
    'entrada-imagen-caja not-prose mx-auto my-10',
    esHorizontal ? 'entrada-imagen-caja--horizontal' : 'entrada-imagen-caja--vertical',
  ]}
  style={maxAncho ? `--imagen-max: ${maxAncho}px` : undefined}
  data-bloque-especial
  data-etiqueta="Imagen"
  data-posicion={posicion ?? ''}
>
  <div class:list={['overflow-hidden', esHorizontal ? 'aspect-[4/3]' : 'aspect-[3/4]']}>
    <img
      src={imagen}
      alt={alt || leyenda || titulo}
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover"
    />
  </div>
  {
    leyenda && (
      <figcaption class="entrada-leyenda mt-2 font-mono text-xs text-ink-muted">{leyenda}</figcaption>
    )
  }
</figure>

<style>
  /* Mismo esquema de topes que EntradaBanner.astro: el menor entre el ancho de columna y el
     tamaño real de la imagen (`--imagen-max`), para no agrandar una foto chica. */
  .entrada-imagen-caja--vertical {
    width: min(78vw, 360px, var(--imagen-max, 100vw));
  }

  .entrada-imagen-caja--horizontal {
    width: min(92vw, 560px, var(--imagen-max, 100vw));
  }

  @media (min-width: 768px) {
    .entrada-imagen-caja--vertical {
      width: min(420px, var(--imagen-max, 100vw));
    }

    .entrada-imagen-caja--horizontal {
      width: min(640px, var(--imagen-max, 100vw));
    }
  }
</style>
