---
/**
 * Hero de "Último número" — portada estática, sin ningún comportamiento de hover/tap
 * (se sacó a propósito: la imagen flotante que seguía al cursor interfería con el click
 * en el botón "Ver número completo"). Misma imagen, mismo tratamiento visual (grayscale
 * + alto contraste), pero como bloque normal en el flujo, en todos los dispositivos.
 *
 * Tokens del Design System Broadsheet actual (paper/ink/accent, font-headline =
 * IM Fell DW Pica en mixed-case, sin uppercase ni bold forzado — la fuente no trae un
 * corte bold real).
 */
interface Props {
  titulo: string;
  descripcion?: string;
  imagen: string;
  href?: string;
}

const { titulo, descripcion, imagen, href } = Astro.props;
---

<section class="relative w-full px-4 py-4 text-center sm:py-6">
  <h1
    class="mx-auto max-w-full font-headline leading-[0.85] tracking-tight text-ink text-[13vw] md:text-[9vw]"
  >
    {titulo}
  </h1>

  <img
    src={imagen}
    alt={titulo}
    class="mx-auto mt-8 w-full max-w-sm border-2 border-ink object-cover shadow-2xl grayscale contrast-125"
  />

  {
    descripcion && (
      <p class="mx-auto mt-8 max-w-2xl px-4 font-serif text-lg italic text-ink/70">
        {descripcion}
      </p>
    )
  }

  {
    href && (
      <a
        href={href}
        class="relative z-10 mt-8 inline-block border border-ink px-6 py-3 font-mono text-xs uppercase tracking-widest text-ink transition-colors hover:border-accent hover:text-accent"
      >
        Ver número completo
      </a>
    )
  }
</section>
