---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArchivoHelix from '../components/ArchivoHelix.astro';
import ArchivoCascade from '../components/ArchivoCascade.astro';

const todasLasEntradas = await getCollection('entradas');

const entradasConRelaciones = await Promise.all(
  todasLasEntradas.map(async (entrada) => {
    const autor = await getEntry('autores', entrada.data.autor);
    const categoria = await getEntry('categorias', entrada.data.categoria);
    return { entrada, autor, categoria };
  })
);

entradasConRelaciones.sort(
  (a, b) => b.entrada.data.fecha.valueOf() - a.entrada.data.fecha.valueOf()
);

// Desktop: hélice 3D (ArchivoHelix), un "vistazo" curado a las últimas entradas — con
// cientos de entradas en el archivo real, renderizar todas como nodos 3D sería un
// problema de performance, así que se recorta.
const HELIX_MAX_ITEMS = 30;
const helixItems = entradasConRelaciones.slice(0, HELIX_MAX_ITEMS).map(({ entrada, categoria }) => ({
  slug: entrada.id,
  title: entrada.data.titulo,
  categoryName: categoria?.data.nombre ?? '',
  coverImage: entrada.data.portada,
}));

// Mobile: columnas en loop automático (ArchivoCascade) en vez de la hélice — un
// dispositivo mobile siempre va a ser menos capaz de sostener un render 3D a 60fps que
// un desktop, así que ahí ni se intenta (además es CSS puro, sin transforms 3D por
// frame). Cada columna repite su lista dos veces en el DOM para el loop sin salto (ver
// el componente), así que se recorta por la misma razón que la hélice: no queremos
// duplicar cientos de nodos si el archivo real crece mucho.
const CASCADE_MAX_ITEMS = 40;
const cascadeItems = entradasConRelaciones.slice(0, CASCADE_MAX_ITEMS).map(({ entrada, autor, categoria }) => ({
  slug: entrada.id,
  title: entrada.data.titulo,
  authorName: autor?.data.nombre ?? '',
  categoryName: categoria?.data.nombre ?? '',
  coverImage: entrada.data.portada,
}));
---

<BaseLayout
  title="Archivo — Blog Literario"
  description="El archivo completo de la revista: todas las entradas publicadas, sin restricción de número."
>
  {
    entradasConRelaciones.length === 0 ? (
      <p class="text-center font-sans text-ink-muted">Todavía no hay entradas en el archivo.</p>
    ) : (
      <Fragment>
        <div class="hidden md:grid md:grid-cols-2 md:items-center md:gap-10 md:pt-24">
          <div>
            <p class="font-sans text-sm uppercase tracking-widest text-accent">Hemeroteca</p>
            <h1 class="mt-2 font-headline text-6xl text-ink">Archivo</h1>
            <p class="mt-4 max-w-xl font-serif text-lg text-ink-muted">
              Todo lo publicado en la revista, de más reciente a más antiguo.
            </p>
          </div>

          <ArchivoHelix items={helixItems} />
        </div>

        <div class="md:hidden">
          <p class="font-sans text-sm uppercase tracking-widest text-accent">Hemeroteca</p>
          <h1 class="mt-2 mb-6 font-headline text-5xl text-ink">Archivo</h1>

          <ArchivoCascade items={cascadeItems} />
        </div>
      </Fragment>
    )
  }
</BaseLayout>
