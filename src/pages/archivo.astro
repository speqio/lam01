---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArchivoCatalogo from '../components/ArchivoCatalogo.astro';
import { splitNumeroTitle } from '../lib/text';

const todasLasEntradas = await getCollection('entradas');

const entradasConRelaciones = await Promise.all(
  todasLasEntradas.map(async (entrada) => {
    const autor = await getEntry('autores', entrada.data.autor);
    const categoria = await getEntry('categorias', entrada.data.categoria);
    const traductor = entrada.data.traducidoPor
      ? await getEntry('autores', entrada.data.traducidoPor)
      : null;
    return { entrada, autor, categoria, traductor };
  })
);

entradasConRelaciones.sort(
  (a, b) => b.entrada.data.fecha.valueOf() - a.entrada.data.fecha.valueOf()
);

// Catálogo completo (ArchivoCatalogo.astro): todas las entradas, sin recortar, con
// filtros de año/categoría/número y buscador de autor.
const catalogoItems = entradasConRelaciones.map(({ entrada, autor, categoria, traductor }) => ({
  slug: entrada.id,
  title: entrada.data.titulo,
  authorName: autor?.data.nombre ?? '',
  translatorName: traductor?.data.nombre,
  categoryName: categoria?.data.nombre ?? '',
  coverImage: entrada.data.portada,
  coverAlt: entrada.data.portadaAlt,
  anio: entrada.data.fecha.getUTCFullYear(),
  categoriaSlug: categoria?.id ?? '',
  numeroSlug: entrada.data.numero,
}));

const anios = Array.from(new Set(catalogoItems.map((item) => item.anio))).sort((a, b) => b - a);

const todasLasCategorias = await getCollection('categorias');
const categoriaOpciones = todasLasCategorias
  .map((categoria) => ({ slug: categoria.id, label: categoria.data.nombre }))
  .sort((a, b) => a.label.localeCompare(b.label, 'es'));

const todosLosAutores = await getCollection('autores');
const autorNombres = todosLosAutores
  .map((autor) => autor.data.nombre)
  .sort((a, b) => a.localeCompare(b, 'es'));

const todosLosNumeros = await getCollection('numeros');
const numeroOpciones = todosLosNumeros
  .map((numero) => ({ slug: numero.id, label: splitNumeroTitle(numero.data.titulo).titulo }))
  .sort((a, b) => b.slug.localeCompare(a.slug));
---

<BaseLayout
  title="Archivo — La Antorcha Magacín"
  description="El archivo completo de la revista: todas las entradas publicadas, sin restricción de número."
>
  {
    entradasConRelaciones.length === 0 ? (
      <p class="text-center font-sans text-ink-muted">Todavía no hay entradas en el archivo.</p>
    ) : (
      <>
        {/* md:pt-header-clear (ver tailwind.config.mjs): mismo despeje estándar del
            masthead flotante que PageHeader.astro — antes era un md:pt-24 propio de
            esta página, con un valor distinto al resto del sitio. */}
        <div class="text-center md:pt-header-clear md:text-left">
          <p class="font-sans text-sm uppercase tracking-widest text-accent">Todo lo publicado</p>
          <h1 class="mt-2 font-headline text-5xl text-ink md:text-6xl">Archivo</h1>
        </div>

        <ArchivoCatalogo
          items={catalogoItems}
          anios={anios}
          categorias={categoriaOpciones}
          autorNombres={autorNombres}
          numeros={numeroOpciones}
        />
      </>
    )
  }
</BaseLayout>
