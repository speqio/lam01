---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import { normalizeTitleText } from '../lib/text';

const todasLasEntradas = await getCollection('entradas');

const entradasConRelaciones = await Promise.all(
  todasLasEntradas.map(async (entrada) => {
    const autor = await getEntry('autores', entrada.data.autor);
    const categoria = await getEntry('categorias', entrada.data.categoria);
    return { entrada, autor, categoria };
  })
);

entradasConRelaciones.sort(
  (a, b) => b.entrada.data.fecha.valueOf() - a.entrada.data.fecha.valueOf()
);

const porAnio = new Map<number, typeof entradasConRelaciones>();
for (const item of entradasConRelaciones) {
  const anio = item.entrada.data.fecha.getUTCFullYear();
  const grupo = porAnio.get(anio) ?? [];
  grupo.push(item);
  porAnio.set(anio, grupo);
}
const anios = [...porAnio.keys()].sort((a, b) => b - a);
---

<BaseLayout
  title="Archivo — Blog Literario"
  description="El archivo completo de la revista: todas las entradas publicadas, sin restricción de número."
>
  <PageHeader
    eyebrow="Hemeroteca"
    title="Archivo"
    description="Todo lo publicado en la revista, de más reciente a más antiguo."
  />

  {
    anios.map((anio) => (
      <section class="mb-12">
        <h2 class="mb-4 font-headline text-2xl text-accent">
          {anio}
        </h2>
        <ul>
          {porAnio.get(anio)!.map(({ entrada, autor, categoria }) => {
            const tituloEntrada = normalizeTitleText(entrada.data.titulo);
            return (
              <li class="flex flex-col gap-1 py-4 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
                <a
                  href={`/entrada/${entrada.id}`}
                  class="font-serif text-lg text-ink no-underline transition-colors hover:text-accent"
                >
                  {tituloEntrada}
                </a>
                <span class="shrink-0 font-sans text-sm text-ink-muted">
                  {categoria?.data.nombre} &middot; {autor?.data.nombre} &middot;{' '}
                  {entrada.data.fecha.toLocaleDateString('es-ES', {
                    day: 'numeric',
                    month: 'short',
                    timeZone: 'UTC',
                  })}
                </span>
              </li>
            );
          })}
        </ul>
      </section>
    ))
  }

  {
    entradasConRelaciones.length === 0 && (
      <p class="text-center font-sans text-ink-muted">
        Todavía no hay entradas en el archivo.
      </p>
    )
  }
</BaseLayout>
