---
import { normalizeTitleText } from '../lib/text';

/**
 * Secuencia editorial para la página de un número.
 *
 * En mobile se usa una secuencia vertical simple: las tarjetas aparecen al hacer
 * scroll, una detrás de otra, con GSAP y sin lógica pesada. En desktop conserva la
 * versión más editorial y de coverflow que ya existía. La idea es mantener el
 * diseño del sitio sin introducir una solución compleja ni dependencias extra.
 */
interface EntradaItem {
  slug: string;
  titulo: string;
  categoriaNombre: string;
  autorNombre: string;
  portada?: string;
}

interface Props {
  titulo: string;
  descripcion?: string;
  fechaFormateada: string;
  entradas: EntradaItem[];
}

const { titulo, descripcion, fechaFormateada, entradas } = Astro.props;
const tituloNormalizado = normalizeTitleText(titulo);
---

<section
  id="numero-sequence"
  class="relative w-full overflow-hidden md:grid md:h-[75vh] md:grid-cols-2 md:gap-10"
>
  <div class="numero-sequence-info flex flex-col justify-center px-4 md:sticky md:top-20 md:z-10 md:min-w-0 md:self-start md:px-0">
    <p class="font-mono text-xs uppercase tracking-widest text-ink-muted">{fechaFormateada}</p>
    <h1 class="numero-sequence-title mt-2 font-headline leading-[0.9] text-ink">{tituloNormalizado}</h1>
    {
      descripcion && (
        <p class="numero-sequence-desc mt-4 max-w-md overflow-hidden font-serif text-ink-muted">
          {descripcion}
        </p>
      )
    }
  </div>

  <div class="md:hidden">
    <div class="mobile-sequence mx-auto max-w-md px-4 pb-8">
      {entradas.map((item, index) => (
        <a
          href={`/entrada/${item.slug}`}
          class="mobile-sequence-card group block overflow-hidden border border-ink/15 bg-surface"
          data-index={index}
        >
          {item.portada && (
            <div class="relative h-52 w-full overflow-hidden">
              <img
                src={item.portada}
                alt={item.titulo}
                class="h-full w-full object-cover grayscale transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
              <span class="absolute left-3 top-3 bg-canvas/80 px-2.5 py-1 font-mono text-[10px] uppercase tracking-[0.2em] text-ink backdrop-blur-sm">
                {item.categoriaNombre}
              </span>
            </div>
          )}

          <div class="space-y-2 p-4">
            <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-ink-muted">
              Por {item.autorNombre}
            </p>
            <h3 class="font-headline text-2xl leading-none tracking-tight text-ink">
              {normalizeTitleText(item.titulo)}
            </h3>
            <span class="inline-block font-mono text-[10px] uppercase tracking-[0.25em] text-accent">
              Leer entrada
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>

  <div class="numero-sequence-runway relative hidden w-full md:block md:h-full">
    <div class="numero-sequence-track static h-full w-full overflow-visible">
      {
        entradas.map((item) => (
          <a
            href={`/entrada/${item.slug}`}
            class="numero-sequence-card group absolute left-1/2 top-1/2 w-full min-w-0 max-w-md md:max-w-xl lg:max-w-2xl"
          >
            <div class="flex h-56 w-full overflow-hidden border border-ink/15 bg-surface md:h-80 lg:h-96">
              <div class="relative h-full w-2/5 shrink-0 bg-surface">
                {item.portada && (
                  <img
                    src={item.portada}
                    alt=""
                    class="pointer-events-none h-full w-full object-cover grayscale contrast-125"
                    loading="lazy"
                  />
                )}
                <span class="absolute left-2 top-2 bg-accent px-2.5 py-1.5 font-mono text-[10px] font-bold uppercase tracking-widest text-canvas md:px-3.5 md:py-2 md:text-sm">
                  {item.categoriaNombre}
                </span>
              </div>
              <div class="flex w-3/5 flex-col gap-1 p-4 md:gap-2 md:p-6">
                <h3 class="font-headline text-lg leading-[1.05] text-ink md:text-2xl lg:text-3xl">
                  {normalizeTitleText(item.titulo)}
                </h3>
                <p class="font-mono text-[10px] uppercase tracking-widest text-ink-muted md:text-xs">
                  Por {item.autorNombre}
                </p>
                <span class="mt-auto font-mono text-xs font-medium uppercase tracking-widest text-accent group-hover:underline md:text-sm">
                  Leer entrada
                </span>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  #numero-sequence {
    --seq-progress: 1;
  }

  @media (min-width: 768px) {
    #numero-sequence {
      --seq-progress: 0;
    }
  }

  .numero-sequence-title {
    font-size: clamp(1.75rem, calc(4rem - var(--seq-progress) * 2.1rem), 4.5rem);
  }

  .numero-sequence-desc {
    opacity: calc(1 - var(--seq-progress) * 1.6);
    max-height: calc((1 - var(--seq-progress)) * 10rem);
    transition: opacity 0.1s linear;
  }

  .numero-sequence-hint {
    opacity: calc(1 - var(--seq-progress) * 3);
  }

  .numero-sequence-card {
    will-change: transform, opacity;
  }

  .mobile-sequence {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 0.5rem 0 2rem;
  }

  .mobile-sequence-card {
    opacity: 0;
    transform: translateY(28px);
    visibility: hidden;
    will-change: transform, opacity, visibility;
  }

  .mobile-sequence-card.is-visible {
    opacity: 1;
    transform: translateY(0);
    visibility: visible;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { Observer } from 'gsap/Observer';

  gsap.registerPlugin(ScrollTrigger);
  gsap.registerPlugin(Observer);

  const isDesktop = window.matchMedia('(min-width: 768px)').matches;
  const stage = document.getElementById('numero-sequence');

  if (!isDesktop) {
    const mobileCards = gsap.utils.toArray<HTMLElement>('.mobile-sequence-card');

    if (mobileCards.length > 0) {
      mobileCards.forEach((card) => {
        const tl = gsap.timeline({
          scrollTrigger: {
            trigger: card,
            start: 'top 82%',
            end: 'bottom 18%',
            toggleActions: 'play reverse play reverse',
          },
        });

        tl.fromTo(
          card,
          { autoAlpha: 0, y: 28, visibility: 'hidden' },
          {
            autoAlpha: 1,
            y: 0,
            duration: 0.65,
            ease: 'power2.out',
            onStart: () => card.classList.add('is-visible'),
            onReverseComplete: () => card.classList.remove('is-visible'),
            onComplete: () => card.classList.add('is-visible'),
          }
        );
      });
    }
  }

  if (stage && isDesktop) {
    const cards = Array.from(stage.querySelectorAll<HTMLElement>('.numero-sequence-card'));

    if (cards.length > 0) {
      const SPACING = 260;
      const SHRINK_DISTANCE = 320;

      let scrollOffset = 0;

      const infoProxy = { value: 0 };
      const animateInfoProgress = gsap.quickTo(infoProxy, 'value', {
        duration: 0.4,
        ease: 'power3',
        onUpdate: () => stage.style.setProperty('--seq-progress', infoProxy.value.toFixed(3)),
      });

      Observer.create({
        target: stage,
        type: 'wheel',
        preventDefault: true,
        onChange: (self) => {
          scrollOffset = Math.max(0, scrollOffset + self.deltaY * 0.5);
        },
      });

      Observer.create({
        target: stage,
        type: 'touch',
        onChange: (self) => {
          scrollOffset = Math.max(0, scrollOffset + self.deltaY * 0.8);
        },
      });

      const update = () => {
        const total = cards.length;

        const infoTarget = Math.min(scrollOffset / SHRINK_DISTANCE, 1);
        animateInfoProgress(infoTarget);

        cards.forEach((card, i) => {
          let progress = (i * SPACING - scrollOffset) % (total * SPACING);
          if (progress < -SPACING) progress += total * SPACING;
          if (progress > total * SPACING - SPACING) progress -= total * SPACING;

          const distanceNormalized = Math.abs(progress) / 400;
          const scale = Math.max(0.7, 1 - distanceNormalized * 0.3);
          const opacity = Math.max(0, 1 - distanceNormalized * 1.2);
          const zIndex = Math.round(100 - Math.abs(progress));

          gsap.set(card, { xPercent: -50, yPercent: -50, y: progress, scale, opacity, zIndex });
        });
      };

      gsap.ticker.add(update);
    }
  }
</script>
