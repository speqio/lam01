---
import { getCollection, getEntry, render } from 'astro:content';
import PostLayout from '../layouts/PostLayout.astro';
import EntradaGaleria from '../components/EntradaGaleria.astro';
import EntradaImagen from '../components/EntradaImagen.astro';
import { normalizeTitleText } from '../lib/text';

const { entrada } = Astro.props;
const { Content } = await render(entrada);

const autor = await getEntry('autores', entrada.data.autor);
const categoria = await getEntry('categorias', entrada.data.categoria);
const tituloEntrada = normalizeTitleText(entrada.data.titulo);

// Un espacio de galería o de imagen individual sin imagen (Keystatic lo guarda como `- {}`
// si el campo no era obligatorio) se ignora en vez de romper la entrada.
const galeriaConImagen = (entrada.data.galeria ?? []).filter(
  (item): item is typeof item & { imagen: string } => !!item.imagen
);
const individualesConImagen = (entrada.data.imagenesIndividuales ?? []).filter(
  (item): item is typeof item & { imagen: string } => !!item.imagen
);

const formattedDate = entrada.data.fecha.toLocaleDateString('es-ES', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<PostLayout
  title={entrada.data.metaTitulo || tituloEntrada}
  description={entrada.data.metaDescripcion || entrada.data.extracto}
>
  <header class="not-prose mb-8 text-center">
    {
      categoria && (
        <a
          href={`/category/${categoria.id}`}
          class="mb-4 inline-block font-mono text-xs uppercase tracking-widest text-accent no-underline hover:underline"
        >
          {categoria.data.nombre}
        </a>
      )
    }
    <h1 class="font-headline text-5xl leading-[0.9] text-ink md:text-6xl">
      {tituloEntrada}
    </h1>
    <p class="mt-4 font-mono text-xs uppercase tracking-widest text-ink-muted">
      Por{' '}
      {autor && (
        <a
          href={`/autor/${autor.id}`}
          class="text-ink no-underline hover:text-accent"
        >
          {autor.data.nombre}
        </a>
      )}
      {' '}&middot; {formattedDate}
    </p>
  </header>

  {/* La portada no se muestra en la entrada: solo sirve como imagen de las cards. Queda
      como <img> oculta para conservar su texto alternativo (SEO). */}
  {
    entrada.data.portada && (
      <img src={entrada.data.portada} alt={entrada.data.portadaAlt || tituloEntrada} hidden loading="lazy" />
    )
  }

  <div class="not-prose mb-8 text-center">
    <button
      type="button"
      id="entrada-enter-reading"
      class="hidden items-center gap-2 rounded-full border border-ink/15 bg-surface px-5 py-2 font-mono text-xs uppercase tracking-widest text-ink transition-colors hover:border-accent hover:text-accent"
    >
      ✦ Entrar en modo lectura
    </button>
  </div>

  <div
    id="entrada-content"
    class="drop-cap"
    data-categoria={categoria?.id ?? ''}
  >
    <Content />
  </div>

  <div
    id="entrada-progress-badge"
    class="not-prose pointer-events-none fixed right-4 z-50 hidden rounded-full border border-ink/15 bg-surface/90 px-4 py-1.5 font-mono text-[0.7rem] uppercase tracking-widest text-ink backdrop-blur"
    style="top: 5.5rem;"
  >
  </div>

  <button
    type="button"
    id="entrada-exit-reading"
    class="not-prose fixed left-4 z-50 hidden items-center gap-2 rounded-full border border-ink/15 bg-surface/90 px-4 py-1.5 font-mono text-[0.7rem] uppercase tracking-widest text-ink backdrop-blur transition-colors hover:border-accent hover:text-accent"
    style="top: 5.5rem;"
  >
    ✕ Salir del modo lectura
  </button>

  {
    individualesConImagen.map((item) => (
      <EntradaImagen
        imagen={item.imagen}
        alt={item.alt}
        leyenda={item.leyenda}
        posicion={item.posicion}
        titulo={tituloEntrada}
      />
    ))
  }

  {
    galeriaConImagen.length > 0 && (
      <EntradaGaleria
        imagenes={galeriaConImagen}
        titulo={tituloEntrada}
        posicion={entrada.data.galeriaPosicion}
      />
    )
  }

  {
    entrada.data.biografiaAutor && (
      <div class="not-prose mt-12 border-t border-ink/15 pt-8">
        <h2 class="mb-3 font-headline text-2xl text-ink">
          {autor ? autor.data.nombre : 'Sobre el autor'}
        </h2>
        <p class="font-serif text-sm italic leading-relaxed text-ink-muted">
          {entrada.data.biografiaAutor}
        </p>
      </div>
    )
  }

  {
    entrada.data.bibliografia && (
      <div class="not-prose mt-12 border-t border-ink/15 pt-8">
        <h2 class="mb-3 font-headline text-2xl text-ink">Bibliografía</h2>
        <p class="whitespace-pre-line font-serif text-sm leading-relaxed text-ink-muted">
          {entrada.data.bibliografia}
        </p>
      </div>
    )
  }
</PostLayout>

<script>
  import { Observer } from 'gsap/Observer';
  import gsap from 'gsap';
  import { write, presets } from 'glitched-writer';

  gsap.registerPlugin(Observer);

  /**
   * Lectura "rueda bloqueada + tipeo": mientras el modo lectura está activo, la rueda
   * (y el touch/swipe en mobile) no hacen scroll real — cada gesto revela el siguiente
   * párrafo (prosa) o verso (poesía — un <p> por línea, así se autoran los poemas en
   * Markdoc), con un efecto de tipeo/glitch (glitched-writer), centrado en pantalla.
   * Adaptado de una plantilla de referencia que aportó el usuario (H. G. Wells /
   * Glitched Writer demo). Un intento anterior de este mismo mecanismo aplicaba el
   * bloqueo/`position: fixed` a toda la página y "rompía la diagramación" en uso real;
   * acá el modo lectura queda acotado a #entrada-content — header, portada, galería,
   * biografía y bibliografía quedan siempre en flujo normal.
   *
   * La página carga siempre en modo normal (texto completo, en flujo, nítido) — el
   * modo lectura es opt-in vía el botón "Entrar en modo lectura", no se activa solo
   * al hacer scroll hasta el texto.
   *
   * Sin JS moderno (sin Observer/glitched-writer disponibles): no se agrega ninguna
   * clase ni se muestra el botón de entrada, el contenido se lee completo y nítido de
   * entrada (Content siempre trae el texto completo en el HTML servido: SEO/accesibilidad intactos).
   */
  const container = document.getElementById('entrada-content');
  // @astrojs/markdoc envuelve el documento renderizado en su propio <article>, así
  // que los párrafos/versos son nietos de #entrada-content, no hijos directos.
  const blocksRoot = container?.querySelector<HTMLElement>(':scope > article') ?? container;
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const esPoesia = container?.dataset.categoria === 'poesia';
  const badge = document.getElementById('entrada-progress-badge');
  const exitButton = document.getElementById('entrada-exit-reading');
  const enterButton = document.getElementById('entrada-enter-reading');
  // Los bloques especiales (imágenes individuales de EntradaImagen.astro y el carrusel
  // de EntradaGaleria.astro) viven por defecto fuera de #entrada-content, al pie de la
  // entrada. Los que configuraron "después de qué párrafo" (data-posicion) se reubican
  // ACÁ, antes de capturar originalBlocks más abajo, moviendo el nodo real (no
  // clonándolo) para que el carrusel y su listener de scroll sigan andando tal cual una
  // vez dentro del stage de lectura — el resto del mecanismo (fade en vez de tipeo, no
  // auto-salir en un bloque especial, dejarle el gesto al carrusel) no le importa en qué
  // posición del array termine cayendo. Varios en la misma posición conservan su orden
  // en el DOM (cada uno se inserta antes del mismo nodo de referencia).
  const especiales = Array.from(document.querySelectorAll<HTMLElement>('[data-bloque-especial]'));
  // Devuelve boolean a propósito (no un predicado de tipo `el is HTMLElement`): con un
  // predicado, TypeScript deja `source` como `never` en la rama contraria.
  const esEspecial = (el: Element | undefined): boolean =>
    !!el && especiales.includes(el as HTMLElement);
  if (blocksRoot) {
    const textos = Array.from(blocksRoot.children);
    especiales.forEach((el) => {
      const posicion = Number(el.dataset.posicion);
      if (Number.isInteger(posicion) && posicion >= 1 && posicion <= textos.length) {
        blocksRoot.insertBefore(el, textos[posicion] ?? null);
      }
    });
  }
  // Se captura recién ahora: si se reubicó arriba, "su lugar" para restaurar al salir
  // del modo lectura ya es el nuevo, dentro de blocksRoot.
  const especialSitio = new Map(
    especiales.map((el) => [el, { parent: el.parentElement, next: el.nextElementSibling }])
  );
  const sacarEspecialesDelStage = (stage: HTMLElement) => {
    especiales.forEach((el) => {
      if (stage.contains(el)) stage.removeChild(el);
    });
  };
  // Misma barra de progreso de PostLayout.astro (fija arriba de toda la página): en
  // modo normal la sigue actualizando su propio listener de scroll; en modo lectura
  // no hay scroll real (body queda con overflow:hidden), así que acá se pisa su ancho
  // a mano según cuántos bloques ya se revelaron.
  const readingProgressBar = document.getElementById('post-reading-progress');

  if (container && blocksRoot && exitButton && enterButton) {
    const originalBlocks = Array.from(blocksRoot.children) as HTMLElement[];
    // Si no se reubicó arriba (sin posición configurada), sigue afuera de blocksRoot —
    // se suma al final de la secuencia, comportamiento previo.
    especiales.forEach((el) => {
      if (!blocksRoot.contains(el)) originalBlocks.push(el);
    });
    const total = originalBlocks.length;
    const blockClass = esPoesia ? 'entrada-verse' : 'entrada-block';
    const unidad = esPoesia ? 'Verso' : 'Párrafo';

    if (total > 0) {
      // El stage reemplaza el contenido de blocksRoot mientras dura el modo lectura;
      // al salir, blocksRoot vuelve a mostrar todos los bloques originales en flujo.
      const stage = document.createElement('div');
      stage.className = 'entrada-reading-stage';

      let revealed = 0;
      let isWriting = false;
      let readingActive = false;

      const updateBadge = () => {
        if (!badge || revealed === 0) return;
        const actual = originalBlocks[revealed - 1];
        const etiqueta = esEspecial(actual) ? (actual.dataset.etiqueta ?? 'Imagen') : unidad;
        badge.textContent = `${etiqueta} ${revealed} de ${total}`;
      };

      const updateReadingProgress = () => {
        if (!readingProgressBar) return;
        readingProgressBar.style.width = `${(revealed / total) * 100}%`;
      };

      // `stage.innerHTML = ''` destruiría el nodo real de la galería si es lo que
      // está montado ahí en ese momento (a diferencia de los bloques de texto, que
      // siempre son copias descartables) — hay que sacarla primero, no borrarla. No
      // hace falta reinsertarla en ningún lado todavía: mientras dura la sesión de
      // lectura, blocksRoot solo contiene el `stage` (su posición real recién se
      // reconstruye al salir, desde `originalBlocks`, más abajo) — alcanza con
      // desmontarla del stage sin destruirla.
      const clearStage = () => {
        sacarEspecialesDelStage(stage);
        stage.innerHTML = '';
      };

      const enterReadingMode = () => {
        if (readingActive || revealed >= total) return;
        readingActive = true;
        blocksRoot!.innerHTML = '';
        blocksRoot!.appendChild(stage);
        container!.classList.add('is-reading-mode');
        document.body.classList.add('overflow-hidden');
        badge?.classList.remove('hidden');
        exitButton!.classList.remove('hidden');
        exitButton!.classList.add('flex');
        enterButton!.classList.add('hidden');
        enterButton!.classList.remove('flex');
      };

      const exitReadingMode = () => {
        if (!readingActive) return;
        readingActive = false;
        container!.classList.remove('is-reading-mode');
        document.body.classList.remove('overflow-hidden');
        badge?.classList.add('hidden');
        exitButton!.classList.add('hidden');
        exitButton!.classList.remove('flex');
        if (revealed < total) {
          enterButton!.classList.remove('hidden');
          enterButton!.classList.add('flex');
        }
        // Si la galería está montada en el stage en este momento (se salió sin pasar
        // por clearStage — ej. clic directo en "Salir"), sacarla primero sin
        // destruirla — blocksRoot!.innerHTML = '' de abajo se llevaría puesto el stage
        // entero, y con él el nodo real de la galería.
        sacarEspecialesDelStage(stage);
        // Al salir, se muestran todos los bloques originales en flujo normal — tanto
        // los ya revelados con tipeo como los que faltaban. Si la galería tenía
        // posición configurada (es hija real de blocksRoot), originalBlocks ya la
        // tiene en el índice correcto y se reinserta ahí sin más, en orden, junto con
        // el resto; si no, se reinserta afuera, en su lugar original
        // (especialSitio — capturado ANTES de que arrancara el
        // modo lectura, cuando ese contenedor todavía no se había tocado, así que esa
        // referencia sigue siendo válida).
        blocksRoot!.innerHTML = '';
        originalBlocks.forEach((el) => {
          el.classList.remove('entrada-reading-block', 'entrada-reading-fade');
          const sitio = especialSitio.get(el);
          if (sitio && sitio.parent !== blocksRoot) {
            sitio.parent?.insertBefore(el, sitio.next);
          } else {
            blocksRoot!.appendChild(el);
          }
        });
        // Le devuelve el control de la barra a su propio listener de scroll
        // (PostLayout.astro), que la recalcula según la posición real ya restaurada.
        window.dispatchEvent(new Event('scroll'));
      };

      const revealNext = () => {
        if (isWriting || revealed >= total) {
          if (revealed >= total) exitReadingMode();
          return;
        }
        const source = originalBlocks[revealed];

        // La galería es un bloque especial: se mueve el nodo REAL (no una copia por
        // innerHTML) para no perder su carrusel/listener de scroll ya armado, y
        // aparece con un fade simple — tipear una imagen letra por letra no tiene
        // sentido. Tampoco se auto-sale del modo lectura al terminar de aparecer (a
        // diferencia del texto): el usuario tiene que poder seguir usando el carrusel
        // el tiempo que quiera antes de salir (botón o un gesto más).
        if (esEspecial(source)) {
          clearStage();
          source.classList.add('entrada-reading-block', 'entrada-reading-fade');
          stage.appendChild(source);
          revealed += 1;
          updateBadge();
          updateReadingProgress();
          gsap.fromTo(
            source,
            { opacity: 0 },
            { opacity: 1, duration: prefersReducedMotion ? 0 : 0.6, ease: 'power2.out' }
          );
          return;
        }

        const el = document.createElement(source.tagName.toLowerCase());
        el.className = `${blockClass} entrada-reading-block`;

        clearStage();
        stage.appendChild(el);

        revealed += 1;
        updateBadge();
        updateReadingProgress();

        if (prefersReducedMotion) {
          el.innerHTML = source.innerHTML;
          if (revealed >= total) exitReadingMode();
          return;
        }

        isWriting = true;
        // Interval más rápido que el preset por defecto de glitched-writer (que es
        // [50, 150] ms entre caracteres).
        write(source.innerHTML, el, { ...presets.typewriter, html: true, interval: [18, 65] })
          .then(() => {
            isWriting = false;
            if (revealed >= total) exitReadingMode();
          })
          .catch(() => {
            isWriting = false;
          });
      };

      const revealPrevious = () => {
        if (isWriting || revealed <= 1) return;
        revealed -= 1;
        const source = originalBlocks[revealed - 1];

        if (esEspecial(source)) {
          clearStage();
          source.classList.add('entrada-reading-block', 'entrada-reading-fade');
          stage.appendChild(source);
          updateBadge();
          updateReadingProgress();
          return;
        }

        const el = document.createElement(source.tagName.toLowerCase());
        el.className = `${blockClass} entrada-reading-block`;
        el.innerHTML = source.innerHTML;
        clearStage();
        stage.appendChild(el);
        updateBadge();
        updateReadingProgress();
      };

      exitButton.addEventListener('click', exitReadingMode);
      enterButton.addEventListener('click', () => {
        enterReadingMode();
        revealNext();
      });
      enterButton.classList.remove('hidden');
      enterButton.classList.add('flex');

      // Un solo paso por gesto: onChangeY/onChange disparan repetidas veces mientras
      // dura el gesto (rueda continua, arrastre), así que se acotan con isWriting +
      // un lock corto tras cada paso, mismo patrón que el carrusel de categorías
      // (CategoriasCards.astro) para "un paso = un salto", no un scroll continuo.
      let gestureLocked = false;
      const step = (delta: number) => {
        if (!readingActive || isWriting || gestureLocked) return;
        gestureLocked = true;
        if (delta > 0) revealNext();
        else revealPrevious();
        setTimeout(() => {
          gestureLocked = false;
        }, 350);
      };

      // preventDefault se aplica solo mientras el modo lectura está activo: antes de
      // eso, el scroll real de la página tiene que poder pasar sin trabas para que el
      // usuario llegue a #entrada-content y el IntersectionObserver de activación
      // pueda dispararse (si se bloqueara siempre, la página nunca podría scrollear
      // lo suficiente como para activar el modo en primer lugar).
      Observer.create({
        target: container,
        type: 'wheel',
        onChangeY: (self) => {
          if (readingActive) self.event?.preventDefault();
          step(self.deltaY);
        },
      });
      Observer.create({
        target: container,
        type: 'touch,pointer',
        onChange: (self) => {
          // El carrusel de la galería (si está activo) tiene su propio scroll
          // horizontal nativo — un swipe que empieza ahí no debe avanzar/retroceder
          // de bloque, se le deja el gesto entero al carrusel.
          const target = self.event?.target as HTMLElement | null;
          if (target?.closest('.entrada-galeria-carousel')) return;
          if (readingActive) self.event?.preventDefault();
          step(-self.deltaY);
        },
      });
    }
  }
</script>

<style is:global>
  /* Los elementos animados acá vienen del HTML que genera @astrojs/markdoc (via
     <Content />), no de markup propio de este componente — el scoping de Astro no
     llega de forma confiable ahí, por eso global + prefijo #entrada-content.

     Mecanismos descartados en el camino: lectura por blur/foco con scroll real y
     `IntersectionObserver` de banda central (funcionaba, pero no daba la sensación de
     lectura buscada); CSS Scroll Snap (Chromium reubicaba el scroll al cargar la
     página, y trababa el scroll con incrementos de rueda normales). Este mecanismo
     retoma rueda/touch bloqueados + `position: fixed`, pero acotado a
     #entrada-content (no a toda la página, que fue lo que rompió la diagramación en
     un intento anterior). */

  /* El modo lectura (rueda/touch bloqueados, un bloque a la vez) solo aplica una vez
     que JS lo activó — sin JS, el texto se lee completo y nítido en flujo normal. */
  #entrada-content.is-reading-mode {
    position: fixed;
    inset: 0;
    /* Por encima del header fijo (z-20 en Header.astro) para que cubra la pantalla
       entera y, sobre todo, para que reciba los eventos de wheel/touch en vez de que
       algún elemento del header (con pointer-events propio) se los quede primero. */
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgb(var(--color-canvas));
    padding: 2rem;
  }

  #entrada-content.is-reading-mode .entrada-reading-stage {
    width: 100%;
    max-width: 60ch;
    max-height: 80vh;
    overflow: hidden;
  }

  /* La galería (imagen suelta o cinta horizontal) necesita más ancho que una columna
     de texto — se ensancha el stage solo cuando el bloque activo es el de galería. */
  #entrada-content.is-reading-mode .entrada-reading-stage:has(.entrada-reading-fade) {
    max-width: min(90vw, 70rem);
  }

  /* El bloque de galería no lleva tipografía de lectura — es la misma
     EntradaGaleria.astro de siempre, solo que centrada y con fade en vez de tipeo. */
  .entrada-reading-fade {
    width: 100%;
    max-height: 80vh;
    overflow-y: auto;
  }

  /* En modo lectura las imágenes de la cinta bajan de altura para que cinta, leyendas e
     indicador quepan en el alto del bloque (80vh) sin scroll vertical. Solo cambia el
     tamaño: la proporción y los colores siguen siendo los originales. */
  #entrada-content.is-reading-mode .entrada-reading-fade [data-galeria-slide] img {
    max-height: min(42vh, 400px);
    max-width: 100cqw;
  }

  /* Prosa: bloque centrado en el stage. */
  .entrada-reading-block.entrada-block {
    font-family: 'Lekton', monospace;
    font-size: clamp(1.05rem, 2.4vw, 1.35rem);
    line-height: 1.7;
    color: rgb(var(--color-bone));
  }

  /* Poesía: verso centrado, un poco más grande. */
  .entrada-reading-block.entrada-verse {
    text-align: center;
    font-family: 'Lekton', monospace;
    font-style: italic;
    font-size: clamp(1.2rem, 4vw, 2rem);
    line-height: 1.6;
    color: rgb(var(--color-ink));
  }

  #entrada-content.is-reading-mode hr {
    border: none;
    text-align: center;
    opacity: 0.5;
  }

  #entrada-content.is-reading-mode hr::before {
    content: '✦  ✦  ✦';
    color: rgb(var(--color-accent));
    letter-spacing: 0.5em;
    font-size: 0.75rem;
  }

  #entrada-content.is-reading-mode img {
    display: block;
    max-height: 60vh;
    max-width: 100%;
    margin-inline: auto;
    object-fit: contain;
  }
</style>
