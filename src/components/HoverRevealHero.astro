---
import { splitNumeroTitle } from '../lib/text';
import EstampillaFace from './ui/EstampillaFace.astro';

/**
 * Hero de "Último número" — título, descripción y link, con una estampilla 3D (CSS + GSAP, sin isla de React) que gira y flota
 * al lado del título, no de fondo. (Versión anterior con partículas: HoverRevealHero.particulas.astro.bak.)
 * Sin portada (se sacó a propósito) y sin ningún comportamiento de hover/tap (esa
 * mecánica interfería con el click en el botón "Ver número completo").
 *
 * Tokens del design system Riptype-dark (canvas/ink/accent), font-headline = Lekton en
 * mixed-case, bold real.
 */
interface Props {
  titulo: string;
  descripcion?: string;
  href?: string;
  /** Portada del número: es la cara de la estampilla. Sin ella queda la ilustración
      genérica de /images/home/, que es la que había antes de que los números tuvieran
      tapa propia. */
  portada?: string;
}

const { titulo, descripcion, href, portada } = Astro.props;
const caraEstampilla = portada ?? '/images/home/estampilla.webp';
const { titulo: tituloPrincipal, subtitulo } = splitNumeroTitle(titulo);
---

<section class="relative mb-16 w-full mt-10 px-4 py-4 sm:mt-14 sm:py-6 md:mt-16 md:mb-32 lg:mt-20 lg:mb-40">
  <div class="mx-auto flex max-w-none flex-col items-center gap-3 text-center">
    <div
      class="stamp-scene shrink-0 justify-self-center"
      data-stamp-scene
      aria-hidden="true"
    >
      <div class="stamp" data-stamp>
        <EstampillaFace class="stamp-face stamp-front">
          <img src={caraEstampilla} alt="" draggable="false" />
        </EstampillaFace>
        <EstampillaFace class="stamp-face stamp-back">
          <img src={caraEstampilla} alt="" draggable="false" />
        </EstampillaFace>
      </div>
    </div>

    <div class="flex w-full min-w-0 flex-col items-center text-center">
      <h1
        class="max-w-full font-headline leading-[0.85] tracking-tight text-ink text-[7.5vw] md:text-[min(7vw,7rem)] lg:text-[min(6.5vw,8.5rem)]"
      >
        {tituloPrincipal}
      </h1>

      {
        subtitulo && (
          <p class="mt-2 max-w-full font-serif italic leading-tight text-ink/70 text-[3.8vw] md:text-[min(3vw,2.75rem)] lg:text-[min(2.6vw,3.25rem)]">
            {subtitulo}
          </p>
        )
      }

      {
        descripcion && (
          <p class="mt-6 max-w-2xl font-serif text-base italic text-ink/70 md:text-xl">
            {descripcion}
          </p>
        )
      }
    </div>

    {
      href && (
        <a
          href={href}
          class="mt-5 inline-block rounded-full border border-ink px-4 py-2.5 font-mono text-[0.65rem] sm:px-6 sm:py-3 sm:text-xs uppercase tracking-widest text-ink transition-colors hover:bg-ink hover:text-canvas md:px-8 md:py-4 md:text-sm"
        >
          Ver número completo
        </a>
      )
    }
  </div>
</section>

<style>
  .stamp-scene {
    /* La estampilla es enorme a propósito: su mitad superior ocupa el alto visible
       disponible al cargar, y hay que bajar con scroll para ver el resto + la info del
       número. Altura en vh/vw (nunca en px fijos) para que la proporción 300/460 se
       mantenga en todos los dispositivos sin recortarse por ancho. */
    height: min(85vh, 130vw, 760px);
    aspect-ratio: 300 / 460;
    perspective: 1200px;
    /* Solo el scroll vertical pasa al navegador; el giro horizontal lo captura Observer. */
    touch-action: pan-y;
    cursor: grab;
  }
  .stamp-scene:active {
    cursor: grabbing;
  }
  .stamp {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
  }
  /* .stamp-face/.stamp-front/.stamp-back en realidad renderizan como el <div> que
     devuelve EstampillaFace.astro (perforado + viñeta viven ahí ahora), no un elemento
     propio de este archivo — un <style> de Astro solo alcanza elementos que el propio
     archivo renderiza directamente, así que estas reglas de posición/fondo/flip van
     envueltas en :global() para poder pisar ese <div> de todos modos. */
  :global(.stamp-face) {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
  }
  :global(.stamp-front) {
    background-color: #fff;
    overflow: hidden;
  }
  :global(.stamp-front img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
    user-select: none;
  }
  :global(.stamp-back) {
    transform: rotateY(180deg);
    background-color: #fff;
    overflow: hidden;
  }
  :global(.stamp-back img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
    user-select: none;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { Observer } from 'gsap/Observer';

  gsap.registerPlugin(Observer);

  /* Estampilla 3D junto al título (adaptada de estampilla home.htm): giro automático
     + flotación, y giro manual por arrastre HORIZONTAL solamente. El mockup capturaba
     pointer events en todo el documento con touch-action:none y arrastre en ambos
     ejes; aquí el gesto queda acotado a la estampilla y el scroll vertical del
     celular pasa de largo (ver "Mobile vs. desktop" en CLAUDE.md). */
  const scene = document.querySelector<HTMLElement>('[data-stamp-scene]');
  const stamp = scene?.querySelector<HTMLElement>('[data-stamp]');

  if (scene && stamp) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let idle: gsap.core.Tween | null = null;
    let float: gsap.core.Tween | null = null;
    let resume: gsap.core.Tween | null = null;
    let visible = true;

    const startIdle = () => {
      idle?.kill();
      const from = (gsap.getProperty(stamp, 'rotationY') as number) % 360;
      gsap.set(stamp, { rotationY: from });
      idle = gsap.to(stamp, {
        rotationY: from + 360,
        duration: 15,
        repeat: -1,
        ease: 'none',
      });
      if (!visible) idle.pause();
    };

    if (!reduced) {
      startIdle();
      float = gsap.to(stamp, {
        y: -15,
        duration: 2.5,
        yoyo: true,
        repeat: -1,
        ease: 'sine.inOut',
      });

      // Sin trabajo continuo mientras la estampilla está fuera de pantalla.
      new IntersectionObserver(
        ([entry]) => {
          visible = entry.isIntersecting;
          for (const t of [idle, float]) visible ? t?.resume() : t?.pause();
        },
        { rootMargin: '200px' }
      ).observe(scene);
    }

    let target = 0;
    Observer.create({
      target: scene,
      type: 'touch,pointer',
      lockAxis: true,
      onPress: () => {
        resume?.kill();
        idle?.pause();
        target = gsap.getProperty(stamp, 'rotationY') as number;
      },
      onDrag: (self) => {
        if (self.axis === 'y') return;
        target += self.deltaX * 0.6;
        gsap.to(stamp, { rotationY: target, duration: 0.8, ease: 'power3.out', overwrite: 'auto' });
      },
      onRelease: () => {
        if (reduced) return;
        resume = gsap.delayedCall(2, startIdle);
      },
    });
  }
</script>
