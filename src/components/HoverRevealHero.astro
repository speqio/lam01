---
/**
 * Hero de "Último número" — solo título, descripción y link. Sin portada (se sacó a
 * propósito) y sin ningún comportamiento de hover/tap (esa mecánica interfería con el
 * click en el botón "Ver número completo").
 *
 * Tokens del design system Riptype-dark (canvas/ink/accent), font-headline = Lekton en
 * mixed-case, bold real.
 */
interface Props {
  titulo: string;
  descripcion?: string;
  href?: string;
}

const { titulo, descripcion, href } = Astro.props;
---

<section class="relative w-full px-4 py-4 text-center sm:py-6 md:mb-20">
  <h1
    class="mx-auto max-w-full font-headline leading-[0.85] tracking-tight text-ink text-[13vw] md:text-[9vw]"
  >
    {titulo}
  </h1>

  {
    descripcion && (
      <p class="mx-auto mt-8 max-w-2xl px-4 font-serif text-lg italic text-ink/70">
        {descripcion}
      </p>
    )
  }

  {
    href && (
      <a
        href={href}
        class="relative z-10 mt-8 inline-block rounded-full border border-accent px-6 py-3 font-mono text-xs uppercase tracking-widest text-accent transition-colors hover:bg-accent hover:text-canvas"
      >
        Ver número completo
      </a>
    )
  }
</section>
