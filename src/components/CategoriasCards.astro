---
import { normalizeTitleText } from '../lib/text';
import { dialWrap, dialCount, dialTrack, dialThumb } from '../lib/dialNav';

/**
 * Rueda de categorías: cards en perspectiva 3D que rotan alrededor de un pivote muy
 * por debajo de ellas mismas (adaptado de un demo de referencia con `perspective` +
 * `transform-style: preserve-3d`, en vez del abanico plano anterior), controlada con
 * el mismo criterio que el resto de los carruseles del sitio: rueda del mouse o
 * arrastre 1:1 mientras se sostiene, más un snap con inercia al soltar
 * (`gsap.quickTo`) — nada de temporizadores ni reordenar el DOM.
 *
 * Solo se muestran 3 cards a la vez (la activa + una a cada lado, ver
 * `data-wheel-faroff` en el script) para que la imagen se vea grande — el resto del
 * set sigue ahí (navegable con la rueda/el dial), simplemente oculto hasta que entra
 * en ese rango de ±1 posición.
 *
 * Cada card no lleva badge ni contador de entradas — solo la imagen fija de la
 * categoría. El nombre de la categoría enfocada se muestra aparte, en un título que
 * cambia con la rotación, sin texto de acompañamiento.
 */
export interface CategoriaCardItem {
  slug: string;
  nombre: string;
  coverImage?: string;
}

interface Props {
  categorias: CategoriaCardItem[];
}

const { categorias } = Astro.props;
---

{
  categorias.length > 0 && (
    <div class="categorias-wheel-outer">
      <div class="categorias-wheel-stage" id="categorias-wheel-stage">
        <div class="categorias-wheel-track" id="categorias-wheel-track">
          {categorias.map((categoria, index) => (
            <a
              href={`/categoria/${categoria.slug}`}
              class="categorias-wheel-card"
              data-index={index}
              data-nombre={normalizeTitleText(categoria.nombre)}
              aria-label={normalizeTitleText(categoria.nombre)}
            >
              {/* La escala de énfasis de la card activa vive en este wrapper interno,
                  con su propio transform-origin centrado — separado a propósito del
                  <a> exterior, que rota sobre el pivote lejano de la rueda. Si el
                  scale compartiera ese mismo origen lejano, agrandar la card activa
                  la empuja mucho más allá de lo esperado (la distancia al pivote se
                  multiplica por la escala), y esa era la causa real de que la parte
                  superior de la imagen se recortara contra el borde del escenario. */}
              <div class="categorias-wheel-card-inner">
                {categoria.coverImage && (
                  <img
                    src={categoria.coverImage}
                    alt=""
                    class="h-full w-full object-cover grayscale contrast-125"
                    loading="lazy"
                    draggable="false"
                  />
                )}
              </div>
            </a>
          ))}
        </div>

        {/* Difuminado en los bordes donde la rueda se corta contra el borde de la
            escena, igual criterio que el abanico anterior. */}
        <div class="categorias-wheel-fade categorias-wheel-fade--left" aria-hidden="true" />
        <div class="categorias-wheel-fade categorias-wheel-fade--right" aria-hidden="true" />
        <div class="categorias-wheel-fade-bottom" aria-hidden="true" />
      </div>

      <div class="categorias-wheel-info">
        <h3 class="categorias-wheel-title" id="categorias-wheel-title">
          {normalizeTitleText(categorias[0].nombre)}
        </h3>
      </div>

      {
        categorias.length > 1 && (
          <div class={`categorias-wheel-dial ${dialWrap}`}>
            <span class={dialCount} data-dial-count>
              {`01 / ${String(categorias.length).padStart(2, '0')}`}
            </span>
            <div class={`${dialTrack} categorias-wheel-dial-track`} data-dial-track>
              <div class={dialThumb} data-dial-thumb />
            </div>
          </div>
        )
      }
    </div>
  )
}

<style>
  .categorias-wheel-stage {
    position: relative;
    width: 100%;
    height: 12rem;
    overflow: hidden;
    touch-action: pan-y;
    cursor: grab;
    perspective: 1400px;
  }

  .categorias-wheel-stage:active {
    cursor: grabbing;
  }

  .categorias-wheel-track {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    transform-style: preserve-3d;
  }

  .categorias-wheel-card {
    position: absolute;
    left: 0;
    top: 0;
    display: block;
    overflow: hidden;
    width: 11rem;
    /* Las ilustraciones de categoría son horizontales (1200×1000, con su propio marco
       tipo postal) — la proporción de la card sigue la de la imagen real (6:5) para
       que `object-fit: cover` no las recorte, a diferencia de las cards de
       entrada/número (verticales) que usan otra relación de aspecto. */
    aspect-ratio: 6 / 5;
    margin-left: -5.5rem;
    margin-top: -4.58rem;
    user-select: none;
    -webkit-user-drag: none;
    /* Sin fondo propio: las ilustraciones son PNG con transparencia real (confirmado
       — su canal alfa no está en 255 parejo) recortadas en un rectángulo apenas
       inclinado sobre el lienzo 1200×1000. Un fondo sólido acá se veía como un
       bloque de color detrás de esa transparencia en vez de dejar que se funda con
       el canvas de la página. */
    background: transparent;
    /* El pivote de rotación está muy por debajo de la card, dando el efecto de rueda
       (mismo truco que el abanico anterior, ahora sumado a `perspective` en el
       contenedor para que las cards de los costados se vean giradas en el espacio). */
    transform-origin: 50% 480%;
  }

  .categorias-wheel-card-inner {
    width: 100%;
    height: 100%;
    /* transform-origin centrado (default) a propósito: acá vive el scale de énfasis
       de la card activa, separado del rotate() del <a> exterior — ver comentario en
       el markup. */
  }

  .categorias-wheel-card[data-wheel-hidden] {
    display: none;
  }

  .categorias-wheel-fade {
    position: absolute;
    top: 0;
    width: 22%;
    height: 100%;
    pointer-events: none;
    z-index: 5;
  }

  .categorias-wheel-fade--left {
    left: 0;
    background: linear-gradient(to right, rgb(var(--color-canvas)), transparent);
  }

  .categorias-wheel-fade--right {
    right: 0;
    background: linear-gradient(to left, rgb(var(--color-canvas)), transparent);
  }

  /* Igual criterio que left/right pero en el borde inferior de la escena, donde las
     cards rotadas se cortan contra `overflow: hidden` — sin esto el corte se ve
     como un borde recto y duro en vez de fundirse con el fondo de la página. */
  .categorias-wheel-fade-bottom {
    position: absolute;
    inset: auto 0 0 0;
    height: 35%;
    pointer-events: none;
    z-index: 5;
    background: linear-gradient(to bottom, transparent, rgb(var(--color-canvas)) 90%);
  }

  .categorias-wheel-info {
    margin-top: 1.25rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    text-align: center;
  }

  .categorias-wheel-title {
    font-family: var(--font-headline, 'Lekton', 'Arial', sans-serif);
    font-weight: 400;
    font-size: 1.05rem;
    line-height: 1.1;
    color: rgb(var(--color-ink));
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .categorias-wheel-dial {
    width: min(70%, 16rem);
    margin: 1.5rem auto 0;
    /* El área de arrastre real es toda la fila (ver JS: se escucha en este
       elemento, no solo en la barra de 3px) — así el hit target no queda
       limitado al alto visual de la barra, como un slider nativo. */
    cursor: grab;
    touch-action: pan-y;
  }

  .categorias-wheel-dial:active {
    cursor: grabbing;
  }

  @media (min-width: 768px) {
    .categorias-wheel-stage {
      height: 26rem;
    }

    .categorias-wheel-card {
      width: 24rem;
      margin-left: -12rem;
      margin-top: -10rem;
    }

    .categorias-wheel-title {
      font-size: 1.35rem;
    }
  }

  @media (min-width: 1024px) {
    .categorias-wheel-stage {
      height: 32.5rem;
    }

    .categorias-wheel-card {
      width: 30rem;
      margin-left: -15rem;
      margin-top: -12.5rem;
    }

    .categorias-wheel-title {
      font-size: 1.5rem;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { Observer } from 'gsap/Observer';

  gsap.registerPlugin(Observer);

  // Ángulo entre cards contiguas — más abierto que la versión de 5 cards visibles,
  // ya que ahora solo hay 3 en pantalla (ver FAR_OFF_DISTANCE) y conviene que las dos
  // laterales se noten claramente giradas, no apenas asomando.
  const ANGLE_STEP_MOBILE = 16;
  const ANGLE_STEP_DESKTOP = 18;
  const DRAG_SENSITIVITY = 0.014;

  // Más allá de esta distancia (en posiciones) del centro, la card se oculta del
  // todo — así siempre se ven como máximo 3 (activa + una a cada lado), sin importar
  // cuántas categorías tenga el set completo (que sigue siendo navegable con
  // rueda/drag/dial, solo que el resto queda fuera de vista hasta que le toca entrar).
  const FAR_OFF_DISTANCE = 1.5;

  // Sin wraparound a propósito: de la última categoría no se pasa a la primera ni al
  // revés — `pos.value` queda acotado a [0, total-1] en cada handler de abajo, así que
  // la distancia es simplemente lineal (no un módulo circular).
  function distance(index: number, position: number) {
    return index - position;
  }

  function initCategoriasWheel() {
    const stage = document.getElementById('categorias-wheel-stage');
    const track = document.getElementById('categorias-wheel-track');
    if (!(stage instanceof HTMLElement) || !(track instanceof HTMLElement)) return;

    const cards = Array.from(track.querySelectorAll<HTMLAnchorElement>('.categorias-wheel-card'));
    const isMobile = !window.matchMedia('(min-width: 768px)').matches;
    const ANGLE_STEP = isMobile ? ANGLE_STEP_MOBILE : ANGLE_STEP_DESKTOP;

    const total = cards.length;
    if (total === 0) return;

    const outer = stage.closest('.categorias-wheel-outer');
    const titleEl = outer?.querySelector<HTMLElement>('#categorias-wheel-title') ?? null;
    const thumb = outer?.querySelector<HTMLElement>('[data-dial-thumb]') ?? null;
    const countEl = outer?.querySelector<HTMLElement>('[data-dial-count]') ?? null;
    const dialTrackEl = thumb?.parentElement ?? null;
    const dialRow = outer?.querySelector<HTMLElement>('.categorias-wheel-dial') ?? null;
    if (thumb && dialTrackEl) {
      thumb.style.width = `${100 / total}%`;
    }

    const pos = { value: 0 };
    let lastActiveIndex = 0;

    function render() {
      cards.forEach((card, i) => {
        const dist = distance(i, pos.value);
        const absDist = Math.abs(dist);
        const isActive = absDist < 0.5;
        // Fundido suave entre "totalmente visible" (a 1 posición del centro) y
        // "oculta" (a partir de FAR_OFF_DISTANCE), en vez de un corte abrupto.
        const visibility = absDist <= 1 ? 1 : gsap.utils.clamp(0, 1, 1 - (absDist - 1) / (FAR_OFF_DISTANCE - 1));

        gsap.set(card, {
          rotate: gsap.utils.clamp(-90, 90, dist * ANGLE_STEP),
          zIndex: Math.round(100 - absDist * 10),
          opacity: visibility,
          pointerEvents: visibility > 0.5 ? 'auto' : 'none',
        });

        gsap.set(card.firstElementChild, {
          scale: isActive ? 1.08 : 1,
          filter: `brightness(${isActive ? 1 : Math.max(0.35, 1 - absDist * 0.22)})`,
        });
      });

      const activeIndex = gsap.utils.clamp(0, total - 1, Math.round(pos.value));
      if (titleEl && activeIndex !== lastActiveIndex) {
        lastActiveIndex = activeIndex;
        titleEl.textContent = cards[activeIndex].dataset.nombre ?? '';
      } else if (titleEl && !titleEl.textContent) {
        titleEl.textContent = cards[activeIndex].dataset.nombre ?? '';
      }

      if (thumb && dialTrackEl && countEl) {
        // total-1 (no total): el thumb ocupa 1/total del track, así que su posición
        // debe ir de 0 a (trackWidth - thumbWidth) interpolando sobre los "total-1"
        // pasos entre el primer y el último ítem — con `total` en el divisor nunca
        // llegaba al extremo derecho en el último ítem, dejando un espacio vacío.
        const ratio = total > 1 ? activeIndex / (total - 1) : 0;
        const trackWidth = dialTrackEl.clientWidth;
        const thumbWidth = trackWidth / total;
        gsap.to(thumb, { x: ratio * (trackWidth - thumbWidth), duration: 0.2, ease: 'power2.out', overwrite: true });
        countEl.textContent = `${String(activeIndex + 1).padStart(2, '0')} / ${String(total).padStart(2, '0')}`;
      }
    }

    const snapTo = gsap.quickTo(pos, 'value', {
      duration: 0.55,
      ease: 'power3.out',
      onUpdate: render,
    });

    render();

    // Arrastrar sobre la barra de paginación mueve el carrusel 1:1, igual que la
    // rueda/el drag sobre las cards — la posición del puntero dentro del track
    // (no un delta) define directamente `pos.value`, ya que acá lo natural es
    // "ir a donde toqué", no "empujar una cantidad relativa".
    let dialDragging = false;

    function posFromPointer(clientX: number) {
      if (!dialTrackEl) return null;
      const rect = dialTrackEl.getBoundingClientRect();
      const ratio = gsap.utils.clamp(0, 1, (clientX - rect.left) / rect.width);
      // total-1, coherente con cómo se posiciona el thumb en render(): el extremo
      // izquierdo del track es el ítem 0, el extremo derecho es el último.
      return gsap.utils.clamp(0, total - 1, ratio * (total - 1));
    }

    function endDialDrag() {
      if (!dialDragging) return;
      dialDragging = false;
      snapTo(gsap.utils.clamp(0, total - 1, Math.round(pos.value)));
    }

    dialRow?.addEventListener('pointerdown', (e) => {
      const target = posFromPointer(e.clientX);
      if (target === null) return;
      gsap.killTweensOf(pos);
      dialDragging = true;
      dialRow.setPointerCapture(e.pointerId);
      pos.value = target;
      render();
    });

    dialRow?.addEventListener('pointermove', (e) => {
      if (!dialDragging) return;
      const target = posFromPointer(e.clientX);
      if (target === null) return;
      pos.value = target;
      render();
    });

    dialRow?.addEventListener('pointerup', endDialDrag);
    dialRow?.addEventListener('pointercancel', endDialDrag);

    // "Lockeo" categoría a categoría: a diferencia de otros carruseles del sitio
    // (que arrastran 1:1 y pueden recorrer varios ítems en un solo gesto), acá cada
    // gesto de rueda o de arrastre avanza como máximo UNA posición y queda pineada
    // ahí hasta el próximo gesto — evita que un scroll/drag grande "se pase" de
    // varias categorías de un salto (la fuente de los bugs de movimiento/interacción
    // que se pedía evitar).
    let wheelLocked = false;
    let wheelLockTimeout: ReturnType<typeof setTimeout> | undefined;

    function stepBy(dir: number) {
      const from = gsap.utils.clamp(0, total - 1, Math.round(pos.value));
      const target = gsap.utils.clamp(0, total - 1, from + dir);
      if (target === from) return; // ya en el límite: no hay nada que animar
      wheelLocked = true;
      clearTimeout(wheelLockTimeout);
      snapTo(target);
      wheelLockTimeout = setTimeout(() => {
        wheelLocked = false;
      }, 600);
    }

    Observer.create({
      target: stage,
      type: 'wheel',
      preventDefault: true,
      onChangeY: (self) => {
        if (wheelLocked) return;
        stepBy(self.deltaY > 0 ? 1 : -1);
      },
    });

    let dragStartIndex = 0;

    Observer.create({
      target: stage,
      type: 'touch,pointer',
      preventDefault: true,
      onPress: () => {
        gsap.killTweensOf(pos);
        dragStartIndex = gsap.utils.clamp(0, total - 1, Math.round(pos.value));
      },
      onChange: (self) => {
        // Vista previa continua mientras se sostiene el gesto, pero sin pasar nunca
        // de la categoría siguiente/anterior a la de inicio — el resto del arrastre
        // más allá de eso no mueve nada más.
        const preview = dragStartIndex - (self.x - self.startX) * DRAG_SENSITIVITY;
        pos.value = gsap.utils.clamp(
          Math.max(0, dragStartIndex - 1),
          Math.min(total - 1, dragStartIndex + 1),
          preview
        );
        render();
      },
      onRelease: () => {
        const ADVANCE_THRESHOLD = 0.35; // fracción de un paso para confirmar el avance
        const delta = pos.value - dragStartIndex;
        let target = dragStartIndex;
        if (delta > ADVANCE_THRESHOLD) target = dragStartIndex + 1;
        else if (delta < -ADVANCE_THRESHOLD) target = dragStartIndex - 1;
        snapTo(gsap.utils.clamp(0, total - 1, target));
      },
    });
  }

  const stage = document.getElementById('categorias-wheel-stage');
  if (stage && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          initCategoriasWheel();
          observer.disconnect();
        }
      },
      { rootMargin: '200px' }
    );
    observer.observe(stage);
  } else {
    initCategoriasWheel();
  }
</script>
