---
/**
 * Caja de imagen compartida por EntradaImagen.astro y EntradaGaleria.astro: mockup de
 * "foto antigua" (filtro envejecido con viñeta, sombra suave) sobre una caja de proporción
 * fija (3:4 vertical, 4:3 horizontal) con `object-cover`.
 *
 * Sin marco de papel (se probó con `border-image` sobre
 * public/images/mockups/papel-foto-marco.png, pero a este grosor de borde se veía como un
 * borde blanco recto, no como papel desgastado — se sacó). Si se retoma el marco, hay que
 * resolver antes por qué no se distingue la textura a este tamaño.
 *
 * El filtro de envejecido (grayscale + sepia + contraste) sigue aplicado a la foto.
 *
 * La orientación/maxAncho vienen de `integrations/portadas.mjs` vía `datosImagen()`
 * (src/lib/portada.ts) — mismo mecanismo que la estampilla de portada (EntradaBanner.astro).
 */
interface Props {
  imagen: string;
  alt: string;
  orientacion: 'vertical' | 'horizontal';
  /** En px. `null` cuando no se pudo medir: entonces manda el tope del diseño. */
  maxAncho: number | null;
  class?: string;
  /** 'eager' para la primera imagen visible de una tira (EntradaGaleria.astro); el resto, 'lazy'. */
  loading?: 'eager' | 'lazy';
}

const { imagen, alt, orientacion, maxAncho, class: claseExtra, loading = 'lazy' } = Astro.props;
const esHorizontal = orientacion === 'horizontal';
---

<div
  class:list={[
    'foto-antigua',
    esHorizontal ? 'foto-antigua--horizontal' : 'foto-antigua--vertical',
    claseExtra,
  ]}
  style={maxAncho ? `--imagen-max: ${maxAncho}px` : undefined}
>
  <div class:list={['foto-antigua-marco', esHorizontal ? 'aspect-[4/3]' : 'aspect-[3/4]']}>
    <img src={imagen} alt={alt} loading={loading} decoding="async" class="h-full w-full object-cover" />
    <span class="foto-antigua-vineta pointer-events-none absolute inset-0" aria-hidden="true"></span>
  </div>
</div>

<style>
  /* Mismo esquema de topes que EntradaBanner.astro: el menor entre el ancho de columna y el
     tamaño real de la imagen (`--imagen-max`), para no agrandar una foto chica. */
  .foto-antigua--vertical {
    width: min(78vw, 360px, var(--imagen-max, 100vw));
  }

  .foto-antigua--horizontal {
    width: min(92vw, 560px, var(--imagen-max, 100vw));
  }

  @media (min-width: 768px) {
    .foto-antigua--vertical {
      width: min(420px, var(--imagen-max, 100vw));
    }

    .foto-antigua--horizontal {
      width: min(640px, var(--imagen-max, 100vw));
    }
  }

  .foto-antigua {
    box-sizing: border-box;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.15);
  }

  .foto-antigua-marco {
    position: relative;
    overflow: hidden;
  }

  .foto-antigua-marco img {
    /* Look envejecido: desatura, sube el contraste y tiñe levemente a sepia. */
    filter: grayscale(0.85) sepia(0.2) contrast(1.08) brightness(0.98);
  }

  /* Viñeta interior, mismo recurso que .entrada-estampilla-vineta en EntradaBanner.astro. */
  .foto-antigua-vineta {
    box-shadow: inset 0 0 22px rgba(0, 0, 0, 0.45);
  }
</style>
