---
import SearchModal from './ui/SearchModal.tsx';
import ThemeToggle from './ThemeToggle.astro';
import { navItems, navItemActivo } from '../data/navItems';

const currentPath = Astro.url.pathname;
---

<nav
  class="nav-flotante fixed inset-x-4 bottom-4 z-30 flex items-stretch justify-between rounded-2xl border border-ink/15 bg-surface/95 px-1 py-1 backdrop-blur-sm md:hidden"
  aria-label="Navegación móvil"
  data-nav-flotante
>
  {
    navItems.map((item) => {
      const isActive = navItemActivo(item, currentPath);
      return (
        <a
          href={item.url}
          class:list={[
            'flex flex-1 flex-col items-center gap-0.5 px-2 py-1.5 font-mono text-[9px] uppercase tracking-wide transition-colors',
            isActive ? 'text-accent' : 'text-ink-muted',
          ]}
          aria-current={isActive ? 'page' : undefined}
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d={item.icon} />
          </svg>
          <span class="nav-etiqueta">{item.name}</span>
        </a>
      );
    })
  }

  <SearchModal client:load variant="compact" />
  <div class="flex items-center px-1">
    <ThemeToggle class="h-8 w-8 border-ink/15" />
  </div>
</nav>

<style>
  /*
   * SE CONTRAE MIENTRAS SE BAJA Y SE ABRE CUANDO EL SCROLL SE DETIENE. Lo que se esconde
   * son las ETIQUETAS, no la barra entera: los iconos quedan siempre a mano, asi que la
   * navegacion nunca deja de estar disponible --es la unica que hay en mobile-- y lo que
   * se recupera es alto de pantalla mientras se lee.
   *
   * Se anima `max-height` y no `display`, que no transiciona; `overflow: hidden` en la
   * etiqueta es lo que recorta mientras se cierra.
   */
  /* `:global` en la etiqueta porque una de ellas vive en el island de React del buscador
     (SearchModal.tsx), fuera del alcance del estilo acotado de este componente: sin esto,
     "Buscar" se quedaba sola al contraerse la barra. El contenedor sigue acotado, asi que
     la regla no se escapa de esta barra. */
  .nav-flotante :global(.nav-etiqueta) {
    display: block;
    max-height: 1.2em;
    /* Tambien el ANCHO, no solo el alto: recortada solo a lo alto la palabra sigue
       ocupando su ancho --invisible pero midiendo--, y la barra no podia bajar de 356 px
       porque "CATEGORIAS" seguia reservando su lugar. */
    max-width: 8rem;
    overflow: hidden;
    white-space: nowrap;
    opacity: 1;
    transition:
      max-height 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      max-width 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.35s ease-out;
  }
  .nav-flotante[data-contraida='true'] :global(.nav-etiqueta) {
    max-height: 0;
    max-width: 0;
    opacity: 0;
  }

  /* Tambien se angosta, no solo se achata. Se anima `max-width` y no el ancho ni
     `fit-content`: el ancho abierto depende de la pantalla y `fit-content` no interpola
     en los navegadores de hoy, asi que no habria transicion. `margin-inline: auto` es lo
     que la mantiene centrada mientras encoge; sin eso se cerraria contra el borde
     izquierdo. */
  .nav-flotante {
    margin-inline: auto;
    max-width: 100%;
    transition:
      max-width 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      padding 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .nav-flotante[data-contraida='true'] {
    /* Lo que miden los seis iconos con su aire: por debajo empiezan a amontonarse. */
    max-width: 15rem;
    padding-top: 0.125rem;
    padding-bottom: 0.125rem;
  }

  /* Con el movimiento desactivado el cambio sigue pasando, pero sin animarlo: la barra
     se contrae igual, de una. */
  @media (prefers-reduced-motion: reduce) {
    .nav-flotante,
    .nav-flotante :global(.nav-etiqueta) {
      transition: none;
    }
  }
</style>

<script>
  /*
   * Contraer mientras hay movimiento (subiendo o bajando), abrir al detenerse. Dos
   * reglas y nada mas:
   *  - cualquier scroll, en cualquier direccion, la contrae;
   *  - cuando el scroll deja de llegar por 180 ms, se abre, tambien subiendo: a
   *    diferencia de la version anterior, abrirla a mitad de un gesto hacia arriba
   *    debajo del pulgar ya no es un problema porque solo se abre al soltar/detenerse,
   *    nunca a mitad de gesto.
   *
   * El listener es pasivo y solo escribe un atributo: no mide nada en el handler (leer
   * scrollY ya obliga al navegador a calcular posicion, y hacerlo por frame es el
   * clasico atascadero del scroll en mobile), y el trabajo real lo hace CSS.
   */
  const barra = document.querySelector<HTMLElement>('[data-nav-flotante]');

  if (barra) {
    let ultimaY = window.scrollY;
    let quieta: number | undefined;

    window.addEventListener(
      'scroll',
      () => {
        const y = window.scrollY;
        // El umbral evita que el rebote de iOS (unos pocos pixeles) la cierre sola.
        if (Math.abs(y - ultimaY) > 4) barra.dataset.contraida = 'true';
        ultimaY = y;

        window.clearTimeout(quieta);
        quieta = window.setTimeout(() => {
          barra.dataset.contraida = 'false';
        }, 180);
      },
      { passive: true }
    );
  }
</script>
