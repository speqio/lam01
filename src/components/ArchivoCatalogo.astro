---
import EntradaTicket from './ui/EntradaTicket.astro';
import ColeccionEstampillas from './ui/ColeccionEstampillas.astro';
import OrbitaEstampillas from './ui/OrbitaEstampillas.astro';
import { cardBadge } from '../lib/cardStyles';
import { formatearTitulo, normalizeTitleText } from '../lib/text';

/**
 * Catálogo completo del archivo, con filtros — único componente de /archivo.astro
 * (antes convivía debajo de la hélice/cascada 3D, que se sacaron para simplificar la
 * página a solo esto).
 *
 * Sin h2 propio a propósito: la página ya tiene su h1 ("Archivo"), así que acá va solo
 * una etiqueta de sección ("Todas las entradas"), no otro encabezado que repita
 * jerarquía con el h1.
 *
 * Los filtros de año/categoría/número son un dropdown propio (botón + lista
 * absolutamente posicionada, ambos con nuestras clases), NO un <select> nativo — se
 * probó primero con <select> pero el popup de opciones lo dibuja el navegador con su
 * propio widget de sistema operativo, y ni `color-scheme` ni el color de cada <option>
 * lo garantizan de forma confiable en todos los navegadores (falló específicamente en
 * Chrome/Windows, que ignoró el tema oscuro/claro del sitio). Reemplazarlo por un menú
 * propio (mismo patrón que cualquier otro popover del sitio) es la única forma de
 * asegurar que los colores coincidan siempre con el design system.
 *
 * El buscador de autor es un <input> con lista de sugerencias propia (combobox): solo
 * muestra coincidencias mientras se escribe (máximo 6, sin distinguir tildes ni mayúsculas),
 * en vez del <datalist> nativo, que despliega todos los autores. Escala con la cantidad de
 * autores sin alargar la página.
 *
 * Reusa EntradaTicket.astro (misma card tipo "boleto" que /categoria y el home) en vez
 * de reinventar el layout, y el mismo mecanismo de filtro por atributos +
 * classList.toggle('hidden', ...) que ya usa /numeros.astro para sus chips de rango —
 * acá extendido a año/categoría/número (dropdown propio, coincidencia exacta) más
 * autor (texto libre, coincidencia parcial sobre el nombre). Sin fetch, sin reordenar
 * el DOM, sin GSAP (es un toggle de visibilidad, no una animación).
 */
export interface ArchivoCatalogoItem {
  slug: string;
  title: string;
  authorName: string;
  /** Nombre de quien tradujo la entrada, si corresponde. */
  translatorName?: string;
  categoryName: string;
  coverImage?: string;
  coverAlt?: string;
  anio: number;
  categoriaSlug: string;
  numeroSlug: string;
}

interface FiltroOpcion {
  slug: string;
  label: string;
  /**
   * La opción existe en el catálogo completo pero NO entre los items que esta página
   * renderiza — el caso del home, que muestra las 100 entradas más recientes. Antes esas
   * opciones simplemente no se listaban, y el filtro terminaba mintiendo sobre lo que
   * existe: en el home llegó a ofrecer 4 números de 29, y daba a entender que la revista
   * iba por el 26. Ahora se listan todas y elegir una de estas lleva a /archivo ya
   * filtrada, que es donde está el catálogo sin recortar.
   */
  fuera?: boolean;
}

interface Props {
  items: ArchivoCatalogoItem[];
  /** Años del catálogo. Misma forma que `categorias` y `numeros` para que los tres
      puedan marcar opciones `fuera` (ver FiltroOpcion). */
  anios: FiltroOpcion[];
  categorias: FiltroOpcion[];
  autorNombres: string[];
  numeros: FiltroOpcion[];
  /**
   * Cómo se muestran los resultados. `tickets` es la grilla de boletos de /archivo;
   * `estampillas` es la hoja de estampillas verticales que usa el home. El mecanismo de
   * filtrado es el mismo en las dos: los `data-*` por item y classList.toggle('hidden').
   * ColeccionEstampillas los cuelga de cada hueco con su prop `filtrable`.
   * `tunel` pone la órbita de estampillas (OrbitaEstampillas, escritorio y móvil) y
   * lee el resultado del filtro por el evento `catalogo:filtrado`. No renderiza boletos.
   */
  vista?: 'tickets' | 'estampillas' | 'tunel';
  /**
   * Qué controles de filtro se ofrecen. `dropdowns` es el juego completo
   * (año/categoría/número + buscador de autor) de /archivo y del home.
   * `chips-categoria` deja SOLO las categorías, como chips, para /categorias: esa
   * página existe para entrar por género, y los otros tres filtros ahí sobran.
   */
  controles?: 'dropdowns' | 'chips-categoria';
}

const {
  items,
  anios,
  categorias,
  autorNombres,
  numeros,
  vista = 'tickets',
  controles = 'dropdowns',
} = Astro.props;

const triggerClass =
  'archivo-catalogo-trigger inline-flex items-center gap-2 rounded-full border border-ink/20 bg-transparent px-5 py-2.5 font-mono text-xs lowercase tracking-widest text-ink-muted transition-colors hover:border-ink/40 aria-expanded:border-accent aria-expanded:text-ink focus:outline-none md:text-sm';

const inputClass =
  'archivo-catalogo-autor w-full md:w-auto rounded-full border border-ink/20 bg-transparent px-5 py-2.5 font-mono text-xs lowercase tracking-widest text-ink-muted placeholder:text-ink-muted/70 transition-colors hover:border-ink/40 focus:border-accent focus:outline-none md:text-sm';

const dropdowns: Array<{ key: string; label: string; ariaLabel: string; opciones: FiltroOpcion[] }> = [
  { key: 'anio', label: 'Año', ariaLabel: 'Filtrar por año', opciones: anios },
  { key: 'categoria', label: 'Categoría', ariaLabel: 'Filtrar por categoría', opciones: categorias },
  { key: 'numero', label: 'Número', ariaLabel: 'Filtrar por número', opciones: numeros },
];

/* Cada fila del menú es una opción o, solo en Número, la cabecera de un grupo de cinco
   números ("36–40") que despliega sus opciones. Sin grupos, el menú de Número crecía una
   fila por número. */
type FilaMenu =
  | { tipo: 'cabecera'; grupo: number; etiqueta: string }
  | { tipo: 'opcion'; opcion: FiltroOpcion; grupo?: number };

const TAMANO_GRUPO_NUMERO = 5;

function indiceDeNumero(slug: string) {
  const match = slug.match(/(\d+)/);
  return match ? parseInt(match[0], 10) : 0;
}

function filasDe(key: string, opciones: FiltroOpcion[]): FilaMenu[] {
  if (key !== 'numero') return opciones.map((opcion): FilaMenu => ({ tipo: 'opcion', opcion }));

  const grupos = new Map<number, FiltroOpcion[]>();
  for (const opcion of opciones) {
    const grupo = Math.max(0, Math.floor((indiceDeNumero(opcion.slug) - 1) / TAMANO_GRUPO_NUMERO));
    grupos.set(grupo, [...(grupos.get(grupo) ?? []), opcion]);
  }

  // Del grupo más nuevo al más viejo, y dentro de cada grupo también de más nuevo a más viejo.
  return [...grupos.keys()].sort((a, b) => b - a).flatMap((grupo): FilaMenu[] => {
    const desde = grupo * TAMANO_GRUPO_NUMERO + 1;
    const cabecera: FilaMenu = {
      tipo: 'cabecera',
      grupo,
      etiqueta: `${desde}–${desde + TAMANO_GRUPO_NUMERO - 1}`,
    };
    const delGrupo = (grupos.get(grupo) ?? []).sort(
      (a, b) => indiceDeNumero(b.slug) - indiceDeNumero(a.slug)
    );
    return [cabecera, ...delGrupo.map((opcion): FilaMenu => ({ tipo: 'opcion', opcion, grupo }))];
  });
}
---

{
  items.length > 0 && (
    <div class="archivo-catalogo mt-12 md:mt-16">
      {controles === 'chips-categoria' ? (
        /* /categorias: un solo buscador de categorías. El placeholder no es un atributo sino
           una instancia del anagrama del header (HeroAnagram, vía data-anagrama) puesta
           encima del campo; el contenedor recorta las letras que vuelan al reordenarse. */
        <div class="archivo-catalogo-filtros relative z-10 mb-10 flex justify-center" role="search">
          <div class="relative w-64 overflow-hidden rounded-full md:w-72">
            <input
              type="search"
              class={`${inputClass.replace('md:w-auto', 'md:w-full').replace('border-ink/20', 'border-ink/40').replace('hover:border-ink/40', 'hover:border-ink/70')} peer cursor-text pl-11`}
              data-buscador-categoria
              aria-label="Buscar por categoría"
              autocomplete="off"
            />
            <svg
              class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-ink-muted transition-colors peer-focus:text-accent"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="11" cy="11" r="7"></circle>
              <path d="M20 20l-3.5-3.5"></path>
            </svg>
            <div
              class="pointer-events-none absolute inset-y-0 left-11 right-5 flex items-center"
              data-buscador-placeholder
              aria-hidden="true"
            >
              <span
                class="hero-anagram-title relative block min-h-[1.25rem] w-full whitespace-nowrap text-left font-mono text-xs leading-none lowercase tracking-widest text-ink-muted md:text-sm"
                data-anagrama={JSON.stringify([
                  'lee más',
                  ...categorias
                    .filter((categoria) => categoria.slug !== 'sin-categoria')
                    .map((categoria) => categoria.label.toLowerCase()),
                ])}
              />
            </div>
          </div>
        </div>
      ) : (
      <div
        class={`archivo-catalogo-filtros relative z-10 flex flex-wrap justify-center gap-3 md:justify-start ${vista === 'tunel' ? 'mb-2 md:mb-10' : 'mb-10'}`}
        role="group"
        aria-label="Filtrar el archivo"
      >
        {dropdowns.map((dropdown) => (
          <div
            class="archivo-catalogo-dropdown relative"
            data-dropdown={dropdown.key}
            data-value="all"
            data-agrupado={dropdown.key === 'numero' ? 'true' : undefined}
          >
            <button
              type="button"
              class={triggerClass}
              data-dropdown-trigger
              aria-haspopup="listbox"
              aria-expanded="false"
            >
              <span data-dropdown-label>{dropdown.label}</span>
              <svg
                class="archivo-catalogo-chevron"
                width="10"
                height="10"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M6 9l6 6 6-6" />
              </svg>
            </button>
            <div class="archivo-catalogo-dropdown-menu" hidden>
              <input
                type="search"
                class="archivo-catalogo-dropdown-buscar"
                data-dropdown-buscar
                placeholder={dropdown.label.toLowerCase()}
                aria-label={`Buscar ${dropdown.label.toLowerCase()}`}
                autocomplete="off"
              />
              <ul role="listbox" aria-label={dropdown.ariaLabel}>
              {filasDe(dropdown.key, dropdown.opciones).map((fila) =>
                fila.tipo === 'cabecera' ? (
                  <li role="presentation">
                    <button
                      type="button"
                      class="archivo-catalogo-dropdown-grupo"
                      data-grupo-cabecera={fila.grupo}
                      aria-expanded="false"
                    >
                      {fila.etiqueta}
                    </button>
                  </li>
                ) : (
                  <li role="presentation">
                    <button
                      type="button"
                      role="option"
                      aria-selected="false"
                      data-value={fila.opcion.slug}
                      data-fuera={fila.opcion.fuera ? 'true' : undefined}
                      data-grupo={fila.grupo}
                      class="archivo-catalogo-dropdown-option"
                    >
                      {fila.opcion.label}
                    </button>
                  </li>
                )
              )}
              </ul>
              <p class="archivo-catalogo-dropdown-pista" data-dropdown-pista hidden>
                Escribe para ver más opciones
              </p>
            </div>
          </div>
        ))}

        <div class="relative order-first w-56 md:order-none md:w-auto" data-autor-combo data-autores={JSON.stringify(autorNombres)}>
          <input
            type="search"
            id="archivo-filtro-autor"
            name="archivo-filtro-autor"
            class={inputClass}
            data-filtro-autor
            placeholder="Autoría"
            aria-label="Buscar por autor"
            autocomplete="off"
            role="combobox"
            aria-expanded="false"
            aria-controls="archivo-autor-sugerencias"
            aria-autocomplete="list"
          />
          <ul
            id="archivo-autor-sugerencias"
            class="archivo-catalogo-dropdown-menu"
            role="listbox"
            aria-label="Sugerencias de autor"
            data-autor-sugerencias
            hidden
          />
        </div>
      </div>
      )}

      {vista === 'estampillas' ? (
        <ColeccionEstampillas
          disposicion="grilla"
          filtrable
          items={items.map((item) => ({
            title: normalizeTitleText(item.title),
            authorName: item.authorName,
            translatorName: item.translatorName,
            categoryName: item.categoryName,
            slug: item.slug,
            coverImage: item.coverImage,
            coverAlt: item.coverAlt,
            anio: item.anio,
            categoriaSlug: item.categoriaSlug,
            numeroSlug: item.numeroSlug,
          }))}
        />
      ) : (
      <>
      {vista === 'tunel' && (
        <>
          {/* Datos de cada entrada para el túnel (desktop) y la órbita (móvil): nunca se ven. La
              clase `hidden` de cada uno la alterna aplicarFiltros(); ellos leen el resultado. */}
          <div hidden aria-hidden="true">
            {items.map((item) => (
              <div
                data-catalogo-item
                data-tunel-dato
                data-anio={item.anio}
                data-categoria={item.categoriaSlug}
                data-autor-nombre={item.authorName.toLocaleLowerCase('es')}
                data-numero={item.numeroSlug}
                data-slug={item.slug}
                data-src={item.coverImage ?? ''}
                data-alt={item.coverAlt ?? ''}
                data-titulo={item.title}
              >
                <template>
                  {item.categoryName && <span class="ficha-categoria">{item.categoryName}</span>}
                  <h3 class="ficha-titulo" set:html={formatearTitulo(item.title).html} />
                  {item.authorName && <p class="ficha-autor">Por {item.authorName}</p>}
                  {item.translatorName && <p class="ficha-autor">Traducción de {item.translatorName}</p>}
                  <a class={`${cardBadge} ficha-entrar`} href={`/${item.slug}`}>
                    Entrar al texto
                  </a>
                </template>
              </div>
            ))}
          </div>
          <OrbitaEstampillas />
        </>
      )}
      {vista !== 'tunel' && (
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3" data-catalogo-grid>
        {items.map((item) => (
          <div
            class="h-56 lg:h-64"
            data-catalogo-item
            data-anio={item.anio}
            data-categoria={item.categoriaSlug}
            data-autor-nombre={item.authorName.toLocaleLowerCase('es')}
            data-numero={item.numeroSlug}
          >
            <EntradaTicket
              title={item.title}
              authorName={item.authorName}
              translatorName={item.translatorName}
              categoryName={item.categoryName}
              slug={item.slug}
              coverImage={item.coverImage}
              coverAlt={item.coverAlt}
              class="h-full"
            />
          </div>
        ))}
      </div>
      )}
      </>
      )}

      <p class="hidden py-12 text-center font-sans text-ink-muted" data-catalogo-vacio>
        Ningún resultado coincide con estos filtros.
      </p>
    </div>
  )
}

<style>
  /* Las sugerencias de autor son una lista propia (no el <datalist> nativo, que en varios
     navegadores despliega TODOS los autores al hacer clic): solo aparecen al escribir y
     con pocas coincidencias. */
  .archivo-catalogo-autor {
    color-scheme: dark;
  }

  :root[data-theme='light'] .archivo-catalogo-autor {
    color-scheme: light;
  }

  .archivo-catalogo-chevron {
    transition: transform 200ms ease;
  }

  .archivo-catalogo-trigger[aria-expanded='true'] .archivo-catalogo-chevron {
    transform: rotate(180deg);
  }

  .archivo-catalogo-dropdown-menu {
    position: absolute;
    left: 0;
    top: calc(100% + 0.5rem);
    z-index: 20;
    min-width: 100%;
    background: rgb(var(--color-surface));
    border: 1px solid rgb(var(--color-ink) / 0.15);
    border-radius: 0.75rem;
    padding: 0.35rem;
    box-shadow: 0 12px 32px rgb(0 0 0 / 0.35);
  }

  .archivo-catalogo-dropdown-option {
    display: block;
    width: 100%;
    text-align: left;
    padding: 0.5rem 0.75rem;
    border-radius: 0.5rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    text-transform: lowercase;
    letter-spacing: 0.08em;
    color: rgb(var(--color-ink-muted));
    background: transparent;
    white-space: nowrap;
  }

  .archivo-catalogo-dropdown-option:hover,
  .archivo-catalogo-dropdown-option:focus-visible {
    background: rgb(var(--color-ink) / 0.08);
    color: rgb(var(--color-ink));
    outline: none;
  }

  .archivo-catalogo-dropdown-option[aria-selected='true'] {
    color: rgb(var(--color-accent));
  }

  /* Buscador del menú de Año/Categoría/Número. Sin tope de alto: el menú no crece con el
     catálogo porque solo muestra unas pocas opciones a la vez (ver MAX_OPCIONES_MENU). */
  .archivo-catalogo-dropdown-buscar {
    display: block;
    width: 100%;
    margin-bottom: 0.35rem;
    padding: 0.5rem 0.75rem;
    border: 0;
    border-radius: 0.5rem;
    background: transparent;
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: rgb(var(--color-ink));
  }

  .archivo-catalogo-dropdown-buscar:focus {
    outline: none;
  }

  /* Cabecera de un grupo de números: despliega sus opciones al pulsarla. */
  .archivo-catalogo-dropdown-grupo {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 0.75rem;
    border-radius: 0.5rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: rgb(var(--color-ink));
    background: transparent;
  }

  .archivo-catalogo-dropdown-grupo:hover,
  .archivo-catalogo-dropdown-grupo:focus-visible {
    background: rgb(var(--color-ink) / 0.08);
    outline: none;
  }

  .archivo-catalogo-dropdown-grupo::after {
    content: '›';
    transition: transform 200ms ease;
  }

  .archivo-catalogo-dropdown-grupo[aria-expanded='true']::after {
    transform: rotate(90deg);
  }

  /* Las opciones dentro de un grupo van sangradas bajo su cabecera. */
  .archivo-catalogo-dropdown-option[data-grupo] {
    padding-left: 1.5rem;
  }

  .archivo-catalogo-dropdown-buscar::placeholder {
    color: rgb(var(--color-ink-muted) / 0.7);
  }

  .archivo-catalogo-dropdown-pista {
    padding: 0.5rem 0.75rem 0.25rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: lowercase;
    color: rgb(var(--color-ink-muted));
  }
</style>

<script>
  /* Por [data-dropdown] y no por la clase: así el mismo aplicarFiltros() lee tanto los
     dropdowns como el grupo de chips de categoría, que declara el filtro de la misma
     forma (data-dropdown + data-value) sin ser un dropdown. El bucle que engancha
     trigger/menú más abajo sale solo cuando esas partes no están. */
  const dropdowns = Array.from(document.querySelectorAll<HTMLElement>('[data-dropdown]'));
  const autorInput = document.querySelector<HTMLInputElement>('[data-filtro-autor]');
  const buscadorCategoria = document.querySelector<HTMLInputElement>('[data-buscador-categoria]');
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-catalogo-item]'));
  const vacioMsg = document.querySelector<HTMLElement>('[data-catalogo-vacio]');

  function aplicarFiltros() {
    const filtros = new Map(dropdowns.map((dropdown) => [dropdown.dataset.dropdown, dropdown.dataset.value ?? 'all']));
    const busquedaAutor = (autorInput?.value ?? '').trim().toLocaleLowerCase('es');

    const busquedaCategoria = sinTildes(buscadorCategoria?.value ?? '').trim();

    let visibles = 0;
    items.forEach((item) => {
      const coincideDropdowns = Array.from(filtros.entries()).every(([filtro, valor]) => {
        if (!filtro || valor === 'all') return true;
        return item.dataset[filtro] === valor;
      });
      const coincideAutor =
        busquedaAutor === '' || (item.dataset.autorNombre ?? '').includes(busquedaAutor);
      const coincideCategoriaTexto =
        busquedaCategoria === '' || sinTildes(item.dataset.categoriaNombre ?? '').includes(busquedaCategoria);
      const coincide = coincideDropdowns && coincideAutor && coincideCategoriaTexto;

      item.classList.toggle('hidden', !coincide);
      if (coincide) visibles += 1;
    });

    vacioMsg?.classList.toggle('hidden', visibles > 0);
    // Avisa a quien dibuje el resultado por su cuenta (el túnel de estampillas).
    document.dispatchEvent(new CustomEvent('catalogo:filtrado'));
  }

  /* Quita todos los filtros (lo pide la grilla de resultados de la órbita móvil). */
  document.addEventListener('catalogo:limpiar', () => {
    dropdowns.forEach((dropdown) => {
      dropdown.dataset.value = 'all';
      const label = dropdown.querySelector<HTMLElement>('[data-dropdown-label]');
      if (label && dropdown.dataset.etiquetaBase) label.textContent = dropdown.dataset.etiquetaBase;
      dropdown
        .querySelectorAll('.archivo-catalogo-dropdown-option')
        .forEach((o) => o.setAttribute('aria-selected', 'false'));
    });
    if (autorInput) autorInput.value = '';
    aplicarFiltros();
  });

  /* Cuántas opciones muestra un menú a la vez. Sin tope, cada número nuevo alargaba la
     lista con scroll; con el tope el menú tiene siempre el mismo alto y el resto se
     alcanza escribiendo en el buscador. */
  const MAX_OPCIONES_MENU = 8;

  const sinTildes = (texto: string) =>
    texto.normalize('NFD').replace(/[̀-ͯ]/g, '').toLocaleLowerCase('es');

  /* Decide qué filas del menú se ven. Con texto escrito, muestra las coincidencias (sin
     cabeceras de grupo, hasta MAX_OPCIONES_MENU). Sin texto, en los menús con grupos
     (Número) muestra solo las cabeceras y las opciones del grupo que está desplegado;
     en los demás, las primeras MAX_OPCIONES_MENU. */
  function filtrarOpciones(dropdown: HTMLElement, texto: string) {
    const q = sinTildes(texto.trim());
    const agrupado = dropdown.dataset.agrupado === 'true';
    const topeAplica = !(agrupado && q === '');

    dropdown.querySelectorAll<HTMLElement>('[data-grupo-cabecera]').forEach((cabecera) => {
      const fila = cabecera.parentElement as HTMLElement | null;
      if (fila) fila.hidden = q !== '';
    });

    let mostradas = 0;
    let coincidencias = 0;
    dropdown.querySelectorAll<HTMLButtonElement>('.archivo-catalogo-dropdown-option').forEach((op) => {
      const fila = op.parentElement as HTMLElement | null;
      if (!fila) return;
      const coincide = sinTildes(op.textContent ?? '').includes(q);
      if (coincide) coincidencias += 1;
      const grupo = op.dataset.grupo;
      const grupoCerrado =
        agrupado &&
        q === '' &&
        dropdown.querySelector(`[data-grupo-cabecera="${grupo}"][aria-expanded="true"]`) === null;
      const oculta = !coincide || grupoCerrado || (topeAplica && mostradas >= MAX_OPCIONES_MENU);
      fila.hidden = oculta;
      if (!oculta) mostradas += 1;
    });

    const pista = dropdown.querySelector<HTMLElement>('[data-dropdown-pista]');
    if (pista) pista.hidden = !(topeAplica && coincidencias > MAX_OPCIONES_MENU);
  }

  function closeDropdown(dropdown: HTMLElement) {
    dropdown.querySelector<HTMLButtonElement>('[data-dropdown-trigger]')?.setAttribute('aria-expanded', 'false');
    const menu = dropdown.querySelector<HTMLElement>('.archivo-catalogo-dropdown-menu');
    if (menu) menu.hidden = true;
    // Al cerrar, el buscador vuelve vacío y los grupos se pliegan: la próxima vez el menú
    // abre como al principio.
    const buscar = dropdown.querySelector<HTMLInputElement>('[data-dropdown-buscar]');
    if (buscar) buscar.value = '';
    dropdown
      .querySelectorAll<HTMLElement>('[data-grupo-cabecera]')
      .forEach((cabecera) => cabecera.setAttribute('aria-expanded', 'false'));
    filtrarOpciones(dropdown, '');
  }

  function closeAllDropdowns(except?: HTMLElement) {
    dropdowns.forEach((dropdown) => {
      if (dropdown !== except) closeDropdown(dropdown);
    });
  }

  dropdowns.forEach((dropdown) => {
    const trigger = dropdown.querySelector<HTMLButtonElement>('[data-dropdown-trigger]');
    const menu = dropdown.querySelector<HTMLElement>('.archivo-catalogo-dropdown-menu');
    const label = dropdown.querySelector<HTMLElement>('[data-dropdown-label]');
    const options = Array.from(
      dropdown.querySelectorAll<HTMLButtonElement>('.archivo-catalogo-dropdown-option')
    );
    if (!trigger || !menu || !label) return;

    trigger.addEventListener('click', () => {
      const isOpen = trigger.getAttribute('aria-expanded') === 'true';
      closeAllDropdowns(dropdown);
      trigger.setAttribute('aria-expanded', String(!isOpen));
      menu.hidden = isOpen;
      if (!isOpen) dropdown.querySelector<HTMLInputElement>('[data-dropdown-buscar]')?.focus();
    });

    // La etiqueta de origen ("Año", "Categoría", "Número") se guarda antes de cualquier
    // elección: es lo que vuelve a mostrarse al quitar el filtro.
    const etiquetaBase = label.textContent ?? '';
    dropdown.dataset.etiquetaBase = etiquetaBase;

    const elegir = (option: HTMLButtonElement) => {
      // Tocar otra vez la opción ya elegida quita el filtro. Así no hace falta una fila
      // "Todas" dentro del menú.
      const valor = option.dataset.value ?? 'all';
      const quitar = valor === dropdown.dataset.value;
      dropdown.dataset.value = quitar ? 'all' : valor;
      label.textContent = quitar ? etiquetaBase : option.textContent;
      options.forEach((o) => o.setAttribute('aria-selected', String(!quitar && o === option)));
      closeDropdown(dropdown);
      aplicarFiltros();
    };

    options.forEach((option) => {
      option.addEventListener('click', () => {
        /* Opción que existe en el catálogo pero no entre los items de esta página (ver
           `fuera` en FiltroOpcion): filtrarla acá dejaría la grilla vacía, así que se
           delega en /archivo, que tiene el catálogo entero y lee el parámetro al cargar. */
        if (option.dataset.fuera === 'true') {
          const clave = dropdown.dataset.dropdown ?? '';
          const valor = option.dataset.value ?? '';
          window.location.href = `/archivo?${encodeURIComponent(clave)}=${encodeURIComponent(valor)}`;
          return;
        }
        elegir(option);
      });
    });

    // Buscador: filtra mientras se escribe; Enter elige la primera opción visible.
    const buscar = dropdown.querySelector<HTMLInputElement>('[data-dropdown-buscar]');
    if (buscar) {
      buscar.addEventListener('input', () => filtrarOpciones(dropdown, buscar.value));
      buscar.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter') return;
        event.preventDefault();
        const primera = options.find((o) => o.parentElement?.hidden === false && o.dataset.value !== 'all');
        primera?.click();
      });
    }
    // Cabeceras de grupo (Número): despliegan o pliegan sus opciones.
    dropdown.querySelectorAll<HTMLButtonElement>('[data-grupo-cabecera]').forEach((cabecera) => {
      cabecera.addEventListener('click', () => {
        cabecera.setAttribute('aria-expanded', String(cabecera.getAttribute('aria-expanded') !== 'true'));
        filtrarOpciones(dropdown, buscar?.value ?? '');
      });
    });
    filtrarOpciones(dropdown, '');

    /* Al cargar, aplica el filtro que venga en la URL. Es lo que hace que el salto desde
       el home llegue a /archivo ya filtrado, y de paso hace enlazable cualquier filtro. */
    const pedido = new URLSearchParams(window.location.search).get(dropdown.dataset.dropdown ?? '');
    if (pedido) {
      const option = options.find((o) => o.dataset.value === pedido);
      if (option) elegir(option);
    }
  });

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Node)) return;
    dropdowns.forEach((dropdown) => {
      if (!dropdown.contains(event.target as Node)) closeDropdown(dropdown);
    });
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeAllDropdowns();
  });

  // Buscador de categorías (/categorias): filtra al escribir y esconde el placeholder animado.
  const placeholderBuscador = document.querySelector<HTMLElement>('[data-buscador-placeholder]');
  buscadorCategoria?.addEventListener('input', () => {
    placeholderBuscador?.classList.toggle('hidden', buscadorCategoria.value !== '');
    aplicarFiltros();
  });

  // Sugerencias de autor: aparecen solo al escribir, máximo MAX_SUGERENCIAS, sin lista larga.
  const MAX_SUGERENCIAS = 6;
  const combo = document.querySelector<HTMLElement>('[data-autor-combo]');
  const lista = combo?.querySelector<HTMLElement>('[data-autor-sugerencias]') ?? null;
  const autores: string[] = JSON.parse(combo?.dataset.autores ?? '[]');
  const normalizar = (t: string) =>
    t.normalize('NFD').replace(/[̀-ͯ]/g, '').toLocaleLowerCase('es');
  let activa = -1;

  function cerrarSugerencias() {
    if (lista) lista.hidden = true;
    autorInput?.setAttribute('aria-expanded', 'false');
    activa = -1;
  }

  function elegir(nombre: string) {
    if (!autorInput) return;
    autorInput.value = nombre;
    cerrarSugerencias();
    aplicarFiltros();
  }

  function marcarActiva() {
    lista?.querySelectorAll<HTMLElement>('[role=option]').forEach((op, i) => {
      op.setAttribute('aria-selected', String(i === activa));
    });
  }

  function mostrarSugerencias() {
    if (!lista || !autorInput) return;
    const q = normalizar(autorInput.value.trim());
    const coincidencias = q ? autores.filter((n) => normalizar(n).includes(q)).slice(0, MAX_SUGERENCIAS) : [];
    lista.replaceChildren();
    // Sin texto, sin coincidencias, o ya escrito el nombre exacto: no hay nada que sugerir.
    if (coincidencias.length === 0 || (coincidencias.length === 1 && normalizar(coincidencias[0]) === q)) {
      cerrarSugerencias();
      return;
    }
    coincidencias.forEach((nombre) => {
      const li = document.createElement('li');
      li.setAttribute('role', 'presentation');
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.setAttribute('role', 'option');
      btn.setAttribute('aria-selected', 'false');
      btn.className = 'archivo-catalogo-dropdown-option';
      btn.textContent = nombre;
      // mousedown (no click): se elige antes de que el input pierda el foco.
      btn.addEventListener('mousedown', (e) => {
        e.preventDefault();
        elegir(nombre);
      });
      li.appendChild(btn);
      lista.appendChild(li);
    });
    lista.hidden = false;
    autorInput.setAttribute('aria-expanded', 'true');
    activa = -1;
  }

  autorInput?.addEventListener('input', () => {
    mostrarSugerencias();
    aplicarFiltros();
  });

  autorInput?.addEventListener('keydown', (event) => {
    const opciones = lista ? Array.from(lista.querySelectorAll<HTMLElement>('[role=option]')) : [];
    if (event.key === 'ArrowDown' && opciones.length) {
      event.preventDefault();
      activa = (activa + 1) % opciones.length;
      marcarActiva();
    } else if (event.key === 'ArrowUp' && opciones.length) {
      event.preventDefault();
      activa = (activa - 1 + opciones.length) % opciones.length;
      marcarActiva();
    } else if (event.key === 'Enter' && activa >= 0 && opciones[activa]) {
      event.preventDefault();
      elegir(opciones[activa].textContent ?? '');
    } else if (event.key === 'Escape') {
      cerrarSugerencias();
    }
  });

  autorInput?.addEventListener('blur', cerrarSugerencias);
</script>
