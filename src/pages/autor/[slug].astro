---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NumeroSequence from '../../components/NumeroSequence.astro';

export async function getStaticPaths() {
  const autores = await getCollection('autores');
  return autores.map((autor) => ({
    params: { slug: autor.id },
    props: { autor },
  }));
}

const { autor } = Astro.props;

const todasLasEntradas = await getCollection('entradas');
// Entradas donde este autor escribió el original o donde lo tradujo — ambos roles se
// muestran en su página (ver EntradaPagina.astro / EntryCard.tsx para el rótulo de traductor).
const entradasDelAutor = todasLasEntradas.filter(
  (entrada) => entrada.data.autor === autor.id || entrada.data.traducidoPor === autor.id
);

const entradasConRelaciones = await Promise.all(
  entradasDelAutor.map(async (entrada) => {
    const categoria = await getEntry('categorias', entrada.data.categoria);
    // El autor de la card no es necesariamente este perfil: puede ser la autoría
    // original de una entrada que este perfil solo tradujo.
    const autorEntrada = await getEntry('autores', entrada.data.autor);
    const traductor = entrada.data.traducidoPor
      ? await getEntry('autores', entrada.data.traducidoPor)
      : null;
    return { entrada, categoria, autorEntrada, traductor };
  })
);

entradasConRelaciones.sort(
  (a, b) => b.entrada.data.fecha.valueOf() - a.entrada.data.fecha.valueOf()
);
---

<BaseLayout
  title={autor.data.metaTitulo || `${autor.data.nombre} — La Antorcha Magacín`}
  description={
    autor.data.metaDescripcion ||
    autor.data.biografia ||
    /* Sin biografía (ahora es opcional) caía en la descripción genérica del sitio, igual
       para todos los autores. Esta al menos nombra a la persona. */
    `Todo lo que ${autor.data.nombre} ha publicado en La Antorcha Magacín.`
  }
>
  <NumeroSequence
    titulo={autor.data.nombre}
    tituloLiteral
    descripcionCompleta
    descripcion={autor.data.biografia}
    entradas={entradasConRelaciones.map(({ entrada, categoria, autorEntrada, traductor }) => ({
      slug: entrada.id,
      titulo: entrada.data.titulo,
      categoriaNombre: categoria?.data.nombre ?? '',
      autorNombre: autorEntrada?.data.nombre ?? '',
      translatorName: traductor?.data.nombre,
      portada: entrada.data.portada,
    }))}
  />

  {
    entradasConRelaciones.length === 0 && (
      <p class="text-center font-sans text-ink-muted">
        Este autor todavía no tiene artículos publicados.
      </p>
    )
  }
</BaseLayout>
