---
import type { CollectionEntry } from 'astro:content';

/**
 * Carrusel automático de categorías: pista CSS que se desplaza en loop infinito
 * (adaptado de una referencia de marquee de tarjetas con fondo, reemplaza al carrusel
 * 3D en Three.js que había antes). Cada tarjeta es un link real a `/categoria/[id]`.
 *
 * El loop es puramente CSS (`@keyframes` + `translateX(-50%)`): la pista renderiza la
 * lista de categorías dos veces seguidas y anima exactamente la mitad de su ancho, así
 * que cuando el primer set termina de salir por la izquierda el segundo ya está en la
 * posición inicial del primero — no hace falta JS para el loop. El segundo set se
 * marca `aria-hidden`/`tabindex="-1"` para que lectores de pantalla y navegación por
 * teclado no encuentren cada categoría dos veces.
 *
 * Las categorías no tienen portada propia en el CMS (ver `imagenPorCategoria`, resuelto
 * en index.astro a partir de la entrada más reciente de cada categoría) — la tarjeta
 * cae a un panel tipográfico cuando no hay ninguna disponible todavía.
 */
interface Props {
  categorias: CollectionEntry<'categorias'>[];
  imagenPorCategoria: Record<string, string>;
}

const { categorias, imagenPorCategoria } = Astro.props;
---

{
  categorias.length > 0 && (
    <section class="relative mb-12">
      <div class="mb-6 md:hidden">
        <h2 class="font-headline text-2xl lg:text-3xl">Categorías</h2>
      </div>

      <div class="mb-6 hidden text-center md:block">
        <span class="mb-2 block font-mono text-xs uppercase tracking-widest text-ink/50">
          Revisá nuestro catálogo
        </span>
        <h2 class="font-headline text-4xl uppercase leading-none tracking-tight text-ink lg:text-6xl">
          Categorías
        </h2>
      </div>

      <div class="categorias-marquee-view">
        <ul class="categorias-marquee-track">
          {categorias.map((categoria) => (
            <li class="categorias-marquee-card">
              <a
                href={`/categoria/${categoria.id}`}
                class="group relative block h-full w-full overflow-hidden border border-ink/15 bg-surface transition-colors duration-300 hover:border-accent"
                style={
                  imagenPorCategoria[categoria.id]
                    ? `background-image:url(${imagenPorCategoria[categoria.id]})`
                    : undefined
                }
              >
                {imagenPorCategoria[categoria.id] && (
                  <span class="absolute inset-0 bg-gradient-to-t from-canvas/90 via-canvas/10 to-transparent" />
                )}
                <span class="relative flex h-full flex-col justify-end p-4">
                  <span class="font-headline text-lg uppercase leading-tight text-ink lg:text-xl">
                    {categoria.data.nombre}
                  </span>
                  <span class="mt-1 font-mono text-xs uppercase tracking-widest text-accent opacity-0 transition-opacity duration-300 group-hover:opacity-100">
                    Explorar
                  </span>
                </span>
              </a>
            </li>
          ))}
          {categorias.map((categoria) => (
            <li class="categorias-marquee-card" aria-hidden="true">
              <a
                href={`/categoria/${categoria.id}`}
                tabindex="-1"
                class="group relative block h-full w-full overflow-hidden border border-ink/15 bg-surface transition-colors duration-300 hover:border-accent"
                style={
                  imagenPorCategoria[categoria.id]
                    ? `background-image:url(${imagenPorCategoria[categoria.id]})`
                    : undefined
                }
              >
                {imagenPorCategoria[categoria.id] && (
                  <span class="absolute inset-0 bg-gradient-to-t from-canvas/90 via-canvas/10 to-transparent" />
                )}
                <span class="relative flex h-full flex-col justify-end p-4">
                  <span class="font-headline text-lg uppercase leading-tight text-ink lg:text-xl">
                    {categoria.data.nombre}
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .categorias-marquee-view {
    width: 100%;
    overflow: hidden;
    /* Se desvanece contra el fondo en los bordes del contenedor en vez de cortar en
       seco — no hay bleed a viewport-width en este sitio (ver frontmatter), así que el
       degradado atenúa contra el propio `container` de la página. */
    mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent);
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      black 5%,
      black 95%,
      transparent
    );
  }

  .categorias-marquee-track {
    display: flex;
    width: max-content;
    animation: categorias-marquee-scroll 40s linear infinite;
  }

  /* Pausa al pasar el mouse o al enfocar por teclado una tarjeta de la pista. */
  .categorias-marquee-view:hover .categorias-marquee-track,
  .categorias-marquee-track:has(:focus-visible) {
    animation-play-state: paused;
  }

  .categorias-marquee-card {
    width: 12rem;
    height: 17rem;
    margin-right: 1rem;
    flex-shrink: 0;
  }

  @keyframes categorias-marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      /* La mitad del ancho total = el largo exacto del primer set (ver frontmatter). */
      transform: translateX(-50%);
    }
  }

  @media (min-width: 768px) {
    .categorias-marquee-card {
      width: 15rem;
      height: 21rem;
    }
  }

  @media (min-width: 1024px) {
    .categorias-marquee-card {
      width: 17rem;
      height: 23rem;
    }
    .categorias-marquee-track {
      animation-duration: 50s;
    }
  }

  /* Sin bg propio: el estilo inline de la tarjeta ya trae background-image. */
  .categorias-marquee-card a {
    background-size: cover;
    background-position: center;
  }

  /* Se detiene en vez de animar, pero sigue con overflow: hidden (nunca aparece un
     scrollbar) — el segundo set de tarjetas queda oculto, igual que cualquier card
     recortada por la máscara de bordes. */
  @media (prefers-reduced-motion: reduce) {
    .categorias-marquee-track {
      animation: none;
    }
  }
</style>
