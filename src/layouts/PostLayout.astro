---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div
    class="pointer-events-none fixed inset-x-0 top-0 z-50 h-[2px] bg-transparent"
    aria-hidden="true"
  >
    <div id="post-reading-progress" class="h-full w-0 bg-accent"></div>
  </div>

  {/* Banner fuera del <article>: la columna de lectura está limitada por `prose` (~65-72ch) y
      el banner de portada necesita todo el ancho del contenedor principal. Al ir por fuera
      tampoco entra en la barra de progreso, que mide #post-article.

      Sin envoltorio y sin tocar el `my-12` del artículo a propósito: un <div> con margen
      alrededor del slot empujaría el artículo también en las 309 entradas que no tienen
      portada. Así, sin banner el layout queda byte a byte como antes, y el margen del banner
      lo pone el propio EntradaBanner.astro. */}
  <slot name="banner" />

  {/* `md:max-w-none` levanta el `max-width: 65ch` de Tailwind Typography, que es su único
      tope de ancho y no cambia entre breakpoints. Con Lekton (monoespaciada, 1ch ≈ 0,5em) esos
      65ch son ~650px de los 1504px disponibles, y el cuerpo de la entrada va en dos columnas a
      partir de 1024px (ver EntradaPagina.astro). En móvil se mantiene la medida de 65ch, que
      ahí es la correcta. */}
  <article
    id="post-article"
    class="prose prose-lg md:prose-xl prose-invert mx-auto my-12 md:max-w-none prose-headings:font-headline prose-headings:uppercase prose-headings:tracking-tight prose-headings:text-ink prose-p:font-serif prose-p:text-bone prose-a:text-accent prose-blockquote:border-accent prose-blockquote:font-serif prose-blockquote:italic prose-strong:text-ink prose-li:text-bone"
  >
    <slot />
  </article>
</BaseLayout>

<script>
  /**
   * Barra de progreso de lectura: refleja cuánto se scrolleó del <article> real
   * (no un contador de caracteres tipeados como en la plantilla de referencia) —
   * mismo mecanismo en cualquier página que use PostLayout, ya que no depende de
   * ninguna otra particularidad de la entrada.
   */
  const article = document.getElementById('post-article');
  const bar = document.getElementById('post-reading-progress');

  if (article && bar) {
    const update = () => {
      const rect = article.getBoundingClientRect();
      const total = rect.height - window.innerHeight;
      const scrolled = -rect.top;
      const ratio = total > 0 ? Math.min(1, Math.max(0, scrolled / total)) : 0;
      bar.style.width = `${ratio * 100}%`;
    };

    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
  }
</script>
