---
/**
 * Libro de hojas: el texto completo de la entrada paginado en hojas que se pasan. Reemplaza al
 * modo lectura anterior (máquina de escribir, un párrafo a la vez).
 *
 * POR QUÉ ES UNA CAPA SOBRE UNA COPIA. El modo lectura anterior vaciaba el <article> real, movía
 * los nodos y los reconstruía planos al salir: de ahí venía su fragilidad, la coordinación
 * delicada con los pliegos y el riesgo de que una imagen intercalada terminara insertada en un
 * nodo desconectado. Acá el libro se arma con `cloneNode(true)` del cuerpo y vive en una capa
 * `position: fixed` propia, así que:
 *   - el flujo normal (pliegos incluidos) no se toca nunca;
 *   - cerrar el libro es destruir la capa, sin restauración que pueda fallar;
 *   - el texto completo sigue en el HTML servido, intacto para buscadores y lectores de pantalla.
 *
 * Y como el <body> queda sin scroll mientras el libro está abierto, no hay gesto vertical que
 * competir: el swipe horizontal es inequívoco. Eso es lo que lo hace viable en móvil, donde
 * CLAUDE.md advierte de los componentes que capturan gestos. El botón de salida está siempre
 * visible, que es el requisito de esa misma regla.
 *
 * El pliegue es GSAP: giro sobre el lomo con dos caras. Sin la curvatura real del papel, que
 * habría pedido una dependencia nueva (page-flip) y la regla del proyecto es solo GSAP.
 */
---

<!-- La capa arranca vacía y oculta: todo el contenido se arma al abrir, desde el clon. -->
<div
  id="entrada-libro"
  class="fixed inset-0 z-[60] hidden flex-col bg-canvas"
  role="dialog"
  aria-modal="true"
  aria-label="Lectura en hojas"
>
  <div class="flex items-center justify-between px-4 py-3 md:px-6">
    <p id="libro-contador" class="font-mono text-xs tabular-nums tracking-widest text-ink-muted">
      01 / 01
    </p>
    <button
      type="button"
      id="libro-salir"
      class="inline-flex items-center gap-2 border border-ink/20 px-3 py-2 font-mono text-xs uppercase tracking-widest text-ink transition-colors hover:border-accent hover:text-accent"
    >
      Cerrar libro
    </button>
  </div>

  <div id="libro-escena" class="relative flex flex-1 items-center justify-center overflow-hidden px-2">
    <!-- Hoja izquierda (solo escritorio): la página anterior, quieta. -->
    <div id="libro-izq" class="libro-hoja hidden lg:block" aria-hidden="true"></div>
    <!-- Pila derecha: debajo la hoja siguiente, encima la que gira. -->
    <div id="libro-pila" class="libro-pila">
      <div id="libro-siguiente" class="libro-hoja" aria-hidden="true"></div>
      <div id="libro-activa" class="libro-hoja libro-hoja--activa">
        <div id="libro-frente" class="libro-cara"></div>
        <div id="libro-dorso" class="libro-cara libro-cara--dorso" aria-hidden="true"></div>
      </div>
    </div>
  </div>

  <div class="flex items-center justify-center gap-3 px-4 py-3 md:py-4">
    <button type="button" id="libro-antes" class="libro-control">Anterior</button>
    <button type="button" id="libro-despues" class="libro-control">Siguiente</button>
  </div>
</div>

<style>
  /* Medidas de la hoja. El área de texto es esto menos el padding, y es lo que se le pasa al
     paginador: si cambian acá, cambia la paginación. */
  #entrada-libro {
    --hoja-ancho: min(92vw, 520px);
    --hoja-alto: min(76vh, 680px);
    --hoja-padding: 1.5rem;
  }

  @media (min-width: 1024px) {
    #entrada-libro {
      /* Dos hojas lado a lado tienen que caber juntas. */
      --hoja-ancho: min(44vw, 500px);
      --hoja-alto: min(78vh, 720px);
      --hoja-padding: 2.25rem;
    }
  }

  #libro-escena {
    perspective: 2000px;
  }

  .libro-pila {
    position: relative;
    width: var(--hoja-ancho);
    height: var(--hoja-alto);
    transform-style: preserve-3d;
  }

  .libro-hoja {
    width: var(--hoja-ancho);
    height: var(--hoja-alto);
    background: rgb(var(--color-surface));
    border: 1px solid rgb(var(--color-ink) / 0.12);
  }

  #libro-siguiente {
    position: absolute;
    inset: 0;
    padding: var(--hoja-padding);
    overflow: hidden;
  }

  .libro-hoja--activa {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    /* El giro es sobre el lomo, que en la hoja derecha es su borde izquierdo. */
    transform-origin: left center;
    background: transparent;
    border: 0;
  }

  .libro-cara {
    position: absolute;
    inset: 0;
    padding: var(--hoja-padding);
    overflow: hidden;
    backface-visibility: hidden;
    background: rgb(var(--color-surface));
    border: 1px solid rgb(var(--color-ink) / 0.12);
  }

  .libro-cara--dorso {
    transform: rotateY(180deg);
  }

  #libro-izq {
    padding: var(--hoja-padding);
    overflow: hidden;
    margin-right: 1px;
  }

  /* Tipografía del libro. La caja de medición del paginador usa estas mismas clases, así que
     cualquier cambio acá hay que reflejarlo allá (se le pasan por el parámetro `clases`). */
  .libro-texto {
    font-family: 'Lekton', monospace;
    font-size: 0.95rem;
    line-height: 1.65;
    color: rgb(var(--color-bone));
    hyphens: auto;
  }

  @media (min-width: 1024px) {
    .libro-texto {
      font-size: 1rem;
    }
  }

  .libro-texto :global(p) {
    margin: 0 0 0.9em;
  }

  .libro-texto :global(p[data-continuacion]) {
    /* La mitad de un párrafo partido no lleva sangría ni margen arriba: es el mismo párrafo. */
    margin-top: 0;
  }

  .libro-texto :global(h2),
  .libro-texto :global(h3) {
    font-weight: 700;
    color: rgb(var(--color-ink));
    margin: 0 0 0.6em;
  }

  .libro-texto :global(blockquote) {
    margin: 0 0 0.9em;
    padding-left: 0.9em;
    border-left: 2px solid rgb(var(--color-accent));
    font-style: italic;
  }

  .libro-texto :global(hr) {
    border: 0;
    margin: 1.2em 0;
    text-align: center;
  }

  .libro-texto :global(hr)::before {
    content: '✦  ✦  ✦';
    color: rgb(var(--color-accent));
    font-size: 0.7rem;
    letter-spacing: 0.5em;
  }

  .libro-texto :global(a) {
    color: rgb(var(--color-accent));
  }

  .libro-texto :global(img) {
    max-width: 100%;
    height: auto;
  }

  /* Hoja de un bloque especial: la imagen o la galería mandan, sin tipografía de texto. */
  .libro-cara--especial,
  .libro-hoja--especial {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .libro-control {
    border: 1px solid rgb(var(--color-ink) / 0.2);
    padding: 0.5rem 1.1rem;
    font-family: 'Lekton', monospace;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: rgb(var(--color-ink));
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .libro-control:hover:not(:disabled) {
    border-color: rgb(var(--color-accent));
    color: rgb(var(--color-accent));
  }

  .libro-control:disabled {
    opacity: 0.35;
  }

  #entrada-libro.esta-abierto {
    display: flex;
  }
</style>

<script>
  import gsap from 'gsap';
  import { Observer } from 'gsap/Observer';
  import { paginar, textoDeHojas, textoNormalizado, type Hoja } from '../lib/paginar';

  gsap.registerPlugin(Observer);

  const capa = document.getElementById('entrada-libro');
  const origen = document.getElementById('entrada-content');
  const abrirBoton = document.getElementById('entrada-enter-reading');
  const salirBoton = document.getElementById('libro-salir');
  const escena = document.getElementById('libro-escena');
  const pila = document.getElementById('libro-pila');
  const izq = document.getElementById('libro-izq');
  const siguienteEl = document.getElementById('libro-siguiente');
  const activa = document.getElementById('libro-activa');
  const frente = document.getElementById('libro-frente');
  const dorso = document.getElementById('libro-dorso');
  const contador = document.getElementById('libro-contador');
  const antes = document.getElementById('libro-antes') as HTMLButtonElement | null;
  const despues = document.getElementById('libro-despues') as HTMLButtonElement | null;
  const barra = document.getElementById('post-reading-progress');

  if (capa && origen && abrirBoton && salirBoton && escena && pila && izq && siguienteEl && activa && frente && dorso && contador && antes && despues) {
    // Modo de diagnóstico: ?libro=registro imprime las hojas, el tiempo y —lo importante— si el
    // texto paginado coincide con el original. Perder texto acá no da ningún error.
    let modo = '';
    try {
      modo = (String(location.search).match(/[?&]libro=([a-z]+)/) || [])[1] || '';
    } catch {}

    const sinMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)');
    const dosHojas = window.matchMedia('(min-width: 1024px)');

    let hojas: Hoja[] = [];
    let indice = 0; // índice de la hoja derecha (o la única, en móvil)
    let abierto = false;
    let girando = false;

    const paso = () => (dosHojas.matches ? 2 : 1);

    const areaTexto = () => {
      const estilo = getComputedStyle(capa);
      const anchoHoja = parseFloat(estilo.getPropertyValue('--hoja-ancho'));
      const altoHoja = parseFloat(estilo.getPropertyValue('--hoja-alto'));
      const pad = parseFloat(estilo.getPropertyValue('--hoja-padding'));
      // getPropertyValue puede devolver la expresión min() sin resolver en algunos navegadores:
      // en ese caso se mide la caja real, que siempre está.
      const medidaReal = siguienteEl.getBoundingClientRect();
      const ancho = Number.isFinite(anchoHoja) && anchoHoja > 0 ? anchoHoja : medidaReal.width;
      const alto = Number.isFinite(altoHoja) && altoHoja > 0 ? altoHoja : medidaReal.height;
      const padding = Number.isFinite(pad) && pad > 0 ? pad : 24;
      return { ancho: Math.max(120, ancho - padding * 2), alto: Math.max(120, alto - padding * 2) };
    };

    const pintar = (caja: HTMLElement, idx: number) => {
      caja.replaceChildren();
      caja.classList.remove('libro-texto', 'libro-cara--especial', 'libro-hoja--especial');
      const hoja = hojas[idx];
      if (!hoja) return;
      caja.classList.add(hoja.especial ? 'libro-cara--especial' : 'libro-texto');
      // Se clona al pintar: la misma hoja puede aparecer en dos sitios a la vez (dorso y, tras
      // el giro, página izquierda), y un nodo solo puede estar en un lugar del DOM.
      hoja.nodos.forEach((n) => caja.appendChild(n.cloneNode(true)));
    };

    const refrescar = () => {
      const p = paso();
      pintar(frente, indice);
      pintar(dorso, indice + 1);
      pintar(siguienteEl, indice + p);
      if (dosHojas.matches) pintar(izq, indice - 1);
      gsap.set(activa, { rotateY: 0 });
      const total = hojas.length;
      const actual = Math.min(total, indice + 1);
      contador.textContent = `${String(actual).padStart(2, '0')} / ${String(total).padStart(2, '0')}`;
      antes.disabled = indice <= 0;
      despues.disabled = indice + p >= total;
      // La barra de progreso de PostLayout.astro: mientras el libro está abierto no hay scroll
      // real, así que se le pisa el ancho con el avance de hojas (mismo recurso que usaba el
      // modo lectura anterior).
      if (barra) barra.style.width = `${total > 1 ? (indice / (total - 1)) * 100 : 100}%`;
    };

    const girar = (direccion: 1 | -1) => {
      if (girando) return;
      const p = paso();
      const destino = indice + direccion * p;
      if (destino < 0 || destino >= hojas.length) return;
      girando = true;

      const terminar = () => {
        indice = destino;
        refrescar();
        girando = false;
      };

      if (sinMovimiento.matches) {
        // Sin animación, pero el libro sigue funcionando: es la lección del modo lectura
        // anterior, que con esta preferencia se desactivaba entero y se rompía en silencio.
        terminar();
        return;
      }

      if (direccion === 1) {
        gsap.to(activa, { rotateY: -180, duration: 0.65, ease: 'power2.inOut', onComplete: terminar });
      } else {
        // Hacia atrás: la hoja entra desde la izquierda, así que arranca ya girada. Y debajo
        // tiene que quedar la hoja que se está dejando, no la siguiente: si no, durante el giro
        // se asoma por detrás una hoja que no corresponde.
        pintar(siguienteEl, indice);
        pintar(frente, destino);
        pintar(dorso, destino + 1);
        gsap.fromTo(
          activa,
          { rotateY: -180 },
          { rotateY: 0, duration: 0.65, ease: 'power2.inOut', onComplete: terminar }
        );
      }
    };

    const apuntar = (texto: string) => {
      if (modo !== 'registro') return;
      let caja = document.getElementById('libro-registro');
      if (!caja) {
        caja = document.createElement('div');
        caja.id = 'libro-registro';
        caja.style.cssText =
          'position:fixed;left:8px;bottom:8px;z-index:2147483647;max-width:52ch;background:#000;' +
          'color:#0f0;font:11px/1.4 ui-monospace,monospace;padding:8px;border:1px solid #0f0;white-space:pre-wrap';
        document.body.appendChild(caja);
      }
      caja.appendChild(document.createTextNode(texto + '\n'));
    };

    const construir = () => {
      const { ancho, alto } = areaTexto();
      const resultado = paginar(origen, { ancho, alto, clases: 'libro-texto' });
      hojas = resultado.hojas;
      if (indice >= hojas.length) indice = Math.max(0, hojas.length - 1);

      // La comprobación de integridad corre SIEMPRE, no solo en el modo de diagnóstico: que la
      // paginación pierda texto no da ningún error, solo una entrada incompleta, y eso no puede
      // pasar en silencio. En el diagnóstico además se imprime en pantalla.
      const original = textoNormalizado(origen);
      const paginado = textoDeHojas(hojas);
      const integro = original === paginado;
      if (!integro) {
        let i = 0;
        while (i < Math.min(original.length, paginado.length) && original[i] === paginado[i]) i++;
        console.warn(
          `[libro] la paginación no conserva el texto: original ${original.length} vs ${paginado.length} caracteres, divergen en ${i}\n` +
            `  original: …${original.slice(Math.max(0, i - 40), i + 40)}…\n` +
            `  paginado: …${paginado.slice(Math.max(0, i - 40), i + 40)}…`
        );
      }

      if (modo === 'registro') {
        apuntar(`hojas: ${hojas.length}  area: ${Math.round(ancho)}x${Math.round(alto)}px`);
        apuntar(`paginado en ${resultado.ms} ms con ${resultado.mediciones} mediciones`);
        apuntar(
          integro
            ? `TEXTO INTEGRO: ${original.length} caracteres coinciden`
            : `✖ TEXTO DISTINTO: original ${original.length} vs paginado ${paginado.length} (ver consola)`
        );
      }
      refrescar();
    };

    const abrir = () => {
      if (abierto) return;
      abierto = true;
      capa.classList.add('esta-abierto');
      document.body.classList.add('overflow-hidden');
      construir();
      salirBoton.focus();
    };

    const cerrar = () => {
      if (!abierto) return;
      abierto = false;
      capa.classList.remove('esta-abierto');
      document.body.classList.remove('overflow-hidden');
      // Le devuelve la barra a su propio listener de scroll (PostLayout.astro).
      window.dispatchEvent(new Event('scroll'));
      abrirBoton.focus();
    };

    abrirBoton.addEventListener('click', abrir);
    salirBoton.addEventListener('click', cerrar);
    antes.addEventListener('click', () => girar(-1));
    despues.addEventListener('click', () => girar(1));

    // Clic o toque en una mitad de la escena. Los controles y los enlaces del texto se quedan
    // con su propio clic.
    escena.addEventListener('click', (ev) => {
      const objetivo = ev.target as HTMLElement | null;
      if (objetivo?.closest('a, button, [data-galeria-scroll]')) return;
      const caja = escena.getBoundingClientRect();
      girar(ev.clientX - caja.left > caja.width / 2 ? 1 : -1);
    });

    document.addEventListener('keydown', (ev) => {
      if (!abierto) return;
      if (ev.key === 'Escape') cerrar();
      else if (ev.key === 'ArrowRight' || ev.key === 'PageDown') girar(1);
      else if (ev.key === 'ArrowLeft' || ev.key === 'PageUp') girar(-1);
      else if (ev.key === 'Home') {
        indice = 0;
        refrescar();
      } else if (ev.key === 'End') {
        indice = Math.max(0, hojas.length - paso());
        refrescar();
      } else return;
      ev.preventDefault();
    });

    // Gestos: eje bloqueado y solo dentro de la escena, el idioma de Observer que usa todo el
    // sitio. La galería de una hoja especial se queda con su propio gesto horizontal.
    Observer.create({
      target: escena,
      type: 'touch,pointer',
      lockAxis: true,
      tolerance: 40,
      onLeft: () => girar(1),
      onRight: () => girar(-1),
      onPress: (self) => {
        const objetivo = self.event?.target as HTMLElement | null;
        if (objetivo?.closest('[data-galeria-scroll]')) self.disable();
      },
      onRelease: (self) => {
        if (!self.isEnabled) self.enable();
      },
    });
    Observer.create({
      target: escena,
      type: 'wheel',
      tolerance: 80,
      onDown: () => girar(1),
      onUp: () => girar(-1),
    });

    // Repaginar al cambiar el tamaño o rotar: el área de la hoja manda, y se conserva la hoja
    // actual lo más cerca posible.
    let rehacer: number | undefined;
    const alRedimensionar = () => {
      if (!abierto) return;
      window.clearTimeout(rehacer);
      rehacer = window.setTimeout(construir, 250);
    };
    window.addEventListener('resize', alRedimensionar);
    window.addEventListener('orientationchange', alRedimensionar);

    // El botón existe en el HTML oculto: lo muestra JS, así que sin JS no aparece y la entrada
    // se lee completa en flujo normal.
    abrirBoton.classList.remove('hidden');
    abrirBoton.classList.add('inline-flex');
  }
</script>
