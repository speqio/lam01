---
import SearchModal from './ui/SearchModal.tsx';
import { navItems } from '../data/navItems';
---

<header class="pointer-events-none absolute inset-x-0 top-0 z-20 hidden md:block">
  <!-- Masthead -->
  <div class="pointer-events-auto border-b border-transparent bg-transparent backdrop-blur-none">
    <div class="mx-auto flex h-20 max-w-[1600px] items-center justify-between gap-4 px-4 md:px-8 lg:px-12">
      <nav class="hidden items-center gap-6 font-mono text-xs uppercase tracking-widest text-ink md:flex">
        {
          navItems.map((item) => (
            <a href={item.url} class="group relative text-ink transition-colors hover:text-accent">
              {item.name}
              <span class="absolute -bottom-1 left-0 h-px w-0 bg-accent transition-all duration-300 group-hover:w-full" />
            </a>
          ))
        }
      </nav>

      <div class="hidden md:block">
        <SearchModal client:load />
      </div>
    </div>
  </div>
</header>
