---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileFloatingNav from '../components/MobileFloatingNav.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Un blog de literatura: cuento, poesía y ensayo.' } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <script is:inline>
      // Corre antes de que se pinte nada: fija data-theme desde localStorage (o "dark"
      // por defecto, la paleta original del sitio) para que el toggle no produzca un
      // flash de un tema y luego el otro al cargar la página.
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var theme = stored === 'light' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {}
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-canvas text-ink flex flex-col font-sans">
    <Header />
    <main
      class="mx-auto w-full max-w-[1600px] flex-grow px-4 py-8 pb-28 md:px-8 md:pb-8 lg:px-12"
      data-pagefind-body
    >
      <slot />
    </main>
    <Footer />
    <MobileFloatingNav />
  </body>
</html>
