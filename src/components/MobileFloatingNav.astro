---
import SearchModal from './ui/SearchModal.tsx';

const navItems = [
  {
    name: 'Inicio',
    url: '/',
    icon: 'M3 11l9-8 9 8 M5 10v10h4v-6h6v6h4V10',
  },
  {
    name: 'Números',
    url: '/numeros',
    icon: 'M12 3l9 5-9 5-9-5 9-5z M3 13l9 5 9-5',
  },
  {
    name: 'Categorías',
    url: '/categorias',
    icon: 'M20 12.5l-7.5 7.5a1 1 0 0 1-1.4 0L4 12.9V4h8.9l7.1 7.1a1 1 0 0 1 0 1.4z M8 8h.01',
  },
  {
    name: 'Archivo',
    url: '/archivo',
    icon: 'M3 4h18v4H3z M5 8v11h14V8 M10 12h4',
  },
];

const currentPath = Astro.url.pathname;
---

<nav
  class="fixed inset-x-4 bottom-4 z-30 flex items-stretch justify-between border border-ink bg-paper/95 px-1 py-1 shadow-[0_4px_20px_rgba(0,0,0,0.15)] backdrop-blur md:hidden"
  aria-label="Navegación móvil"
>
  {
    navItems.map((item) => {
      const isActive = currentPath === item.url;
      return (
        <a
          href={item.url}
          class:list={[
            'flex flex-1 flex-col items-center gap-0.5 px-2 py-1.5 font-mono text-[9px] uppercase tracking-wide transition-colors',
            isActive ? 'text-accent' : 'text-ink-muted',
          ]}
          aria-current={isActive ? 'page' : undefined}
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d={item.icon} />
          </svg>
          <span>{item.name}</span>
        </a>
      );
    })
  }

  <SearchModal client:load variant="compact" />
</nav>
