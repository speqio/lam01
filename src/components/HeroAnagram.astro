---
/**
 * Hero principal de la home inspirada en la referencia "Lam Flama": un bloque negro
 * muy limpio con capas de gradiente rojo animadas y tipografía editorial en la parte
 * inferior. Está pensado para funcionar en todos los tamaños de pantalla: móvil,
 * tablet y desktop, sin depender de una lógica pesada ni de una estructura compleja.
 *
 * Se mantiene el sistema visual del sitio (canvas/ink/accent, tipografía de cabecera,
 * monospace para etiquetas) y se usa GSAP para la animación del gradiente y del texto,
 * pero con una sola timeline simple y un render muy liviano.
 */
---

<div class="lam-flama-hero">
  <div class="lam-flama-stage" id="lam-flama-stage">
    <div class="lam-flama-overlay" aria-hidden="true"></div>
    <div class="lam-flama-grads" aria-hidden="true"></div>

    <div class="lam-flama-copy">
      <p class="lam-flama-kicker font-mono uppercase tracking-[0.28em] text-ink/70">
        Agosto de 2026
      </p>
      <h1 class="lam-flama-title font-headline leading-[0.9] tracking-[-0.05em] text-ink">
        Número 3: <span class="text-accent">Ciudades</span>
      </h1>
    </div>
  </div>
</div>

<style is:global>
  .lam-flama-hero {
    width: 100%;
    display: flex;
    justify-content: center;
    padding: 0.5rem 0 0;
  }

  .lam-flama-stage {
    position: relative;
    width: min(100%, 1200px);
    min-height: 72vh;
    height: min(78vh, 800px);
    overflow: hidden;
    background: #121212;
    border: 1px solid rgba(255, 255, 255, 0.08);
    isolation: isolate;
    cursor: pointer;
  }

  .lam-flama-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: transparent;
    mix-blend-mode: overlay;
    filter: url('#lam-flama-noise');
    pointer-events: none;
  }

  .lam-flama-grads {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    z-index: 1;
  }

  .lam-flama-row {
    height: clamp(22px, 3.1vw, 34px);
    width: 130%;
    margin-left: -15%;
    opacity: 0;
    background: linear-gradient(
      90deg,
      rgba(255, 70, 70, 0) 0%,
      rgba(255, 70, 70, 0.025) 4%,
      rgba(255, 70, 70, 0.08) 8%,
      rgba(255, 70, 70, 0.16) 12%,
      rgba(255, 70, 70, 0.25) 17%,
      rgba(255, 70, 70, 0.38) 22%,
      rgba(255, 70, 70, 0.52) 28%,
      rgba(255, 70, 70, 0.68) 34%,
      rgba(255, 70, 70, 0.84) 42%,
      rgba(255, 70, 70, 1) 50%,
      rgba(255, 70, 70, 0.84) 58%,
      rgba(255, 70, 70, 0.68) 66%,
      rgba(255, 70, 70, 0.52) 72%,
      rgba(255, 70, 70, 0.38) 78%,
      rgba(255, 70, 70, 0.25) 83%,
      rgba(255, 70, 70, 0.16) 88%,
      rgba(255, 70, 70, 0.08) 92%,
      rgba(255, 70, 70, 0.025) 96%,
      rgba(255, 70, 70, 0) 100%
    );
    transform: translateX(-28%);
  }

  .lam-flama-copy {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 3;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.25rem;
    padding: 1.25rem 1rem 1rem;
    transform: translateZ(0);
  }

  .lam-flama-kicker {
    font-size: 0.62rem;
  }

  .lam-flama-title {
    font-size: clamp(2.8rem, 9vw, 7.2rem);
    letter-spacing: -0.06em;
    line-height: 0.9;
    max-width: 11ch;
    text-transform: none;
  }

  @media (min-width: 768px) {
    .lam-flama-stage {
      min-height: 70vh;
      height: 78vh;
    }

    .lam-flama-copy {
      padding: 1.5rem 1.25rem 1.25rem;
    }

    .lam-flama-kicker {
      font-size: 0.7rem;
    }
  }
</style>

<svg aria-hidden="true" focusable="false" style="position:absolute;width:0;height:0;overflow:hidden">
  <filter id="lam-flama-noise">
    <feTurbulence type="fractalNoise" baseFrequency="0.6" numOctaves="1" result="noise" />
    <feColorMatrix in="noise" type="saturate" values="0" />
  </filter>
</svg>

<script>
  import { gsap } from 'gsap';

  const stage = document.getElementById('lam-flama-stage');
  if (!stage) {
    throw new Error('lam-flama-stage element not found');
  }

  const grads = Array.from({ length: 18 }, (_, index) => {
    const row = document.createElement('div');
    row.className = 'lam-flama-row';
    row.style.opacity = '0';
    row.style.zIndex = String(index + 1);
    return row;
  });

  const gradsContainer = stage.querySelector('.lam-flama-grads');
  if (!gradsContainer) {
    throw new Error('lam-flama-grads container not found');
  }

  grads.forEach((row) => gradsContainer.appendChild(row));

  const rows = Array.from(stage.querySelectorAll<HTMLElement>('.lam-flama-row'));

  const title = stage.querySelector<HTMLElement>('.lam-flama-title');
  const kicker = stage.querySelector<HTMLElement>('.lam-flama-kicker');

  const master = gsap.timeline({ repeat: -1, repeatDelay: 0.2 });

  master
    .fromTo(
      rows,
      { opacity: 0 },
      {
        opacity: 1,
        duration: 1.1,
        ease: 'sine.inOut',
        stagger: 0.12,
      }
    )
    .fromTo(
      rows,
      { x: '-32%' },
      {
        x: '32%',
        duration: 3.2,
        ease: 'sine.inOut',
        stagger: {
          each: 0.15,
          repeat: -1,
          yoyo: true,
        },
      },
      0.2
    );

  if (title && kicker) {
    gsap.fromTo(
      [title, kicker],
      { autoAlpha: 0, y: 18, rotateX: 70 },
      {
        autoAlpha: 1,
        y: 0,
        rotateX: 0,
        duration: 1.2,
        ease: 'power3.out',
        stagger: 0.2,
        delay: 0.4,
      }
    );
  }

  stage.addEventListener('click', () => {
    master.restart();
  });
</script>
