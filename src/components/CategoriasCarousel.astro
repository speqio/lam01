---
import type { CollectionEntry } from 'astro:content';

/**
 * Categorías del home — ya no es una tira de tarjetas con foto (esa versión, en
 * cualquiera de sus variantes, seguía dando problemas de renderizado en mobile que no
 * se pudieron acotar). Ahora es un ticker tipográfico: solo el nombre de cada
 * categoría, como links reales, en loop horizontal continuo — sin fotos, sin
 * tarjetas/bordes/rectángulos, mismo mecanismo en todos los tamaños de pantalla.
 *
 * Es CSS puro (`@keyframes` + `translateX(-50%)`, la pista duplica la lista de
 * categorías una vez para el loop sin costura) — sin JS. Sin fotos que decodificar ni
 * pintar, no hay ninguna razón para que esto le cueste nada al hilo principal en
 * ningún dispositivo, así que no hace falta la complejidad de rAF/scroll-snap/pausa
 * por interacción que tenía la versión con imágenes. Se pausa con :hover (mouse) y
 * :focus-within (teclado); en touch no hace falta pausar nada porque tocar un link no
 * compite con la animación (el tap registra en la posición visual del momento, se
 * mueva o no el track).
 */
interface Props {
  categorias: CollectionEntry<'categorias'>[];
}

const { categorias } = Astro.props;
---

{
  categorias.length > 0 && (
    <section class="relative mb-12">
      <div class="mb-6 md:hidden">
        <h2 class="font-headline text-2xl lg:text-3xl">Categorías</h2>
      </div>

      <div class="mb-6 hidden text-center md:block">
        <span class="mb-2 block font-mono text-xs uppercase tracking-widest text-ink/50">
          Revisá nuestro catálogo
        </span>
        <h2 class="font-headline text-4xl uppercase leading-none tracking-tight text-ink lg:text-6xl">
          Categorías
        </h2>
      </div>

      <div class="categorias-ticker-view">
        <div class="categorias-ticker-track">
          {categorias.map((categoria) => (
            <>
              <a
                href={`/categoria/${categoria.id}`}
                class="font-headline text-3xl font-bold uppercase leading-none tracking-tight text-ink transition-colors duration-200 hover:text-accent sm:text-4xl md:text-6xl"
              >
                {categoria.data.nombre}
              </a>
              <span
                class="mx-5 text-3xl leading-none text-ink/20 sm:text-4xl md:mx-8 md:text-6xl"
                aria-hidden="true"
              >
                /
              </span>
            </>
          ))}
          {categorias.map((categoria) => (
            <>
              <a
                href={`/categoria/${categoria.id}`}
                tabindex="-1"
                aria-hidden="true"
                class="font-headline text-3xl font-bold uppercase leading-none tracking-tight text-ink transition-colors duration-200 hover:text-accent sm:text-4xl md:text-6xl"
              >
                {categoria.data.nombre}
              </a>
              <span
                class="mx-5 text-3xl leading-none text-ink/20 sm:text-4xl md:mx-8 md:text-6xl"
                aria-hidden="true"
              >
                /
              </span>
            </>
          ))}
        </div>

        <div
          class="pointer-events-none absolute inset-y-0 left-0 z-10 w-10 bg-gradient-to-r from-canvas to-transparent md:w-24"
          aria-hidden="true"
        />
        <div
          class="pointer-events-none absolute inset-y-0 right-0 z-10 w-10 bg-gradient-to-l from-canvas to-transparent md:w-24"
          aria-hidden="true"
        />
      </div>
    </section>
  )
}

<style>
  .categorias-ticker-view {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .categorias-ticker-track {
    display: flex;
    align-items: baseline;
    width: max-content;
    white-space: nowrap;
    animation: categorias-ticker-scroll 34s linear infinite;
  }

  .categorias-ticker-view:hover .categorias-ticker-track,
  .categorias-ticker-track:has(:focus-visible) {
    animation-play-state: paused;
  }

  @keyframes categorias-ticker-scroll {
    from {
      transform: translateX(0);
    }
    to {
      /* La mitad del ancho total = el largo exacto del primer set (misma lista
         duplicada una vez más abajo). */
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .categorias-ticker-track {
      animation: none;
    }
  }
</style>
