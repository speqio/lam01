---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';

const autores = await getCollection('autores');
const entradas = await getCollection('entradas');

const autoresConConteo = autores
  .map((autor) => ({
    autor,
    cantidad: entradas.filter((entrada) => entrada.data.autor === autor.id).length,
  }))
  .sort((a, b) => a.autor.data.nombre.localeCompare(b.autor.data.nombre, 'es'));
---

<BaseLayout
  title="Autores — La Antorcha Magacín"
  description="Quiénes escriben en la revista, con su biografía y todo lo que publicaron."
>
  <PageHeader eyebrow="Firmas" title="Autores" />

  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      autoresConConteo.map(({ autor, cantidad }) => (
        <a
          href={`/autor/${autor.id}`}
          class="group flex items-center gap-4 border border-ink/15 bg-surface p-5 transition-colors hover:border-accent"
        >
          {autor.data.foto && (
            <img
              src={autor.data.foto}
              alt={autor.data.nombre}
              class="h-16 w-16 shrink-0 rounded-full border border-ink/15 object-cover"
            />
          )}
          <div class="min-w-0">
            <h2 class="font-serif text-lg text-ink group-hover:text-accent">
              {autor.data.nombre}
            </h2>
            <p class="font-sans text-xs uppercase tracking-wide text-ink-muted">
              {cantidad} {cantidad === 1 ? 'entrada' : 'entradas'}
            </p>
          </div>
        </a>
      ))
    }
  </div>

  {
    autoresConConteo.length === 0 && (
      <p class="text-center font-sans text-ink-muted">Todavía no hay autores cargados.</p>
    )
  }
</BaseLayout>
