---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileFloatingNav from '../components/MobileFloatingNav.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  sinFooter?: boolean;
}

const { title, description = 'Un blog de literatura: cuento, poesía y ensayo.', sinFooter = false } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <script is:inline>
      // Corre antes de que se pinte nada: fija data-theme desde localStorage (o "dark"
      // por defecto, la paleta original del sitio) para que el toggle no produzca un
      // flash de un tema y luego el otro al cargar la página.
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var theme = stored === 'light' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {}
      })();
      // Misma idea que el theme: clase "js" en <html> ANTES del primer paint. Las
      // cards con reveal-on-scroll (EntryCard.tsx) arrancan visibles en el HTML que
      // sirve el servidor; sin esto, el CSS las escondería incluso cuando JS está
      // deshabilitado (o mientras React todavía no hidrató, con `client:visible`,
      // que puede tardar), provocando un salto: card visible -> de golpe invisible ->
      // fade-in. Con "html.js" como selector, "sin JS" nunca las esconde (fallback
      // seguro: se ven de entrada, sin animación) y "con JS" las esconde desde el
      // primer frame, así que React solo las revela, nunca las hace desaparecer.
      document.documentElement.classList.add('js');
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-canvas text-ink flex flex-col font-sans">
    <Header />
    <main
      class="mx-auto w-full flex-grow px-4 py-8 pb-2 md:px-6 md:pb-8 lg:px-10"
    >
      <slot />
    </main>
    {!sinFooter && <Footer />}
    <MobileFloatingNav />
  </body>
</html>
