---
/**
 * Efecto "anagrama tipográfico": un set de frases literarias se van reordenando letra
 * por letra usando GSAP Flip — las letras que ya estaban en pantalla se mueven a su
 * nueva posición (no se destruyen y recrean), y solo las que sobran/faltan hacen fade
 * in/out. El emparejamiento "qué letra vieja se convierte en cuál letra nueva" lo
 * resuelve @algorithm.ts/lcs (longest common subsequence) sobre los códigos ASCII de
 * ambas palabras — el mismo mecanismo del CodePen original.
 *
 * Dos variantes del mismo componente, no dos componentes: `hero` (grande, centrado,
 * usado en la portada del home en mobile) y `header` (chico, alineado a la derecha,
 * vive dentro de Header.astro en desktop). El script corre sobre TODAS las instancias
 * en la página (`querySelectorAll('.hero-anagram-title')`, cada una con su propio
 * estado de animación) en vez de buscar un id único: Astro deduplica el contenido de
 * un <script> idéntico y solo lo incluye una vez por página, así que si ambas
 * variantes llegaran a convivir en el DOM (una oculta por CSS según breakpoint) un
 * `getElementById` solo habría animado la primera instancia encontrada.
 *
 * Es un componente 100% Astro/vanilla JS (sin React): no hay estado de UI que React
 * necesite manejar, es una animación DOM directa sobre un único <h1> por instancia —
 * encaja mejor con un script nativo que con una isla. (Ojo: no escribir la etiqueta
 * script con sus ángulos en este comentario — el pre-escaneo de dependencias de Vite
 * la toma por un bloque de script real y `astro dev` deja de arrancar. `astro build`
 * no se entera.)
 */

interface Props {
  variant?: 'hero' | 'header';
}

const { variant = 'hero' } = Astro.props;
---

<div
  class:list={[
    'hero-anagram-wrap',
    variant === 'hero' ? 'w-full overflow-hidden py-1' : 'w-max origin-left scale-[0.42]',
  ]}
>
  <h1
    class="hero-anagram-title relative min-h-[2.25rem] w-full text-center font-light leading-none text-ink text-[min(4.5vw,3rem)] sm:min-h-[3.25rem] lg:min-h-[4rem] lg:text-[min(4vw,3.75rem)]"
  ></h1>
</div>

<style is:global>
  .hero-anagram-title .char {
    position: relative;
    display: inline-block;
  }

  .hero-anagram-title .out {
    display: none;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { Flip } from 'gsap/Flip';
  import { lcs_dp } from '@algorithm.ts/lcs';

  gsap.registerPlugin(Flip);

  const options = [
    'la antorcha magacin',
    'pensamiento',
    'arte',
    'literatura',
  ];

  const titles = document.querySelectorAll<HTMLElement>('.hero-anagram-title');

  titles.forEach((title) => {
    const nameMap: Record<string, string> = { ' ': 'space', '.': 'dot' };
    const charMap: Record<string, string> = { ' ': '&nbsp;' };

    let tl: gsap.core.Timeline | null = null;
    let round = 0;
    let step = 0;

    const setTitle = (titleString: string) => {
      title.setAttribute('aria-label', titleString);

      const doTheFlip = () => {
        round++;

        const state = Flip.getState(title.querySelectorAll('.char'));

        const counts: Record<string, number> = {};
        const currentChars = [...title.querySelectorAll<HTMLElement>('.char')];
        const lastWord = currentChars
          .filter((d) => Number(d.dataset['round']) === round - 1)
          .map((d) => {
            const char = d.dataset['char'] ?? '';
            return {
              char,
              ascii: char.charCodeAt(0),
              id: d.dataset['flipId'],
            };
          });

        currentChars.forEach((char) => {
          char.classList.add('out');
        });

        tl = gsap.timeline();

        tl.to(currentChars, {
          opacity: 0,
          stagger: 0.01,
          y: -60,
          scale: 0,
          duration: 0.4,
          rotation: 'random(-90, 90)',
          ease: 'power2.in',
        });

        const newChars = titleString.split('');
        const newWord = newChars.map((char) => {
          const name = nameMap[char] || char;

          if (!counts[name]) counts[name] = 1;
          else counts[name]++;

          return {
            char,
            name,
            ascii: char.charCodeAt(0),
            id: `${name}-${round}-${counts[name]}`,
          };
        });

        const s1 = lastWord.map((d) => d.ascii);
        const s2 = newWord.map((d) => d.ascii);

        const lcsMap = lcs_dp(s1.length, s2.length, (x, y) => s1[x] === s2[y]);

        newWord.forEach((wordChar, i) => {
          let id = wordChar.id;
          if (lcsMap.length && lcsMap[0][1] === i) {
            const match = lcsMap.shift()!;
            id = lastWord[match[0]].id ?? id;
          }

          const span = document.createElement('span');
          span.classList.add('char');
          span.dataset['flipId'] = id;
          span.dataset['char'] = wordChar.char;
          span.dataset['round'] = String(round);
          span.setAttribute('aria-hidden', 'true');
          span.innerHTML = charMap[wordChar.char] || wordChar.char;

          title.append(span);
        });

        tl.add(
          // "back.*" (antes acá) overshoot-ea a propósito — se pasa del destino y
          // rebota de vuelta, lo cual lee como un salto/rebote en vez de un
          // asentamiento suave. "power3" llega directo, sin pasarse.
          Flip.from(state, {
            duration: 1,
            ease: 'power3.inOut',
            absolute: true,
            targets: title.querySelectorAll('.char'),
            scale: true,
            toggleClass: 'flipping',
            onEnter: (elements) =>
              gsap.fromTo(
                elements,
                { opacity: 0, scale: 0.5, y: 60, rotation: 'random(-90, 90)' },
                {
                  duration: 0.6,
                  y: 0,
                  rotation: 0,
                  delay: 0.6,
                  scale: 1,
                  opacity: 1,
                  stagger: 0.05,
                  ease: 'power3.out',
                }
              ),
          }),
          0.1
        );

        tl.add(() => {
          currentChars.forEach((d) => d.remove());
        });

        tl.add(() => {
          step++;
          setTitle(options[step % options.length]);
        }, '+=1');
      };

      if (tl && tl.progress() < 1) {
        tl.add(() => doTheFlip());
        if (tl.timeScale() === 1) {
          tl.timeScale(3);
        } else {
          tl.progress(1);
        }
      } else {
        doTheFlip();
      }
    };

    async function start() {
      await document.fonts.ready;
      setTitle(options[0]);
    }

    start();
  });
</script>

