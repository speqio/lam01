---
import { normalizeTitleText } from '../lib/text';
import { dialWrap, dialCount, dialTrack, dialThumb } from '../lib/dialNav';

/**
 * Rueda de categorías: cards en perspectiva 3D que rotan alrededor de un pivote muy
 * por debajo de ellas mismas (adaptado de un demo de referencia con `perspective` +
 * `transform-style: preserve-3d`, en vez del abanico plano anterior), controlada con
 * el mismo criterio que el resto de los carruseles del sitio: rueda del mouse o
 * arrastre 1:1 mientras se sostiene, más un snap con inercia al soltar
 * (`gsap.quickTo`) — nada de temporizadores ni reordenar el DOM.
 *
 * A diferencia de la versión anterior, cada card no lleva badge ni contador de
 * entradas — solo la imagen fija de la categoría. El nombre de la categoría enfocada
 * se muestra aparte, en un título que cambia con la rotación (`updateTitle`), sin
 * texto de acompañamiento.
 */
export interface CategoriaCardItem {
  slug: string;
  nombre: string;
  coverImage?: string;
}

interface Props {
  categorias: CategoriaCardItem[];
}

const { categorias } = Astro.props;
---

{
  categorias.length > 0 && (
    <div class="categorias-wheel-outer">
      <div class="categorias-wheel-stage" id="categorias-wheel-stage">
        <div class="categorias-wheel-track" id="categorias-wheel-track">
          {categorias.map((categoria, index) => (
            <a
              href={`/categoria/${categoria.slug}`}
              class="categorias-wheel-card"
              data-index={index}
              data-nombre={normalizeTitleText(categoria.nombre)}
              aria-label={normalizeTitleText(categoria.nombre)}
            >
              {categoria.coverImage && (
                <img
                  src={categoria.coverImage}
                  alt=""
                  class="categorias-wheel-card-img h-full w-full object-cover grayscale contrast-125"
                  loading="lazy"
                  draggable="false"
                />
              )}
            </a>
          ))}
        </div>

        {/* Difuminado en los bordes donde la rueda se corta contra el borde de la
            escena, igual criterio que el abanico anterior. */}
        <div class="categorias-wheel-fade categorias-wheel-fade--left" aria-hidden="true" />
        <div class="categorias-wheel-fade categorias-wheel-fade--right" aria-hidden="true" />
        <div class="categorias-wheel-fade-bottom" aria-hidden="true" />
      </div>

      <div class="categorias-wheel-info">
        <h3 class="categorias-wheel-title" id="categorias-wheel-title">
          {normalizeTitleText(categorias[0].nombre)}
        </h3>

        {
          categorias.length > 1 && (
            <div class="categorias-wheel-nav">
              <button
                type="button"
                class="categorias-wheel-nav-btn"
                data-wheel-prev
                aria-label="Categoría anterior"
              >
                &#10094;
              </button>
              <button
                type="button"
                class="categorias-wheel-nav-btn"
                data-wheel-next
                aria-label="Categoría siguiente"
              >
                &#10095;
              </button>
            </div>
          )
        }
      </div>

      {
        categorias.length > 1 && (
          <div class={`categorias-wheel-dial ${dialWrap}`}>
            <span class={dialCount} data-dial-count>
              {`01 / ${String(categorias.length).padStart(2, '0')}`}
            </span>
            <div class={dialTrack}>
              <div class={dialThumb} data-dial-thumb />
            </div>
          </div>
        )
      }
    </div>
  )
}

<style>
  .categorias-wheel-stage {
    position: relative;
    width: 100%;
    height: 13rem;
    overflow: hidden;
    touch-action: pan-y;
    cursor: grab;
    perspective: 1400px;
  }

  .categorias-wheel-stage:active {
    cursor: grabbing;
  }

  .categorias-wheel-track {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    transform-style: preserve-3d;
  }

  .categorias-wheel-card {
    position: absolute;
    left: 0;
    top: 0;
    display: block;
    overflow: hidden;
    width: 8.5rem;
    /* Las ilustraciones de categoría son horizontales (1200×1000, con su propio marco
       tipo postal) — la proporción de la card sigue la de la imagen real (6:5) para
       que `object-fit: cover` no las recorte, a diferencia de las cards de
       entrada/número (verticales) que usan otra relación de aspecto. */
    aspect-ratio: 6 / 5;
    margin-left: -4.25rem;
    margin-top: -3.54rem;
    user-select: none;
    -webkit-user-drag: none;
    /* Sin fondo propio: las ilustraciones son PNG con transparencia real (confirmado
       — su canal alfa no está en 255 parejo) recortadas en un rectángulo apenas
       inclinado sobre el lienzo 1200×1000. Un fondo sólido acá se veía como un
       bloque de color detrás de esa transparencia en vez de dejar que se funda con
       el canvas de la página. */
    background: transparent;
    border: 1px solid rgb(var(--color-ink) / 0.15);
    transition: border-color 200ms ease;
    /* El pivote de rotación está muy por debajo de la card, dando el efecto de rueda
       (mismo truco que el abanico anterior, ahora sumado a `perspective` en el
       contenedor para que las cards de los costados se vean giradas en el espacio). */
    transform-origin: 50% 480%;
  }

  .categorias-wheel-card:hover,
  .categorias-wheel-card:focus-visible {
    border-color: rgb(var(--color-accent));
  }

  .categorias-wheel-card[data-wheel-hidden] {
    display: none;
  }

  /* La ilustración está apenas rotada dentro de su lienzo transparente y trae un
     borde tipo postal (papel crema) propio del arte original — se recorta con este
     zoom para que la card muestre solo el dibujo, sin esa franja más clara en los
     bordes ni el ángulo de la rotación original asomando. */
  .categorias-wheel-card-img {
    /* Las 10 ilustraciones comparten exactamente la misma plantilla (mismo bounding
       box de contenido opaco, medido con sharp): el dibujo real ocupa un rectángulo
       centrado en x pero corrido hacia arriba en y dentro del lienzo 1200×1000 —
       el marco crema queda fuera de este recorte en vez de asomar en un extremo. */
    transform: scale(1.92) translateY(7.5%);
  }

  .categorias-wheel-fade {
    position: absolute;
    top: 0;
    width: 22%;
    height: 100%;
    pointer-events: none;
    z-index: 5;
  }

  .categorias-wheel-fade--left {
    left: 0;
    background: linear-gradient(to right, rgb(var(--color-canvas)), transparent);
  }

  .categorias-wheel-fade--right {
    right: 0;
    background: linear-gradient(to left, rgb(var(--color-canvas)), transparent);
  }

  /* Igual criterio que left/right pero en el borde inferior de la escena, donde las
     cards rotadas se cortan contra `overflow: hidden` — sin esto el corte se ve
     como un borde recto y duro en vez de fundirse con el fondo de la página. */
  .categorias-wheel-fade-bottom {
    position: absolute;
    inset: auto 0 0 0;
    height: 35%;
    pointer-events: none;
    z-index: 5;
    background: linear-gradient(to bottom, transparent, rgb(var(--color-canvas)) 90%);
  }

  .categorias-wheel-info {
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    text-align: center;
  }

  .categorias-wheel-title {
    font-family: var(--font-headline, 'Lekton', 'Arial', sans-serif);
    font-size: 1.5rem;
    line-height: 1.1;
    color: rgb(var(--color-ink));
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .categorias-wheel-nav {
    display: flex;
    gap: 1rem;
  }

  .categorias-wheel-nav-btn {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 9999px;
    border: 1px solid rgb(var(--color-ink) / 0.3);
    background: transparent;
    color: rgb(var(--color-ink));
    font-size: 1rem;
    line-height: 1;
    cursor: pointer;
    transition: border-color 200ms ease, color 200ms ease;
  }

  .categorias-wheel-nav-btn:hover,
  .categorias-wheel-nav-btn:focus-visible {
    border-color: rgb(var(--color-accent));
    color: rgb(var(--color-accent));
  }

  .categorias-wheel-dial {
    width: min(70%, 16rem);
    margin: 1.5rem auto 0;
  }

  @media (min-width: 768px) {
    .categorias-wheel-stage {
      height: 16.5rem;
    }

    .categorias-wheel-card {
      width: 13rem;
      margin-left: -6.5rem;
      margin-top: -5.42rem;
    }

    .categorias-wheel-title {
      font-size: 2rem;
    }
  }

  @media (min-width: 1024px) {
    .categorias-wheel-stage {
      height: 20rem;
    }

    .categorias-wheel-card {
      width: 16rem;
      margin-left: -8rem;
      margin-top: -6.67rem;
    }

    .categorias-wheel-title {
      font-size: 2.5rem;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { Observer } from 'gsap/Observer';

  gsap.registerPlugin(Observer);

  // Ángulo entre cards contiguas — con `perspective` en el contenedor, un ángulo más
  // chico que el abanico anterior ya deja ver bien la curvatura de la rueda.
  const ANGLE_STEP_MOBILE = 9;
  const ANGLE_STEP_DESKTOP = 10;
  const WHEEL_SENSITIVITY = 0.012;
  const DRAG_SENSITIVITY = 0.014;

  // En mobile las cards son más grandes en proporción a la pantalla — mostrar todas
  // las categorías ahí las achica demasiado. Mejor mostrar menos, más grandes.
  const MOBILE_VISIBLE_LIMIT = 6;

  function shortestDistance(index: number, position: number, total: number) {
    let dist = (((index - position) % total) + total) % total;
    if (dist > total / 2) dist -= total;
    return dist;
  }

  function initCategoriasWheel() {
    const stage = document.getElementById('categorias-wheel-stage');
    const track = document.getElementById('categorias-wheel-track');
    if (!(stage instanceof HTMLElement) || !(track instanceof HTMLElement)) return;

    const allCards = Array.from(track.querySelectorAll<HTMLAnchorElement>('.categorias-wheel-card'));
    const isMobile = !window.matchMedia('(min-width: 768px)').matches;
    const visibleCount = isMobile ? Math.min(MOBILE_VISIBLE_LIMIT, allCards.length) : allCards.length;
    const ANGLE_STEP = isMobile ? ANGLE_STEP_MOBILE : ANGLE_STEP_DESKTOP;

    const cards = allCards.slice(0, visibleCount);
    allCards.slice(visibleCount).forEach((card) => card.setAttribute('data-wheel-hidden', ''));

    const total = cards.length;
    if (total === 0) return;

    const outer = stage.closest('.categorias-wheel-outer');
    const titleEl = outer?.querySelector<HTMLElement>('#categorias-wheel-title') ?? null;
    const thumb = outer?.querySelector<HTMLElement>('[data-dial-thumb]') ?? null;
    const countEl = outer?.querySelector<HTMLElement>('[data-dial-count]') ?? null;
    const dialTrackEl = thumb?.parentElement ?? null;
    const prevBtn = outer?.querySelector<HTMLButtonElement>('[data-wheel-prev]') ?? null;
    const nextBtn = outer?.querySelector<HTMLButtonElement>('[data-wheel-next]') ?? null;
    if (thumb && dialTrackEl) {
      thumb.style.width = `${100 / total}%`;
    }

    const pos = { value: 0 };
    let lastActiveIndex = 0;

    function render() {
      cards.forEach((card, i) => {
        const dist = shortestDistance(i, pos.value, total);
        const absDist = Math.abs(dist);
        const isActive = absDist < 0.5;

        gsap.set(card, {
          rotate: gsap.utils.clamp(-90, 90, dist * ANGLE_STEP),
          scale: isActive ? 1.08 : 1,
          filter: `brightness(${isActive ? 1 : Math.max(0.35, 1 - absDist * 0.22)})`,
          zIndex: Math.round(100 - absDist * 10),
        });
      });

      const activeIndex = ((Math.round(pos.value) % total) + total) % total;
      if (titleEl && activeIndex !== lastActiveIndex) {
        lastActiveIndex = activeIndex;
        titleEl.textContent = cards[activeIndex].dataset.nombre ?? '';
      } else if (titleEl && !titleEl.textContent) {
        titleEl.textContent = cards[activeIndex].dataset.nombre ?? '';
      }

      if (thumb && dialTrackEl && countEl) {
        const ratio = activeIndex / total;
        const trackWidth = dialTrackEl.clientWidth;
        const thumbWidth = trackWidth / total;
        gsap.to(thumb, { x: ratio * (trackWidth - thumbWidth), duration: 0.2, ease: 'power2.out', overwrite: true });
        countEl.textContent = `${String(activeIndex + 1).padStart(2, '0')} / ${String(total).padStart(2, '0')}`;
      }
    }

    const snapTo = gsap.quickTo(pos, 'value', {
      duration: 0.55,
      ease: 'power3.out',
      onUpdate: render,
    });

    render();

    function move(dir: number) {
      // No gsap.killTweensOf(pos) acá: quickTo ya reapunta en caliente el mismo
      // tween interno — matarlo entre clicks sucesivos rompe esa referencia y el
      // snap deja de responder al segundo click.
      snapTo(Math.round(pos.value) + dir);
    }

    prevBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      move(-1);
    });
    nextBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      move(1);
    });

    Observer.create({
      target: stage,
      type: 'wheel',
      preventDefault: true,
      onChangeY: (self) => {
        gsap.killTweensOf(pos);
        pos.value += self.deltaY * WHEEL_SENSITIVITY;
        render();
      },
      onStop: () => snapTo(Math.round(pos.value)),
    });

    Observer.create({
      target: stage,
      type: 'touch,pointer',
      preventDefault: true,
      onPress: () => gsap.killTweensOf(pos),
      onChange: (self) => {
        pos.value -= self.deltaX * DRAG_SENSITIVITY;
        render();
      },
      onRelease: () => snapTo(Math.round(pos.value)),
    });
  }

  const stage = document.getElementById('categorias-wheel-stage');
  if (stage && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          initCategoriasWheel();
          observer.disconnect();
        }
      },
      { rootMargin: '200px' }
    );
    observer.observe(stage);
  } else {
    initCategoriasWheel();
  }
</script>
