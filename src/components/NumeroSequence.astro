---
import NumeroEntradasDial from './NumeroEntradasDial.astro';

/**
 * Secuencia editorial para la página de un número: info fija (título/fecha/
 * descripción) + tarjetas de sus entradas. El texto es compartido entre pantallas,
 * pero el carrusel de tarjetas usa DOS componentes distintos según el tamaño:
 *
 * - Desktop (md+): coverflow con scroll virtual, adaptado de un CodePen de referencia
 *   (pista vertical infinita con `wheel`/`touch`). El plugin `Observer` de GSAP
 *   captura wheel/touch apuntando al contenedor, nunca a `window` — la referencia era
 *   una demo de una sola pantalla que podía capturar todo el scroll del documento;
 *   acá hay header/footer/resto del sitio, así que capturar scroll global dejaría al
 *   usuario atrapado. Al apuntar Observer al elemento, el navegador solo dispara el
 *   evento cuando el cursor está físicamente encima — mover el mouse afuera devuelve
 *   el scroll normal. El loop de render (posición/escala/opacidad de cada tarjeta
 *   según distancia al centro, y el lerp de `--seq-progress` que achica el título)
 *   corre sobre `gsap.ticker`/`gsap.quickTo`.
 *
 * - Mobile: NumeroEntradasDial.astro (carrusel tipo dial arrastrable, sin scroll de la
 *   página involucrado). Antes mobile reusaba la misma mecánica que desktop pero
 *   manejada con scroll real pasivo dentro de un carril alto medido en JS — daba
 *   problemas recurrentes en mobile (posiblemente ligado a números con pocas
 *   entradas), así que se reemplazó por un componente estructuralmente distinto en
 *   vez de seguir depurando esa mecánica puntual.
 */
interface EntradaItem {
  slug: string;
  titulo: string;
  categoriaNombre: string;
  autorNombre: string;
  portada?: string;
}

interface Props {
  titulo: string;
  descripcion?: string;
  fechaFormateada: string;
  entradas: EntradaItem[];
}

const { titulo, descripcion, fechaFormateada, entradas } = Astro.props;
---

<section
  id="numero-sequence"
  class="relative w-full overflow-hidden md:grid md:h-[75vh] md:grid-cols-2 md:gap-10"
>
  <div class="numero-sequence-info flex flex-col justify-center px-4 md:sticky md:top-20 md:z-10 md:min-w-0 md:self-start md:px-0">
    <p class="font-mono text-xs uppercase tracking-widest text-ink-muted">{fechaFormateada}</p>
    <h1 class="numero-sequence-title mt-2 font-headline leading-[0.9] text-ink">{titulo}</h1>
    {
      descripcion && (
        <p class="numero-sequence-desc mt-4 max-w-md overflow-hidden font-serif text-ink-muted">
          {descripcion}
        </p>
      )
    }
  </div>

  <div class="md:hidden">
    <NumeroEntradasDial entradas={entradas} />
  </div>

  <div class="numero-sequence-runway relative hidden w-full md:block md:h-full">
    <div class="numero-sequence-track static h-full w-full overflow-visible">
      {
        entradas.map((item) => (
          <a
            href={`/entrada/${item.slug}`}
            class="numero-sequence-card group absolute left-1/2 top-1/2 w-full min-w-0 max-w-md md:max-w-xl lg:max-w-2xl"
          >
            <div class="flex h-56 w-full overflow-hidden border border-ink/15 bg-surface md:h-80 lg:h-96">
              <div class="relative h-full w-2/5 shrink-0 bg-surface">
                {item.portada && (
                  <img
                    src={item.portada}
                    alt=""
                    class="pointer-events-none h-full w-full object-cover grayscale contrast-125"
                    loading="lazy"
                  />
                )}
                <span class="absolute left-2 top-2 bg-accent px-2.5 py-1.5 font-mono text-[10px] font-bold uppercase tracking-widest text-canvas md:px-3.5 md:py-2 md:text-sm">
                  {item.categoriaNombre}
                </span>
              </div>
              <div class="flex w-3/5 flex-col gap-1 p-4 md:gap-2 md:p-6">
                <h3 class="font-headline text-lg uppercase leading-[1.05] text-ink md:text-2xl lg:text-3xl">
                  {item.titulo}
                </h3>
                <p class="font-mono text-[10px] uppercase tracking-widest text-ink-muted md:text-xs">
                  Por {item.autorNombre}
                </p>
                <span class="mt-auto font-mono text-xs font-medium uppercase tracking-widest text-accent group-hover:underline md:text-sm">
                  Leer entrada
                </span>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  #numero-sequence {
    /* Mobile: arranca directo en compacto (1) — sin scroll virtual ni sticky ahí, el
       título ya se ve en su tamaño final desde el principio. Desktop la pisa con 0 y
       la anima el script en base al wheel. */
    --seq-progress: 1;
  }

  @media (min-width: 768px) {
    #numero-sequence {
      --seq-progress: 0;
    }
  }

  /* Todo lo que depende del progreso del scroll se interpola en CSS a partir de la
     custom property que el script actualiza cada frame — el script solo escribe un
     número, nunca toca font-size/opacity directamente. */
  .numero-sequence-title {
    font-size: clamp(1.75rem, calc(4rem - var(--seq-progress) * 2.1rem), 4.5rem);
  }

  .numero-sequence-desc {
    opacity: calc(1 - var(--seq-progress) * 1.6);
    max-height: calc((1 - var(--seq-progress)) * 10rem);
    transition: opacity 0.1s linear;
  }

  .numero-sequence-hint {
    opacity: calc(1 - var(--seq-progress) * 3);
  }

  .numero-sequence-card {
    will-change: transform, opacity;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { Observer } from 'gsap/Observer';

  gsap.registerPlugin(Observer);

  // Este componente ahora es desktop-only para el carrusel (mobile usa
  // NumeroEntradasDial.astro, ver frontmatter) — bail-out temprano evita trabajo de
  // más sobre las `.numero-sequence-card`, que siguen en el DOM en mobile (ocultas
  // por CSS vía `hidden md:block` en el contenedor, no removidas del documento).
  const isDesktop = window.matchMedia('(min-width: 768px)').matches;
  const stage = document.getElementById('numero-sequence');

  if (stage && isDesktop) {
    const cards = Array.from(stage.querySelectorAll<HTMLElement>('.numero-sequence-card'));

    if (cards.length > 0) {
      const SPACING = 260;
      const SHRINK_DISTANCE = 320;

      let scrollOffset = 0;

      // Lerp de `--seq-progress` (achica el título / desvanece la descripción) vía
      // GSAP en vez de un `+= (target - actual) * 0.12` a mano cada frame: mismo
      // "frenado suave" pero independiente del framerate, y `quickTo` está pensado
      // justo para esto — llamarlo de nuevo en cada frame con un target que cambia
      // (acá, `infoTarget`) sin que la animación arranque de cero cada vez.
      const infoProxy = { value: 0 };
      const animateInfoProgress = gsap.quickTo(infoProxy, 'value', {
        duration: 0.4,
        ease: 'power3',
        onUpdate: () => stage.style.setProperty('--seq-progress', infoProxy.value.toFixed(3)),
      });

      // wheel/touch capturados y bloqueados (preventDefault en wheel), seguro porque
      // Observer apunta al elemento, no a window (ver comentario del frontmatter). Dos
      // Observer separados (no un solo `type: 'wheel,touch'`) para mantener el
      // multiplicador y el preventDefault distintos que tenía cada gesto originalmente.
      Observer.create({
        target: stage,
        type: 'wheel',
        preventDefault: true,
        onChange: (self) => {
          scrollOffset = Math.max(0, scrollOffset + self.deltaY * 0.5);
        },
      });

      Observer.create({
        target: stage,
        type: 'touch',
        onChange: (self) => {
          scrollOffset = Math.max(0, scrollOffset + self.deltaY * 0.8);
        },
      });

      const update = () => {
        const total = cards.length;

        const infoTarget = Math.min(scrollOffset / SHRINK_DISTANCE, 1);
        animateInfoProgress(infoTarget);

        cards.forEach((card, i) => {
          let progress = (i * SPACING - scrollOffset) % (total * SPACING);
          if (progress < -SPACING) progress += total * SPACING;
          if (progress > total * SPACING - SPACING) progress -= total * SPACING;

          const distanceNormalized = Math.abs(progress) / 400;
          const scale = Math.max(0.7, 1 - distanceNormalized * 0.3);
          const opacity = Math.max(0, 1 - distanceNormalized * 1.2);
          const zIndex = Math.round(100 - Math.abs(progress));

          // xPercent/yPercent (centrado) + y en px (desplazamiento) se combinan en un
          // solo transform — GSAP arma el equivalente a translate3d(-50%, calc(-50% +
          // Npx), 0) solo, sin necesidad de armar el string a mano.
          gsap.set(card, { xPercent: -50, yPercent: -50, y: progress, scale, opacity, zIndex });
        });
      };

      gsap.ticker.add(update);
    }
  }
</script>
