---
import { cardBadge } from '../lib/cardStyles';
import { normalizeTitleText } from '../lib/text';

/**
 * Versión mobile de /archivo — reemplaza a la hélice 3D de desktop (ArchivoHelix.astro)
 * con columnas de cards que caen en loop automático, adaptado de una referencia de
 * testimonios (columnas con `animation: translateY` infinita + fades arriba/abajo).
 * Cards sin ningún ángulo/perspectiva 3D, "de frente" — a diferencia de la hélice, esto
 * es CSS puro (@keyframes), no JS por frame: no hace falta GSAP acá, es la herramienta
 * más simple posible para un loop declarativo, y además significa que el componente
 * nunca captura ningún gesto (ni drag ni scroll) — la página se sigue scrolleando 100%
 * nativo por encima, sin el riesgo de "atrapar" el gesto que sí existe en la hélice.
 *
 * Loop sin salto: cada columna repite su lista de items DOS VECES seguidas en el DOM y
 * anima `translateY` entre 0% y -50% — al llegar a -50% se ve exactamente igual que el
 * arranque (porque ahí empieza la copia idéntica), así que el reinicio del keyframe es
 * invisible. La referencia original no duplicaba el contenido, lo que hace que el loop
 * salte de golpe.
 */
export interface ArchivoCascadeItem {
  slug: string;
  title: string;
  authorName: string;
  categoryName: string;
  coverImage?: string;
}

interface Props {
  items: ArchivoCascadeItem[];
}

const { items } = Astro.props;

const COLUMN_COUNT = 2;
const columns: ArchivoCascadeItem[][] = Array.from({ length: COLUMN_COUNT }, () => []);
items.forEach((item, i) => columns[i % COLUMN_COUNT].push(item));

const SECONDS_PER_CARD = 7;
---

{
  items.length > 0 && (
    <div class="archivo-cascade">
      {columns.map((columnItems, i) => (
        <div
          class="archivo-cascade-col"
          data-dir={i % 2 === 0 ? 'down' : 'up'}
          style={`animation-duration: ${Math.max(columnItems.length, 1) * SECONDS_PER_CARD}s`}
        >
          {[...columnItems, ...columnItems].map((item, dupIndex) => (
            <a
              href={`/entrada/${item.slug}`}
              class="archivo-cascade-card"
              aria-hidden={dupIndex >= columnItems.length ? 'true' : undefined}
              tabindex={dupIndex >= columnItems.length ? -1 : undefined}
            >
              <div class="archivo-cascade-image">
                {item.coverImage && (
                  <img
                    src={item.coverImage}
                    alt=""
                    class="h-full w-full object-cover grayscale contrast-125"
                    loading="lazy"
                  />
                )}
                <span class={cardBadge}>{item.categoryName}</span>
              </div>
              <div class="archivo-cascade-body">
                <h3 class="font-headline text-sm leading-[1.1] text-ink line-clamp-2">
                  {normalizeTitleText(item.title)}
                </h3>
                <p class="mt-1 font-mono text-[10px] uppercase tracking-widest text-ink-muted">
                  Por {item.authorName}
                </p>
              </div>
            </a>
          ))}
        </div>
      ))}
    </div>
  )
}

<style>
  .archivo-cascade {
    position: relative;
    display: flex;
    /* flex-start, NO stretch (el default): con stretch, cada columna se estira a la
       altura fija de acá abajo y sus cards (flex-shrink:1 por defecto, sin min-height)
       se comprimen todas para entrar ahí — se ven como líneas finitas en vez de cards.
       Con flex-start la columna crece a su alto natural (mucho más que esto) y el
       overflow:hidden de acá recorta lo que sobra, que es lo que se quiere. */
    align-items: flex-start;
    gap: 0.75rem;
    height: 62vh;
    max-height: 540px;
    overflow: hidden;
  }

  .archivo-cascade::before,
  .archivo-cascade::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 4.5rem;
    z-index: 2;
    pointer-events: none;
  }

  .archivo-cascade::before {
    top: 0;
    background: linear-gradient(to bottom, #121212, transparent);
  }

  .archivo-cascade::after {
    bottom: 0;
    background: linear-gradient(to top, #121212, transparent);
  }

  .archivo-cascade-col {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-width: 0;
    animation-name: archivo-cascade-down;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
    will-change: transform;
  }

  .archivo-cascade-col[data-dir='up'] {
    animation-name: archivo-cascade-up;
  }

  @keyframes archivo-cascade-down {
    from {
      transform: translateY(-50%);
    }
    to {
      transform: translateY(0);
    }
  }

  @keyframes archivo-cascade-up {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(-50%);
    }
  }

  .archivo-cascade-card {
    display: block;
    flex-shrink: 0;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: #292929;
  }

  .archivo-cascade-image {
    position: relative;
    aspect-ratio: 4 / 5;
    background: #292929;
  }

  .archivo-cascade-body {
    padding: 0.6rem 0.65rem 0.75rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .archivo-cascade-col {
      animation: none;
    }
  }
</style>
