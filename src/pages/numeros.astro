---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import CarpetaNumero from '../components/ui/CarpetaNumero.astro';
import type { EstampillaItem } from '../components/ui/ColeccionEstampillas.astro';
import { splitNumeroTitle, normalizeTitleText } from '../lib/text';

// "octubre de 2026" -> "oct·26": abreviatura de mes (3 letras) + separador de viñeta +
// dos últimos dígitos del año. getUTCMonth/getUTCFullYear, no local, por la misma razón
// que el resto del archivo usa timeZone:'UTC' — evita que la fecha se lea un día
// distinto según la zona horaria del navegador.
const MESES_ABREV = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'];

function formatoBadgeFecha(fecha: Date) {
  const mes = MESES_ABREV[fecha.getUTCMonth()];
  const anio = String(fecha.getUTCFullYear()).slice(-2);
  return `${mes}·${anio}`;
}

// "sin-numero" es el contenedor interno de las entradas sin numero asignado: no es una
// edicion, no tiene pagina publica (ver [slug].astro) y no debe tener carpeta.
const numeros = (await getCollection('numeros')).filter((numero) => numero.id !== 'sin-numero');

/** El indice de una edicion sale de su slug (`numero-9`, `numero-13`), no del titulo, que
    puede llevar subtitulo y mayusculas. */
function numeroIndice(numero: { id: string }) {
  const match = numero.id.match(/(\d+)/);
  return match ? parseInt(match[0], 10) : 0;
}

/**
 * Orden ascendente por INDICE, del 1 al ultimo: la grilla se lee como la coleccion
 * completa en su orden natural, y es el orden que se ve con el chip "Todos" puesto (el
 * filtro solo esconde carpetas, nunca reordena el DOM). Por indice y no por `fecha` a
 * proposito: la fecha puede traer una errata --numero-26 tiene 2026-10-05 cuando sus
 * entradas son de 2025-- y entonces el 26 se colaba entre los ultimos. El indice sale del
 * slug, que es el unico dato garantizado numerico y estable.
 */
const numerosOrdenados = numeros.sort((a, b) => numeroIndice(a) - numeroIndice(b));

/**
 * Las entradas de cada número, agrupadas una sola vez. A diferencia del resto de las
 * páginas (que resuelven autor/categoría con getEntry por entrada, ver "No joins" en
 * CLAUDE.md), acá se arman mapas con las tres colecciones completas: esta página las
 * necesita TODAS, y un getEntry por relación serían cientos de lecturas para el mismo
 * puñado de autores y categorías.
 */
const autores = new Map((await getCollection('autores')).map((a) => [a.id, a.data.nombre]));
const categorias = new Map(
  (await getCollection('categorias')).map((c) => [c.id, c.data.nombre])
);

const entradasPorNumero = new Map<string, EstampillaItem[]>();

for (const entrada of (await getCollection('entradas')).sort(
  (a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf()
)) {
  const grupo = entradasPorNumero.get(entrada.data.numero) ?? [];
  grupo.push({
    title: normalizeTitleText(entrada.data.titulo),
    authorName: autores.get(entrada.data.autor),
    translatorName: entrada.data.traducidoPor ? autores.get(entrada.data.traducidoPor) : undefined,
    categoryName: categorias.get(entrada.data.categoria),
    slug: entrada.id,
    coverImage: entrada.data.portada,
  });
  entradasPorNumero.set(entrada.data.numero, grupo);
}

/**
 * Chips para filtrar por rango ("1–5", "6–10", ...) en vez de listar los números todos
 * juntos — pensado para cuando haya varias decenas de ediciones, no solo las pocas que
 * hay hoy. El número de cada edición sale de su slug (`numero-9`, `numero-13`,...), no
 * del título (que puede llevar subtítulo, mayúsculas, etc.) porque el slug es el único
 * dato garantizado numérico y estable. Los rangos se calculan a partir del número más
 * alto que exista — no están hardcodeados a "hasta 30" — así que agregar más números
 * más adelante simplemente agrega más chips, sin tocar este archivo.
 */
const RANGO_SIZE = 5;

const indices = numerosOrdenados.map(numeroIndice);
const maxIndice = indices.length > 0 ? Math.max(...indices) : 0;
const totalRangos = Math.max(1, Math.ceil(maxIndice / RANGO_SIZE));

const rangos = Array.from({ length: totalRangos }, (_, i) => ({
  id: i,
  desde: i * RANGO_SIZE + 1,
  hasta: i * RANGO_SIZE + RANGO_SIZE,
}));

const chipClass =
  'numeros-chip rounded-full border border-ink/20 px-4 py-1.5 font-mono text-xs lowercase tracking-widest text-ink-muted transition-colors hover:border-ink/40 data-[active=true]:border-transparent';
---

<BaseLayout
  title="Números — La Antorcha Magacín"
  description="Todas las ediciones publicadas de la revista, del primer número al último."
>
  <PageHeader eyebrow="Ediciones" title="Números" />

  {
    rangos.length > 1 && (
      <div
        class="numeros-chips mb-8 flex flex-wrap justify-center gap-2"
        role="group"
        aria-label="Filtrar números por rango"
      >
        <button type="button" class={chipClass} data-rango-filter="all" data-active="true">
          Todos
        </button>
        {rangos.map((rango) => (
          <button type="button" class={chipClass} data-rango-filter={rango.id}>
            {rango.desde}–{rango.hasta}
          </button>
        ))}
      </div>
    )
  }

  {/* Grilla de carpetas verticales. Cada una es un link a la página de su número. */}
  <div class="grid grid-cols-2 gap-x-8 gap-y-14 md:grid-cols-3 md:gap-x-12 md:gap-y-20 xl:grid-cols-4">
    {
      numerosOrdenados.map((numero) => {
        const { titulo, subtitulo } = splitNumeroTitle(numero.data.titulo);
        const indice = numeroIndice(numero);
        return (
          <CarpetaNumero
            numero={indice}
            titulo={titulo}
            subtitulo={subtitulo}
            portada={numero.data.portada}
            href={`/${numero.id}`}
            fecha={formatoBadgeFecha(numero.data.fecha)}
            items={entradasPorNumero.get(numero.id) ?? []}
            rangoId={Math.floor((indice - 1) / RANGO_SIZE)}
          />
        );
      })
    }
  </div>

  {
    numerosOrdenados.length === 0 && (
      <p class="text-center font-sans text-ink-muted">Todavía no hay números publicados.</p>
    )
  }
</BaseLayout>

<script>
  // Filtro por chips: solo esconde/muestra carpetas ya renderizadas (sin fetch ni
  // reordenar el DOM), comparando el rango del chip activo contra data-numero-rango de
  // cada una. Nada de GSAP acá — es un toggle de visibilidad, no una animación.
  // `hidden` (display:none) le gana al `display: contents` de la carpeta, así que
  // esconde la tapa y su panel juntos.
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.numeros-chip'));
  const carpetas = Array.from(document.querySelectorAll<HTMLElement>('[data-numero-rango]'));

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const filtro = chip.dataset.rangoFilter;

      chips.forEach((c) => {
        c.dataset.active = String(c === chip);
      });

      carpetas.forEach((carpeta) => {
        const coincide = filtro === 'all' || carpeta.dataset.numeroRango === filtro;
        carpeta.classList.toggle('hidden', !coincide);
      });
    });
  });
</script>
