---
// Primitiva del design system: chip de filtro/navegación por categoría. Es un link
// simple (sin JS) — "filtrar" acá significa navegar a la página ya filtrada
// (/categoria/[slug]), no un filtro en cliente. Reusable en cualquier página que
// necesite ofrecer categorías como acceso rápido (home, /categorias, etc).
export interface Props {
  href: string;
  label: string;
  count?: number;
  active?: boolean;
}

const { href, label, count, active = false } = Astro.props;
---

<a
  href={href}
  class:list={[
    'inline-flex items-center gap-1.5 rounded-md border px-3.5 py-1.5 font-mono text-[11px] uppercase tracking-widest transition-colors',
    active
      ? 'border-accent bg-accent/15 text-accent'
      : 'border-ink/20 text-ink hover:border-accent hover:text-accent',
  ]}
>
  {label}
  {count !== undefined && <span class="opacity-60">({count})</span>}
</a>
