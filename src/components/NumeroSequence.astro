---
/**
 * Secuencia editorial para la página de un número — adaptada de un CodePen de
 * referencia (pista vertical infinita con `wheel`/`touch` + rAF). Mismo lenguaje visual
 * en todas las pantallas (info fija + tarjetas fluyendo), pero con DOS mecanismos de
 * entrada distintos según el tamaño, a propósito:
 *
 * - Desktop (md+): el mecanismo original de la referencia — `wheel` sobre la sección
 *   mueve un "scroll virtual" que reposiciona las tarjetas en loop infinito y compacta
 *   el título (todo interpolado desde la custom property `--seq-progress`). El listener
 *   va en el contenedor, no en `window` como en la referencia — la referencia era una
 *   demo de una sola pantalla que podía capturar todo el scroll del documento; acá hay
 *   header/footer/resto del sitio, así que capturar scroll global dejaría al usuario
 *   atrapado. Al escuchar en el elemento, el navegador solo dispara el evento cuando el
 *   cursor está físicamente encima — mover el mouse afuera devuelve el scroll normal.
 *
 * - Mobile: el mismo truco (capturar `touchmove`/`wheel` y bloquear el scroll real) NO
 *   es seguro acá — no existe "mover el dedo afuera" para soltarlo, y la sección ocupa
 *   casi toda la pantalla, así que el usuario podría quedar atrapado sin poder bajar.
 *   Pero la pila de tarjetas SÍ tiene que animarse acá también (no un simple listado
 *   estático) — así que el "carrusel" se maneja igual que un scrollytelling clásico:
 *   un listener de `scroll` PASIVO en window (nunca `preventDefault`, el navegador
 *   scrollea normal siempre) lee cuánto se scrolleó dentro de un "carril" alto
 *   (`.numero-sequence-runway`) y ese número alimenta la MISMA fórmula de posición que
 *   usa desktop. El carril tiene una pista `sticky` adentro que se queda fija en
 *   pantalla mientras dura el scroll del carril — eso es lo que hace que las tarjetas
 *   parezcan "pasar" en vez de que la sección entera se desplace de golpe.
 *
 * El texto (título/fecha/descripción) sigue en flujo simple arriba, a ancho completo,
 * sin sticky ni grid compartido con desktop — ver el layout mobile-first más abajo.
 */
interface EntradaItem {
  slug: string;
  titulo: string;
  categoriaNombre: string;
  autorNombre: string;
  portada?: string;
}

interface Props {
  titulo: string;
  descripcion?: string;
  fechaFormateada: string;
  entradas: EntradaItem[];
}

const { titulo, descripcion, fechaFormateada, entradas } = Astro.props;
---

<section
  id="numero-sequence"
  class="relative w-full overflow-hidden md:grid md:h-[75vh] md:grid-cols-2 md:gap-10"
>
  <div class="numero-sequence-info flex flex-col justify-center px-4 md:sticky md:top-20 md:z-10 md:min-w-0 md:self-start md:px-0">
    <p class="font-mono text-xs uppercase tracking-widest text-ink-muted">{fechaFormateada}</p>
    <h1 class="numero-sequence-title mt-2 font-headline leading-[0.9] text-ink">{titulo}</h1>
    {
      descripcion && (
        <p class="numero-sequence-desc mt-4 max-w-md overflow-hidden font-serif text-ink-muted">
          {descripcion}
        </p>
      )
    }
  </div>

  <div class="numero-sequence-runway relative h-[280vh] w-full md:h-full">
    <div
      class="numero-sequence-track sticky top-20 h-[65vh] w-full min-w-0 overflow-hidden px-4 md:static md:top-auto md:h-full md:w-full md:overflow-visible md:px-0"
    >
      {
        entradas.map((item) => (
          <a
            href={`/entrada/${item.slug}`}
            class="numero-sequence-card group absolute left-1/2 top-1/2 w-full min-w-0 max-w-md md:max-w-xl lg:max-w-2xl"
          >
            <div class="flex h-56 w-full overflow-hidden border border-ink/15 bg-surface md:h-80 lg:h-96">
              <div class="relative h-full w-2/5 shrink-0 bg-surface">
                {item.portada && (
                  <img
                    src={item.portada}
                    alt=""
                    class="pointer-events-none h-full w-full object-cover grayscale contrast-125"
                    loading="lazy"
                  />
                )}
                <span class="absolute left-2 top-2 border border-accent bg-canvas/80 px-2 py-1 font-mono text-[9px] uppercase tracking-widest text-accent md:px-3 md:py-1.5 md:text-xs">
                  {item.categoriaNombre}
                </span>
              </div>
              <div class="flex w-3/5 flex-col gap-1 p-4 md:gap-2 md:p-6">
                <h3 class="font-headline text-lg uppercase leading-[1.05] text-ink md:text-2xl lg:text-3xl">
                  {item.titulo}
                </h3>
                <p class="font-mono text-[10px] uppercase tracking-widest text-ink-muted md:text-xs">
                  Por {item.autorNombre}
                </p>
                <span class="mt-auto font-mono text-xs font-medium uppercase tracking-widest text-accent group-hover:underline md:text-sm">
                  Leer entrada
                </span>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  #numero-sequence {
    /* Mobile: arranca directo en compacto (1) — sin scroll virtual ni sticky ahí, el
       título ya se ve en su tamaño final desde el principio. Desktop la pisa con 0 y
       la anima el script en base al wheel. */
    --seq-progress: 1;
  }

  @media (min-width: 768px) {
    #numero-sequence {
      --seq-progress: 0;
    }
  }

  /* Todo lo que depende del progreso del scroll se interpola en CSS a partir de la
     custom property que el script actualiza cada frame — el script solo escribe un
     número, nunca toca font-size/opacity directamente. */
  .numero-sequence-title {
    font-size: clamp(1.75rem, calc(4rem - var(--seq-progress) * 2.1rem), 4.5rem);
  }

  .numero-sequence-desc {
    opacity: calc(1 - var(--seq-progress) * 1.6);
    max-height: calc((1 - var(--seq-progress)) * 10rem);
    transition: opacity 0.1s linear;
  }

  .numero-sequence-hint {
    opacity: calc(1 - var(--seq-progress) * 3);
  }

  .numero-sequence-card {
    will-change: transform, opacity;
  }
</style>

<script>
  const stage = document.getElementById('numero-sequence');

  if (stage) {
    const cards = Array.from(stage.querySelectorAll<HTMLElement>('.numero-sequence-card'));

    if (cards.length > 0) {
      const isDesktop = window.matchMedia('(min-width: 768px)').matches;
      const SPACING = 260;
      const SHRINK_DISTANCE = 320;

      let scrollOffset = 0;
      let infoProgress = 0;

      if (isDesktop) {
        // Desktop: scroll virtual — wheel/touch capturados y bloqueados (preventDefault),
        // seguro porque el listener vive en el elemento, no en window (ver comentario del
        // frontmatter).
        stage.addEventListener(
          'wheel',
          (event) => {
            event.preventDefault();
            scrollOffset = Math.max(0, scrollOffset + event.deltaY * 0.5);
          },
          { passive: false }
        );

        let touchStartY = 0;
        stage.addEventListener(
          'touchstart',
          (event) => {
            touchStartY = event.touches[0].clientY;
          },
          { passive: true }
        );
        stage.addEventListener(
          'touchmove',
          (event) => {
            const deltaY = touchStartY - event.touches[0].clientY;
            scrollOffset = Math.max(0, scrollOffset + deltaY * 0.8);
            touchStartY = event.touches[0].clientY;
          },
          { passive: true }
        );
      } else {
        // Mobile: scroll real y pasivo — nunca preventDefault, el navegador scrollea
        // normal siempre. El carril alto + la pista `sticky` (CSS) hacen que, mientras
        // se scrollea DENTRO del carril, la pista quede fija en pantalla; ese tramo de
        // scroll real es lo que se traduce a `scrollOffset` acá.
        const runway = stage.querySelector<HTMLElement>('.numero-sequence-runway');

        const updateFromScroll = () => {
          if (!runway) return;
          const top = runway.getBoundingClientRect().top;
          scrollOffset = Math.max(0, -top);
        };

        window.addEventListener('scroll', updateFromScroll, { passive: true });
        updateFromScroll();
      }

      const update = () => {
        const total = cards.length;

        if (isDesktop) {
          const infoTarget = Math.min(scrollOffset / SHRINK_DISTANCE, 1);
          infoProgress += (infoTarget - infoProgress) * 0.12;
          stage.style.setProperty('--seq-progress', infoProgress.toFixed(3));
        }

        cards.forEach((card, i) => {
          let progress = (i * SPACING - scrollOffset) % (total * SPACING);
          if (progress < -SPACING) progress += total * SPACING;
          if (progress > total * SPACING - SPACING) progress -= total * SPACING;

          const distanceNormalized = Math.abs(progress) / 400;
          const scale = Math.max(0.7, 1 - distanceNormalized * 0.3);
          const opacity = Math.max(0, 1 - distanceNormalized * 1.2);
          const zIndex = Math.round(100 - Math.abs(progress));

          card.style.transform = `translate3d(-50%, calc(-50% + ${progress}px), 0) scale(${scale})`;
          card.style.opacity = String(opacity);
          card.style.zIndex = String(zIndex);
        });

        requestAnimationFrame(update);
      };

      update();
    }
  }
</script>
