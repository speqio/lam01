---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryCard from '../../components/EntryCard.tsx';
import FilterChip from '../../components/ui/FilterChip.astro';

export async function getStaticPaths() {
  const categorias = await getCollection('categorias');
  return categorias.map((categoria) => ({
    params: { slug: categoria.id },
    props: { categoria },
  }));
}

const { categoria } = Astro.props;

const todasLasEntradas = await getCollection('entradas');
const entradasDeCategoria = todasLasEntradas.filter(
  (entrada) => entrada.data.categoria === categoria.id
);

const entradasConRelaciones = await Promise.all(
  entradasDeCategoria.map(async (entrada) => {
    const autor = await getEntry('autores', entrada.data.autor);
    return { entrada, autor };
  })
);

entradasConRelaciones.sort(
  (a, b) => b.entrada.data.fecha.valueOf() - a.entrada.data.fecha.valueOf()
);

const todasLasCategorias = await getCollection('categorias');
---

<BaseLayout title={`${categoria.data.nombre} — Blog Literario`}>
  <header class="mb-8 text-center">
    <p class="font-sans text-sm uppercase tracking-widest text-accent">Categoría</p>
    <h1 class="mt-2 font-headline text-5xl text-ink md:text-6xl">{categoria.data.nombre}</h1>
  </header>

  <div class="mb-12 flex flex-wrap justify-center gap-2">
    {
      todasLasCategorias.map((otraCategoria) => (
        <FilterChip
          href={`/categoria/${otraCategoria.id}`}
          label={otraCategoria.data.nombre}
          active={otraCategoria.id === categoria.id}
        />
      ))
    }
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
    {
      entradasConRelaciones.map(({ entrada, autor }) => (
        <EntryCard
          client:visible
          title={entrada.data.titulo}
          authorName={autor?.data.nombre ?? ''}
          categoryName={categoria.data.nombre}
          slug={entrada.id}
          coverImage={entrada.data.portada}
          date={entrada.data.fecha.toISOString()}
        />
      ))
    }
  </div>

  {
    entradasConRelaciones.length === 0 && (
      <p class="text-center font-sans text-ink-muted">
        Todavía no hay entradas publicadas en esta categoría.
      </p>
    )
  }
</BaseLayout>
