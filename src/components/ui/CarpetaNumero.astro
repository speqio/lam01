---
import type { EstampillaItem } from './ColeccionEstampillas.astro';

/**
 * CARPETA DE NÚMERO — la pieza de /numeros. Una carpeta de archivo plana y negra, con
 * dibujada entera con CSS y un `path` (ningún asset, ninguna línea de código del
 * componente de Framer que sirvió de referencia).
 *
 * DOS ESTADOS:
 * 1. Cerrada.
 * 2. Abierta: las estampillas del número asoman en abanico por el borde superior. En
 *    desktop basta pasar por encima (`@media (hover: hover)`, CSS puro).
 *
 * El clic es un link común a la página del número (`/numero-NN`, ver
 * views/NumeroPagina.astro), que tiene su propia diagramación para desktop y mobile. Ya
 * no hay ventana ni telón con la colección: esa versión quedó retirada (ver
 * docs/piezas-guardadas.md).
 */
interface Props {
  /** El número suelto, para la lengüeta ("28"). */
  numero: number;
  /** "Número 28", ya normalizado. */
  titulo: string;
  subtitulo?: string;
  portada?: string;
  /** Link al número completo. */
  href: string;
  /** Fecha ya formateada ("oct·26"). */
  fecha: string;
  /** Solo las primeras tres asoman en el abanico. */
  items: EstampillaItem[];
  /** Rango al que pertenece, para el filtro por chips de /numeros. */
  rangoId?: number;
  /**
   * Solo la tapa: sin las estampillas asomadas y sin el abanico del hover. Es lo que usa
   * la página de un número, donde las entradas ya están listadas arriba.
   */
  soloTapa?: boolean;
  /**
   * Sin la fecha ni el título sobre la portada. Es para cuando la página ya los dice al
   * lado (la de un número): ahí la carpeta es la imagen del número, no su ficha, y
   * repetir el dato encima de la foto lo dice dos veces. Se va con ellos el degradado
   * oscuro del pie, que existía solo para que ese texto se leyera sobre cualquier
   * portada.
   */
  sinDatos?: boolean;
}

const {
  numero,
  titulo,
  subtitulo,
  portada,
  href,
  fecha,
  items,
  rangoId,
  soloTapa = false,
  sinDatos = false,
} = Astro.props;

/* Lo que asoma: las tres primeras entradas del número. Más que eso no se distingue
   detrás de la tapa. */
const asoman = soloTapa ? [] : items.slice(0, 3);
---

<article
  class:list={['carpeta', soloTapa && 'carpeta--sola', sinDatos && 'carpeta--sin-datos']}
  data-numero-rango={rangoId}
  data-numero={numero}
>
  <a class="carpeta-tapa" href={href}>
    <span class="carpeta-pieza">
      {/* Las estampillas guardadas: asoman en abanico al pasar por encima. Van detrás del
          cuerpo, que es lo que las tapa cuando está cerrada, y llevan el mismo dentado que
          en la hoja (`.estampilla-perforada`, global.css). */}
      <span class="carpeta-hojas" aria-hidden="true">
        {asoman.map((item, i) => (
          <span
            class="carpeta-hoja estampilla-perforada"
            style={`--h: ${i}; --giro: ${(i - 1) * 4}deg;`}
          >
            {item.coverImage && <img src={item.coverImage} alt="" loading="lazy" />}
          </span>
        ))}
      </span>

      <span class="carpeta-cuerpo">
        {portada && (
          <span class="carpeta-portada">
            <img src={portada} alt="" loading="lazy" />
          </span>
        )}

        {!sinDatos && (
          <span class="carpeta-datos">
            <span class="carpeta-fecha">{fecha}</span>
            <span class="carpeta-titulo">{titulo}</span>
            {subtitulo && <span class="carpeta-subtitulo">{subtitulo}</span>}
          </span>
        )}
      </span>
    </span>
  </a>
</article>

<style>
  .carpeta {
    /* La carpeta es casi negra sobre el canvas, apenas más oscura: la forma la dibujan
       la línea interior y la lengüeta, no el relleno. */
    --carpeta-papel: 8 8 8;
    --carpeta-radio: 14px;
  }

  .carpeta-tapa {
    display: block;
  }

  .carpeta-pieza {
    position: relative;
    display: block;
    /* Carpeta parada: más alta que ancha. */
    aspect-ratio: 3 / 4;
  }

  .carpeta-cuerpo {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.15rem;
    overflow: hidden;
    /* Esquinas redondeadas de la tapa. Van en una custom property porque la portada, el
       degradado y el filo interior se recortan todos contra este mismo radio: el
       `overflow: hidden` de acá es lo que redondea la foto que va a sangre adentro. */
    border-radius: var(--carpeta-radio);
    padding: 1rem 1.1rem;
    background-color: rgb(var(--carpeta-papel));
    /* Un filo tenue para que la silueta se despegue del fondo del sitio, que también es
       oscuro: en la referencia la carpeta negra se recorta contra blanco. */
    box-shadow:
      inset 0 0 0 1px rgb(var(--rgb-ink) / 0.07),
      0 14px 30px rgb(0 0 0 / 0.5);
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  /* La portada ocupa toda la carpeta, a sangre. */
  .carpeta-portada {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: inherit;
  }
  .carpeta-portada img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Sin datos no hace falta el degradado: estaba para que el texto se leyera sobre
     cualquier portada, y sin texto solo oscurece la foto. */
  .carpeta--sin-datos .carpeta-cuerpo::after {
    content: none;
  }

  .carpeta-cuerpo::after {
    /* Degradado hacia abajo: es lo que deja leer el título sobre cualquier portada.
       Va en negro literal y no en tokens: en tema claro los tokens se invierten y la
       sombra se volvía blanca, con lo que el título quedaba ilegible sobre la foto. Por
       el mismo motivo las letras de la carpeta son blancas en los dos temas. */
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgb(8 8 8 / 0.95) 4%,
      rgb(8 8 8 / 0.6) 38%,
      rgb(8 8 8 / 0) 72%
    );
  }

  .carpeta-datos {
    position: relative;
    z-index: 1;
    display: flex;
    min-width: 0;
    max-width: 78%;
    flex-direction: column;
    gap: 0.15rem;
  }
  .carpeta-fecha {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.18em;
    color: rgb(255 255 255 / 0.65);
  }
  .carpeta-titulo {
    font-family: var(--font-headline);
    font-size: 1rem;
    line-height: 1.15;
    color: rgb(255 255 255);
  }
  .carpeta-subtitulo {
    font-family: var(--font-serif);
    font-size: 0.78rem;
    font-style: italic;
    color: rgb(255 255 255 / 0.75);
  }

  /* Las estampillas, detrás del cuerpo, que las tapa cuando está cerrada. */
  .carpeta-hojas {
    position: absolute;
    inset: 8% 10% 12%;
    display: block;
  }
  .carpeta-hoja {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background-color: rgb(var(--rgb-surface));
    /* `drop-shadow` y no `box-shadow`: la sombra tiene que seguir la silueta dentada,
       no la caja rectangular que hay debajo de la máscara. */
    filter: drop-shadow(0 6px 14px rgb(0 0 0 / 0.5));
    /* Dientes más chicos que en la hoja grande: acá solo se ve la franja de arriba. */
    --diente-r: 4px;
    --diente-paso: 12px;
    transform-origin: 50% 100%;
    transition: transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .carpeta-hoja img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ABIERTA: las estampillas salen en abanico por el borde superior, con el hover. */
  @media (hover: hover) {
    .carpeta:hover .carpeta-hoja,
    .carpeta:focus-within .carpeta-hoja {
      transform: translateY(calc(-16% - var(--h) * 6%)) rotate(var(--giro));
    }
    .carpeta:hover .carpeta-cuerpo,
    .carpeta:focus-within .carpeta-cuerpo {
      transform: translateY(4px);
    }
  }

  /* La tapa sola no se mueve al pasar por encima: no hay estampillas que asomar, y el
     cuerpo levantandose sin nada detras se lee como un salto sin motivo. Va despues de
     las reglas de hover y con su misma especificidad, o no las gana. */
  .carpeta--sola:hover .carpeta-cuerpo,
  .carpeta--sola:focus-within .carpeta-cuerpo {
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .carpeta-hoja,
    .carpeta-cuerpo {
      transition: none;
    }
  }
</style>
