---
import type { CollectionEntry } from 'astro:content';

/**
 * Carrusel de categorías — DOS mecanismos de navegación distintos según el tamaño, a
 * propósito (mismo criterio que NumeroSequence.astro):
 *
 * - Desktop (md+): autoplay + loop infinito en JS (rAF + `translateX` en px, offset con
 *   módulo sobre el ancho de un set) y navegación con la rueda del mouse/trackpad
 *   estando encima — capturada en el contenedor, nunca en window. La pista renderiza
 *   la lista de categorías dos veces seguidas para el loop; el segundo set se marca
 *   `aria-hidden`/`tabindex="-1"` para que lectores de pantalla y teclado no lo vean.
 *
 * - Mobile: SIN autoplay — se probó y la animación continua ahí se sentía pesada aun
 *   optimizada (ver historial de este componente), y además "algo que se mueve solo"
 *   no comunica que se puede navegar. En su lugar es un carril con scroll horizontal
 *   NATIVO (`overflow-x` + `scroll-snap`, sin JS de por medio moviendo nada — el
 *   navegador compone el scroll, no hay forma más barata) y puntos de paginación
 *   debajo que (a) avisan que hay más categorías para el lado y (b) marcan cuál está
 *   activa a medida que se scrollea. El segundo set (solo necesario para el loop
 *   infinito de desktop) se oculta en mobile — el scroll nativo es finito, no loop.
 *
 * Las categorías no tienen portada propia en el CMS (ver `imagenPorCategoria`, resuelto
 * en index.astro a partir de la entrada más reciente de cada categoría) — la tarjeta
 * cae a un panel tipográfico cuando no hay ninguna disponible todavía.
 *
 * Las fotos van en `<img loading="lazy" decoding="async">` en vez de background-image
 * inline: el navegador las decodifica fuera del hilo principal y no descarga las del
 * segundo set (fuera de vista en desktop, inexistente en mobile) de entrada.
 */
interface Props {
  categorias: CollectionEntry<'categorias'>[];
  imagenPorCategoria: Record<string, string>;
}

const { categorias, imagenPorCategoria } = Astro.props;
---

{
  categorias.length > 0 && (
    <section class="relative mb-12">
      <div class="mb-6 md:hidden">
        <h2 class="font-headline text-2xl lg:text-3xl">Categorías</h2>
      </div>

      <div class="mb-6 hidden text-center md:block">
        <span class="mb-2 block font-mono text-xs uppercase tracking-widest text-ink/50">
          Revisá nuestro catálogo
        </span>
        <h2 class="font-headline text-4xl uppercase leading-none tracking-tight text-ink lg:text-6xl">
          Categorías
        </h2>
      </div>

      <div id="categorias-marquee" class="categorias-marquee-view">
        <ul class="categorias-marquee-track">
          {categorias.map((categoria) => (
            <li class="categorias-marquee-card">
              <a
                href={`/categoria/${categoria.id}`}
                class="group relative block h-full w-full overflow-hidden border border-ink/15 bg-surface transition-colors duration-300 hover:border-accent"
              >
                {imagenPorCategoria[categoria.id] && (
                  <img
                    src={imagenPorCategoria[categoria.id]}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    class="pointer-events-none absolute inset-0 h-full w-full object-cover"
                  />
                )}
                {imagenPorCategoria[categoria.id] && (
                  <span class="absolute inset-0 bg-gradient-to-t from-canvas/90 via-canvas/10 to-transparent" />
                )}
                <span class="relative flex h-full flex-col justify-end p-4">
                  <span class="font-headline text-lg uppercase leading-tight text-ink lg:text-xl">
                    {categoria.data.nombre}
                  </span>
                  <span class="mt-1 font-mono text-xs uppercase tracking-widest text-accent opacity-0 transition-opacity duration-300 group-hover:opacity-100">
                    Explorar
                  </span>
                </span>
              </a>
            </li>
          ))}
          {categorias.map((categoria) => (
            <li class="categorias-marquee-card hidden md:block" aria-hidden="true">
              <a
                href={`/categoria/${categoria.id}`}
                tabindex="-1"
                class="group relative block h-full w-full overflow-hidden border border-ink/15 bg-surface transition-colors duration-300 hover:border-accent"
              >
                {imagenPorCategoria[categoria.id] && (
                  <img
                    src={imagenPorCategoria[categoria.id]}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    class="pointer-events-none absolute inset-0 h-full w-full object-cover"
                  />
                )}
                {imagenPorCategoria[categoria.id] && (
                  <span class="absolute inset-0 bg-gradient-to-t from-canvas/90 via-canvas/10 to-transparent" />
                )}
                <span class="relative flex h-full flex-col justify-end p-4">
                  <span class="font-headline text-lg uppercase leading-tight text-ink lg:text-xl">
                    {categoria.data.nombre}
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ul>

        <div
          class="pointer-events-none absolute inset-y-0 left-0 z-10 w-10 bg-gradient-to-r from-canvas to-transparent md:w-16"
          aria-hidden="true"
        />
        <div
          class="pointer-events-none absolute inset-y-0 right-0 z-10 w-10 bg-gradient-to-l from-canvas to-transparent md:w-16"
          aria-hidden="true"
        />
      </div>

      <div
        class="categorias-marquee-pagination mt-4 flex flex-wrap items-center justify-center gap-2.5 md:hidden"
        role="tablist"
        aria-label="Ir a categoría"
      >
        {categorias.map((categoria) => (
          <button
            type="button"
            class="categorias-marquee-dot h-2.5 w-2.5 shrink-0 rounded-full border border-ink/30 bg-ink/10 transition-all duration-300"
            aria-label={`Ir a ${categoria.data.nombre}`}
          />
        ))}
      </div>
    </section>
  )
}

<style>
  .categorias-marquee-view {
    position: relative;
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    /* pan-x (no pan-y): el navegador tiene que manejar nativo el swipe horizontal acá
       adentro para que el scroll-snap responda al dedo sobre las cards, no solo al
       tocar los puntos de paginación — un swipe vertical que arranca acá sigue
       burbujeando como scroll normal de la página. */
    touch-action: pan-x;
    contain: layout paint;
  }

  .categorias-marquee-view::-webkit-scrollbar {
    display: none;
  }

  @media (min-width: 768px) {
    .categorias-marquee-view {
      overflow: hidden;
      scroll-snap-type: none;
    }
  }

  .categorias-marquee-track {
    display: flex;
    width: max-content;
    will-change: transform;
    backface-visibility: hidden;
    transform: translate3d(0, 0, 0);
  }

  .categorias-marquee-card {
    width: 12rem;
    height: 17rem;
    margin-right: 1rem;
    flex-shrink: 0;
    scroll-snap-align: start;
  }

  @media (min-width: 768px) {
    .categorias-marquee-card {
      width: 15rem;
      height: 21rem;
    }
  }

  @media (min-width: 1024px) {
    .categorias-marquee-card {
      width: 17rem;
      height: 23rem;
    }
  }
</style>

<script>
  const AUTOPLAY_DURATION_S = 48;

  function initDesktopMarquee(view: HTMLElement, trackEl: HTMLElement) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let setWidth = 0;
    let offset = 0;
    let isInteracting = false;
    let lastTime: number | null = null;

    function measure() {
      const width = trackEl.scrollWidth;
      setWidth = width > 0 ? width / 2 : 0;
      if (setWidth <= 0) return;
      offset = ((offset % setWidth) + setWidth) % setWidth;
      render();
    }

    function render() {
      if (!setWidth) return;
      trackEl.style.transform = `translate3d(${-offset}px, 0, 0)`;
    }

    view.addEventListener(
      'wheel',
      (event) => {
        event.preventDefault();
        const delta = Math.abs(event.deltaX) > Math.abs(event.deltaY) ? event.deltaX : event.deltaY;
        if (!delta || !setWidth) return;
        offset = ((offset + delta) % setWidth + setWidth) % setWidth;
        render();
      },
      { passive: false }
    );

    view.addEventListener('mouseenter', () => {
      isInteracting = true;
    });
    view.addEventListener('mouseleave', () => {
      isInteracting = false;
    });
    view.addEventListener('focusin', () => {
      isInteracting = true;
    });
    view.addEventListener('focusout', () => {
      isInteracting = false;
    });

    if (reduceMotion) {
      measure();
      render();
      return;
    }

    function tick(now: number) {
      if (lastTime === null) lastTime = now;
      const dt = Math.min((now - lastTime) / 1000, 0.05);
      lastTime = now;

      if (!isInteracting && setWidth > 0) {
        const velocity = setWidth / AUTOPLAY_DURATION_S;
        offset = ((offset + velocity * dt) % setWidth + setWidth) % setWidth;
        render();
      }

      requestAnimationFrame(tick);
    }

    measure();
    render();
    window.addEventListener('resize', measure, { passive: true });

    if ('ResizeObserver' in window) {
      const resizeObserver = new ResizeObserver(() => measure());
      resizeObserver.observe(view);
    }

    requestAnimationFrame(tick);
  }

  // Mobile: sin autoplay, el navegador scrollea nativo (scroll-snap). Los puntos son
  // indicador de posición + atajo para saltar a una tarjeta — nada mueve la pista por
  // JS, solo se lee `view.scrollLeft` para saber cuál está activa.
  function initMobilePagination(view: HTMLElement, trackEl: HTMLElement) {
    const dots = Array.from(
      document.querySelectorAll<HTMLButtonElement>('.categorias-marquee-dot')
    );
    if (dots.length === 0) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const step = () => trackEl.scrollWidth / dots.length;

    let lastActive = -1;
    function updateActive() {
      const index = Math.max(0, Math.min(dots.length - 1, Math.round(view.scrollLeft / step())));
      if (index === lastActive) return;
      lastActive = index;
      dots.forEach((dot, i) => {
        const active = i === index;
        dot.classList.toggle('bg-accent', active);
        dot.classList.toggle('border-accent', active);
        dot.classList.toggle('scale-125', active);
        dot.classList.toggle('bg-ink/10', !active);
        dot.classList.toggle('border-ink/30', !active);
      });
    }

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        view.scrollTo({ left: i * step(), behavior: reduceMotion ? 'auto' : 'smooth' });
      });
    });

    view.addEventListener('scroll', updateActive, { passive: true });
    updateActive();
  }

  function initMarquee() {
    const view = document.getElementById('categorias-marquee');
    if (!(view instanceof HTMLElement)) return;

    const track = view.querySelector('.categorias-marquee-track');
    if (!(track instanceof HTMLElement)) return;

    const isDesktop = window.matchMedia('(min-width: 768px)').matches;

    if (isDesktop) {
      initDesktopMarquee(view, track);
    } else {
      initMobilePagination(view, track);
    }
  }

  initMarquee();
</script>
