---
import SearchModal from './ui/SearchModal.tsx';
import ThemeToggle from './ThemeToggle.astro';
import HeroAnagram from './HeroAnagram.astro';
import { navItems } from '../data/navItems';
---

<header class="pointer-events-none fixed inset-x-0 top-0 z-20 hidden md:block" data-header>
  <!-- Masthead: se contrae en una nav bar compacta al bajar el scroll (ver script abajo) -->
  <div class="border-b border-transparent bg-transparent backdrop-blur-none" data-header-masthead>
    <div
      class="pointer-events-auto mx-auto grid h-20 max-w-[1600px] grid-cols-3 items-center gap-4 px-4 md:px-8 lg:px-12"
      data-header-bar
    >
      <div class="relative z-10 justify-self-start">
        <HeroAnagram variant="header" />
      </div>

      <nav class="flex items-center justify-center gap-6 font-mono text-xs uppercase tracking-widest text-ink">
        {
          navItems.map((item) => (
            <a href={item.url} class="group relative text-ink transition-colors hover:text-accent">
              {item.name}
              <span class="absolute -bottom-1 left-0 h-px w-0 bg-accent transition-all duration-300 group-hover:w-full" />
            </a>
          ))
        }
      </nav>

      <div class="flex items-center gap-3 justify-self-end">
        <SearchModal client:load />
        <ThemeToggle />
      </div>
    </div>
  </div>
</header>

<style>
  /*
   * Contracción al bajar el scroll: el header pasa de masthead transparente (flota sobre
   * el hero) a nav bar compacta con fondo, como la barra flotante de mobile pero sin
   * esconder nada — en desktop siempre hay espacio para los tres bloques, lo que cambia
   * es el alto y el fondo. `header` es `fixed` (no `absolute`) para que se quede anclado
   * al viewport mientras se scrollea: con `absolute` se iba con el contenido y nunca
   * llegaba a mostrarse como nav bar.
   */
  [data-header-masthead] {
    /* El blur/fondo del masthead se difumina hacia abajo en vez de cortar en una
       línea recta contra el contenido que scrollea detrás: `padding-bottom` agrega
       una franja extra debajo de la barra visible (`[data-header-bar]`, que define
       el alto real) y `mask-image` la usa para desvanecer — opaco hasta el borde de
       la barra, transparente al final de esa franja. Sin `pointer-events` acá (lo
       tiene `[data-header-bar]` en su lugar): si esta franja extra fuera clickeable,
       un área invisible debajo de la nav bar bloquearía clics en el contenido. */
    padding-bottom: 1.5rem;
    mask-image: linear-gradient(to bottom, black calc(100% - 1.5rem), transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, black calc(100% - 1.5rem), transparent 100%);
    transition:
      background-color 0.35s ease,
      border-color 0.35s ease,
      backdrop-filter 0.35s ease;
  }
  [data-header-bar] {
    transition: height 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  [data-header][data-compacto='true'] [data-header-masthead] {
    /* Fondo SIEMPRE transparente, también contraído: un fondo sólido interrumpe la
       lectura del contenido que pasa debajo. El blur alcanza para separar visualmente
       la nav bar sin tapar lo que hay detrás. */
    backdrop-filter: blur(8px);
  }
  [data-header][data-compacto='true'] [data-header-bar] {
    height: 3.5rem;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-header-masthead],
    [data-header-bar] {
      transition: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');

  if (header) {
    const actualizar = () => {
      header.dataset.compacto = window.scrollY > 24 ? 'true' : 'false';
    };

    actualizar();
    window.addEventListener('scroll', actualizar, { passive: true });
  }
</script>
