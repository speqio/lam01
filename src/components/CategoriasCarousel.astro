---
import type { CollectionEntry } from 'astro:content';

/**
 * Categorías del home — ya no es una tira de tarjetas con foto (esa versión, en
 * cualquiera de sus variantes, seguía dando problemas de renderizado en mobile que no
 * se pudieron acotar). Ahora es un ticker tipográfico: solo el nombre de cada
 * categoría, como links reales, en loop horizontal continuo — sin fotos, sin
 * tarjetas/bordes/rectángulos, mismo mecanismo en todos los tamaños de pantalla.
 *
 * El movimiento lo maneja GSAP por completo (sin CSS @keyframes ni requestAnimationFrame
 * manual): un solo tween infinito (`xPercent` 0→-50, la pista duplica la lista de
 * categorías una vez para el loop sin costura) que se pausa con :hover/:focus-within y
 * retoma solo. En desktop (md+), el plugin `Observer` de GSAP captura la rueda del
 * mouse/trackpad sobre el contenedor (nunca en window) y "scrubea" el mismo tween
 * escribiendo directamente su `totalTime` — GSAP resuelve el wrap del loop infinito
 * solo, no hace falta acumular ni normalizar un offset a mano.
 *
 * Los nombres se pasan por `.toLocaleUpperCase('es')` en vez de usar `uppercase` de
 * CSS: en algunos navegadores mobile, pedirle al motor de render que transforme a
 * mayúscula un acento (ñ→Ñ, ó→Ó) sobre esta tipografía rompe la composición del glifo
 * y se pierde la tilde/diéresis ("reseña" quedaba "RESENA"). Mandar el string ya en
 * mayúscula evita ese paso — el navegador solo tiene que dibujar el carácter, no
 * transformarlo primero.
 */
interface Props {
  categorias: CollectionEntry<'categorias'>[];
}

const { categorias } = Astro.props;
---

{
  categorias.length > 0 && (
    <section class="relative mb-12">
      <div class="mb-6 md:hidden">
        <h2 class="font-headline text-2xl lg:text-3xl">Categorías</h2>
      </div>

      <div class="mb-6 hidden text-center md:block">
        <span class="mb-2 block font-mono text-xs uppercase tracking-widest text-ink/50">
          Revisá nuestro catálogo
        </span>
        <h2 class="font-headline text-4xl uppercase leading-none tracking-tight text-ink lg:text-6xl">
          Categorías
        </h2>
      </div>

      <div id="categorias-ticker" class="categorias-ticker-view">
        <div class="categorias-ticker-track">
          {categorias.map((categoria) => (
            <>
              <a
                href={`/categoria/${categoria.id}`}
                class="font-headline text-xl font-medium leading-none tracking-tight text-ink transition-colors duration-200 hover:text-accent sm:text-2xl md:text-3xl"
              >
                {categoria.data.nombre.toLocaleUpperCase('es')}
              </a>
              <span
                class="mx-4 text-xl leading-none text-ink/20 sm:text-2xl md:mx-6 md:text-3xl"
                aria-hidden="true"
              >
                •
              </span>
            </>
          ))}
          {categorias.map((categoria) => (
            <>
              <a
                href={`/categoria/${categoria.id}`}
                tabindex="-1"
                aria-hidden="true"
                class="font-headline text-xl font-medium leading-none tracking-tight text-ink transition-colors duration-200 hover:text-accent sm:text-2xl md:text-3xl"
              >
                {categoria.data.nombre.toLocaleUpperCase('es')}
              </a>
              <span
                class="mx-4 text-xl leading-none text-ink/20 sm:text-2xl md:mx-6 md:text-3xl"
                aria-hidden="true"
              >
                •
              </span>
            </>
          ))}
        </div>

        <div
          class="pointer-events-none absolute inset-y-0 left-0 z-10 w-10 bg-gradient-to-r from-canvas to-transparent md:w-24"
          aria-hidden="true"
        />
        <div
          class="pointer-events-none absolute inset-y-0 right-0 z-10 w-10 bg-gradient-to-l from-canvas to-transparent md:w-24"
          aria-hidden="true"
        />
      </div>
    </section>
  )
}

<style>
  .categorias-ticker-view {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .categorias-ticker-track {
    display: flex;
    align-items: baseline;
    width: max-content;
    white-space: nowrap;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { Observer } from 'gsap/Observer';

  gsap.registerPlugin(Observer);

  const AUTOPLAY_DURATION_S = 34;

  function initCategoriasTicker() {
    const view = document.getElementById('categorias-ticker');
    if (!(view instanceof HTMLElement)) return;

    const track = view.querySelector('.categorias-ticker-track');
    if (!(track instanceof HTMLElement)) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isDesktop = window.matchMedia('(min-width: 768px)').matches;

    // Tween infinito único: es la única fuente de verdad de la posición, en todos los
    // tamaños de pantalla. Con reduced-motion arranca pausado (se queda en el estado
    // "from", xPercent 0) pero igual puede recibir scrub por wheel en desktop — la
    // idea de reduced-motion es no animar solo, no bloquear un gesto que el usuario
    // mismo inició.
    const tween = gsap.to(track, {
      xPercent: -50,
      duration: AUTOPLAY_DURATION_S,
      ease: 'none',
      repeat: -1,
      paused: reduceMotion,
    });

    if (!reduceMotion) {
      view.addEventListener('mouseenter', () => tween.pause());
      view.addEventListener('mouseleave', () => tween.play());
      view.addEventListener('focusin', () => tween.pause());
      view.addEventListener('focusout', () => tween.play());
    }

    if (isDesktop) {
      // La mitad del scrollWidth = el largo de un set (la pista duplica la lista de
      // categorías una vez para el loop sin costura).
      let setWidth = track.scrollWidth / 2;
      const measure = () => {
        setWidth = track.scrollWidth / 2;
      };

      // Observer normaliza wheel/trackpad y se captura sobre el contenedor, nunca en
      // window — mismo criterio que el resto de las secciones scroll-driven del
      // sitio, así no secuestra el scroll de la página cuando el cursor pasa encima.
      Observer.create({
        target: view,
        type: 'wheel',
        preventDefault: true,
        onChange: (self) => {
          const delta = Math.abs(self.deltaX) > Math.abs(self.deltaY) ? self.deltaX : self.deltaY;
          if (!delta || !setWidth) return;
          // Scrubea el tween escribiendo su totalTime directamente: GSAP ya resuelve
          // el wrap del loop infinito solo (repeat: -1), no hace falta acumular ni
          // normalizar un offset a mano.
          tween.totalTime(tween.totalTime() + delta / (setWidth / AUTOPLAY_DURATION_S));
        },
      });

      window.addEventListener('resize', measure, { passive: true });
      if ('ResizeObserver' in window) {
        new ResizeObserver(measure).observe(view);
      }
    }
  }

  initCategoriasTicker();
</script>
